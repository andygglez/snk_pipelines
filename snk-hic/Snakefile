# BOWTIE2_BUILD
rule bowtie2_build:
    input:
        FASTA,
    output:
        maybe_temp(directory(f"{O}/genome/bowtie2"), config["save_reference"]),
    params:
        prefix=lambda wc, input: os.path.splitext(os.path.basename(input[0]))[0],
    container:
        container_path("bowtie2")
    threads: res("single")["threads"]
    resources:
        mem_mb=res("single")["mem_mb"],
    log:
        f"{O}/logs/bowtie2_build.log",
    shell:
        """
        mkdir -p {output}
        bowtie2-build --threads {threads} {input} {output}/{params.prefix} > {log} 2>&1
        """


# CUSTOM_GETCHROMSIZES
rule getchromsizes:
    input:
        FASTA,
    output:
        sizes=maybe_temp(f"{O}/genome/{os.path.basename(FASTA)}.sizes", config["save_reference"]),
        fai=maybe_temp(f"{O}/genome/{os.path.basename(FASTA)}.fai", config["save_reference"]),
    container:
        container_path("samtools_chromsizes")
    threads: res("single")["threads"]
    resources:
        mem_mb=res("single")["mem_mb"],
    shell:
        """
        samtools faidx --fai-idx {output.fai} {input}
        cut -f 1,2 {output.fai} > {output.sizes}
        """


# GET_RESTRICTION_FRAGMENTS
rule get_restriction_fragments:
    input:
        FASTA,
    output:
        maybe_temp(f"{O}/genome/restriction_fragments.bed", config["save_reference"]),
    params:
        site=RESTRICTION_SITE,
    container:
        container_path("hicpro_python")
    threads: res("low")["threads"]
    resources:
        mem_mb=res("low")["mem_mb"],
    shell:
        "python {SCRIPTS}/digest_genome.py -r '{params.site}' -o {output} {input}"


# =============================================================================
# QC
# =============================================================================

# FASTQC (prefix meta.id). nf-core runs it on every chunk and all chunks of a
# sample publish the same <sample>_{1,2}_fastqc.* (the last one written wins);
# here each chunk is checked in the work area and the last chunk is published.
rule fastqc:
    input:
        r1=lambda wc: chunk_pairs(wc.sample)[int(wc.chunk)][0],
        r2=lambda wc: chunk_pairs(wc.sample)[int(wc.chunk)][1],
    output:
        html1=f"{O}/work/fastqc/{{sample}}/{{chunk}}/{{sample}}_1_fastqc.html",
        zip1=f"{O}/work/fastqc/{{sample}}/{{chunk}}/{{sample}}_1_fastqc.zip",
        html2=f"{O}/work/fastqc/{{sample}}/{{chunk}}/{{sample}}_2_fastqc.html",
        zip2=f"{O}/work/fastqc/{{sample}}/{{chunk}}/{{sample}}_2_fastqc.zip",
    container:
        container_path("fastqc")
    threads: res("medium")["threads"]
    resources:
        mem_mb=res("medium")["mem_mb"],
    log:
        f"{O}/logs/fastqc/{{sample}}_{{chunk}}.log",
    shell:
        """
        tmp=$(mktemp -d)
        ln -s $(realpath {input.r1}) $tmp/{wildcards.sample}_1.fastq.gz
        ln -s $(realpath {input.r2}) $tmp/{wildcards.sample}_2.fastq.gz
        fastqc --threads {threads} -o $(dirname {output.html1}) \
            $tmp/{wildcards.sample}_1.fastq.gz $tmp/{wildcards.sample}_2.fastq.gz > {log} 2>&1
        rm -rf $tmp
        """


rule fastqc_publish:
    input:
        lambda wc: f"{O}/work/fastqc/{wc.sample}/{list(chunks(wc.sample))[-1]}/{wc.sample}_{wc.r}_fastqc.{wc.ext}",
    output:
        f"{O}/fastqc/{{sample}}_{{r}}_fastqc.{{ext}}",
    wildcard_constraints:
        r="1|2",
        ext="html|zip",
    shell:
        "cp {input} {output}"


# =============================================================================
# HICPRO_MAPPING
# =============================================================================

# BOWTIE2_ALIGN — end-to-end alignment of each mate as single-end reads
rule bowtie2_align:
    input:
        fq=chunk_fastq,
        index=BWT2_INDEX,
        samplesheet=f"{O}/samplesheet/samplesheet.valid.csv",
    output:
        bam=maybe_temp(f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.bam", config["save_aligned_intermediates"]),
        unmapped=maybe_temp(f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.unmapped.fastq.gz", config["save_aligned_intermediates"]),
    log:
        f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.bowtie2.log",
    params:
        args=config["bwt2_opts_end2end"],
        args2="" if DNASE else "-F 4",
    container:
        container_path("bowtie2_samtools")
    threads: res("high")["threads"]
    resources:
        mem_mb=res("high")["mem_mb"],
    shell:
        """
        INDEX=$(find -L {input.index} -name "*.rev.1.bt2" | sed "s/\\.rev.1.bt2$//")
        [ -z "$INDEX" ] && INDEX=$(find -L {input.index} -name "*.rev.1.bt2l" | sed "s/\\.rev.1.bt2l$//")
        [ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1

        bowtie2 -x $INDEX -U {input.fq} --threads {threads} \
            --un-gz {output.unmapped} {params.args} 2> {log} \
            | samtools view {params.args2} --threads {threads} -o {output.bam} -
        """


if not DNASE:

    # TRIM_READS — trim unmapped reads at the ligation junction
    rule trim_reads:
        input:
            f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.unmapped.fastq.gz",
        output:
            maybe_temp(f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}_trimmed.fastq.gz", config["save_aligned_intermediates"]),
        params:
            motif=LIGATION_SITE,
            tmp=f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.tmp.fastq",
            out=f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}_trimmed.fastq",
        container:
            container_path("ubuntu")
        threads: res("low")["threads"]
        resources:
            mem_mb=res("low")["mem_mb"],
        shell:
            """
            zcat {input} > {params.tmp}
            {SCRIPTS}/cutsite_trimming --fastq {params.tmp} \
                --cutsite {params.motif} \
                --out {params.out}
            gzip -f {params.out}
            rm -f {params.tmp}
            """

    # BOWTIE2_ALIGN_TRIMMED — re-align the trimmed reads
    rule bowtie2_align_trimmed:
        input:
            fq=f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}_trimmed.fastq.gz",
            index=BWT2_INDEX,
        output:
            bam=maybe_temp(f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}_trimmed.bam", config["save_aligned_intermediates"]),
        log:
            f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}_trimmed.bowtie2.log",
        params:
            args=config["bwt2_opts_trimmed"],
        container:
            container_path("bowtie2_samtools")
        threads: res("high")["threads"]
        resources:
            mem_mb=res("high")["mem_mb"],
        shell:
            """
            INDEX=$(find -L {input.index} -name "*.rev.1.bt2" | sed "s/\\.rev.1.bt2$//")
            [ -z "$INDEX" ] && INDEX=$(find -L {input.index} -name "*.rev.1.bt2l" | sed "s/\\.rev.1.bt2l$//")
            [ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1

            bowtie2 -x $INDEX -U {input.fq} --threads {threads} {params.args} 2> {log} \
                | samtools view --threads {threads} -o {output.bam} -
            """

    # MERGE_BOWTIE2 — merge end-to-end + trimmed alignments, name-sort, mapping stats
    rule merge_bowtie2:
        input:
            bam1=f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.bam",
            bam2=f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}_trimmed.bam",
        output:
            bam=maybe_temp(f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}_bwt2merged.bam", config["save_aligned_intermediates"]),
            stats=f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.mapstat",
        params:
            prefix="{sample}_{chunk}_{mate}",
            unsorted=f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}_bwt2merged.unsorted.bam",
            sort_mem=config["samtools_sort_mem"],
        container:
            container_path("samtools")
        threads: res("medium")["threads"]
        resources:
            mem_mb=res("medium")["mem_mb"],
        shell:
            """
            samtools merge -@ {threads} -f {params.unsorted} {input.bam1} {input.bam2}
            samtools sort -@ {threads} -m {params.sort_mem} -n -o {output.bam} {params.unsorted}
            rm -f {params.unsorted}

            echo "## {params.prefix}" > {output.stats}
            echo -n "total_{wildcards.mate}\t" >> {output.stats}
            samtools view -c {output.bam} >> {output.stats}
            echo -n "mapped_{wildcards.mate}\t" >> {output.stats}
            samtools view -c -F 4 {output.bam} >> {output.stats}
            echo -n "global_{wildcards.mate}\t" >> {output.stats}
            samtools view -c -F 4 {input.bam1} >> {output.stats}
            echo -n "local_{wildcards.mate}\t" >> {output.stats}
            samtools view -c -F 4 {input.bam2} >> {output.stats}
            """

else:

    # MAPPING_STATS_DNASE
    rule mapping_stats_dnase:
        input:
            f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.bam",
        output:
            stats=f"{MAPDIR}/{{sample}}_{{chunk}}_{{mate}}.mapstat",
        params:
            prefix="{sample}_{chunk}_{mate}",
        container:
            container_path("samtools")
        threads: res("medium")["threads"]
        resources:
            mem_mb=res("medium")["mem_mb"],
        shell:
            """
            echo "## {params.prefix}" > {output.stats}
            echo -n "total_{wildcards.mate}\t" >> {output.stats}
            samtools view -c {input} >> {output.stats}
            echo -n "mapped_{wildcards.mate}\t" >> {output.stats}
            samtools view -c -F 4 {input} >> {output.stats}
            echo -n "global_{wildcards.mate}\t" >> {output.stats}
            samtools view -c -F 4 {input} >> {output.stats}
            echo -n "local_{wildcards.mate}\t0" >> {output.stats}
            """


def mate_bam(mate):
    suffix = "" if DNASE else "_bwt2merged"
    return f"{MAPDIR}/{{sample}}_{{chunk}}_{mate}{suffix}.bam"


# COMBINE_MATES — pair R1/R2 alignments, MAPQ filtering, pairing stats
rule combine_mates:
    input:
        r1=mate_bam("R1"),
        r2=mate_bam("R2"),
    output:
        bam=f"{MAPDIR}/{{sample}}_{{chunk}}_bwt2pairs.bam",
        stats=f"{MAPDIR}/{{sample}}_{{chunk}}_bwt2pairs.pairstat",
    params:
        args=" ".join(filter(None, [
            "-t",
            "--multi" if config["keep_multi"] else "",
            f"-q {config['min_mapq']}" if config["min_mapq"] else "",
        ])),
    container:
        container_path("hicpro_python")
    threads: res("low")["threads"]
    resources:
        mem_mb=res("low")["mem_mb"],
    shell:
        "python {SCRIPTS}/mergeSAM.py -f {input.r1} -r {input.r2} -o {output.bam} {params.args}"


# =============================================================================
# HICPRO — valid interactions, stats, pairs, optional HiC-Pro maps
# =============================================================================

if not DNASE:

    # GET_VALID_INTERACTION
    rule get_valid_interaction:
        input:
            bam=f"{MAPDIR}/{{sample}}_{{chunk}}_bwt2pairs.bam",
            resfrag=RESFRAG,
        output:
            valid=maybe_temp(f"{VPDIR}/{{sample}}_{{chunk}}_bwt2pairs.validPairs", config["save_pairs_intermediates"]),
            stats=f"{VPDIR}/{{sample}}_{{chunk}}_bwt2pairs.RSstat",
            other=[
                maybe_temp(f"{VPDIR}/{{sample}}_{{chunk}}_bwt2pairs.{ext}", config["save_pairs_intermediates"])
                for ext in ["DEPairs", "SCPairs", "REPairs", "FiltPairs", "DumpPairs", "SinglePairs"]
            ],
        params:
            outdir=VPDIR,
            args=" ".join(filter(None, [
                f"-d {config['min_cis_dist']}" if config["min_cis_dist"] > 0 else "",
                f"-s {config['min_insert_size']}" if config["min_insert_size"] > 0 else "",
                f"-l {config['max_insert_size']}" if config["max_insert_size"] > 0 else "",
                f"-t {config['min_restriction_fragment_size']}" if config["min_restriction_fragment_size"] > 0 else "",
                f"-m {config['max_restriction_fragment_size']}" if config["max_restriction_fragment_size"] > 0 else "",
                "--sam" if config["save_interaction_bam"] else "",
            ])),
        container:
            container_path("hicpro_python")
        threads: res("low")["threads"]
        resources:
            mem_mb=res("low")["mem_mb"],
        shell:
            """
            python {SCRIPTS}/mapped_2hic_fragments.py \
                -f {input.resfrag} -r {input.bam} --all {params.args} -o {params.outdir}
            """

else:

    # GET_VALID_INTERACTION_DNASE
    rule get_valid_interaction_dnase:
        input:
            bam=f"{MAPDIR}/{{sample}}_{{chunk}}_bwt2pairs.bam",
        output:
            valid=maybe_temp(f"{VPDIR}/{{sample}}_{{chunk}}_bwt2pairs.validPairs", config["save_pairs_intermediates"]),
            stats=f"{VPDIR}/{{sample}}_{{chunk}}_bwt2pairs.RSstat",
        params:
            outdir=VPDIR,
            args=f"-d {config['min_cis_dist']}" if config["min_cis_dist"] > 0 else "",
        container:
            container_path("hicpro_python")
        threads: res("low")["threads"]
        resources:
            mem_mb=res("low")["mem_mb"],
        shell:
            """
            python {SCRIPTS}/mapped_2hic_dnase.py -r {input.bam} {params.args} -o {params.outdir}
            """


# MERGE_VALID_INTERACTION — merge chunks, remove duplicates, merge stats
rule merge_valid_interaction:
    input:
        lambda wc: [f"{VPDIR}/{wc.sample}_{c}_bwt2pairs.validPairs" for c in chunks(wc.sample)],
    output:
        valid=f"{VPDIR}/{{sample}}.allValidPairs",
        stats=f"{STATDIR}/{{sample}}/{{sample}}_allValidPairs.mergestat",
    params:
        args="" if config["keep_dups"] else "-d",
    container:
        container_path("ubuntu")
    threads: res("high_memory")["threads"]
    resources:
        mem_mb=res("high_memory")["mem_mb"],
    shell:
        """
        out_valid=$(realpath {output.valid})
        out_stats=$(realpath {output.stats})
        files=$(for f in {input}; do basename $f; done)
        # the chunks sit next to the merged file, so merge in a scratch directory
        tmp=$(mktemp -d)
        for f in {input}; do ln -s $(realpath $f) $tmp/; done
        cd $tmp
        bash {SCRIPTS}/hicpro_merge_validpairs.sh {params.args} -p {wildcards.sample} $files
        mv {wildcards.sample}.allValidPairs $out_valid
        mv {wildcards.sample}_allValidPairs.mergestat $out_stats
        cd - >/dev/null && rm -rf $tmp
        """


# MERGE_STATS (mapping stats, one per mate)
