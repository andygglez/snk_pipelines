# =============================================================================
# snk-hic — Snakemake port of nf-core/hic 2.1.0
#
# Every rule mirrors one nf-core process (named in the comment above each rule)
# and runs inside the same Singularity image the nf-core module uses
# (see config/containers.yaml). Custom tools from nf-core/hic bin/ live in
# scripts/.
#
# Run:  snakemake --cores N --sdm apptainer
# =============================================================================

import csv
import glob
import os
import re
import sys
from collections import OrderedDict

configfile: "config/config.yaml"
configfile: "config/containers.yaml"

# -----------------------------------------------------------------------------
# iGenomes (main.nf getGenomeAttribute): with `genome`, every parameter left
# empty is filled from config/igenomes.yaml (conf/igenomes.config). nf-core reads
# s3://ngi-igenomes directly; here the default base is the public HTTPS mirror,
# which serves single files only, so iGenomes index *directories* are only used
# when igenomes_base is a local mirror (otherwise the index is built locally).
# -----------------------------------------------------------------------------
IGENOMES_ATTRS = {"fasta": "fasta", "bwt2_index": "bowtie2"}


def apply_igenomes():
    import yaml as _yaml

    genome = config.get("genome")
    if not genome:
        return None
    genomes = {} if config.get("igenomes_ignore") else _yaml.safe_load(
        open(os.path.join(workflow.basedir, "config/igenomes.yaml")))
    if genome not in genomes:
        raise ValueError(f"Genome {genome!r} not found in config/igenomes.yaml. Currently available: "
                         f"{', '.join(genomes)}")
    base = str(config.get("igenomes_base") or "s3://ngi-igenomes/igenomes/").rstrip("/")
    if base.startswith("s3://ngi-igenomes/"):
        base = "https://ngi-igenomes.s3.amazonaws.com/" + base[len("s3://ngi-igenomes/"):]
    attrs = genomes[genome]
    for param, key in IGENOMES_ATTRS.items():
        if config.get(param) not in (None, "") or key not in attrs:
            continue
        value = attrs[key]
        if isinstance(value, str):
            value = value.format(igenomes_base=base, project_dir=workflow.basedir)
            if value.endswith("/") and re.match(r"^(https?|ftp)://", value):
                print(f"WARNING: iGenomes {key} index {value} is a remote directory; it will be built "
                      "locally instead (set igenomes_base to a local iGenomes mirror to use it).",
                      file=sys.stderr)
                continue
            value = value.rstrip("/") if value.endswith("/") else value
        config[param] = value
    return attrs


IGENOME = apply_igenomes()


SCRIPTS = os.path.join(workflow.basedir, "scripts")
O = config["outdir"].rstrip("/")


# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
def container_path(key):
    path = config["containers"][key]
    return path if os.path.isabs(path) else os.path.join(workflow.basedir, path)


def asset_path(path):
    """A path from the run directory, else from the port (bundled defaults)."""
    if os.path.isabs(path) or os.path.exists(path):
        return path
    return os.path.join(workflow.basedir, path)


def res(label):
    return config["resources"][label]


def maybe_temp(path, keep):
    return path if keep else temp(path)


def as_list(value):
    if value is None or value == "":
        return []
    if isinstance(value, (list, tuple)):
        return [int(v) for v in value]
    return [int(v) for v in str(value).split(",")]


def is_url(path):
    return str(path).startswith(("http://", "https://", "ftp://"))


# Remote inputs (FASTQ / FASTA URLs) are staged into {O}/inputs/ by fetch_remote,
# the equivalent of Nextflow's automatic staging of remote files.
REMOTE = {}


def stage(path):
    if not is_url(path):
        return path
    local = f"{O}/inputs/{os.path.basename(path)}"
    REMOTE[os.path.basename(path)] = path
    return local


# -----------------------------------------------------------------------------
# Parameters (WorkflowHic.initialise / workflows/hic.nf)
# -----------------------------------------------------------------------------
DNASE = bool(config["dnase"])
if config["digestion"]:
    RESTRICTION_SITE = config["digest"][config["digestion"]]["restriction_site"]
    LIGATION_SITE = config["digest"][config["digestion"]]["ligation_site"]
elif config["restriction_site"] and config["ligation_site"]:
    RESTRICTION_SITE = config["restriction_site"]
    LIGATION_SITE = config["ligation_site"]
elif DNASE:
    RESTRICTION_SITE = LIGATION_SITE = None
else:
    raise ValueError(
        "Ligation motif not found. Set `digestion`, or both `restriction_site` and "
        "`ligation_site`. For DNase Hi-C, set `dnase: true`."
    )

if not config["fasta"]:
    raise ValueError("`fasta` is required.")
FASTA = stage(config["fasta"])

RES_DIST_DECAY = [] if config["skip_dist_decay"] else as_list(config["res_dist_decay"])
RES_TADS = [] if config["skip_tads"] else as_list(config["res_tads"])
RES_COMPARTMENTS = [] if config["skip_compartments"] else as_list(config["res_compartments"])
MAP_RES = sorted(set(
    as_list(config["bin_size"]) + as_list(config["res_zoomify"])
    + RES_TADS + RES_DIST_DECAY + RES_COMPARTMENTS
))
# nf-core zoomifies every res_zoomify value into the same <sample>.mcool;
# here the finest one is used as the base resolution (see COOLER subworkflow).
ZOOMIFY_RES = min(as_list(config["res_zoomify"]) or MAP_RES)
TADS_CALLER = config["tads_caller"]
if isinstance(TADS_CALLER, str):
    TADS_CALLER = TADS_CALLER.split(",")

# -----------------------------------------------------------------------------
# Samplesheet (INPUT_CHECK). Rows sharing a sample name are separate chunks.
# -----------------------------------------------------------------------------
SAMPLES = OrderedDict()
with open(config["input"], newline="") as fh:
    for row in csv.DictReader(fh):
        sample = row["sample"].replace(" ", "_")
        SAMPLES.setdefault(sample, []).append(
            (stage(row["fastq_1"]), stage(row["fastq_2"]))
        )

wildcard_constraints:
    sample="[^/]+",
    chunk=r"\d+",
    lane=r"\d+",
    mate="R[12]",
    res=r"\d+",


def chunk_pairs(sample):
    """Ordered list of (R1, R2) FASTQ chunks for a sample."""
    pairs = []
    for lane, (r1, r2) in enumerate(SAMPLES[sample]):
        if config["split_fastq"]:
            outdir = checkpoints.split_fastq.get(sample=sample, lane=lane).output[0]
            for part in sorted(glob.glob(f"{outdir}/R1_*.fastq.gz")):
                pairs.append((part, part.replace("/R1_", "/R2_")))
        else:
            pairs.append((r1, r2))
    return pairs


def chunks(sample):
    return range(len(chunk_pairs(sample)))


def chunk_fastq(wc):
    r1, r2 = chunk_pairs(wc.sample)[int(wc.chunk)]
    return r1 if wc.mate == "R1" else r2


# Genome resources: provided by the user or built by PREPARE_GENOME.
BWT2_INDEX = config["bwt2_index"] or f"{O}/genome/bowtie2"
CHROMSIZES = config["chromosome_size"] or f"{O}/genome/{os.path.basename(FASTA)}.sizes"
RESFRAG = config["restriction_fragments"] or f"{O}/genome/restriction_fragments.bed"

MAPDIR = f"{O}/hicpro/mapping"
VPDIR = f"{O}/hicpro/valid_pairs"
STATDIR = f"{O}/hicpro/stats"
COOLDIR = f"{O}/contact_maps/cool"


# -----------------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------------
def all_outputs(wc):
    out = [f"{O}/samplesheet/samplesheet.valid.csv"]
    for s in SAMPLES:
        for c in chunks(s):
            out.append(f"{MAPDIR}/{s}_{c}_bwt2pairs.bam")
        out += expand(f"{O}/fastqc/{s}_{{r}}_fastqc.{{ext}}", r=[1, 2], ext=["html", "zip"])
        out += [
            f"{VPDIR}/{s}.allValidPairs",
            f"{VPDIR}/pairix/{s}_contacts.pairs.gz",
            f"{VPDIR}/pairix/{s}_contacts.pairs.gz.px2",
            f"{STATDIR}/{s}/{s}_allValidPairs.mergestat",
            f"{STATDIR}/{s}/{s}.R1.mmapstat",
            f"{STATDIR}/{s}/{s}.R2.mmapstat",
            f"{STATDIR}/{s}/{s}.mpairstat",
            f"{STATDIR}/{s}/{s}.mRSstat",
            f"{COOLDIR}/{s}.mcool",
        ]
        if config["save_raw_maps"]:
            out += expand(f"{COOLDIR}/{s}.{{res}}.cool", res=MAP_RES)
        out += expand(f"{COOLDIR}/{s}.{{res}}_balanced.cool", res=MAP_RES)
        out += expand(f"{O}/contact_maps/txt/{s}.{{res}}_balanced.txt", res=MAP_RES)
        if config["save_raw_maps"]:
            out += expand(f"{O}/contact_maps/txt/{s}.{{res}}_raw.txt", res=MAP_RES)
        if config["hicpro_maps"]:
            out += expand(f"{O}/hicpro/matrix/iced/{s}.{{res}}_iced.matrix", res=MAP_RES)
        if RES_DIST_DECAY:
            out.append(f"{O}/distance_decay/{s}_distcount.png")
        out += expand(f"{O}/compartments/{s}.{{res}}_compartments.cis.vecs.tsv", res=RES_COMPARTMENTS)
        if "insulation" in TADS_CALLER:
            out += expand(f"{O}/tads/insulation/{s}.{{res}}_balanced_insulation.tsv", res=RES_TADS)
        if "hicexplorer" in TADS_CALLER:
            out += expand(f"{O}/tads/hicExplorer/{s}.{{res}}_balanced_hicfindtads_domains.bed", res=RES_TADS)
    out += expand(f"{O}/contact_maps/bins/cooler_bins_{{res}}.bed", res=MAP_RES)
    if not config["skip_multiqc"]:
        out.append(f"{O}/multiqc/multiqc_report.html")
    return out


rule all:
    input:
        lambda wc: all_outputs(wc) + [VERSIONS_YML],


# =============================================================================
# Input staging
# =============================================================================

# Not an nf-core process: Nextflow stages remote inputs itself.
rule fetch_remote:
    output:
        f"{O}/inputs/{{fname}}",
    params:
        url=lambda wc: REMOTE[wc.fname],
    retries: 2
    run:
        import shutil
        import urllib.request

        with urllib.request.urlopen(params.url) as src, open(output[0], "wb") as dst:
            shutil.copyfileobj(src, dst)


# SAMPLESHEET_CHECK
rule samplesheet_check:
    input:
        config["input"],
    output:
        f"{O}/samplesheet/samplesheet.valid.csv",
    container:
        container_path("python")
    threads: res("single")["threads"]
    resources:
        mem_mb=res("single")["mem_mb"],
    shell:
        "python {SCRIPTS}/check_samplesheet.py {input} {output}"


# splitFastq (INPUT_CHECK, split_fastq: true): fastq_chunks_size reads per chunk.
checkpoint split_fastq:
    input:
        r1=lambda wc: SAMPLES[wc.sample][int(wc.lane)][0],
        r2=lambda wc: SAMPLES[wc.sample][int(wc.lane)][1],
    output:
        directory(f"{O}/split_fastq/{{sample}}/lane{{lane}}"),
    params:
        lines=4 * int(config["fastq_chunks_size"]),
    container:
        container_path("ubuntu")
    threads: res("low")["threads"]
    resources:
        mem_mb=res("low")["mem_mb"],
    shell:
        """
        mkdir -p {output}
        zcat {input.r1} | split -l {params.lines} -d -a 5 --additional-suffix=.fastq \
            --filter='gzip > $FILE.gz' - {output}/R1_
        zcat {input.r2} | split -l {params.lines} -d -a 5 --additional-suffix=.fastq \
            --filter='gzip > $FILE.gz' - {output}/R2_
        """


