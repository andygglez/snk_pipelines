# =============================================================================
# Software versions (CUSTOM_DUMPSOFTWAREVERSIONS)
# =============================================================================
# config/versions.yaml maps every nf-core process to the port rules that run it
# and the version commands of its module; each command runs in the image of the
# rule that ran it. Snakemake replaces Nextflow in the Workflow section.
VERSIONS_YML = f"{O}/pipeline_info/software_versions.yml"
VERSIONS_MQC = f"{O}/work/versions/software_versions_mqc.yml"


def versions_inputs(wc):
    """Everything else the run produces, so the DAG is complete when it runs."""
    # every other output (pipeline_info too), so no job drops out of the DAG it reads
    own = {VERSIONS_YML, VERSIONS_MQC}
    return [f for f in all_outputs(wc) if f not in own and not str(f).startswith(f"{O}/multiqc/")]


localrules:
    software_versions,


rule software_versions:
    input:
        versions_inputs,
    output:
        yml=VERSIONS_YML,
        mqc=VERSIONS_MQC,
    run:
        sys.path.insert(0, os.path.join(workflow.basedir, "scripts"))
        from software_versions import collect, dag_jobs, collect_file, styles, version_chunks, workflow_chunk, write_dump, write_topic

        table = os.path.join(workflow.basedir, "config/versions.yaml")
        versions = collect(table, dag_jobs(workflow, input), globals(), yaml_numbers=False)
        dump_img = container_path("dumpsoftwareversions")
        write_dump(versions, "nf-core/hic", "2.1.0", output.yml, output.mqc, img=dump_img)


# =============================================================================
# MULTIQC
# =============================================================================
rule multiqc:
    input:
        fastqc=lambda wc: [
            f"{O}/work/fastqc/{s}/{c}/{s}_{r}_fastqc.zip" for s in SAMPLES for c in chunks(s) for r in (1, 2)
        ],
        stats=lambda wc: [
            f
            for s in SAMPLES
            for f in (
                f"{STATDIR}/{s}/{s}_allValidPairs.mergestat",
                f"{STATDIR}/{s}/{s}.R1.mmapstat",
                f"{STATDIR}/{s}/{s}.R2.mmapstat",
                f"{STATDIR}/{s}/{s}.mpairstat",
                f"{STATDIR}/{s}/{s}.mRSstat",
            )
        ],
        config=asset_path(config["multiqc_config"]),
        versions=VERSIONS_MQC,
    output:
        f"{O}/multiqc/multiqc_report.html",
        directory(f"{O}/multiqc/multiqc_data"),
    container:
        container_path("multiqc")
    threads: res("medium")["threads"]
    resources:
        mem_mb=res("medium")["mem_mb"],
    log:
        f"{O}/logs/multiqc.log",
    shell:
        """
        multiqc -f -c {input.config} -o $(dirname {output[0]}) \
            {input.fastqc} {input.stats} {input.versions} > {log} 2>&1
        """
