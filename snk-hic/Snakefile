# SPLIT_COOLER_DUMP
rule split_cooler_dump:
    input:
        f"{O}/contact_maps/txt/{{sample}}.{{res}}_balanced.bedpe",
    output:
        raw=maybe_temp(f"{O}/contact_maps/txt/{{sample}}.{{res}}_raw.txt", config["save_raw_maps"]),
        balanced=f"{O}/contact_maps/txt/{{sample}}.{{res}}_balanced.txt",
    container:
        container_path("ubuntu")
    threads: res("low")["threads"]
    resources:
        mem_mb=res("low")["mem_mb"],
    shell:
        """
        cat {input} | awk '{{OFS="\\t"; print $1,$2,$3}}' > {output.raw}
        cat {input} | awk '{{OFS="\\t"; print $1,$2,$4}}' > {output.balanced}
        """


