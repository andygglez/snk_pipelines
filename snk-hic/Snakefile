# HICPRO2PAIRS — allValidPairs -> 4DN pairs (bgzip + pairix index)
rule hicpro2pairs:
    input:
        f"{VPDIR}/{{sample}}.allValidPairs",
    output:
        pairs=f"{VPDIR}/pairix/{{sample}}_contacts.pairs.gz",
        index=f"{VPDIR}/pairix/{{sample}}_contacts.pairs.gz.px2",
    container:
        container_path("pairix")
    threads: res("medium")["threads"]
    resources:
        mem_mb=res("medium")["mem_mb"],
    shell:
        """
        awk '{{OFS="\\t";print $1,$2,$3,$5,$6,$4,$7}}' {input} | bgzip -c > {output.pairs}
        pairix -f {output.pairs}
        """


# BUILD_CONTACT_MAPS (hicpro_maps: true)
rule build_contact_maps:
    input:
        pairs=f"{VPDIR}/{{sample}}.allValidPairs",
        chromsizes=CHROMSIZES,
    output:
        matrix=f"{O}/hicpro/matrix/raw/{{sample}}.{{res}}.matrix",
        abs_bed=f"{O}/hicpro/matrix/raw/{{sample}}.{{res}}_abs.bed",
        ord_bed=f"{O}/hicpro/matrix/raw/{{sample}}.{{res}}_ord.bed",
    params:
        prefix=f"{O}/hicpro/matrix/raw/{{sample}}.{{res}}",
    container:
        container_path("ubuntu")
    threads: res("high_memory")["threads"]
    resources:
        mem_mb=res("high_memory")["mem_mb"],
    shell:
        """
        {SCRIPTS}/build_matrix \
            --matrix-format upper \
            --binsize {wildcards.res} \
            --chrsizes {input.chromsizes} \
            --ifile {input.pairs} \
            --oprefix {params.prefix}
        """


# ICE_NORMALIZATION (hicpro_maps: true)
rule ice_normalization:
    input:
        f"{O}/hicpro/matrix/raw/{{sample}}.{{res}}.matrix",
    output:
        matrix=f"{O}/hicpro/matrix/iced/{{sample}}.{{res}}_iced.matrix",
        biases=f"{O}/hicpro/matrix/iced/{{sample}}.{{res}}_iced.matrix.biases",
    params:
        low=config["ice_filter_low_count_perc"],
        high=config["ice_filter_high_count_perc"],
        max_iter=config["ice_max_iter"],
        eps=config["ice_eps"],
    container:
        container_path("hicpro_python")
    threads: res("high_memory")["threads"]
    resources:
        mem_mb=res("high_memory")["mem_mb"],
    shell:
        """
        ice --filter_low_counts_perc {params.low} \
            --results_filename {output.matrix} \
            --filter_high_counts_perc {params.high} \
            --max_iter {params.max_iter} --eps {params.eps} \
            --remove-all-zeros-loci --output-bias 1 --verbose 1 {input}
        """


