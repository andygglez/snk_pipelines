# HIC_PLOT_DIST_VS_COUNTS (prefix meta.id: with several res_dist_decay values
# nf-core writes every resolution to the same <sample>_distcount.* and the last
# one wins; here the last resolution of the list is used)
rule hic_plot_dist_vs_counts:
    input:
        lambda wc: f"{COOLDIR}/{wc.sample}.{RES_DIST_DECAY[-1]}_balanced.cool",
    output:
        png=f"{O}/distance_decay/{{sample}}_distcount.png",
        txt=f"{O}/distance_decay/{{sample}}_distcount.txt",
    container:
        container_path("hicexplorer")
    threads: res("medium")["threads"]
    resources:
        mem_mb=res("medium")["mem_mb"],
    shell:
        "hicPlotDistVsCounts --matrices {input} --plotFile {output.png} --outFileData {output.txt}"


# COOLTOOLS_EIGSCIS (COMPARTMENTS)
# As in nf-core/hic 2.1.0, the GC track is computed but not passed to eigs-cis.
rule cooltools_eigscis:
    input:
        cool=f"{COOLDIR}/{{sample}}.{{res}}_balanced.cool",
        fasta=FASTA,
        chromsizes=CHROMSIZES,
    output:
        vecs=f"{O}/compartments/{{sample}}.{{res}}_compartments.cis.vecs.tsv",
        lam=f"{O}/compartments/{{sample}}.{{res}}_compartments.cis.lam.txt",
        bw=f"{O}/compartments/{{sample}}.{{res}}_compartments.cis.bw",
        bins=temp(f"{O}/compartments/{{sample}}.{{res}}.genome_bins.txt"),
        gc=temp(f"{O}/compartments/{{sample}}.{{res}}.genome_gc.txt"),
    params:
        args=config["cooltools_eigscis_args"],
        prefix=f"{O}/compartments/{{sample}}.{{res}}_compartments",
    container:
        container_path("cooltools_eigs")
    threads: res("medium")["threads"]
    resources:
        mem_mb=res("medium")["mem_mb"],
    shell:
        """
        cooltools genome binnify --all-names {input.chromsizes} {wildcards.res} > {output.bins}
        cooltools genome gc {output.bins} {input.fasta} > {output.gc}
        cooltools eigs-cis {params.args} -o {params.prefix} {input.cool}
        """


