# -----------------------------------------------------------------------------
# QC: Qualimap, Preseq
# -----------------------------------------------------------------------------
# QUALIMAP_BAMQC
rule qualimap_bamqc:
    input:
        bam=lambda wc: FINAL[wc.id],
        regions=asset_path(stage(param("bamqc_regions_file"))) if param("bamqc_regions_file") else [],
    output:
        directory(f"{AL}/qualimap/bamqc/{{id}}"),
    wildcard_constraints:
        id=alternation(IDS),
    params:
        # conf/modules/qualimap_bamqc.config: -gd from the genome name
        args=("-gd HUMAN" if str(config.get("genome")).startswith("GRCh") else
              "-gd MOUSE" if str(config.get("genome")).startswith("GRCm") else ""),
        regions=lambda wc, input: f"--gff {input.regions}" if input.regions else "",
        pairs=lambda wc: "" if is_se(wc.id) else "--collect-overlap-pairs",
        mem=lambda wc, resources: f"{jvm_mem(resources)}M",
    container:
        container_path("qualimap")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input.bam}
        unset DISPLAY
        mkdir -p tmp
        export _JAVA_OPTIONS=-Djava.io.tmpdir=./tmp
        qualimap --java-mem-size={params.mem} bamqc {params.args} -bam $(basename {input.bam}) \
            {params.regions} -p non-strand-specific {params.pairs} -outdir {wildcards.id} -nt {threads}
        mv {wildcards.id} {output}
        """


# QUALIMAP_BAMQC versions.yml (published by the pattern "*" publishDir)
rule qualimap_versions:
    output:
        f"{AL}/qualimap/bamqc/versions.yml",
    container:
        container_path("qualimap")
    shell:
        """
        cat <<-END_VERSIONS > {output}
"NFCORE_METHYLSEQ:METHYLSEQ:QUALIMAP_BAMQC":
    qualimap: $(echo $(qualimap 2>&1) | sed 's/^.*QualiMap v.//; s/Built.*$//')
END_VERSIONS
        """


def preseq_succeeded():
    """A failed (ignored) PRESEQ_LCEXTRAP task emits no versions in nf-core."""
    d = f"{O}/{ALIGNER}/preseq"
    return os.path.isdir(d) and any(f.endswith(".lc_extrap.txt") for f in os.listdir(d))


# PRESEQ_LCEXTRAP (errorStrategy 'ignore': on failure nothing is published)
rule preseq_lcextrap:
    input:
        lambda wc: FINAL[wc.id],
    output:
        touch(f"{W}/preseq/{{id}}.done"),
    wildcard_constraints:
        id=alternation(IDS),
    params:
        args=args("preseq_lcextrap"),
        pe=lambda wc: "" if is_se(wc.id) else "-pe",
        dir=f"{O_ABS}/{ALIGNER}/preseq",
    container:
        container_path("preseq")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        if preseq lc_extrap {params.args} {params.pe} -output {wildcards.id}.lc_extrap.txt \
            $(basename {input}) 2> {wildcards.id}.command.log; then
            mkdir -p {params.dir}/log
            mv {wildcards.id}.lc_extrap.txt {params.dir}/
            mv {wildcards.id}.command.log {params.dir}/log/
        else
            cat {wildcards.id}.command.log >&2
            echo "PRESEQ_LCEXTRAP failed for {wildcards.id}; ignored as in nf-core." >&2
        fi
        """


