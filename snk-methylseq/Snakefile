        FASTA,
    output:
        DICT,
    params:
        args=args("picard_createsequencedictionary"),
        mem=lambda wc, resources: jvm_mem(resources),
    container:
        container_path("picard")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        picard -Xmx{params.mem}M CreateSequenceDictionary {params.args} --REFERENCE {FASTA_NAME} \
            --OUTPUT $(basename {output})
        mv $(basename {output}) {output}
        """


# PICARD_BEDTOINTERVALLIST (prefix = target BED baseName)
# PICARD_COLLECTHSMETRICS is not run: in nf-core 4.2.0 its inputs are combined
# with the empty ch_gzi channel, so it never gets a task.
rule picard_bedtointervallist:
    input:
        bed=TARGET_BED or [],
        dict=DICT,
    output:
        INTERVALLIST or f"{W}/none.intervallist",
    params:
        args=args("picard_bedtointervallist"),
        mem=lambda wc, resources: jvm_mem(resources),
    container:
        container_path("picard")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        picard -Xmx{params.mem}M BedToIntervalList --INPUT $(basename {input.bed}) \
            --OUTPUT $(basename {output}) --SEQUENCE_DICTIONARY $(basename {input.dict}) --TMP_DIR . {params.args}
        mv $(basename {output}) {output}
        """


# -----------------------------------------------------------------------------
# MultiQC
# -----------------------------------------------------------------------------
def multiqc_files(wc):
    files = []
    if flag("run_qualimap"):
        files += [f"{AL}/qualimap/bamqc/{s}" for s in IDS]
    if BISMARK:
        files += [f"{AL}/summary/bismark_summary_report.txt", f"{AL}/summary/bismark_summary_report.html"]
        for s in IDS:
            n = mex_name(s)
            files += [ALIGN_REPORT[s], f"{MC}/splitting_report/{n}_splitting_report.txt",
                      f"{MC}/mbias/{n}.M-bias.txt", bismark_report_html(s)]
            if not SKIP_DEDUP:
                files.append(DEDUP_REPORT[s])
    else:
        for s in IDS:
            if not SKIP_DEDUP:
                files.append(picard_metrics(s))
            files += align_stats(s)
    for s in IDS:
        if not SKIP_TRIM:
            files += trim_reports(s)
        if not SKIP_FASTQC:
            files += [f for f in fastqc_outputs(s) if f.endswith(".zip")]
    return files


# =============================================================================
# Software versions (softwareVersionsToYAML + collectFile)
# =============================================================================
# config/versions.yaml maps every nf-core process to the port rules that run it
# and the version commands of its module; each command runs in the image of the
# rule that ran it. Snakemake replaces Nextflow in the Workflow section.
VERSIONS_YML = f"{O}/pipeline_info/nf_core_methylseq_software_mqc_versions.yml"
VERSIONS_TOPIC = f"{O}/pipeline_info/nf_core_methylseq_topic_versions.yml"
VERSIONS_MQC = f"{W}/multiqc/versions/nf_core_methylseq_software_mqc_versions.yml"


def versions_inputs(wc):
    """Everything else the run produces, so the DAG is complete when it runs."""
    # every other output (pipeline_info too), so no job drops out of the DAG it reads
    own = {VERSIONS_YML, VERSIONS_TOPIC, VERSIONS_MQC}
    return [f for f in all_targets() if f not in own and not str(f).startswith(f"{O}/multiqc/")]


localrules:
    software_versions,


rule software_versions:
    input:
        versions_inputs,
    output:
        yml=VERSIONS_YML,
        topic=VERSIONS_TOPIC,
        mqc=VERSIONS_MQC,
    run:
        sys.path.insert(0, os.path.join(workflow.basedir, "scripts"))
        from software_versions import collect, dag_jobs, collect_file, styles, version_chunks, workflow_chunk, write_dump, write_topic

        table = os.path.join(workflow.basedir, "config/versions.yaml")
        versions = collect(table, dag_jobs(workflow, input), globals())
        style = styles(table)
        file_v = {p: v for p, v in versions.items() if style.get(p) != "topic"}
        topic_v = {p: v for p, v in versions.items() if style.get(p) == "topic"}
        main = collect_file(version_chunks(file_v) + [workflow_chunk("nf-core/methylseq", "v4.2.0")])
        topic = collect_file(version_chunks(topic_v)) if topic_v else ""
        # MultiQC gets the main file; on completion nf-core appends the topic file to it
        with open(output.mqc, "w") as fh:
            fh.write(main)
        with open(output.topic, "w") as fh:
            fh.write(topic)
        with open(output.yml, "w") as fh:
            fh.write(main + topic)


rule multiqc:
    input:
        files=multiqc_files,
        versions=VERSIONS_MQC,
        preseq=[f"{W}/preseq/{s}.done" for s in IDS] if flag("run_preseq") else [],
        config=f"{ASSETS}/multiqc_config.yml",
        extra_config=asset_path(param("multiqc_config")) if param("multiqc_config") else [],
        logo=asset_path(param("multiqc_logo")) if param("multiqc_logo") else [],
    output:
        rep=f"{MULTIQC_DIR}/multiqc_report.html",
        data=directory(f"{MULTIQC_DIR}/multiqc_data"),
        plots=directory(f"{MULTIQC_DIR}/multiqc_plots"),
    params:
        title=f"--title \"{config['multiqc_title']}\"" if param("multiqc_title") else "",
        extra_config=lambda wc, input: f"--config {os.path.basename(input.extra_config)}" if input.extra_config else "",
        logo=lambda wc, input: (
            f"--cl-config 'custom_logo: \"{os.path.basename(input.logo)}\"'" if input.logo else ""
        ),
        preseq_logs=f"{O_ABS}/{ALIGNER}/preseq/log" if flag("run_preseq") else "",
    container:
        container_path("multiqc")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir work_mqc && cd work_mqc
        i=0
        for f in {input.files} {input.versions}; do
            i=$((i+1)); mkdir -p $i; ln -s "$(realpath "../$f" 2>/dev/null || realpath "$f")" $i/
        done
        if [ -n "{params.preseq_logs}" ] && ls {params.preseq_logs}/*.command.log >/dev/null 2>&1; then
            for f in {params.preseq_logs}/*.command.log; do i=$((i+1)); mkdir -p $i; ln -s "$f" $i/; done
        fi
        cd ..
        ln -s "$(realpath {input.config})" work_mqc/multiqc_config.yml
        for f in {input.extra_config} {input.logo}; do ln -s "$(realpath $f)" work_mqc/; done
        cd work_mqc
        multiqc --force {params.title} --config multiqc_config.yml {params.extra_config} {params.logo} .
        cd ..
        mv work_mqc/multiqc_report.html {output.rep}
        mv work_mqc/multiqc_data {output.data}
        mv work_mqc/multiqc_plots {output.plots}
        """
