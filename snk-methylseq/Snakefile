# -----------------------------------------------------------------------------
# Reads: CAT_FASTQ, FASTQC, TRIMGALORE
# -----------------------------------------------------------------------------
def run_files(sid):
    return [stage(r) for run in SAMPLES[sid]["runs"] for r in run]


# CAT_FASTQ (single-end; default publishDir: <outdir>/cat)
rule cat_fastq_se:
    input:
        lambda wc: run_files(wc.id),
    output:
        f"{O}/cat/{{id}}.merged.fastq.gz",
    wildcard_constraints:
        id=alternation(s for s in MULTI_IDS if is_se(s)),
    container:
        container_path("coreutils")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        "cat {input} > {output}"


# CAT_FASTQ (paired-end: reads are interleaved R1,R2,R1,R2,...)
rule cat_fastq_pe:
    input:
        r1=lambda wc: run_files(wc.id)[0::2],
        r2=lambda wc: run_files(wc.id)[1::2],
    output:
        r1=f"{O}/cat/{{id}}_1.merged.fastq.gz",
        r2=f"{O}/cat/{{id}}_2.merged.fastq.gz",
    wildcard_constraints:
        id=alternation(s for s in MULTI_IDS if not is_se(s)),
    container:
        container_path("coreutils")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        cat {input.r1} > {output.r1}
        cat {input.r2} > {output.r2}
        """


def fastqc_memory(threads, resources):
    """task.memory MB / cpus, clamped to 100..10000"""
    mb = resources.mem_mb / threads
    mb = 10000 if mb > 10000 else (100 if mb < 100 else mb)
    return int(mb) if float(mb).is_integer() else mb


# FASTQC (reads renamed to <id>.gz / <id>_{1,2}.gz as the module does)
rule fastqc:
    input:
        lambda wc: raw_reads(wc.name if wc.name in SE_IDS else wc.name[:-2]),
    output:
        html=f"{O}/fastqc/{{name}}_fastqc.html",
        zip=f"{O}/fastqc/zips/{{name}}_fastqc.zip",
    wildcard_constraints:
        name=alternation(SE_IDS + [f"{s}_{i}" for s in PE_IDS for i in (1, 2)]),
    params:
        args=args("fastqc"),
        memory=lambda wc, threads, resources: fastqc_memory(threads, resources),
        src=lambda wc, input: input[0] if wc.name in SE_IDS else input[int(wc.name[-1]) - 1],
    container:
        container_path("fastqc")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {params.src}
        ln -s $(basename {params.src}) {wildcards.name}.gz
        fastqc {params.args} --threads {threads} --memory {params.memory} {wildcards.name}.gz
        mv {wildcards.name}_fastqc.html {output.html}
        mv {wildcards.name}_fastqc.zip {output.zip}
        """


def trimgalore_args(se):
    """TRIMGALORE ext.args (conf/modules/trimgalore.config)"""
    p = flag
    presets = not p("skip_trimming_presets")
    clip_r1 = (
        f"--clip_r1 {config['clip_r1']}" if num("clip_r1") > 0 else
        "" if not presets else
        "--clip_r1 8" if p("pbat") else
        "--clip_r1 6" if p("single_cell") else
        "--clip_r1 10" if (p("accel") or p("zymo") or p("em_seq")) else ""
    )
    clip_r2 = "" if se else (
        f"--clip_r2 {config['clip_r2']}" if num("clip_r2") > 0 else
        "" if not presets else
        "--clip_r2 8" if p("pbat") else
        "--clip_r2 6" if p("single_cell") else
        "--clip_r2 10" if (p("zymo") or p("em_seq")) else
        "--clip_r2 15" if p("accel") else ""
    )
    tp_r1 = (
        f"--three_prime_clip_r1 {config['three_prime_clip_r1']}" if num("three_prime_clip_r1") > 0 else
        "" if not presets else
        "--three_prime_clip_r1 8" if p("pbat") else
        "--three_prime_clip_r1 6" if p("single_cell") else
        "--three_prime_clip_r1 10" if (p("accel") or p("zymo") or p("em_seq")) else ""
    )
    tp_r2 = "" if se else (
        f"--three_prime_clip_r2 {config['three_prime_clip_r2']}" if num("three_prime_clip_r2") > 0 else
        "" if not presets else
        "--three_prime_clip_r2 8" if p("pbat") else
        "--three_prime_clip_r2 6" if p("single_cell") else
        "--three_prime_clip_r2 10" if (p("accel") or p("zymo") or p("em_seq")) else ""
    )
    a = gjoin([
        "--fastqc",
        "--rrbs" if RRBS else "",
        f"--nextseq {config['nextseq_trim']}" if num("nextseq_trim") > 0 else "",
        f"--length {config['length_trim']}" if param("length_trim") else "",
        clip_r1, clip_r2, tp_r1, tp_r2,
    ])
    if se:  # args.split("\\s(?=--)"), drop the *_r2 options
        parts = re.split(r"\s(?=--)", a)
        a = " ".join(x for x in parts if "_r2 " not in x.lower())
    return a


def trimgalore_cores(threads, se):
    cores = threads - (3 if se else 4)
    return min(max(cores, 1), 8)


# TRIMGALORE (single-end)
rule trimgalore_se:
    input:
        lambda wc: raw_reads(wc.id),
    output:
        reads=f"{TRIM_DIR}/{{id}}_trimmed.fq.gz",
        log=f"{O}/trimgalore/logs/{{id}}.fastq.gz_trimming_report.txt",
        html=f"{O}/trimgalore/fastqc/{{id}}_trimmed_fastqc.html",
        zip=f"{O}/trimgalore/fastqc/zips/{{id}}_trimmed_fastqc.zip",
    wildcard_constraints:
        id=alternation(SE_IDS),
    params:
        args=trimgalore_args(True),
        cores=lambda wc, threads: trimgalore_cores(threads, True),
    container:
        container_path("trimgalore")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        [ ! -f {wildcards.id}.fastq.gz ] && ln -s $(basename {input}) {wildcards.id}.fastq.gz
        trim_galore {params.args} --cores {params.cores} --gzip {wildcards.id}.fastq.gz
        mv {wildcards.id}_trimmed.fq.gz {output.reads}
        mv {wildcards.id}.fastq.gz_trimming_report.txt {output.log}
        mv {wildcards.id}_trimmed_fastqc.html {output.html}
        mv {wildcards.id}_trimmed_fastqc.zip {output.zip}
        """


# TRIMGALORE (paired-end)
rule trimgalore_pe:
    input:
        lambda wc: raw_reads(wc.id),
    output:
        r1=f"{TRIM_DIR}/{{id}}_1_val_1.fq.gz",
        r2=f"{TRIM_DIR}/{{id}}_2_val_2.fq.gz",
        log1=f"{O}/trimgalore/logs/{{id}}_1.fastq.gz_trimming_report.txt",
        log2=f"{O}/trimgalore/logs/{{id}}_2.fastq.gz_trimming_report.txt",
        html1=f"{O}/trimgalore/fastqc/{{id}}_1_val_1_fastqc.html",
        html2=f"{O}/trimgalore/fastqc/{{id}}_2_val_2_fastqc.html",
        zip1=f"{O}/trimgalore/fastqc/zips/{{id}}_1_val_1_fastqc.zip",
        zip2=f"{O}/trimgalore/fastqc/zips/{{id}}_2_val_2_fastqc.zip",
    wildcard_constraints:
        id=alternation(PE_IDS),
    params:
        args=trimgalore_args(False),
        cores=lambda wc, threads: trimgalore_cores(threads, False),
        r1=lambda wc, input: os.path.basename(input[0]),
        r2=lambda wc, input: os.path.basename(input[1]),
    container:
        container_path("trimgalore")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        [ ! -f {wildcards.id}_1.fastq.gz ] && ln -s {params.r1} {wildcards.id}_1.fastq.gz
        [ ! -f {wildcards.id}_2.fastq.gz ] && ln -s {params.r2} {wildcards.id}_2.fastq.gz
        trim_galore {params.args} --cores {params.cores} --paired --gzip \
            {wildcards.id}_1.fastq.gz {wildcards.id}_2.fastq.gz
        mv {wildcards.id}_1_val_1.fq.gz {output.r1}
        mv {wildcards.id}_2_val_2.fq.gz {output.r2}
        mv {wildcards.id}_1.fastq.gz_trimming_report.txt {output.log1}
        mv {wildcards.id}_2.fastq.gz_trimming_report.txt {output.log2}
        mv {wildcards.id}_1_val_1_fastqc.html {output.html1}
        mv {wildcards.id}_2_val_2_fastqc.html {output.html2}
        mv {wildcards.id}_1_val_1_fastqc.zip {output.zip1}
        mv {wildcards.id}_2_val_2_fastqc.zip {output.zip2}
        """


# -----------------------------------------------------------------------------
# Bismark (FASTQ_ALIGN_DEDUP_BISMARK)
# -----------------------------------------------------------------------------
def bismark_align_args(se):
    """BISMARK_ALIGN ext.args (conf/modules/bismark_align.config)"""
    known = param("known_splices")
    maxins = ""
    if not se:
        if param("maxins"):
            maxins = f" --maxins {config['maxins']}"
        elif flag("em_seq"):
            maxins = " --maxins 1000"
    return gjoin([
        " --hisat2" if ALIGNER == "bismark_hisat" else " --bowtie2",
        f" --known-splicesite-infile <(hisat2_extract_splice_sites.py {os.path.abspath(known)})"
        if (ALIGNER == "bismark_hisat" and known) else "",
        " --pbat" if flag("pbat") else "",
        " --non_directional" if SINGLE_CELL_NONDIR else "",
        " --unmapped" if flag("unmapped") else "",
        f" --score_min L,0,-{config['num_mismatches']}" if flag("relax_mismatches") else "",
        " --local" if flag("local_alignment") else "",
        f" --minins {config['minins']}" if (not se and param("minins")) else "",
        maxins,
    ])


def bismark_multicore(a, threads, resources):
    """BISMARK_ALIGN: --multicore from cpus (3 per core, 5 if non-directional) and memory (13/18 GB per core)."""
    if "--multicore" in a:
        return a
    cpu_per, mem_per = (5, 18 * 1024**3) if "--non_directional" in a else (3, 13 * 1024**3)
    ccore = min(threads // cpu_per, int(resources.mem_mb * 1024**2 / mem_per))
    return a + (f" --multicore {ccore}" if ccore > 1 else "")


BISMARK_ALIGN_CMD = """
        stage {input.reads}
        ln -sfn "$(realpath {input.index})" {INDEX_NAME}
        bismark {params.fastq} --genome {INDEX_NAME} --bam {params.args}
        mv {params.name}.bam {output.bam}
        mv {params.rep} {output.rep}
        if [ -n "{params.unmapped_dir}" ]; then
            mkdir -p {params.unmapped_dir}
            ls *_unmapped_reads*.fq.gz > {output.manifest}
            mv *_unmapped_reads*.fq.gz {params.unmapped_dir}/
        else
            touch {output.manifest}
        fi
"""


def bismark_align_outputs(se):
    suffix = "" if se else "_pe"
    return dict(
        bam=f"{BAL_DIR}/{{stem}}_bismark_{BT}{suffix}.bam",
        rep=f"{AL}/alignments/logs/{{stem}}_bismark_{BT}_{'SE' if se else 'PE'}_report.txt",
        manifest=f"{W}/{ALIGNER}/unmapped/{{stem}}_bismark_{BT}{suffix}.txt",
    )


BISMARK_UNMAPPED_DIR = f"{O_ABS}/{ALIGNER}/alignments/unmapped" if flag("unmapped") else ""


# BISMARK_ALIGN (single-end)
rule bismark_align_se:
