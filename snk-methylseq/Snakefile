# =============================================================================
# snk-methylseq — Snakemake port of nf-core/methylseq 4.2.0
#
# Every rule mirrors one nf-core process (named in the comment above each rule)
# and runs inside the same Singularity image the nf-core module uses
# (see config/containers.yaml). Published files follow the nf-core publishDir
# layout under `outdir`; files nf-core keeps only in its work/ directory go to
# `workdir`.
#
# Ported: the whole workflow — CAT_FASTQ, FastQC, Trim Galore, all four
# aligners (bismark, bismark_hisat, bwameth, bwamem), index building or
# provided indices (directories or .tar.gz), Bismark deduplication /
# methylation extraction / coverage2cytosine / reports / summary, Picard
# MarkDuplicates, MethylDackel, rastair (TAPS), Qualimap, Preseq, the targeted
# sequencing subworkflow and MultiQC.
# use_gpu (nf-core `-profile gpu`) runs PARABRICKS_FQ2BAMMETH instead of
# BWAMETH_ALIGN; it needs an NVIDIA GPU.
# Not produced: Nextflow run metadata (pipeline_info execution reports, MultiQC
# workflow summary / methods sections). Software versions are collected by
# software_versions.
# Kept as in nf-core 4.2.0 (quirks, not fixed here):
#   - PICARD_COLLECTHSMETRICS never runs: its inputs are combined with an empty
#     ch_gzi channel. With collecthsmetrics only the sequence dictionary and the
#     interval list are made.
#   - rastair (TAPS) needs the FASTA index, which FASTA_INDEX_METHYLSEQ only
#     provides for bwameth / bwamem or with collecthsmetrics; otherwise --taps
#     does nothing.
#   - Targeted bedGraphs go to methyldackel/ for every aligner except
#     `bismark` (bismark_hisat included).
#   - Qualimap's and BWA_INDEX's versions.yml are published next to their outputs.
#   - coverage2cytosine output goes to bismark/coverage2cytosine for bismark_hisat too.
#   - PRESEQ_LCEXTRAP has errorStrategy 'ignore': a failing preseq publishes
#     nothing and the run goes on.
#
# Rules run in shadow directories with their inputs linked under the file
# names Nextflow stages, so file names embedded in outputs (BAM @PG lines,
# samtools stats, Bismark reports, Picard metrics) match nf-core. Files whose
# names depend on the data (Bismark per-context call files, --unmapped reads)
# are moved straight to outdir and listed in a manifest under workdir.
#
# Run:  snakemake --cores N --sdm apptainer
# =============================================================================

import csv
import os
import re
import sys
import urllib.request
from collections import OrderedDict

configfile: "config/config.yaml"
configfile: "config/containers.yaml"

# -----------------------------------------------------------------------------
# iGenomes (main.nf getGenomeAttribute): with `genome`, every parameter left
# empty is filled from config/igenomes.yaml (conf/igenomes.config). nf-core reads
# s3://ngi-igenomes directly; here the default base is the public HTTPS mirror,
# which serves single files only, so iGenomes index *directories* are only used
# when igenomes_base is a local mirror (otherwise the index is built locally).
# -----------------------------------------------------------------------------
IGENOMES_ATTRS = {"fasta": "fasta", "fasta_index": "fasta_index", "bwameth_index": "bwameth", "bwamem_index": "bwa", "bismark_index": "bismark_hisat2" if config.get("aligner") == "bismark_hisat" else "bismark"}


def apply_igenomes():
    import yaml as _yaml

    genome = config.get("genome")
    if not genome:
        return None
    genomes = {} if config.get("igenomes_ignore") else _yaml.safe_load(
        open(os.path.join(workflow.basedir, "config/igenomes.yaml")))
    if genome not in genomes:
        raise ValueError(f"Genome {genome!r} not found in config/igenomes.yaml. Currently available: "
                         f"{', '.join(genomes)}")
    base = str(config.get("igenomes_base") or "s3://ngi-igenomes/igenomes/").rstrip("/")
    if base.startswith("s3://ngi-igenomes/"):
        base = "https://ngi-igenomes.s3.amazonaws.com/" + base[len("s3://ngi-igenomes/"):]
    attrs = genomes[genome]
    for param, key in IGENOMES_ATTRS.items():
        if config.get(param) not in (None, "") or key not in attrs:
            continue
        value = attrs[key]
        if isinstance(value, str):
            value = value.format(igenomes_base=base, project_dir=workflow.basedir)
            if value.endswith("/") and re.match(r"^(https?|ftp)://", value):
                print(f"WARNING: iGenomes {key} index {value} is a remote directory; it will be built "
                      "locally instead (set igenomes_base to a local iGenomes mirror to use it).",
                      file=sys.stderr)
                continue
            value = value.rstrip("/") if value.endswith("/") else value
        config[param] = value
    return attrs


IGENOME = apply_igenomes()


ASSETS = os.path.join(workflow.basedir, "assets")

O = config["outdir"].rstrip("/")
W = config["workdir"].rstrip("/")
O_ABS = os.path.abspath(O)

# nextflow.config env{} and process.shell (bash -e -u -o pipefail).
# HPC hosts (Lmod) export a `which` shell function that leaks into containers
# and breaks `which` there; drop it. stage() links inputs into the (shadow)
# working directory under their file names, as Nextflow stages them.
shell.prefix(
    "set -euo pipefail; unset -f which 2>/dev/null || true; export PYTHONNOUSERSITE=1 R_PROFILE_USER=/.Rprofile "
    "R_ENVIRON_USER=/.Renviron JULIA_DEPOT_PATH=/usr/local/share/julia "
    "MPLCONFIGDIR=${{TMPDIR:-/tmp}}/mplcfg; "
    'stage() {{ for f in "$@"; do ln -sfn "$(realpath "$f")" "$(basename "$f")"; done; }}; '
)


# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
def container_path(key):
    path = config["containers"][key]
    return path if os.path.isabs(path) else os.path.join(workflow.basedir, path)


def asset_path(path):
    if os.path.isabs(path) or os.path.exists(path):
        return path
    return os.path.join(workflow.basedir, path)


def res(label):
    return config["resources"][label]


def flag(key):
    return bool(config.get(key))


def param(key):
    """A nf-core param that defaults to null ("" or missing here -> None)."""
    value = config.get(key)
    return None if value in ("", None) else value


def num(key):
    """Groovy numeric param (null -> 0)."""
    value = param(key)
    return 0 if value is None else value


def args(key):
    return config["args"][key]


def gjoin(parts, sep=" "):
    """Groovy [..].join(' ').trim()"""
    return sep.join(parts).strip()


def jvm_mem(resources):
    """avail_mem = (task.memory.mega * 0.8).intValue()"""
    return int(resources.mem_mb * 0.8)


def is_url(path):
    return str(path).startswith(("http://", "https://", "ftp://"))


def basename_noext(path):
    """Nextflow Path.baseName: file name without its last extension."""
    return os.path.splitext(os.path.basename(path))[0]


def alternation(names):
    names = list(names)
    return "|".join(re.escape(n) for n in names) if names else "(?!x)x"


# Remote inputs (FASTQ / reference URLs) are staged into {W}/inputs/ by
# fetch_remote, the equivalent of Nextflow's automatic staging of remote files.
REMOTE = {}


def stage(path):
    if not path or not is_url(path):
        return path
    name = os.path.basename(path)
    if REMOTE.get(name, path) != path:
        raise ValueError(f"Two remote inputs share the file name {name!r}.")
    REMOTE[name] = path
    return f"{W}/inputs/{name}"


# -----------------------------------------------------------------------------
# Parameter validation
# -----------------------------------------------------------------------------
ALIGNER = config["aligner"]
if ALIGNER not in ("bismark", "bismark_hisat", "bwameth", "bwamem"):
    raise ValueError(
        f"ERROR: Invalid aligner '{ALIGNER}'. Valid options are: 'bismark', 'bismark_hisat', 'bwameth' or 'bwamem'."
    )
if not param("fasta"):
    raise ValueError("`fasta` is required.")
# `-profile gpu` in nf-core: bwameth alignment with Parabricks fq2bam_meth
# (needs an NVIDIA GPU; add "--nv" to --apptainer-args).
USE_GPU = flag("use_gpu")

BISMARK = ALIGNER in ("bismark", "bismark_hisat")
BT = "hisat2" if ALIGNER == "bismark_hisat" else "bt2"
TAPS = flag("taps")
RRBS = flag("rrbs")
SKIP_DEDUP_FLAG = flag("skip_deduplication")
# bismark / bwameth: skip_deduplication || rrbs ; bwamem: skip_deduplication
SKIP_DEDUP = SKIP_DEDUP_FLAG if ALIGNER == "bwamem" else (SKIP_DEDUP_FLAG or RRBS)
SAVE_REF = flag("save_reference")
SAVE_ALIGN = flag("save_align_intermeds")
SKIP_TRIM = flag("skip_trimming")
SKIP_FASTQC = flag("skip_fastqc")
COLLECTHS = flag("collecthsmetrics")
TARGETED = flag("run_targeted_sequencing")
SINGLE_CELL_NONDIR = flag("single_cell") or flag("non_directional") or flag("zymo")

if TAPS and ALIGNER != "bwamem":
    print(
        "TAPS protocol detected and aligner is not 'bwamem'. We recommend using bwa-mem for TAPS protocol "
        "as it is optimized for this type of data."
    )
if TARGETED:
    if TAPS or ALIGNER == "bwamem":
        raise ValueError("ERROR: --run_targeted_sequencing can't be running using rastair (methylation caller for TAPS) ")
    if not param("target_regions_file"):
        raise ValueError("ERROR: --target_regions_file must be specified when using --run_targeted_sequencing")

AL = f"{O}/{ALIGNER}"
REF_DIR = f"{AL}/reference_genome" if SAVE_REF else f"{W}/reference"
TRIM_DIR = f"{O}/trimgalore" if flag("save_trimmed") else f"{W}/trimgalore"


# -----------------------------------------------------------------------------
# Samplesheet (PIPELINE_INITIALISATION / samplesheetToList / validateInputSamplesheet)
# -----------------------------------------------------------------------------
FASTQ_RE = re.compile(r"^([\S\s]*\/)?[^\s\/]+\.f(ast)?q\.gz$")


def read_samplesheet(path):
    samples = OrderedDict()
    with open(asset_path(path), newline="") as fh:
        for n, row in enumerate(csv.DictReader(fh), start=2):
            sid = (row.get("sample") or "").strip()
            r1 = (row.get("fastq_1") or "").strip()
            r2 = (row.get("fastq_2") or "").strip()
            if not sid or re.search(r"\s", sid):
                raise ValueError(f"Samplesheet line {n}: Sample name must be provided and cannot contain spaces")
            for r in [r1] + ([r2] if r2 else []):
                if not FASTQ_RE.match(r):
                    raise ValueError(
                        f"Samplesheet line {n}: FastQ file {r!r} must have extension '.fq.gz' or '.fastq.gz'"
                    )
            se = not r2
            entry = samples.setdefault(sid, {"se": se, "runs": []})
            if entry["se"] != se:
                raise ValueError(
                    "Please check input samplesheet -> Multiple runs of a sample must be of the same datatype "
                    f"i.e. single-end or paired-end: {sid}"
                )
            entry["runs"].append([r1] if se else [r1, r2])
    if not samples:
        raise ValueError("The samplesheet has no samples.")
    return samples


SAMPLES = read_samplesheet(config["input"])
IDS = list(SAMPLES)
SE_IDS = [s for s in IDS if SAMPLES[s]["se"]]
PE_IDS = [s for s in IDS if not SAMPLES[s]["se"]]
MULTI_IDS = [s for s in IDS if len(SAMPLES[s]["runs"]) > 1]


def is_se(sid):
    return SAMPLES[sid]["se"]


def raw_reads(sid):
    """Reads after CAT_FASTQ (or the staged inputs of a single-run sample)."""
    runs = SAMPLES[sid]["runs"]
    if len(runs) > 1:
        if is_se(sid):
            return [f"{O}/cat/{sid}.merged.fastq.gz"]
        return [f"{O}/cat/{sid}_1.merged.fastq.gz", f"{O}/cat/{sid}_2.merged.fastq.gz"]
    return [stage(r) for r in runs[0]]


for _s in IDS:  # register remote inputs
    for _run in SAMPLES[_s]["runs"]:
        for _r in _run:
            stage(_r)


def trimmed_reads(sid):
    if SKIP_TRIM:
        return raw_reads(sid)
    if is_se(sid):
        return [f"{TRIM_DIR}/{sid}_trimmed.fq.gz"]
    return [f"{TRIM_DIR}/{sid}_1_val_1.fq.gz", f"{TRIM_DIR}/{sid}_2_val_2.fq.gz"]


# -----------------------------------------------------------------------------
# Reference files (FASTA_INDEX_METHYLSEQ)
# -----------------------------------------------------------------------------
FASTA_IN = stage(config["fasta"])
# ch_fasta meta.id = baseName of the fasta param (genome.fa.gz -> genome.fa)
FASTA_ID = basename_noext(FASTA_IN)
if FASTA_IN.endswith(".gz"):  # GUNZIP (publishDir disabled)
    FASTA = f"{W}/reference/{os.path.basename(FASTA_IN)[:-3]}"
else:
    FASTA = FASTA_IN
FASTA_NAME = os.path.basename(FASTA)

# Indices: provided directory, .tar.gz (UNTAR_*, published to <outdir>/untar), or built.
UNTAR_SRC = {}  # UNTAR: output dir name -> .tar.gz


def provided_index(key):
    value = param(key)
    if not value:
        return None
    value = stage(value)
    if value.endswith(".gz"):
        # UNTAR prefix = meta.id = archive baseName (Bowtie2_Index.tar.gz -> Bowtie2_Index.tar)
        name = basename_noext(value)
        UNTAR_SRC[name] = value
        return f"{O}/untar/{name}"
    return value


if BISMARK:
    INDEX = provided_index("bismark_index") or f"{REF_DIR}/BismarkIndex"
elif ALIGNER == "bwameth":
    INDEX = provided_index("bwameth_index") or f"{REF_DIR}/BwamethIndex"
else:
    INDEX = provided_index("bwamem_index") or f"{REF_DIR}/bwa"
INDEX_NAME = os.path.basename(INDEX.rstrip("/"))

# Fasta index only for bwameth, bwamem or collecthsmetrics (provided one is used as-is)
HAVE_FAI = ALIGNER in ("bwameth", "bwamem") or COLLECTHS
if HAVE_FAI:
    FAI = stage(param("fasta_index")) if param("fasta_index") else f"{REF_DIR}/{FASTA_NAME}.fai"
else:
    FAI = None


# -----------------------------------------------------------------------------
# Per-sample file names
# -----------------------------------------------------------------------------
def read_stem(path):
    """Bismark: file name minus .fastq.gz / .fq.gz / .fastq / .fq"""
    return re.sub(r"(\.fastq\.gz|\.fq\.gz|\.fastq|\.fq)$", "", os.path.basename(path))


# ---- Bismark ----
BAL_DIR = f"{AL}/alignments" if (SAVE_ALIGN or SKIP_DEDUP) else f"{W}/{ALIGNER}/alignments"
BDEDUP_DIR = f"{W}/{ALIGNER}/deduplicated"
MC = f"{AL}/methylation_calls"
STEM2ID = {}
ALIGN_NAME = {}   # BISMARK_ALIGN bam stem
ALIGN_REPORT = {}
for _s in IDS:
    _stem = read_stem(trimmed_reads(_s)[0])
    STEM2ID[_stem] = _s
    ALIGN_NAME[_s] = f"{_stem}_bismark_{BT}" + ("" if is_se(_s) else "_pe")
    ALIGN_REPORT[_s] = f"{AL}/alignments/logs/{_stem}_bismark_{BT}_{'SE' if is_se(_s) else 'PE'}_report.txt"
SE_STEMS = [k for k, v in STEM2ID.items() if is_se(v)]
PE_STEMS = [k for k, v in STEM2ID.items() if not is_se(v)]


def bismark_aligned_bam(sid):
    return f"{BAL_DIR}/{ALIGN_NAME[sid]}.bam"


def mex_name(sid):
    """Stem of the BAM given to the methylation extractor."""
    return ALIGN_NAME[sid] if SKIP_DEDUP else f"{ALIGN_NAME[sid]}.deduplicated"


def mex_bam(sid):
    return bismark_aligned_bam(sid) if SKIP_DEDUP else f"{BDEDUP_DIR}/{mex_name(sid)}.bam"


MEX2ID = {mex_name(s): s for s in IDS} if BISMARK else {}
DEDUP_REPORT = {s: f"{AL}/deduplicated/logs/{ALIGN_NAME[s]}.deduplication_report.txt" for s in IDS}

# ---- Sorted / final BAMs ----
if BISMARK:
    if SKIP_DEDUP:
        SORTED = {s: f"{AL}/alignments/{s}.sorted.bam" for s in IDS}
    else:
        SORTED = {s: f"{AL}/deduplicated/{s}.deduplicated.sorted.bam" for s in IDS}
    FINAL = dict(SORTED)
elif ALIGNER == "bwameth":
    RAW_DIR = f"{AL}/alignments" if SAVE_ALIGN else f"{W}/bwameth/alignments"
    SORT_DIR = f"{AL}/alignments" if (SKIP_DEDUP or SAVE_ALIGN) else f"{W}/bwameth/sorted"
    SORTED = {s: f"{SORT_DIR}/{s}.sorted.bam" for s in IDS}
    FINAL = SORTED if SKIP_DEDUP else {s: f"{AL}/deduplicated/{s}.markdup.sorted.bam" for s in IDS}
else:  # bwamem
    RAW_DIR = f"{AL}/alignments" if SAVE_ALIGN else f"{W}/bwamem/alignments"
    SORT_DIR = f"{AL}/alignments" if SKIP_DEDUP else f"{W}/bwamem/sorted"
    SORTED = {s: f"{SORT_DIR}/{s}.sorted.bam" for s in IDS}
    FINAL = SORTED if SKIP_DEDUP else {s: f"{AL}/deduplicated/{s}.markdup.sorted.bam" for s in IDS}

SORTED2ID = {v: k for k, v in SORTED.items()}
FINAL2ID = {v: k for k, v in FINAL.items()}
BAM_ID = {}  # every BAM indexed by samtools_index -> sample
BAM_ID.update(SORTED2ID)
BAM_ID.update(FINAL2ID)

# ---- MethylDackel ----
METHYLDACKEL = (not TAPS) and ALIGNER == "bwameth"
MD_CONTEXTS = ["CpG"] + (["CHG", "CHH"] if flag("all_contexts") else [])
MD_EXT = "methylKit" if flag("methyl_kit") else "bedGraph"


def md_outputs(sid):
    stem = basename_noext(FINAL[sid])
    return [f"{O}/methyldackel/{stem}_{c}.{MD_EXT}" for c in MD_CONTEXTS]


# ---- rastair (BAM_TAPS_CONVERSION) ----
RUN_TAPS = (TAPS or ALIGNER == "bwamem") and HAVE_FAI


# -----------------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------------
def bismark_targets(sid):
    t = [ALIGN_REPORT[sid], SORTED[sid], SORTED[sid] + ".bai"]
    if SAVE_ALIGN or SKIP_DEDUP:
        t.append(bismark_aligned_bam(sid))
    if not SKIP_DEDUP:
        t.append(DEDUP_REPORT[sid])
    n = mex_name(sid)
    t += [
        f"{MC}/bedGraph/{n}.bedGraph.gz",
        f"{MC}/methylation_coverage/{n}.bismark.cov.gz",
        f"{MC}/splitting_report/{n}_splitting_report.txt",
        f"{MC}/mbias/{n}.M-bias.txt",
        f"{W}/{ALIGNER}/calls/{n}.txt",
        bismark_report_html(sid),
    ]
    if flag("unmapped"):
        t.append(f"{W}/{ALIGNER}/unmapped/{ALIGN_NAME[sid]}.txt")
    if flag("cytosine_report") or flag("nomeseq"):
        t += c2c_outputs(sid)
    return t


def bismark_report_html(sid):
    return f"{AL}/reports/" + os.path.basename(ALIGN_REPORT[sid])[: -len(".txt")] + ".html"


def c2c_outputs(sid):
    # conf/modules/bismark_coverage2cytosine.config hardcodes bismark/ (also for bismark_hisat)
    d = f"{O}/bismark/coverage2cytosine"
    if flag("nomeseq"):
        return [
            f"{d}/summaries/{sid}.cytosine_context_summary.txt",
            f"{d}/reports/{sid}.NOMe.CpG_report.txt.gz",
            f"{d}/reports/{sid}.NOMe.GpC_report.txt.gz",
            f"{d}/coverage/{sid}.NOMe.CpG.cov.gz",
            f"{d}/coverage/{sid}.NOMe.GpC.cov.gz",
        ]
    return [f"{d}/summaries/{sid}.cytosine_context_summary.txt", f"{d}/reports/{sid}.CpG_report.txt.gz"]


STATS_DIR = f"{AL}/alignments/samtools_stats"


def align_stats(sid):
    t = [f"{STATS_DIR}/{sid}.flagstat", f"{STATS_DIR}/{sid}.stats"]
    if ALIGNER == "bwamem":
        t.append(f"{STATS_DIR}/{sid}.idxstats")
    return t


def picard_metrics(sid):
    return f"{AL}/deduplicated/picard_metrics/{sid}.markdup.sorted.MarkDuplicates.metrics.txt"


def bwa_targets(sid):
    t = align_stats(sid)
    if SAVE_ALIGN:
        t.append(f"{RAW_DIR}/{sid}.bam")
    if SORT_DIR == f"{AL}/alignments":
        t += [SORTED[sid], SORTED[sid] + ".bai"]
    if not SKIP_DEDUP:
        t += [FINAL[sid], FINAL[sid] + ".bai", picard_metrics(sid)]
    return t


def fastqc_outputs(sid):
    names = [sid] if is_se(sid) else [f"{sid}_1", f"{sid}_2"]
    return [f"{O}/fastqc/{n}_fastqc.html" for n in names] + [f"{O}/fastqc/zips/{n}_fastqc.zip" for n in names]


def trim_reports(sid):
    if is_se(sid):
        return [f"{O}/trimgalore/logs/{sid}.fastq.gz_trimming_report.txt"]
    return [f"{O}/trimgalore/logs/{sid}_{i}.fastq.gz_trimming_report.txt" for i in (1, 2)]


def trim_fastqc(sid):
    names = [f"{sid}_trimmed"] if is_se(sid) else [f"{sid}_1_val_1", f"{sid}_2_val_2"]
    return [f"{O}/trimgalore/fastqc/{n}_fastqc.html" for n in names] + [
        f"{O}/trimgalore/fastqc/zips/{n}_fastqc.zip" for n in names
    ]


def rastair_outputs(sid):
    return [
        f"{O}/rastair/mbias/{sid}.rastair_mbias.txt",
        f"{O}/rastair/mbiasparser/{sid}.rastair_mbias_processed.csv",
        f"{O}/rastair/call/{sid}.rastair_call.txt",
        f"{O}/rastair/methylkit/{sid}.rastair_methylkit.txt.gz",
    ]


# Targeted sequencing: BEDTOOLS_INTERSECT per bedGraph (prefix = bedGraph baseName)
TARGET_SRC = {}  # output -> bedGraph
if TARGETED:
    _tdir = f"{MC}/bedGraph" if ALIGNER == "bismark" else f"{O}/methyldackel"
    for _s in IDS:
        if BISMARK:
            _bgs = [f"{MC}/bedGraph/{mex_name(_s)}.bedGraph.gz"]
        elif METHYLDACKEL and MD_EXT == "bedGraph":
            _bgs = md_outputs(_s)
        else:
            _bgs = []
        for _bg in _bgs:
            TARGET_SRC[f"{_tdir}/{basename_noext(_bg)}.targeted.bedGraph"] = _bg
TARGET_BED = asset_path(stage(param("target_regions_file"))) if TARGETED else None
DICT = f"{REF_DIR}/{FASTA_ID}.dict"
INTERVALLIST = (
    f"{O}/enrichment_metrics/{basename_noext(TARGET_BED)}.intervallist" if (TARGETED and COLLECTHS) else None
)

MULTIQC_DIR = f"{O}/multiqc/{ALIGNER}"


def all_targets():
    # FASTA_INDEX_METHYLSEQ gunzips a .gz fasta even when the indices are given
    t = [FASTA] if FASTA != FASTA_IN else []
    for s in IDS:
        if not SKIP_FASTQC:
            t += fastqc_outputs(s)
        if not SKIP_TRIM:
            t += trim_reports(s) + trim_fastqc(s) + trimmed_reads(s)
        if s in MULTI_IDS:
            t += raw_reads(s)
        t += bismark_targets(s) if BISMARK else bwa_targets(s)
        if METHYLDACKEL:
            t += md_outputs(s) + [f"{O}/methyldackel/mbias/{s}.mbias.txt"]
        if RUN_TAPS:
            t += rastair_outputs(s)
        if flag("run_qualimap"):
            t.append(f"{AL}/qualimap/bamqc/{s}")
        if flag("run_preseq"):
            t.append(f"{W}/preseq/{s}.done")
    if BISMARK:
        t += [f"{AL}/summary/bismark_summary_report.txt", f"{AL}/summary/bismark_summary_report.html"]
    if flag("run_qualimap"):
        t.append(f"{AL}/qualimap/bamqc/versions.yml")
    t += list(TARGET_SRC)
    if INTERVALLIST:
        t.append(INTERVALLIST)
    if SAVE_REF:
        t += built_reference()
    t += [f"{O}/untar/{n}" for n in UNTAR_SRC]
    if not flag("skip_multiqc"):
        t.append(f"{MULTIQC_DIR}/multiqc_report.html")
    return t


def built_reference():
    """Reference files published with save_reference."""
    t = []
    if INDEX.startswith(REF_DIR):
        t.append(INDEX)
        if ALIGNER == "bwamem":
            t.append(f"{REF_DIR}/versions.yml")
    if FAI and FAI.startswith(REF_DIR):
        t.append(FAI)
    if TARGETED and COLLECTHS:
        t.append(DICT)
    return t


rule all:
    input:
        lambda wc: all_targets() + [VERSIONS_YML],


# -----------------------------------------------------------------------------
# Remote inputs
# -----------------------------------------------------------------------------
rule fetch_remote:
    output:
        f"{W}/inputs/{{fname}}",
    wildcard_constraints:
        fname=alternation(REMOTE),
    params:
        url=lambda wc: REMOTE[wc.fname],
    retries: 2
    run:
        import shutil

        with urllib.request.urlopen(params.url) as src, open(output[0], "wb") as dst:
            shutil.copyfileobj(src, dst)


