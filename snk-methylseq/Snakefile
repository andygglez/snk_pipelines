# -----------------------------------------------------------------------------
# Methylation calling: MethylDackel (BAM_METHYLDACKEL), rastair (BAM_TAPS_CONVERSION)
# -----------------------------------------------------------------------------
METHYLDACKEL_EXTRACT_ARGS = gjoin([
    " --CHG --CHH" if flag("all_contexts") else "",
    " --mergeContext" if flag("merge_context") else "",
    " --ignoreFlags" if flag("ignore_flags") else "",
    " --methylKit" if flag("methyl_kit") else "",
    f" --minDepth {config['min_depth']}" if num("min_depth") > 0 else "",
])
METHYLDACKEL_MBIAS_ARGS = gjoin([
    " --CHG --CHH" if flag("all_contexts") else "",
    " --ignoreFlags" if flag("ignore_flags") else "",
])


def final_bam_inputs(wc):
    return dict(bam=FINAL[wc.id], bai=FINAL[wc.id] + ".bai", fasta=FASTA, fai=FAI)


# METHYLDACKEL_EXTRACT
rule methyldackel_extract:
    input:
        unpack(final_bam_inputs),
    output:
        [f"{O}/methyldackel/{{id}}.{'sorted' if SKIP_DEDUP else 'markdup.sorted'}_{c}.{MD_EXT}" for c in MD_CONTEXTS],
    wildcard_constraints:
        id=alternation(IDS),
    params:
        args=METHYLDACKEL_EXTRACT_ARGS,
    container:
        container_path("methyldackel")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        MethylDackel extract {params.args} {FASTA_NAME} $(basename {input.bam})
        for f in {output}; do mv $(basename $f) $f; done
        """


