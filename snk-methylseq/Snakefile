# UNTAR_BISMARK / UNTAR_BWAMETH (default publishDir: <outdir>/untar)
rule untar_index:
    input:
        lambda wc: UNTAR_SRC[wc.name],
    output:
        directory(f"{O}/untar/{{name}}"),
    wildcard_constraints:
        name=alternation(UNTAR_SRC),
    container:
        container_path("coreutils")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        archive=$(basename {input})
        mkdir {wildcards.name}
        ## Ensures --strip-components only applied when top level of tar contents is a directory
        if [[ $(tar -taf $archive | grep -o -P "^.*?\\/" | uniq | wc -l) -eq 1 ]]; then
            tar -C {wildcards.name} --strip-components 1 -xavf $archive
        else
            tar -C {wildcards.name} -xavf $archive
        fi
        mv {wildcards.name} {output}
        """


