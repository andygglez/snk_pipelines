def mex_args(sid, threads, resources):
    """BISMARK_METHYLATIONEXTRACTOR ext.args + module multicore / buffer_size"""
    se = is_se(sid)
    a = gjoin([
        " --comprehensive" if flag("comprehensive") else "",
        f" --cutoff {config['meth_cutoff']}" if param("meth_cutoff") else "",
        "--CX" if flag("nomeseq") else "",
        f"--ignore {config['ignore_r1']}" if num("ignore_r1") > 0 else "",
        f"--ignore_3prime {config['ignore_3prime_r1']}" if num("ignore_3prime_r1") > 0 else "",
        "" if se else (" --no_overlap" if flag("no_overlap") else "--include_overlap"),
        "" if se else (f"--ignore_r2 {config['ignore_r2']}" if num("ignore_r2") > 0 else ""),
        "" if se else (f"--ignore_3prime_r2 {config['ignore_3prime_r2']}" if num("ignore_3prime_r2") > 0 else ""),
    ])
    if "--multicore" not in a and threads >= 6:
        a += f" --multicore {threads // 3}"
    giga = resources.mem_mb // 1024
    if "--buffer_size" not in a and giga > 6:
        a += f" --buffer_size {giga - 2}G"
    return a


# BISMARK_METHYLATIONEXTRACTOR (input: deduplicated, or aligned with skip_deduplication / rrbs)
rule bismark_methylationextractor:
    input:
        bam=lambda wc: mex_bam(MEX2ID[wc.name]),
        index=INDEX,
    output:
        bedgraph=f"{MC}/bedGraph/{{name}}.bedGraph.gz",
        coverage=f"{MC}/methylation_coverage/{{name}}.bismark.cov.gz",
        rep=f"{MC}/splitting_report/{{name}}_splitting_report.txt",
        mbias=f"{MC}/mbias/{{name}}.M-bias.txt",
        calls=f"{W}/{ALIGNER}/calls/{{name}}.txt",
    wildcard_constraints:
        name=alternation(MEX2ID),
    params:
        args=lambda wc, threads, resources: mex_args(MEX2ID[wc.name], threads, resources),
        seqtype=lambda wc: "-s" if is_se(MEX2ID[wc.name]) else "-p",
        calls_dir=f"{O_ABS}/{ALIGNER}/methylation_calls/methylation_calls",
    container:
        container_path("bismark")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input.bam}
        ln -sfn "$(realpath {input.index})" {INDEX_NAME}
        bismark_methylation_extractor {wildcards.name}.bam --bedGraph --counts --gzip --report \
            {params.seqtype} {params.args}
        mv {wildcards.name}.bedGraph.gz {output.bedgraph}
        mv {wildcards.name}.bismark.cov.gz {output.coverage}
        mv {wildcards.name}_splitting_report.txt {output.rep}
        mv {wildcards.name}.M-bias.txt {output.mbias}
        # per-context call files (which exist depends on the data): published as *txt.gz
        mkdir -p {params.calls_dir}
        ls *.txt.gz > {output.calls}
        mv *.txt.gz {params.calls_dir}/
        """


# BISMARK_COVERAGE2CYTOSINE (cytosine_report or nomeseq)
rule bismark_coverage2cytosine:
    input:
        coverage=lambda wc: f"{MC}/methylation_coverage/{mex_name(wc.id)}.bismark.cov.gz",
        fasta=FASTA,
        index=INDEX,
    output:
        c2c_outputs("{id}"),
    wildcard_constraints:
        id=alternation(IDS),
    params:
        args="--nome-seq" if flag("nomeseq") else "",
        dir=f"{O}/bismark/coverage2cytosine",
    container:
        container_path("bismark")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input.coverage}
        mkdir -p tmp && ln -sfn "$(realpath {input.fasta})" tmp/{FASTA_NAME}
        ln -sfn "$(realpath {input.index})" {INDEX_NAME}
        coverage2cytosine $(basename {input.coverage}) --genome {INDEX_NAME} --output {wildcards.id} \
            --gzip {params.args}
        mkdir -p {params.dir}/coverage
        for f in {output}; do mv $(basename $f) $f; done
        """


def bismark_report_inputs(wc):
    sid = next(s for s in IDS if os.path.basename(ALIGN_REPORT[s]) == f"{wc.rname}_report.txt")
    n = mex_name(sid)
    d = dict(
        align=ALIGN_REPORT[sid],
        splitting=f"{MC}/splitting_report/{n}_splitting_report.txt",
        mbias=f"{MC}/mbias/{n}.M-bias.txt",
    )
    if not SKIP_DEDUP:
        d["dedup"] = DEDUP_REPORT[sid]
    return d


# BISMARK_REPORT
rule bismark_report:
    input:
        unpack(bismark_report_inputs),
    output:
        f"{AL}/reports/{{rname}}_report.html",
    wildcard_constraints:
        rname=alternation(os.path.basename(ALIGN_REPORT[s])[: -len("_report.txt")] for s in IDS) if BISMARK else "(?!x)x",
    params:
        args=args("bismark_report"),
    container:
        container_path("bismark")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        bismark2report {params.args}
        mv {wildcards.rname}_report.html {output}
        """


def bismark_summary_inputs(wc):
    files = []
    for s in IDS:
        n = mex_name(s)
        files += [ALIGN_REPORT[s], f"{MC}/splitting_report/{n}_splitting_report.txt", f"{MC}/mbias/{n}.M-bias.txt"]
        if not SKIP_DEDUP:
            files.append(DEDUP_REPORT[s])
    return files


# BISMARK_SUMMARY (bam names of BISMARK_ALIGN; Nextflow collects them in completion order, sorted here)
rule bismark_summary:
    input:
        bismark_summary_inputs,
    output:
        txt=f"{AL}/summary/bismark_summary_report.txt",
        html=f"{AL}/summary/bismark_summary_report.html",
    params:
        bams=" ".join(sorted(f"{ALIGN_NAME[s]}.bam" for s in IDS)) if BISMARK else "",
    container:
        container_path("bismark")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        bismark2summary {params.bams}
        mv bismark_summary_report.txt {output.txt}
        mv bismark_summary_report.html {output.html}
        """


# -----------------------------------------------------------------------------
# bwa-meth (FASTQ_ALIGN_DEDUP_BWAMETH) and bwa-mem (FASTQ_ALIGN_DEDUP_BWAMEM)
# -----------------------------------------------------------------------------
# BWAMETH_ALIGN. The module links the FASTA into the index directory; here a
# local directory of links with the index's name stands in for it.
rule bwameth_align:
    input:
        reads=lambda wc: trimmed_reads(wc.id),
        fasta=FASTA,
        index=INDEX,
    output:
        f"{RAW_DIR if ALIGNER == 'bwameth' else W + '/none'}/{{id}}.bam",
    wildcard_constraints:
        id=alternation(IDS) if ALIGNER == "bwameth" else "(?!x)x",
    params:
        args=args("bwameth_align"),
        reads=lambda wc, input: " ".join(os.path.basename(r) for r in input.reads),
        in_fq=lambda wc, input: (("--in-se-fq " if is_se(wc.id) else "--in-fq ")
                                 + " ".join(os.path.basename(r) for r in input.reads)),
    container:
        container_path("parabricks" if USE_GPU else "bwameth")
    threads: res("process_high")["threads"]
    resources:
        # conf/base.config: PARABRICKS_FQ2BAMMETH memory 100.GB
        mem_mb=res("parabricks")["mem_mb"] if USE_GPU else res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input.reads} {input.fasta}
        if [ -n "{USE_GPU}" ] && [ "{USE_GPU}" = "True" ]; then
            # PARABRICKS_FQ2BAMMETH (ext.args '--low-memory', one GPU)
            mkdir {INDEX_NAME}
            for f in "$(realpath {input.index})"/*; do ln -s "$f" {INDEX_NAME}/; done
            ln -sf $(readlink {FASTA_NAME}) {INDEX_NAME}/{FASTA_NAME}
            pbrun fq2bam_meth --ref {INDEX_NAME}/{FASTA_NAME} {params.in_fq} --out-bam {wildcards.id}.bam \
                --num-gpus {config[parabricks_num_gpus]} --low-memory
            mv {wildcards.id}.bam {output}
            exit 0
        fi
        mkdir {INDEX_NAME}
        for f in "$(realpath {input.index})"/*; do ln -s "$f" {INDEX_NAME}/; done
        export BWA_METH_SKIP_TIME_CHECKS=1
        ln -sf $(readlink {FASTA_NAME}) {INDEX_NAME}/{FASTA_NAME}
        bwameth.py {params.args} -t {threads} --reference {INDEX_NAME}/{FASTA_NAME} {params.reads} \
            | samtools view -@ {threads} -bhS -o {wildcards.id}.bam -
        mv {wildcards.id}.bam {output}
        """


# BWA_MEM (sort_bam = true)
rule bwa_mem:
    input:
        reads=lambda wc: trimmed_reads(wc.id),
        index=INDEX,
    output:
        f"{RAW_DIR if ALIGNER == 'bwamem' else W + '/none'}/{{id}}.bam",
    wildcard_constraints:
        id=alternation(IDS) if ALIGNER == "bwamem" else "(?!x)x",
    params:
        args=args("bwa_mem"),
        reads=lambda wc, input: " ".join(os.path.basename(r) for r in input.reads),
    container:
        container_path("bwa")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input.reads}
        ln -sfn "$(realpath {input.index})" {INDEX_NAME}
        # nf-core: find -L ./ (the work dir holds only the index); the shadow
        # dir also links outdir, so search the staged index only -> ./<index>/<prefix>
        INDEX=`find -L ./{INDEX_NAME} -name "*.amb" | sed 's/\\.amb$//'`
        bwa mem {params.args} -t {threads} $INDEX {params.reads} \
            | samtools sort --threads {threads} -o {wildcards.id}.bam -
        mv {wildcards.id}.bam {output}
        """


def sort_input(wc):
    sid = SORTED2ID[wc.path]
    if BISMARK:
        return mex_bam(sid)
    return f"{RAW_DIR}/{sid}.bam"


# SAMTOOLS_SORT (bismark: <id>.deduplicated.sorted / <id>.sorted; bwameth, bwamem: <id>.sorted)
rule samtools_sort:
    input:
        bam=sort_input,
        fasta=[FASTA] if ALIGNER == "bwamem" else [],
    output:
        "{path}",
    wildcard_constraints:
        path=alternation(SORTED.values()),
    params:
        prefix=lambda wc: basename_noext(wc.path),
        # BAM_SORT_STATS_SAMTOOLS (bwamem) passes the FASTA; bismark / bwameth pass []
        reference=f"--reference {FASTA_NAME}" if ALIGNER == "bwamem" else "",
    container:
        container_path("samtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input}
        samtools cat $(basename {input.bam}) | samtools sort -T {params.prefix} --threads {threads} \
            {params.reference} -o {params.prefix}.bam -
        mv {params.prefix}.bam {output}
        """


# SAMTOOLS_INDEX (also SAMTOOLS_INDEX_ALIGNMENTS / _DEDUPLICATED)
