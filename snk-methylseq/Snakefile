# RASTAIR_CALL (--nOT / --nOB: first / second line of the mbiasparser CSV)
rule rastair_call:
    input:
        unpack(final_bam_inputs),
        csv=f"{O}/rastair/mbiasparser/{{id}}.rastair_mbias_processed.csv",
    output:
        f"{O}/rastair/call/{{id}}.rastair_call.txt",
    wildcard_constraints:
        id=alternation(IDS),
    container:
        container_path("rastair")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        stage {input.bam} {input.bai} {input.fasta} {input.fai}
        trim_OT=$(head -n 1 {input.csv})
        trim_OB=$(head -n 2 {input.csv} | tail -n 1)
        rastair call --threads {threads} --nOT $trim_OT --nOB $trim_OB --fasta-file {FASTA_NAME} \
            $(basename {input.bam}) > {wildcards.id}.rastair_call.txt
        mv {wildcards.id}.rastair_call.txt {output}
        """


