    container:
        container_path("homer")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        HOMER_CMD


def featurecounts_bams(wc):
    """ch_bams.join(ch_peaks).collect{ it[1] }: merged-library BAMs behind the peak files."""
    check_kind(wc)
    if wc.kind == "library":
        bams = [clean_bam(s) for s in peak_ids("library")]
    else:
        bams = [clean_bam(s) for g in peak_ids("replicate") for s in rep_groups()[g]["samples"]]
    return sorted(bams, key=os.path.basename)


# SUBREAD_FEATURECOUNTS (consensus meta has no single_end, so -p is always set)
rule featurecounts:
    input:
        bams=featurecounts_bams,
        saf=f"{CONSENSUS}.saf",
        status=lambda wc: [TRIM_SUMMARY, f"{W}/status/peak_summary_{wc.kind}.json"],  # read by params
    output:
        counts=f"{CONSENSUS}.featureCounts.txt",
        summary=f"{CONSENSUS}.featureCounts.txt.summary",
    params:
        args=args("featurecounts"),
        prefix=lambda wc: f"consensus_peaks.{wc.lvl}.clN",
        bams=lambda wc: " ".join(os.path.basename(f) for f in featurecounts_bams(wc)),
    container:
        container_path("subread")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bams}; do ln -s $(realpath $f) $(basename $f); done
        ln -s $(realpath {input.saf}) $(basename {input.saf})
        p={params.prefix}
        featureCounts {params.args} -p -T {threads} -a $(basename {input.saf}) -s 0 \
            -o $p.featureCounts.txt {params.bams}
        mv $p.featureCounts.txt {output.counts}
        mv $p.featureCounts.txt.summary {output.summary}
        """


DESEQ2_CMD = """
        ln -s $(realpath {input.counts}) $(basename {input.counts})
        p={params.prefix}
        Rscript {SCRIPTS}/deseq2_qc.r --count_file $(basename {input.counts}) --outdir ./ --outprefix $p \
            --cores {threads} {params.args}
        sed 's/deseq2_pca/deseq2_pca_1/g' <{input.pca_header} >tmp.txt
        sed -i -e 's/DESeq2 /consensus_peaks DESeq2 /g' tmp.txt
        cat tmp.txt $p.pca.vals.txt > $p.pca.vals_mqc.tsv
        sed 's/deseq2_clustering/deseq2_clustering_1/g' <{input.clust_header} >tmp.txt
        sed -i -e 's/DESeq2 /consensus_peaks DESeq2 /g' tmp.txt
        cat tmp.txt $p.sample.dists.txt > $p.sample.dists_mqc.tsv
        mkdir -p {params.outdir}
        for f in $p.dds.RData $p.rds $p.plots.pdf $p.pca.vals.txt $p.pca.vals_mqc.tsv \
                 $p.sample.dists.txt $p.sample.dists_mqc.tsv R_sessionInfo.log size_factors; do
            mv $f {params.outdir}/
        done
"""

# DESEQ2_QC, one rule per branch (deseq2_qc_library / deseq2_qc_replicate).
# meta.id is 'consensus_peaks'; ${task.index} is 1 (one task per process alias).
for _kind, _k in KINDS.items():

    rule:
        name:
            f"deseq2_qc_{_kind}"
        input:
            counts=f"{consensus_prefix(_kind)}.featureCounts.txt",
            pca_header=f"{ASSETS}/multiqc/merged_{_kind}_deseq2_pca_header.txt",
            clust_header=f"{ASSETS}/multiqc/merged_{_kind}_deseq2_clustering_header.txt",
        output:
            **{f"f{i}": f"{_k['macs']}/consensus/deseq2/{n}" for i, n in enumerate(deseq2_names(_kind)[:-1])},
            size_factors=directory(f"{_k['macs']}/consensus/deseq2/size_factors"),
        params:
            args=args("deseq2_qc") + (" --vst TRUE" if flag("deseq2_vst") else ""),
            prefix=f"consensus_peaks.{_k['lvl']}.clN",
            outdir=f"{_k['macs']}/consensus/deseq2",
        container:
            container_path("deseq2")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            DESEQ2_CMD


# =============================================================================
# ataqv (MERGED_LIBRARY_ATAQV_ATAQV / MERGED_LIBRARY_ATAQV_MKARV)
# =============================================================================

# ATAQV_ATAQV (markduplicates BAM + its merged-library peaks)
rule ataqv:
    input:
        bam=mkd_bam("{sample}"),
        bai=f"{mkd_bam('{sample}')}.bai",
        peak=peak_file("library", "{sample}"),
        tss=TSS_BED,
        autosomes=AUTOSOMES,
    output:
        f"{ATAQV_DIR}/{{sample}}.ataqv.json",
    params:
        args=args("ataqv"),
        mito=f"--mitochondrial-reference-name {ATAQV_MITO}" if ATAQV_MITO else "",
    container:
        container_path("ataqv")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input}; do ln -s $(realpath $f) $(basename $f); done
        ataqv {params.args} {params.mito} --peak-file $(basename {input.peak}) --tss-file $(basename {input.tss}) \
            --autosomal-reference-file $(basename {input.autosomes}) \
            --metrics-file "{wildcards.sample}.ataqv.json" --threads {threads} --name {wildcards.sample} \
            NA $(basename {input.bam})
        mv {wildcards.sample}.ataqv.json {output}
        """


# ATAQV_MKARV (all ataqv JSONs -> interactive HTML report)
rule ataqv_mkarv:
    input:
        lambda wc: [f"{ATAQV_DIR}/{s}.ataqv.json" for s in peak_ids("library")],
    output:
        directory(f"{ATAQV_DIR}/html"),
    container:
        container_path("ataqv")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir jsons
        for f in {input}; do ln -s $(realpath $f) jsons/$(basename $f); done
        mkarv --concurrency {threads} --force ./html/ jsons/*
        mv html {output}
        """


# =============================================================================
# IGV session
# =============================================================================
def igv_inputs(wc):
    cons = consensus_kinds()
    return {
        "fasta": FASTA,
        "fai": FAI,
        "lib_bigwigs": [bigwig("library", s) for s in samples_ok()],
        "lib_peaks": [peak_file("library", s) for s in peak_ids("library")],
        "lib_consensus": [f"{consensus_prefix('library')}.bed"] if "library" in cons else [],
        "rep_bigwigs": [bigwig("replicate", g) for g in rep_groups()],
        "rep_peaks": [] if SKIP_MERGE_REP else [peak_file("replicate", g) for g in peak_ids("replicate")],
        "rep_consensus": [f"{consensus_prefix('replicate')}.bed"] if "replicate" in cons else [],
        # checkpoints read by params.stage
        "status": [TRIM_SUMMARY] + [f"{W}/status/peak_summary_{k}.json" for k in KINDS if callers(k)],
    }


IGV_GENOME_OUT = [f for f, src in ((f"{O}/genome/{FASTA_NAME}", FASTA), (f"{O}/genome/{FASTA_NAME}.fai", FAI))
                  if f != src]
IGV_DIRS = {
    "lib_bigwigs": f"{ALIGNER}/merged_library/bigwig",
    "lib_peaks": f"{ALIGNER}/merged_library/macs2/{PEAK_TYPE}",
    "lib_consensus": f"{ALIGNER}/merged_library/macs2/{PEAK_TYPE}/consensus",
    "rep_bigwigs": f"{ALIGNER}/merged_replicate/bigwig",
    "rep_peaks": f"{ALIGNER}/merged_replicate/macs2/{PEAK_TYPE}",
    "rep_consensus": f"{ALIGNER}/merged_replicate/macs2/{PEAK_TYPE}/consensus",
}


def igv_stage_cmd(wc):
    files = igv_inputs(wc)
    cmds = [f"mkdir -p stage/{d}" for d in IGV_DIRS.values()]
    for key, d in IGV_DIRS.items():
        for f in files[key]:
            cmds.append(f"ln -s $(realpath {f}) stage/{d}/{os.path.basename(f)}")
    return "\n".join(cmds)


# IGV (bin/igv_files_to_session.py; also publishes the FASTA and FAI to genome/)
rule igv:
    input:
        unpack(igv_inputs),
    output:
        *IGV_GENOME_OUT,
        xml=f"{O}/igv/{PEAK_TYPE}/igv_session.xml",
        txt=f"{O}/igv/{PEAK_TYPE}/igv_files.txt",
    params:
        stage=igv_stage_cmd,
        genome_out=IGV_GENOME_OUT,
        d=IGV_DIRS,
    container:
        container_path("python")
    threads: res("process_default")["threads"]
    resources:
        mem_mb=res("process_default")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        {params.stage}
        ln -s $(realpath {input.fasta}) stage/{FASTA_NAME}
        ln -s $(realpath {input.fai}) stage/{FASTA_NAME}.fai
        cd stage
        find * -type l -name "*.bigWig" -exec echo -e ""{{}}"\\t0,0,178" \; | {{ grep "^{params.d[lib_bigwigs]}" || test $? = 1; }} > mLb_bigwig.igv.txt
        find * -type l -name "*Peak" -exec echo -e ""{{}}"\\t0,0,178" \; | {{ grep "^{params.d[lib_peaks]}" || test $? = 1; }} > mLb_peaks.igv.txt
        find * -type l -name "*.bed" -exec echo -e ""{{}}"\\t0,0,0" \; | {{ grep "^{params.d[lib_consensus]}" || test $? = 1; }} > mLb_bed.igv.txt
        find * -type l -name "*.bigWig" -exec echo -e ""{{}}"\\t0,0,178" \; | {{ grep "^{params.d[rep_bigwigs]}" || test $? = 1; }} > mRp_bigwig.igv.txt
        find * -type l -name "*Peak" -exec echo -e ""{{}}"\\t0,0,178" \; | {{ grep "^{params.d[rep_peaks]}" || test $? = 1; }} > mRp_peaks.igv.txt
        find * -type l -name "*.bed" -exec echo -e ""{{}}"\\t0,0,0" \; | {{ grep "^{params.d[rep_consensus]}" || test $? = 1; }} > mRp_bed.igv.txt
        cat *.txt > igv_files.txt
        python {SCRIPTS}/igv_files_to_session.py igv_session.xml igv_files.txt ../../genome/{FASTA_NAME} --path_prefix '../../'
        cd ..
        mv stage/igv_session.xml {output.xml}
        mv stage/igv_files.txt {output.txt}
        for f in {params.genome_out}; do cp -L stage/$(basename $f) $f; done
        """


# =============================================================================
# MULTIQC (local module: inputs staged into fixed sub-directories)
# =============================================================================
def multiqc_inputs(wc):
    libs = libs_ok()
    samples = samples_ok()
    groups = list(rep_groups())
    cons = consensus_kinds()
    d = OrderedDict()
    d["fastqc"] = [] if SKIP_FASTQC else [f for l in LIBS for f in raw_fastqc(l, "zip")]
    d["trimgalore/fastqc"] = [] if SKIP_TRIM else [f for l in LIBS for f in trim_fastqc(l, "zip")]
    d["trimgalore"] = [] if SKIP_TRIM else [f for l in LIBS for f in trim_logs(l)]
    d["alignment/library"] = [f for l in libs for f in stats_files(lib_bam(l))]
    d["alignment/merged_library/unfiltered"] = [f for s in samples for f in stats_files(mkd_bam(s))]
    d["alignment/merged_library/unfiltered/picard_metrics"] = [
        f"{ML}/picard_metrics/{s}.mLb.mkD.sorted.MarkDuplicates.metrics.txt" for s in samples]
    d["alignment/merged_library/filtered"] = [f for s in samples for f in stats_files(clean_bam(s))]
    d["alignment/merged_library/filtered/picard_metrics"] = (
        [] if flag("skip_picard_metrics") else [f for s in samples for f in cmm_metrics(s)])
    d["preseq"] = [] if flag("skip_preseq") else [f"{ML}/preseq/{s}.mLb.mkD.lc_extrap.txt" for s in samples]
    d["deeptools"] = [] if flag("skip_plot_profile") else [
        f"{DT_PROFILE.format(sample=s)}.reference_point.plotProfile.tab" for s in samples]
    if not flag("skip_plot_fingerprint"):
        d["deeptools"] += [f"{DT_FINGERPRINT.format(sample=s)}.raw.txt" for s in ip_samples()]
    for kind in ("library", "replicate"):
        k = KINDS[kind]
        ids = [] if (kind == "replicate" and SKIP_MERGE_REP) else peak_ids(kind)
        d[f"macs2/merged_{kind}/peaks"] = [f"{k['macs']}/qc/{i}.{k['lvl']}.clN_peaks.{x}"
                                           for i in ids for x in ("FRiP_mqc.tsv", "count_mqc.tsv")]
        d[f"macs2/merged_{kind}/annotation"] = (
            [f"{k['macs']}/qc/macs2_annotatePeaks.{k['lvl']}.clN.summary_mqc.tsv"]
            if ids and not SKIP_ANNOT and not flag("skip_peak_qc") else [])
        d[f"macs2/merged_{kind}/featurecounts"] = (
            [f"{consensus_prefix(kind)}.featureCounts.txt.summary"] if kind in cons else [])
    d["alignment/merged_replicate"] = [f for g in groups for f in stats_files(rep_bam(g))]
    d["alignment/merged_replicate/picard_metrics"] = [
        f"{MR}/picard_metrics/{g}.mRp.clN.sorted.MarkDuplicates.metrics.txt" for g in groups]
    for kind in deseq2_kinds():
        k = KINDS[kind]
        d[f"deseq2_{kind}"] = [f"{k['macs']}/consensus/deseq2/consensus_peaks.{k['lvl']}.clN.{x}"
                               for x in ("pca.vals_mqc.tsv", "sample.dists_mqc.tsv")]
    return d


def multiqc_files(wc):
    return [f for files in multiqc_inputs(wc).values() for f in files]


def multiqc_stage_cmd(wc):
    """Link every input into its staging sub-directory (path('<dir>/*') inputs)."""
    cmds = []
    for sub, files in multiqc_inputs(wc).items():
        for f in files:
            cmds.append(f"mkdir -p stage/{sub} && ln -s $(realpath {f}) stage/{sub}/{os.path.basename(f)}")
    return "\n".join(cmds)


# MULTIQC. nf-core also feeds workflow_summary_mqc.yaml and the collated
# software versions; those are Nextflow run metadata and are not produced here.
rule multiqc:
    input:
        files=multiqc_files,
        status=lambda wc: [TRIM_SUMMARY] + [f"{W}/status/peak_summary_{k}.json" for k in KINDS
                                            if callers(k)],  # checkpoints read by params.stage
        config=f"{ASSETS}/multiqc_config.yml",
        extra_config=param("multiqc_config") or [],
    output:
        report=f"{O}/multiqc/{PEAK_TYPE}/multiqc_report.html",
        data=directory(f"{O}/multiqc/{PEAK_TYPE}/multiqc_data"),
        plots=directory(f"{O}/multiqc/{PEAK_TYPE}/multiqc_plots"),
    params:
        title=f"--title \"{config['multiqc_title']}\"" if param("multiqc_title") else "",
        custom=f"--config {os.path.abspath(config['multiqc_config'])}" if param("multiqc_config") else "",
        stage=multiqc_stage_cmd,
    container:
        container_path("multiqc")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir -p stage
        ln -s $(realpath {input.config}) stage/multiqc_config.yml
        {params.stage}
        cd stage
        multiqc -f {params.title} {params.custom} .
        cd ..
        mv stage/multiqc_report.html {output.report}
        mv stage/multiqc_data {output.data}
        mv stage/multiqc_plots {output.plots}
        """
