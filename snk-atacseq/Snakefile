# SAMTOOLS sort / index / stats (BAM_SORT_STATS_SAMTOOLS, BAM_STATS_SAMTOOLS)
# =============================================================================
SAMTOOLS_SORT_CMD = """
        ln -s $(realpath {input}) $(basename {input})
        samtools sort {params.args} -@ {threads} -o {params.prefix}.bam -T {params.prefix} $(basename {input})
        mv {params.prefix}.bam {output}
"""


# BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT (library, prefix <id>.Lb.sorted)
rule samtools_sort_library:
