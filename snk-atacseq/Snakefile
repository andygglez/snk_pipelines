    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        CMM_CMD


# =============================================================================
# BAM_BEDGRAPH_BIGWIG_BEDTOOLS_UCSC (merged library and merged replicate)
# =============================================================================
def genomecov_inputs(wc):
    check_kind(wc)
    bam = final_bam(wc.kind, wc.id)
    return {"bam": bam, "flagstat": stats_files(bam)[1], "status": TRIM_SUMMARY}


# BEDTOOLS_GENOMECOV (local module; CPM scale factor from the flagstat)
rule bedtools_genomecov:
    input:
        unpack(genomecov_inputs),
    output:
        bedgraph=f"{W}/bigwig/{{kind}}/{{id}}.{{lvl}}.clN.bedGraph",
        scale=f"{AL}/merged_{{kind}}/bigwig/scale/{{id}}.{{lvl}}.clN.scale_factor.txt",
    params:
        pe=lambda wc: "" if meta(wc.kind, wc.id)["single_end"] else "-pc",
        args=lambda wc: (f"-fs {config['fragment_size']}"
                         if meta(wc.kind, wc.id)["single_end"] and float(config["fragment_size"] or 0) > 0 else ""),
    container:
        container_path("bedtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.bam}) $(basename {input.bam})
        ln -s $(realpath {input.flagstat}) $(basename {input.flagstat})
        p={wildcards.id}.{wildcards.lvl}.clN
        SCALE_FACTOR=$(grep '[0-9] mapped (' $(basename {input.flagstat}) | awk '{{print 1000000/$1}}')
        echo $SCALE_FACTOR > $p.scale_factor.txt
        bedtools genomecov -ibam $(basename {input.bam}) -bg -scale $SCALE_FACTOR {params.pe} {params.args} > tmp.bg
        bedtools sort -i tmp.bg > $p.bedGraph
        mv $p.bedGraph {output.bedgraph}
        mv $p.scale_factor.txt {output.scale}
        """


