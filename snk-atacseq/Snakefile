# GENOME_BLACKLIST_REGIONS (mitochondrial contig dropped unless keep_mito)
rule genome_blacklist_regions:
    input:
        sizes=SIZES,
        blacklist=BLACKLIST or [],
    output:
        FILTERED_BED,
    params:
        mito_filter=("" if flag("keep_mito") or not param("mito_name")
                     else f"| awk '$1 !~ /{config['mito_name']}/ {{print $0}}'"),
    container:
        container_path("bedtools")
    threads: res("process_default")["threads"]
    resources:
        mem_mb=res("process_default")["mem_mb"],
    shell:
        """
        if [ -n "{input.blacklist}" ]; then
            sortBed -i {input.blacklist} -g {input.sizes} | complementBed -i stdin -g {input.sizes} {params.mito_filter} > {output}
        else
            awk '{{print $1, '0' , $2}}' OFS='\\t' {input.sizes} {params.mito_filter} > {output}
        fi
        """


# UNTAR_BWA_INDEX / UNTAR_BOWTIE2_INDEX / UNTAR_STAR_INDEX
rule untar:
    input:
        lambda wc: UNTAR_SRC[wc.name],
    output:
        directory(f"{INDEX_DIR}/{{name}}"),
    wildcard_constraints:
        name=alternation(UNTAR_SRC),
    params:
        args2=args("untar"),
    container:
        container_path("ubuntu20")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        mkdir -p {output}
        if [[ $(tar -taf {input} | grep -o -P "^.*?\\/" | uniq | wc -l) -eq 1 ]]; then
            tar -C {output} --strip-components 1 -xavf {input} {params.args2}
        else
            tar -C {output} -xavf {input} {params.args2}
        fi
        """


