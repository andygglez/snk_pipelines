# =============================================================================
# BAM_PEAKS_CALL_QC_ANNOTATE_MACS2_HOMER (merged library and merged replicate)
# =============================================================================
def macs2_args(kind):
    """conf/modules.config MACS2_CALLPEAK ext.args (p/q-value only for merged libraries),
    with the module's --format handling."""
    parts = [args("macs2"),
             "" if NARROW else f"--broad --broad-cutoff {config['broad_cutoff']}",
             "--bdg --SPMR" if flag("save_macs_pileup") else ""]
    if kind == "library":
        parts += [f"--pvalue {param('macs_pvalue')}" if param("macs_pvalue") else "",
                  f"--qvalue {param('macs_fdr')}" if param("macs_fdr") else ""]
    tokens = join_args(parts).split()
    fmt = None
    if "--format" in tokens:
        i = tokens.index("--format")
        fmt = tokens[i + 1]
        del tokens[i:i + 2]
    return " ".join(tokens), fmt


def macs2_callpeak_inputs(wc):
    check_kind(wc)
    out = ip_control_bams(wc.kind, wc.id)
    out["kmers"] = [] if param("macs_gsize") else f"{W}/khmer/kmers.txt"
    out["status"] = TRIM_SUMMARY  # params read merged-replicate metadata (checkpoint)
    return out


# MACS2_CALLPEAK (IP, vs control with with_control)
rule macs2_callpeak:
    input:
        unpack(macs2_callpeak_inputs),
    output:
        **macs2_output_patterns(),
    params:
        args=lambda wc: macs2_args(wc.kind)[0],
        format=lambda wc: macs2_args(wc.kind)[1] or ("BAM" if meta(wc.kind, wc.id)["single_end"] else "BAMPE"),
        gsize=param("macs_gsize") or "",
        control=lambda wc: " ".join(f"--control {os.path.basename(f)}"
                                    for f in ip_control_bams(wc.kind, wc.id)["control"]),
        outdir=lambda wc: KINDS[wc.kind]["macs"],
    container:
        container_path("macs2")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        LINK_IP_CONTROL + """
        GSIZE="{params.gsize}"
        if [ -z "$GSIZE" ]; then GSIZE=$(tr -d '[:space:]' < {input.kmers}); fi
        macs2 callpeak {params.args} --gsize $GSIZE --format {params.format} \
            --name {wildcards.id}.{wildcards.lvl}.clN --treatment $(basename {input.ip}) {params.control}
        mkdir -p {params.outdir}
        for f in {output}; do mv $(basename $f) $f; done
        """


MACS_K = f"{AL}/merged_{{kind}}/macs2/{PEAK_TYPE}"


# Groovy filter in BAM_PEAKS_CALL_QC_ANNOTATE_MACS2_HOMER: peaks.size() > 0
checkpoint peak_summary:
    input:
        peaks=lambda wc: [peak_file(wc.kind, i) for i in callers(wc.kind)],
        status=TRIM_SUMMARY,
    output:
        f"{W}/status/peak_summary_{{kind}}.json",
    params:
        ids=lambda wc: callers(wc.kind),
    run:
        sizes = {i: os.path.getsize(f) for i, f in zip(params.ids, input.peaks)}
        with open(output[0], "w") as fh:
            json.dump(sizes, fh, indent=1)


# FRIP_SCORE (not published)
rule frip_score:
    input:
        bam=lambda wc: final_bam(wc.kind, wc.id),
        peak=lambda wc: peak_file(wc.kind, wc.id),
    output:
        f"{W}/frip/{{kind}}/{{id}}.FRiP.txt",
    params:
        args=args("frip"),
    container:
        container_path("frip")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        bam=$(basename {input.bam}); peak=$(basename {input.peak})
        ln -s $(realpath {input.bam}) $bam
        ln -s $(realpath {input.peak}) $peak
        READS_IN_PEAKS=$(intersectBed -a $bam -b $peak {params.args} | awk -F '\\t' '{{sum += $NF}} END {{print sum}}')
        samtools flagstat $bam > $bam.flagstat
        grep 'mapped (' $bam.flagstat | grep -v "primary" | awk -v a="$READS_IN_PEAKS" -v OFS='\\t' '{{print "{wildcards.id}", a/$1}}' > {wildcards.id}.FRiP.txt
        mv {wildcards.id}.FRiP.txt {output}
        """


