# Nextflow's collect() order is task-completion order; the order here is sorted.
def collected_peaks(wc):
    check_kind(wc)
    return [peak_file(wc.kind, i) for i in sorted(peak_ids(wc.kind))]


# PLOT_MACS2_QC
rule plot_macs2_qc:
