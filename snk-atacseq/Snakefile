def ip_control_bams(kind, id):
    """[ meta, ip_bam, control_bam ]; no control unless with_control."""
    bam = final_bam(kind, id)
    out = {"ip": bam, "ip_bai": f"{bam}.bai", "control": [], "control_bai": []}
    if WITH_CONTROL:
        ctrl = final_bam(kind, meta(kind, id)["control"])
        out.update(control=[ctrl], control_bai=[f"{ctrl}.bai"])
    return out


LINK_IP_CONTROL = """
        for f in {input.ip} {input.ip_bai} {input.control} {input.control_bai}; do
            ln -s $(realpath $f) $(basename $f)
        done
"""


# MERGED_LIBRARY_DEEPTOOLS_PLOTFINGERPRINT (IP, plus its control with with_control)
rule deeptools_plotfingerprint:
    input:
        unpack(lambda wc: ip_control_bams("library", wc.sample)),
    output:
        pdf=f"{DT_FINGERPRINT}.pdf",
        raw=f"{DT_FINGERPRINT}.raw.txt",
        qc=f"{DT_FINGERPRINT}.qcmetrics.txt",
    params:
        args=lambda wc: join_args([
            args("plotfingerprint"), f"--numberOfSamples {config['fingerprint_bins']}",
            f"--labels {wc.sample}.mLb.clN {SAMPLES[wc.sample]['control']}" if WITH_CONTROL
            else f"--labels {wc.sample}.mLb.clN"]),
        extend_reads=lambda wc: (f"--extendReads {config['fragment_size']}"
                                 if SAMPLES[wc.sample]["single_end"] and float(config["fragment_size"] or 0) > 0
                                 else ""),
        bams=lambda wc: " ".join(os.path.basename(f) for f in
                                 [clean_bam(wc.sample)] + ip_control_bams("library", wc.sample)["control"]),
    container:
        container_path("deeptools")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        LINK_IP_CONTROL + """
        p={wildcards.sample}.mLb.clN
        plotFingerprint {params.args} {params.extend_reads} \
            --bamfiles {params.bams} \
            --plotFile $p.plotFingerprint.pdf --outRawCounts $p.plotFingerprint.raw.txt \
            --outQualityMetrics $p.plotFingerprint.qcmetrics.txt --numberOfProcessors {threads}
        mv $p.plotFingerprint.pdf {output.pdf}
        mv $p.plotFingerprint.raw.txt {output.raw}
        mv $p.plotFingerprint.qcmetrics.txt {output.qc}
        """


