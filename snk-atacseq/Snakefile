# =============================================================================
# Merged libraries: PICARD_MERGESAMFILES_LIBRARY, MERGED_LIBRARY_MARKDUPLICATES_PICARD
# =============================================================================
PICARD_MERGE_CMD = """
        set -- {input}
        if [ $# -gt 1 ]; then
            inputs=
            for f in {input}; do ln -s $(realpath $f) $(basename $f); inputs="$inputs --INPUT $(basename $f)"; done
            picard -Xmx{params.mem}M MergeSamFiles {params.args} $inputs --OUTPUT {params.prefix}.bam
            mv {params.prefix}.bam {output}
        else
            {params.single} $(realpath {input}) {output}
        fi
"""


# PICARD_MERGESAMFILES_LIBRARY (a single library is linked, as in the module)
rule picard_mergesamfiles_library:
    input:
        lambda wc: sorted((lib_bam(l) for l in sample_libs(wc.sample)), key=os.path.basename),
    output:
        f"{MRG_DIR}/{{sample}}.mLb.sorted.bam",
    params:
        args=args("picard_mergesamfiles"),
        mem=lambda wc, resources: picard_mem(resources),
        prefix=lambda wc: f"{wc.sample}.mLb.sorted",
        # publish_dir_mode copy: a real file when the BAM is published
        single="cp" if SAVE_ALIGN else "ln -s",
    container:
        container_path("picard")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        PICARD_MERGE_CMD


MARKDUP_CMD = """
        ln -s $(realpath {input.bam}) $(basename {input.bam})
        ln -s $(realpath {input.fasta}) {FASTA_NAME}
        ln -s $(realpath {input.fai}) {FASTA_NAME}.fai
        picard -Xmx{params.mem}M MarkDuplicates {params.args} \
            --INPUT $(basename {input.bam}) --OUTPUT {params.prefix}.bam \
            --REFERENCE_SEQUENCE {FASTA_NAME} --METRICS_FILE {params.prefix}.MarkDuplicates.metrics.txt
        mv {params.prefix}.bam {output.bam}
        mv {params.prefix}.MarkDuplicates.metrics.txt {output.metrics}
"""


# MERGED_LIBRARY_MARKDUPLICATES_PICARD:PICARD_MARKDUPLICATES
rule picard_markduplicates_library:
    input:
        bam=f"{MRG_DIR}/{{sample}}.mLb.sorted.bam",
        fasta=FASTA,
        fai=FAI,
    output:
        bam=mkd_bam("{sample}"),
        metrics=f"{ML}/picard_metrics/{{sample}}.mLb.mkD.sorted.MarkDuplicates.metrics.txt",
    params:
        args=args("picard_markduplicates_library"),
        mem=lambda wc, resources: picard_mem(resources),
        prefix=lambda wc: f"{wc.sample}.mLb.mkD.sorted",
    container:
        container_path("picard")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        MARKDUP_CMD


# =============================================================================
# MERGED_LIBRARY_FILTER_BAM (BAM_FILTER_BAMTOOLS)
# =============================================================================
def bamtools_args(s):
    """conf/modules.config BAMTOOLS_FILTER ext.args"""
    return join_args([
        "-F 0x004" if SAMPLES[s]["single_end"] else "-F 0x004 -F 0x0008 -f 0x001",
        "" if flag("keep_dups") else "-F 0x0400",
        "" if flag("keep_multi_map") else "-q 1",
    ])


def bamtools_inputs(s):
    se = SAMPLES[s]["single_end"]
    return {
        "bam": mkd_bam(s),
        "bai": f"{mkd_bam(s)}.bai",
        "bed": FILTERED_BED,
        "config": asset_path(config["bamtools_filter_se_config" if se else "bamtools_filter_pe_config"]),
    }


BAMTOOLS_FILTER_CMD = """
        ln -s $(realpath {input.bam}) $(basename {input.bam})
        ln -s $(realpath {input.bai}) $(basename {input.bai})
        ln -s $(realpath {input.bed}) $(basename {input.bed})
        ln -s $(realpath {input.config}) $(basename {input.config})
        samtools view {params.args} -L $(basename {input.bed}) -b $(basename {input.bam}) \
            | bamtools filter -out {params.prefix}.bam -script $(basename {input.config})
        mv {params.prefix}.bam {output}
"""


# BAMTOOLS_FILTER (paired-end: <id>.mLb.flT.sorted.bam, orphans removed next)
rule bamtools_filter_pe:
    input:
        unpack(lambda wc: bamtools_inputs(wc.pe_sample)),
    output:
        f"{MRG_DIR}/{{pe_sample}}.mLb.flT.sorted.bam",
    params:
        args=lambda wc: bamtools_args(wc.pe_sample),
        prefix=lambda wc: f"{wc.pe_sample}.mLb.flT.sorted",
    container:
        container_path("bamtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        BAMTOOLS_FILTER_CMD


# BAMTOOLS_FILTER (single-end: final <id>.mLb.clN.sorted.bam)
rule bamtools_filter_se:
