# =============================================================================
# snk-atacseq — Snakemake port of nf-core/atacseq 2.1.2
#
# Every rule mirrors one nf-core process (named in the comment above each rule)
# and runs inside the same Singularity image the nf-core module uses
# (see config/containers.yaml). nf-core bin/ scripts live in scripts/. Published
# files follow the nf-core publishDir layout under `outdir`; files nf-core keeps
# only in its work/ directory go to `workdir`.
#
# Ported: the whole workflow, with all four aligners (bwa, bowtie2, chromap,
# star), optional controls (with_control), merged-library and merged-replicate
# branches (MACS2 broad/narrow peaks, HOMER annotation, consensus peaks,
# featureCounts, DESeq2 QC), ataqv, IGV session and MultiQC.
# Not ported (rejected at start-up): iGenomes (`genome`), a .tar.gz chromap
# index (nf-core 2.1.2 itself fails on it: UNTAR.out is undefined).
# Not produced: Nextflow run metadata (pipeline_info execution reports, software
# versions YAML from CUSTOM_DUMPSOFTWAREVERSIONS, MultiQC workflow summary /
# versions / methods sections).
# Changed: PRESEQ_LCEXTRAP has errorStrategy 'ignore' in nf-core; here a preseq
# failure fails the run (skip_preseq is true by default, as in nf-core).
#
# Rules run in shadow directories with their inputs linked under the file names
# Nextflow stages, so file names embedded in outputs (BAM @PG lines, samtools
# stats, MACS2 .xls, featureCounts columns, HOMER headers, ataqv JSON) match
# nf-core.
#
# Run:  snakemake --cores N --sdm apptainer
# =============================================================================

import json
import os
import re
import sys
import tempfile
import urllib.request
from collections import OrderedDict

configfile: "config/config.yaml"
configfile: "config/containers.yaml"

SCRIPTS = os.path.join(workflow.basedir, "scripts")
ASSETS = os.path.join(workflow.basedir, "assets")
sys.path.insert(0, SCRIPTS)
from atacseq_utils import (  # noqa: E402
    read_validated_samplesheet,
    strip_rep,
    strip_run,
    trimgalore_reads_after_filtering,
)
import check_samplesheet  # noqa: E402

O = config["outdir"].rstrip("/")
W = config["workdir"].rstrip("/")

# nextflow.config env{} and process.shell (bash -e -u -o pipefail).
# HPC hosts (Lmod) export a `which` shell function that leaks into containers
# and breaks `which` there; drop it.
shell.prefix(
    "set -euo pipefail; unset -f which 2>/dev/null || true; export PYTHONNOUSERSITE=1 R_PROFILE_USER=/.Rprofile "
    "R_ENVIRON_USER=/.Renviron JULIA_DEPOT_PATH=/usr/local/share/julia "
    "MPLCONFIGDIR=${{TMPDIR:-/tmp}}/mplcfg; "
)


# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
def container_path(key):
    path = config["containers"][key]
    return path if os.path.isabs(path) else os.path.join(workflow.basedir, path)


def asset_path(path):
    if os.path.isabs(path) or os.path.exists(path):
        return path
    return os.path.join(workflow.basedir, path)


def res(label):
    return config["resources"][label]


def flag(key):
    return bool(config.get(key))


def param(key):
    """A nf-core param that defaults to null ("" or missing here -> None)."""
    value = config.get(key)
    return None if value in ("", None) else value


def gt0(key):
    """Groovy `params.x > 0` with a null param."""
    value = param(key)
    return value is not None and float(value) > 0


def args(key):
    return config["args"][key]


def join_args(parts):
    return " ".join(parts).strip()


def picard_mem(resources):
    """avail_mem = (task.memory.mega * 0.8).intValue()"""
    return int(resources.mem_mb * 0.8)


def is_url(path):
    return str(path).startswith(("http://", "https://", "ftp://"))


def basename_noext(path):
    """Nextflow Path.baseName: file name without its last extension."""
    return os.path.splitext(os.path.basename(path))[0]


def simple_name(path):
    """Nextflow Path.simpleName: file name up to the first dot."""
    return os.path.basename(path).split(".")[0]


def alternation(names):
    names = list(names)
    return "|".join(re.escape(n) for n in names) if names else "(?!x)x"


# Remote inputs (FASTQ / reference URLs) are staged into {W}/inputs/ by
# fetch_remote, the equivalent of Nextflow's automatic staging of remote files.
REMOTE = {}


def stage(path):
    if not path or not is_url(path):
        return path
    name = os.path.basename(path)
    if REMOTE.get(name, path) != path:
        raise ValueError(f"Two remote inputs share the file name {name!r}.")
    REMOTE[name] = path
    return f"{W}/inputs/{name}"


def read_text(path):
    if is_url(path):
        with urllib.request.urlopen(path) as fh:
            return fh.read().decode()
    with open(path) as fh:
        return fh.read()


# -----------------------------------------------------------------------------
# Parameter validation (WorkflowAtacseq.initialise)
# -----------------------------------------------------------------------------
ALIGNER = config["aligner"]
if ALIGNER not in ("bwa", "bowtie2", "chromap", "star"):
    raise ValueError(f"aligner must be bwa, bowtie2, chromap or star (got {ALIGNER!r}).")
if param("genome"):
    raise ValueError("iGenomes (`genome`) is not ported to snk-atacseq; give `fasta` and `gtf` explicitly.")
if not param("fasta"):
    raise ValueError("`fasta` is required.")
if not param("gtf") and not param("gff"):
    raise ValueError("No GTF or GFF3 annotation specified (`gtf` or `gff`).")
if not param("macs_gsize") and not param("read_length"):
    raise ValueError("Both `read_length` and `macs_gsize` are empty; give one to set the MACS2 genome size.")
if param("chromap_index") and str(config["chromap_index"]).endswith(".tar.gz"):
    raise ValueError("A .tar.gz chromap index is not ported (nf-core 2.1.2 fails on it too); give the .index file.")

WITH_CONTROL = flag("with_control")
NARROW = flag("narrow_peak")
PEAK_TYPE = "narrow_peak" if NARROW else "broad_peak"
PEAK_EXT = "narrowPeak" if NARROW else "broadPeak"
SAVE_REF = flag("save_reference")
SAVE_ALIGN = flag("save_align_intermeds")
SAVE_UNALIGNED = flag("save_unaligned")
SKIP_TRIM = flag("skip_trimming")
SKIP_FASTQC = flag("skip_fastqc") or flag("skip_qc")
SKIP_ANNOT = flag("skip_peak_annotation")
SKIP_MERGE_REP = flag("skip_merge_replicates")
# workflows/atacseq.nf: ataqv_mito_reference falls back to mito_name
ATAQV_MITO = param("ataqv_mito_reference") or param("mito_name") or ""

GENOME_DIR = f"{O}/genome" if SAVE_REF else f"{W}/genome"
INDEX_DIR = f"{O}/genome/index" if SAVE_REF else f"{W}/genome/index"
AL = f"{O}/{ALIGNER}"
ML = f"{AL}/merged_library"
MR = f"{AL}/merged_replicate"
LIB_DIR = f"{AL}/library" if SAVE_ALIGN else f"{W}/{ALIGNER}/library"
MRG_DIR = ML if SAVE_ALIGN else f"{W}/{ALIGNER}/merged_library"
MRP_DIR = MR if SAVE_ALIGN else f"{W}/{ALIGNER}/merged_replicate"
TRIM_DIR = f"{O}/trimgalore" if flag("save_trimmed") else f"{W}/trimgalore"

# The two branches that call peaks: merged library (mLb) and merged replicate (mRp).
KINDS = {
    "library": {"lvl": "mLb", "dir": ML},
    "replicate": {"lvl": "mRp", "dir": MR},
}
for _k in KINDS.values():
    _k["macs"] = f"{_k['dir']}/macs2/{PEAK_TYPE}"

# -----------------------------------------------------------------------------
# Reference files (PREPARE_GENOME)
# -----------------------------------------------------------------------------
GUNZIP_SRC = {}  # GUNZIP_*: output name in GENOME_DIR -> .gz source


def gunzipped(path):
    """Return the path a reference ends up at after (optional) GUNZIP."""
    path = stage(path)
    if not path.endswith(".gz"):
        return path
    name = os.path.basename(path)[:-3]
    GUNZIP_SRC[name] = path
    return f"{GENOME_DIR}/{name}"


FASTA = gunzipped(config["fasta"])
FASTA_NAME = os.path.basename(FASTA)
FAI = f"{GENOME_DIR}/{FASTA_NAME}.fai"      # CUSTOM_GETCHROMSIZES
SIZES = f"{GENOME_DIR}/{FASTA_NAME}.sizes"
AUTOSOMES = f"{GENOME_DIR}/{FASTA_NAME}.autosomes.txt"  # GET_AUTOSOMES: ${fai.baseName}.autosomes.txt

if param("gtf"):
    GTF = gunzipped(config["gtf"])
    GFF = None
else:
    GFF = gunzipped(config["gff"])
    GTF = f"{GENOME_DIR}/{basename_noext(GFF)}.gtf"  # GFFREAD prefix: ${gff.baseName}
GTF_NAME = os.path.basename(GTF)
GFF_NAME = os.path.basename(GFF) if GFF else ""

BLACKLIST = gunzipped(config["blacklist"]) if param("blacklist") else None
GENE_BED = gunzipped(config["gene_bed"]) if param("gene_bed") else f"{GENOME_DIR}/{basename_noext(GTF)}.bed"
GENE_BED_NAME = os.path.basename(GENE_BED)
TSS_BED = gunzipped(config["tss_bed"]) if param("tss_bed") else f"{GENOME_DIR}/{basename_noext(GENE_BED)}.tss.bed"
TSS_BED_NAME = os.path.basename(TSS_BED)
FILTERED_BED = f"{GENOME_DIR}/{simple_name(SIZES)}.include_regions.bed"

# Indices: provided directory/file, .tar.gz (UNTAR_*), or built.
UNTAR_SRC = {}  # UNTAR_*: output name in INDEX_DIR -> .tar.gz source


def index_path(key, built):
    value = param(key)
    if not value:
        return built
    value = stage(value)
    if value.endswith(".tar.gz"):
        name = os.path.basename(value)[: -len(".tar.gz")]
        UNTAR_SRC[name] = value
        return f"{INDEX_DIR}/{name}"
    return value


CHROMAP_INDEX = f"{O}/genome/chromap/index/{basename_noext(FASTA)}.index"
INDEX = {
    "bwa": lambda: index_path("bwa_index", f"{INDEX_DIR}/bwa"),
    "bowtie2": lambda: index_path("bowtie2_index", f"{INDEX_DIR}/bowtie2"),
    # CHROMAP_INDEX publishes to genome/chromap/index regardless of save_reference
    "chromap": lambda: index_path("chromap_index", CHROMAP_INDEX),
    "star": lambda: index_path("star_index", f"{INDEX_DIR}/star"),
}[ALIGNER]()

# -----------------------------------------------------------------------------
# Samplesheet (SAMPLESHEET_CHECK + INPUT_CHECK)
# -----------------------------------------------------------------------------
# bin/check_samplesheet.py is run here to derive the library ids
# (<sample>_REP<n>_T<m>) the DAG needs; the samplesheet_check rule runs it again
# in its container to publish samplesheet.valid.csv.
INPUT = stage(config["input"]) if is_url(config["input"]) else config["input"]
with tempfile.TemporaryDirectory() as _tmp:
    _raw = os.path.join(_tmp, "samplesheet.csv")
    with open(_raw, "w") as fh:
        fh.write(read_text(config["input"]))
    _valid = os.path.join(_tmp, "samplesheet.valid.csv")
    _cwd = os.getcwd()
    os.chdir(_tmp)  # the script's make_dir() fails on an existing output directory
    try:
        check_samplesheet.check_samplesheet(_raw, "samplesheet.valid.csv", WITH_CONTROL)
    except SystemExit as e:
        raise ValueError(f"Samplesheet check failed for {config['input']} (see message above).") from e
    finally:
        os.chdir(_cwd)
    _libs = read_validated_samplesheet(_valid, param("seq_center") or "")

LIBS = OrderedDict()     # library id (..._T<m>) -> meta
SAMPLES = OrderedDict()  # merged library id (..._REP<n>) -> meta
for lib in _libs:
    fq = [stage(lib.pop("fastq_1"))]
    fq2 = lib.pop("fastq_2")
    if not lib["single_end"]:
        fq.append(stage(fq2))
    LIBS[lib["id"]] = dict(lib, reads=fq)
    sid = strip_run(lib["id"])
    meta = SAMPLES.setdefault(sid, {"single_end": lib["single_end"], "control": lib["control"], "libs": []})
    meta["libs"].append(lib["id"])

GROUP_IDS = list(OrderedDict.fromkeys(strip_rep(s) for s in SAMPLES))  # possible merged-replicate ids
PE_LIBS = [l for l in LIBS if not LIBS[l]["single_end"]]
SE_LIBS = [l for l in LIBS if LIBS[l]["single_end"]]
PE_SAMPLES = [s for s in SAMPLES if not SAMPLES[s]["single_end"]]
SE_SAMPLES = [s for s in SAMPLES if SAMPLES[s]["single_end"]]

wildcard_constraints:
    lib=alternation(LIBS),
    pe_lib=alternation(PE_LIBS),
    se_lib=alternation(SE_LIBS),
    sample=alternation(SAMPLES),
    pe_sample=alternation(PE_SAMPLES),
    se_sample=alternation(SE_SAMPLES),
    group=alternation(GROUP_IDS),
    id=alternation(list(SAMPLES) + GROUP_IDS),
    kind="library|replicate",
    lvl="mLb|mRp",


def mates(lib):
    return [""] if LIBS[lib]["single_end"] else ["_1", "_2"]


def check_kind(wc):
    if KINDS[wc.kind]["lvl"] != wc.lvl:
        raise ValueError(f"{wc.lvl} files do not belong to merged_{wc.kind}.")


# -----------------------------------------------------------------------------
# Per-library / per-sample status written by checkpoints (Groovy logic in nf-core)
# -----------------------------------------------------------------------------
TRIM_SUMMARY = f"{W}/status/trim_summary.json"


def _summary(cp, **kw):
    with open(cp.get(**kw).output[0]) as fh:
        return json.load(fh)


def lib_pass(lib):
    """FASTQ_FASTQC_UMITOOLS_TRIMGALORE: reads after trimming >= min_trimmed_reads."""
    return SKIP_TRIM or _summary(checkpoints.trim_summary)[lib]["pass"]


def sample_libs(s):
    return [l for l in SAMPLES[s]["libs"] if lib_pass(l)]


def libs_ok():
    return [l for l in LIBS if lib_pass(l)]


def samples_ok():
    """Merged libraries with at least one library left after trimming."""
    return [s for s in SAMPLES if sample_libs(s)]


def is_control(meta):
    return WITH_CONTROL and not meta["control"]


def ip_samples():
    """ch_bam_library: all merged libraries, or (with_control) those whose control made it through."""
    ok = samples_ok()
    if not WITH_CONTROL:
        return ok
    controls = {s for s in ok if not SAMPLES[s]["control"]}
    return [s for s in ok if SAMPLES[s]["control"] in controls]


def rep_groups():
    """ch_merged_library_replicate_bam: replicates grouped by id - _REP<n>, kept when > 1."""
    if SKIP_MERGE_REP:
        return OrderedDict()
    groups = OrderedDict()
    for s in samples_ok():
        groups.setdefault(strip_rep(s), []).append(s)
    out = OrderedDict()
    for g, members in groups.items():
        if len(members) > 1:
            first = SAMPLES[members[0]]  # metas[0]
            out[g] = {"samples": members, "single_end": first["single_end"],
                      "control": strip_rep(first["control"]) if first["control"] else ""}
    return out


def ip_groups():
    """ch_bam_replicate: merged replicates, or (with_control) those whose control was merged too."""
    groups = rep_groups()
    if not WITH_CONTROL:
        return list(groups)
    controls = {g for g, m in groups.items() if not m["control"]}
    return [g for g, m in groups.items() if m["control"] in controls]


def meta(kind, id):
    return SAMPLES[id] if kind == "library" else rep_groups()[id]


def callers(kind):
    return ip_samples() if kind == "library" else ip_groups()


def peak_ids(kind):
    """BAM_PEAKS_CALL_QC_ANNOTATE_MACS2_HOMER: peaks.size() > 0."""
    ids = callers(kind)
    if not ids:
        return []
    sizes = _summary(checkpoints.peak_summary, kind=kind)
    return [i for i in ids if sizes[i] > 0]


def consensus_kinds():
    """MACS2_CONSENSUS runs when more than one peak file is collected."""
    if flag("skip_consensus_peaks"):
        return []
    kinds = ["library"] + ([] if SKIP_MERGE_REP else ["replicate"])
    return [k for k in kinds if len(peak_ids(k)) > 1]


def deseq2_kinds():
    return [] if flag("skip_deseq2_qc") else consensus_kinds()


# -----------------------------------------------------------------------------
# File names
# -----------------------------------------------------------------------------
def raw_reads(lib):
    return LIBS[lib]["reads"]


def trimmed_reads(lib):
    if SKIP_TRIM:
        return raw_reads(lib)
    if LIBS[lib]["single_end"]:
        return [f"{TRIM_DIR}/{lib}_trimmed.fq.gz"]
    return [f"{TRIM_DIR}/{lib}_1_val_1.fq.gz", f"{TRIM_DIR}/{lib}_2_val_2.fq.gz"]


def trim_logs(lib):
    if LIBS[lib]["single_end"]:
        return [f"{O}/trimgalore/logs/{lib}.fastq.gz_trimming_report.txt"]
    return [f"{O}/trimgalore/logs/{lib}_{r}.fastq.gz_trimming_report.txt" for r in (1, 2)]


def trim_fastqc(lib, ext):
    sub = "fastqc" if ext == "html" else "fastqc/zips"
    if LIBS[lib]["single_end"]:
        return [f"{O}/trimgalore/{sub}/{lib}_trimmed_fastqc.{ext}"]
    return [f"{O}/trimgalore/{sub}/{lib}_{r}_val_{r}_fastqc.{ext}" for r in (1, 2)]


def raw_fastqc(lib, ext):
    sub = "fastqc" if ext == "html" else "fastqc/zips"
    return [f"{O}/{sub}/{lib}{m}_fastqc.{ext}" for m in mates(lib)]


def lib_bam(lib):
    return f"{LIB_DIR}/{lib}.Lb.sorted.bam"


def mkd_bam(s):
    return f"{MRG_DIR}/{s}.mLb.mkD.sorted.bam"


def clean_bam(s):
    return f"{ML}/{s}.mLb.clN.sorted.bam"


def rep_bam(g):
    return f"{MR}/{g}.mRp.clN.sorted.bam"


def final_bam(kind, id):
    return clean_bam(id) if kind == "library" else rep_bam(id)


# Where each BAM lives and where its samtools stats are published.
BAM_SUFFIX = {  # suffix -> (BAM directory, stats directory)
    ".Lb.sorted.bam": (LIB_DIR, LIB_DIR),
    ".mLb.mkD.sorted.bam": (MRG_DIR, ML),
    ".mLb.clN.sorted.bam": (ML, ML),
    ".mRp.clN.sorted.bam": (MR, MR),
}
STAT_BAM = r"[^/]+(?:" + "|".join(re.escape(s) for s in BAM_SUFFIX) + ")"
BAM_DIRS = sorted({d for d, _ in BAM_SUFFIX.values()})
STATS_DIRS = sorted({d for _, d in BAM_SUFFIX.values()})


def bam_location(name):
    for suffix, (bdir, _) in BAM_SUFFIX.items():
        if name.endswith(suffix):
            return f"{bdir}/{name}"
    raise ValueError(name)


def stats_files(bam):
    name = os.path.basename(bam)
    sdir = next(s for suf, (_, s) in BAM_SUFFIX.items() if name.endswith(suf))
    return [f"{sdir}/samtools_stats/{name}.{x}" for x in ("stats", "flagstat", "idxstats")]


def bigwig(kind, id):
    k = KINDS[kind]
    return f"{k['dir']}/bigwig/{id}.{k['lvl']}.clN.bigWig"


def peak_file(kind, id):
    k = KINDS[kind]
    return f"{k['macs']}/{id}.{k['lvl']}.clN_peaks.{PEAK_EXT}"


def consensus_prefix(kind):
    k = KINDS[kind]
    return f"{k['macs']}/consensus/consensus_peaks.{k['lvl']}.clN"


CMM_METRICS = ["alignment_summary_metrics", "base_distribution_by_cycle_metrics",
               "quality_by_cycle_metrics", "quality_distribution_metrics"]


def cmm_metrics(s):
    names = CMM_METRICS + ([] if SAMPLES[s]["single_end"] else ["insert_size_metrics"])
    return [f"{ML}/picard_metrics/{s}.mLb.clN.CollectMultipleMetrics.{m}" for m in names]


def macs2_outputs(kind, id):
    k = KINDS[kind]
    p = f"{k['macs']}/{id}.{k['lvl']}.clN"
    out = {"peak": f"{p}_peaks.{PEAK_EXT}", "xls": f"{p}_peaks.xls"}
    if NARROW:
        out["summits"] = f"{p}_summits.bed"
    else:
        out["gapped"] = f"{p}_peaks.gappedPeak"
    if flag("save_macs_pileup"):
        out["treat_bdg"] = f"{p}_treat_pileup.bdg"
        out["control_bdg"] = f"{p}_control_lambda.bdg"
    return out


def macs2_output_patterns():
    """macs2_outputs() with {kind}/{id}/{lvl} wildcards (rule output)."""
    p = f"{AL}/merged_{{kind}}/macs2/{PEAK_TYPE}/{{id}}.{{lvl}}.clN"
    out = {"peak": f"{p}_peaks.{PEAK_EXT}", "xls": f"{p}_peaks.xls"}
    if NARROW:
        out["summits"] = f"{p}_summits.bed"
    else:
        out["gapped"] = f"{p}_peaks.gappedPeak"
    if flag("save_macs_pileup"):
        out["treat_bdg"] = f"{p}_treat_pileup.bdg"
        out["control_bdg"] = f"{p}_control_lambda.bdg"
    return out


DT_PROFILE = f"{ML}/deeptools/plotprofile/{{sample}}.mLb.clN"
DT_FINGERPRINT = f"{ML}/deeptools/plotfingerprint/{{sample}}.mLb.clN.plotFingerprint"
ATAQV_DIR = f"{ML}/ataqv/{PEAK_TYPE}"


# -----------------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------------
def genome_outputs():
    out = [f"{O}/pipeline_info/samplesheet.valid.csv"]
    if not flag("skip_igv"):
        out += [f"{O}/genome/{FASTA_NAME}", f"{O}/genome/{FASTA_NAME}.fai"]
    if SAVE_REF:
        built = [GTF, GENE_BED, TSS_BED, FAI, SIZES, AUTOSOMES, FILTERED_BED, INDEX]
        built += [f"{GENOME_DIR}/{n}" for n in GUNZIP_SRC]
        out += [f for f in built if f.startswith(f"{O}/")]
    if ALIGNER == "chromap" and not param("chromap_index"):
        out.append(INDEX)
    return list(OrderedDict.fromkeys(out))


def library_outputs(lib):
    out = []
    if not SKIP_FASTQC:
        out += raw_fastqc(lib, "html") + raw_fastqc(lib, "zip")
    if not SKIP_TRIM:
        out += trim_logs(lib) + trim_fastqc(lib, "html") + trim_fastqc(lib, "zip")
    return out


def aligned_library_outputs(lib):
    out = []
    if flag("save_trimmed") and not SKIP_TRIM:
        out += trimmed_reads(lib)
    if ALIGNER == "star":
        out += [f"{AL}/library/log/{lib}.{x}" for x in ("Log.final.out", "Log.out", "Log.progress.out", "SJ.out.tab")]
    if SAVE_ALIGN:
        out += [lib_bam(lib), f"{lib_bam(lib)}.bai"] + stats_files(lib_bam(lib))
    return out


def sample_outputs(s):
    pe = not SAMPLES[s]["single_end"]
    out = [f"{ML}/picard_metrics/{s}.mLb.mkD.sorted.MarkDuplicates.metrics.txt"]
    out += stats_files(mkd_bam(s))
    out += [clean_bam(s), f"{clean_bam(s)}.bai"] + stats_files(clean_bam(s))
    if SAVE_ALIGN:
        out += [f"{MRG_DIR}/{s}.mLb.sorted.bam", mkd_bam(s), f"{mkd_bam(s)}.bai"]
        if pe:
            out += [f"{MRG_DIR}/{s}.mLb.flT.sorted.bam", f"{MRG_DIR}/{s}.mLb.flT.name_sorted.bam",
                    f"{MRG_DIR}/{s}.mLb.clN.bam"]
    if not flag("skip_preseq"):
        out += [f"{ML}/preseq/{s}.mLb.mkD.lc_extrap.txt", f"{ML}/preseq/{s}.mLb.mkD.command.log"]
    if not flag("skip_picard_metrics"):
        out += cmm_metrics(s)
    out += [bigwig("library", s), f"{ML}/bigwig/scale/{s}.mLb.clN.scale_factor.txt"]
    if not flag("skip_plot_profile"):
        p = DT_PROFILE.format(sample=s)
        out += [f"{p}.{m}.computeMatrix.{x}" for m in ("scale_regions", "reference_point")
                for x in ("mat.gz", "vals.mat.tab")]
        out += [f"{p}.reference_point.plotProfile.{x}" for x in ("pdf", "tab")]
        out += [f"{p}.scale_regions.plotHeatmap.{x}" for x in ("pdf", "mat.tab")]
    return out


def ip_outputs(s):
    out = []
    if not flag("skip_plot_fingerprint"):
        p = DT_FINGERPRINT.format(sample=s)
        out += [f"{p}.{x}" for x in ("pdf", "raw.txt", "qcmetrics.txt")]
    return out


def group_outputs(g):
    out = [f"{MR}/picard_metrics/{g}.mRp.clN.sorted.MarkDuplicates.metrics.txt"]
    out += [rep_bam(g), f"{rep_bam(g)}.bai"] + stats_files(rep_bam(g))
    if SAVE_ALIGN:
        out.append(f"{MRP_DIR}/{g}.mRp.sorted.bam")
    out += [bigwig("replicate", g), f"{MR}/bigwig/scale/{g}.mRp.clN.scale_factor.txt"]
    return out


def peak_outputs(kind, id):
    k = KINDS[kind]
    p = f"{id}.{k['lvl']}.clN_peaks"
    out = [f"{k['macs']}/qc/{p}.count_mqc.tsv", f"{k['macs']}/qc/{p}.FRiP_mqc.tsv"]
    if not SKIP_ANNOT:
        out.append(f"{k['macs']}/{p}.annotatePeaks.txt")
    return out


def peak_qc_outputs(kind):
    k = KINDS[kind]
    q = f"{k['macs']}/qc"
    out = [f"{q}/macs2_peak.{k['lvl']}.clN.{x}" for x in ("summary.txt", "plots.pdf")]
    out += [f"{q}/macs2_annotatePeaks.{k['lvl']}.clN.{x}" for x in ("summary.txt", "plots.pdf", "summary_mqc.tsv")]
    return out


def deseq2_names(kind):
    p = f"consensus_peaks.{KINDS[kind]['lvl']}.clN"
    return [f"{p}.{x}" for x in ("dds.RData", "rds", "plots.pdf", "pca.vals.txt", "pca.vals_mqc.tsv",
                                 "sample.dists.txt", "sample.dists_mqc.tsv")] + ["R_sessionInfo.log", "size_factors"]


def consensus_outputs(kind):
    p = consensus_prefix(kind)
    out = [f"{p}.{x}" for x in ("bed", "saf", "boolean.txt", "boolean.intersect.txt",
                                 "boolean.intersect.plot.pdf", "featureCounts.txt",
                                 "featureCounts.txt.summary")]
    if not SKIP_ANNOT:
        out.append(f"{p}.annotatePeaks.txt")
    if kind in deseq2_kinds():
        out += [f"{os.path.dirname(p)}/deseq2/{x}" for x in deseq2_names(kind)]
    return out


def all_outputs(wc):
    out = genome_outputs()
    for lib in LIBS:
        out += library_outputs(lib)
    for lib in libs_ok():
        out += aligned_library_outputs(lib)
    for s in samples_ok():
        out += sample_outputs(s)
    for s in ip_samples():
        out += ip_outputs(s)
        out += list(macs2_outputs("library", s).values())
    for g in rep_groups():
        out += group_outputs(g)
    for g in ip_groups():
        out += list(macs2_outputs("replicate", g).values())
    for kind in KINDS:
        if kind == "replicate" and SKIP_MERGE_REP:
            continue
        ids = peak_ids(kind)
        for i in ids:
            out += peak_outputs(kind, i)
        if ids and not SKIP_ANNOT and not flag("skip_peak_qc"):
            out += peak_qc_outputs(kind)
    for kind in consensus_kinds():
        out += consensus_outputs(kind)
    if not flag("skip_ataqv") and peak_ids("library"):
        out += [f"{ATAQV_DIR}/{s}.ataqv.json" for s in peak_ids("library")]
        out.append(f"{ATAQV_DIR}/html")
    if not flag("skip_igv"):
        out += [f"{O}/igv/{PEAK_TYPE}/igv_session.xml", f"{O}/igv/{PEAK_TYPE}/igv_files.txt"]
    if not flag("skip_multiqc"):
        out.append(f"{O}/multiqc/{PEAK_TYPE}/multiqc_report.html")
    return out


rule all:
    input:
        all_outputs,


localrules:
    all,
    fetch_remote,
    trim_status,
    trim_summary,
    peak_summary,


