# =============================================================================
# BED_CONSENSUS_QUANTIFY_QC_BEDTOOLS_FEATURECOUNTS_DESEQ2
# =============================================================================
CONSENSUS = f"{MACS_K}/consensus/consensus_peaks.{{lvl}}.clN"


def consensus_peak_inputs(wc):
    check_kind(wc)
    return sorted((peak_file(wc.kind, i) for i in peak_ids(wc.kind)), key=os.path.basename)


# MACS2_CONSENSUS (merged-replicate consensus has no --min_replicates in modules.config)
rule macs2_consensus:
    input:
        peaks=consensus_peak_inputs,
        status=lambda wc: [TRIM_SUMMARY, f"{W}/status/peak_summary_{wc.kind}.json"],  # read by params
    output:
        bed=f"{CONSENSUS}.bed",
        saf=f"{CONSENSUS}.saf",
        boolean=f"{CONSENSUS}.boolean.txt",
        intersect=f"{CONSENSUS}.boolean.intersect.txt",
        pdf=f"{CONSENSUS}.boolean.intersect.plot.pdf",
        txt=f"{W}/consensus/{{kind}}/consensus_peaks.{{lvl}}.clN.txt",
    params:
        prefix=lambda wc: f"consensus_peaks.{wc.lvl}.clN",
        args=lambda wc: f"--min_replicates {config['min_reps_consensus']}" if wc.kind == "library" else "",
        mergecols=",".join(str(i) for i in range(2, 11 if NARROW else 10)),
        collapsecols=",".join(["collapse"] * (9 if NARROW else 8)),
        files=lambda wc: " ".join(os.path.basename(f) for f in consensus_peak_inputs(wc)),
        names=lambda wc: ",".join(os.path.basename(f) for f in consensus_peak_inputs(wc)).replace(f"_peaks.{PEAK_EXT}", ""),
        narrow="--is_narrow_peak" if NARROW else "",
    container:
        container_path("consensus")
    threads: res("process_default")["threads"]
    resources:
        mem_mb=res("process_default")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.peaks}; do ln -s $(realpath $f) $(basename $f); done
        p={params.prefix}
        sort -T '.' -k1,1 -k2,2n {params.files} \
            | mergeBed -c {params.mergecols} -o {params.collapsecols} > $p.txt
        python {SCRIPTS}/macs2_merged_expand.py $p.txt {params.names} $p.boolean.txt {params.args} {params.narrow}
        awk -v FS='\\t' -v OFS='\\t' 'FNR > 1 {{ print $1, $2, $3, $4, "0", "+" }}' $p.boolean.txt > $p.bed
        echo -e "GeneID\\tChr\\tStart\\tEnd\\tStrand" > $p.saf
        awk -v FS='\\t' -v OFS='\\t' 'FNR > 1 {{ print $4, $1, $2, $3,  "+" }}' $p.boolean.txt >> $p.saf
        Rscript {SCRIPTS}/plot_peak_intersect.r -i $p.boolean.intersect.txt -o $p.boolean.intersect.plot.pdf
        mv $p.bed {output.bed}
        mv $p.saf {output.saf}
        mv $p.boolean.txt {output.boolean}
        mv $p.boolean.intersect.txt {output.intersect}
        mv $p.boolean.intersect.plot.pdf {output.pdf}
        mv $p.txt {output.txt}
        """


# BED_CONSENSUS_...:HOMER_ANNOTATEPEAKS (prefix consensus_peaks.<mLb|mRp>.clN)
rule homer_annotatepeaks_consensus:
    input:
        peak=f"{CONSENSUS}.bed",
