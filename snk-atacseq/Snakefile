        files=lambda wc: ",".join(os.path.basename(f) for f in collected_peaks(wc)),
        names=lambda wc: ",".join(os.path.basename(f) for f in collected_peaks(wc)).replace(f"_peaks.{PEAK_EXT}", ""),
    container:
