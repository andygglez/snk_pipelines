# CUSTOM_GETCHROMSIZES
rule custom_getchromsizes:
    input:
        FASTA,
    output:
        fai=FAI,
        sizes=SIZES,
    container:
        container_path("samtools")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input}) {FASTA_NAME}
        samtools faidx {FASTA_NAME}
        cut -f 1,2 {FASTA_NAME}.fai > {FASTA_NAME}.sizes
        mv {FASTA_NAME}.fai {output.fai}
        mv {FASTA_NAME}.sizes {output.sizes}
        """


# GENOME_BLACKLIST_REGIONS
rule genome_blacklist_regions:
    input:
        sizes=SIZES,
        blacklist=BLACKLIST or [],
    output:
        FILTERED_BED,
    container:
        container_path("bedtools")
    threads: res("process_default")["threads"]
    resources:
        mem_mb=res("process_default")["mem_mb"],
    shell:
        """
        if [ -n "{input.blacklist}" ]; then
            sortBed -i {input.blacklist} -g {input.sizes} | complementBed -i stdin -g {input.sizes} > {output}
        else
            awk '{{print $1, '0' , $2}}' OFS='\\t' {input.sizes} > {output}
        fi
        """


# UNTAR_BWA_INDEX / UNTAR_BOWTIE2_INDEX / UNTAR_STAR_INDEX
rule untar:
    input:
        lambda wc: UNTAR_SRC[wc.name],
    output:
        directory(f"{INDEX_DIR}/{{name}}"),
    wildcard_constraints:
        name=alternation(UNTAR_SRC),
    container:
        container_path("ubuntu22")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        mkdir -p {output}
        if [[ $(tar -taf {input} | grep -o -P "^.*?\\/" | uniq | wc -l) -eq 1 ]]; then
            tar -C {output} --strip-components 1 -xavf {input} --no-same-owner
        else
            tar -C {output} -xavf {input} --no-same-owner
        fi
        """


