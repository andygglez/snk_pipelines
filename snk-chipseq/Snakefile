# =============================================================================
# snk-chipseq — Snakemake port of nf-core/chipseq 2.1.0
#
# Every rule mirrors one nf-core process (named in the comment above each rule)
# and runs inside the same Singularity image the nf-core module uses
# (see config/containers.yaml). nf-core bin/ scripts live in scripts/. Published
# files follow the nf-core publishDir layout under `outdir`; files nf-core keeps
# only in its work/ directory go to `workdir`.
#
# Ported: the whole workflow, with all four aligners (bwa, bowtie2, chromap,
# star), MACS3 broad/narrow peaks, HOMER annotation, consensus peaks,
# featureCounts, DESeq2 QC, IGV session and MultiQC.
# Not produced: Nextflow run metadata (pipeline_info execution reports, MultiQC
# workflow summary section). Software versions are collected by software_versions.
# Port extensions (port-format samplesheets only, no nf-core counterpart):
# replicate/sample bigWigs, per-protein heatmaps, scale-factor bar plots and
# chipbinner (padilr1/ChIPbinner port on the final BAMs; section "chipbinner").
#
# Rules run in shadow directories with their inputs linked under the file names
# Nextflow stages, so file names embedded in outputs (BAM @PG lines, samtools
# stats, MACS3 .xls, featureCounts columns, HOMER headers) match nf-core.
#
# Run:  snakemake --cores N --sdm apptainer
# =============================================================================

import csv
