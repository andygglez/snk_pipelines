# STAR_GENOMEGENERATE (local module; --genomeSAindexNbases from genome size)
rule star_genomegenerate:
    input:
        fasta=FASTA,
        gtf=GTF,
    output:
        directory(f"{INDEX_DIR}/star"),
    params:
        memory=lambda wc, resources: resources.mem_mb * 1024 * 1024 - 100000000,
    container:
        container_path("star_genomegenerate")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.fasta}) {FASTA_NAME}
        ln -s $(realpath {input.gtf}) {GTF_NAME}
        samtools faidx {FASTA_NAME}
        NUM_BASES=`gawk '{{sum = sum + $2}}END{{if ((log(sum)/log(2))/2 - 1 > 14) {{printf "%.0f", 14}} else {{printf "%.0f", (log(sum)/log(2))/2 - 1}}}}' {FASTA_NAME}.fai`
        mkdir star
        STAR --runMode genomeGenerate --genomeDir star/ --genomeFastaFiles {FASTA_NAME} \
            --sjdbGTFfile {GTF_NAME} --runThreadN {threads} --genomeSAindexNbases $NUM_BASES \
            --limitGenomeGenerateRAM {params.memory}
        mkdir -p $(dirname {output}) && mv star {output}
        """


# =============================================================================
# FASTQ_FASTQC_UMITOOLS_TRIMGALORE (UMI extraction is never enabled by chipseq)
# =============================================================================

# FASTQC (raw reads). The module links reads as ${prefix}.${extension}
# (<id>.gz) or ${prefix}_<n>.${extension} (<id>_1.gz, <id>_2.gz).
rule fastqc_se:
    input:
        lambda wc: raw_reads(wc.se_lib),
    output:
        html=f"{O}/fastqc/{{se_lib}}_fastqc.html",
        zip=f"{O}/fastqc/zips/{{se_lib}}_fastqc.zip",
    params:
        args=args("fastqc"),
        memory=lambda wc, resources: min(10000, max(100, resources.mem_mb)),
        p=lambda wc: wc.se_lib,
    container:
        container_path("fastqc")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input[0]}) {params.p}.gz
        fastqc {params.args} --threads {threads} --memory {params.memory} {params.p}.gz
        mv {params.p}_fastqc.html {output.html}
        mv {params.p}_fastqc.zip {output.zip}
        """


rule fastqc_pe:
    input:
        lambda wc: raw_reads(wc.pe_lib),
    output:
        html1=f"{O}/fastqc/{{pe_lib}}_1_fastqc.html",
        zip1=f"{O}/fastqc/zips/{{pe_lib}}_1_fastqc.zip",
        html2=f"{O}/fastqc/{{pe_lib}}_2_fastqc.html",
        zip2=f"{O}/fastqc/zips/{{pe_lib}}_2_fastqc.zip",
    params:
        args=args("fastqc"),
        memory=lambda wc, resources: min(10000, max(100, resources.mem_mb)),
        p=lambda wc: wc.pe_lib,
    container:
        container_path("fastqc")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input[0]}) {params.p}_1.gz
        ln -s $(realpath {input[1]}) {params.p}_2.gz
        fastqc {params.args} --threads {threads} --memory {params.memory} {params.p}_1.gz {params.p}_2.gz
        mv {params.p}_1_fastqc.html {output.html1}
        mv {params.p}_1_fastqc.zip {output.zip1}
        mv {params.p}_2_fastqc.html {output.html2}
        mv {params.p}_2_fastqc.zip {output.zip2}
        """


def trimgalore_args(single_end):
    """conf/modules.config TRIMGALORE ext.args (+ the module's SE _r2 filter)."""
    parts = [args("trimgalore")]
    if gt0("trim_nextseq"):
        parts.append(f"--nextseq {param('trim_nextseq')}")
    for key in ("clip_r1", "clip_r2", "three_prime_clip_r1", "three_prime_clip_r2"):
        if gt0(key):
            parts.append(f"--{key} {param(key)}")
    joined = join_args(parts)
    if single_end:
        joined = " ".join(a for a in re.split(r"\s(?=--)", joined) if "_r2 " not in a.lower())
    return joined


def trimgalore_cores(threads, single_end):
    cores = threads - (3 if single_end else 4)
    return min(8, max(1, cores))


# TRIMGALORE (paired-end)
rule trimgalore_pe:
    input:
        lambda wc: raw_reads(wc.pe_lib),
    output:
        r1=f"{TRIM_DIR}/{{pe_lib}}_1_val_1.fq.gz",
        r2=f"{TRIM_DIR}/{{pe_lib}}_2_val_2.fq.gz",
        log1=f"{O}/trimgalore/logs/{{pe_lib}}_1.fastq.gz_trimming_report.txt",
        log2=f"{O}/trimgalore/logs/{{pe_lib}}_2.fastq.gz_trimming_report.txt",
        html1=f"{O}/trimgalore/fastqc/{{pe_lib}}_1_val_1_fastqc.html",
        html2=f"{O}/trimgalore/fastqc/{{pe_lib}}_2_val_2_fastqc.html",
        zip1=f"{O}/trimgalore/fastqc/zips/{{pe_lib}}_1_val_1_fastqc.zip",
        zip2=f"{O}/trimgalore/fastqc/zips/{{pe_lib}}_2_val_2_fastqc.zip",
    params:
        args=trimgalore_args(False),
        cores=lambda wc, threads: trimgalore_cores(threads, False),
        p=lambda wc: wc.pe_lib,
    container:
        container_path("trimgalore")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input[0]}) {params.p}_1.fastq.gz
        ln -s $(realpath {input[1]}) {params.p}_2.fastq.gz
        trim_galore {params.args} --cores {params.cores} --paired --gzip \
            {params.p}_1.fastq.gz {params.p}_2.fastq.gz
        mv {params.p}_1_val_1.fq.gz {output.r1}
        mv {params.p}_2_val_2.fq.gz {output.r2}
        mv {params.p}_1.fastq.gz_trimming_report.txt {output.log1}
        mv {params.p}_2.fastq.gz_trimming_report.txt {output.log2}
        mv {params.p}_1_val_1_fastqc.html {output.html1}
        mv {params.p}_2_val_2_fastqc.html {output.html2}
        mv {params.p}_1_val_1_fastqc.zip {output.zip1}
        mv {params.p}_2_val_2_fastqc.zip {output.zip2}
        """


