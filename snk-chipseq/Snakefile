        container_path("ubuntu20")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        cut -f2- {input.homer} | awk 'NR==1; NR > 1 {{print $0 | "sort -T '.' -k1,1 -k2,2n"}}' | cut -f6- > tmp.txt
        paste {input.boolean} tmp.txt > {output}
        """


def antibody_bams(wc):
    """ch_antibody_bams: IP BAMs of the antibody (sorted by file name)."""
    bams = [clean_bam(s) for s in macs_samples() if SAMPLES[s]["antibody"] == wc.antibody]
    return sorted(bams, key=os.path.basename)


# SUBREAD_FEATURECOUNTS (consensus meta has no single_end, so -p is always set)
rule featurecounts:
    input:
        bams=antibody_bams,
        saf=f"{CONSENSUS}.saf",
    output:
        counts=f"{CONSENSUS}.featureCounts.txt",
        summary=f"{CONSENSUS}.featureCounts.txt.summary",
    params:
        args=args("featurecounts"),
        bams=lambda wc, input: " ".join(os.path.basename(f) for f in input.bams),
    container:
        container_path("subread")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bams}; do ln -s $(realpath $f) $(basename $f); done
        ln -s $(realpath {input.saf}) $(basename {input.saf})
        p={wildcards.antibody}.consensus_peaks
        featureCounts {params.args} -p -T {threads} -a $(basename {input.saf}) -s 0 \
            -o $p.featureCounts.txt {params.bams}
        mv $p.featureCounts.txt {output.counts}
        mv $p.featureCounts.txt.summary {output.summary}
        """


def deseq2_names(ab):
    p = f"{ab}.consensus_peaks"
    return [f"{p}.{x}" for x in ("dds.RData", "rds", "plots.pdf", "pca.vals.txt", "pca.vals_mqc.tsv",
                                 "sample.dists.txt", "sample.dists_mqc.tsv")] + ["R_sessionInfo.log", "size_factors"]


# DESEQ2_QC (runs when the antibody has several groups and replicates).
# ${task.index} in the MultiQC section ids is the antibody's 1-based rank.
rule deseq2_qc:
    input:
        counts=f"{CONSENSUS}.featureCounts.txt",
        pca_header=f"{ASSETS}/multiqc/deseq2_pca_header.txt",
        clust_header=f"{ASSETS}/multiqc/deseq2_clustering_header.txt",
        peaks=f"{W}/status/peak_summary.json",  # params.index reads this checkpoint
    output:
        **{f"f{i}": f"{MACS}/consensus/{{antibody}}/deseq2/{n}"
           for i, n in enumerate(deseq2_names("{antibody}")[:-1])},
        size_factors=directory(f"{MACS}/consensus/{{antibody}}/deseq2/size_factors"),
    params:
        # the config keeps the nf-core suffix; port sheets name the BAMs differently
        args=args("deseq2_qc").replace(".mLb.clN.sorted.bam", CLEAN_SUFFIX) + (" --vst TRUE" if flag("deseq2_vst") else ""),
        index=lambda wc: deseq2_antibodies().index(wc.antibody) + 1,
        outdir=f"{MACS}/consensus/{{antibody}}/deseq2",
    container:
        container_path("deseq2")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.counts}) $(basename {input.counts})
        p={wildcards.antibody}.consensus_peaks
        {SCRIPTS}/deseq2_qc.r --count_file $(basename {input.counts}) --outdir ./ --outprefix $p \
            --cores {threads} {params.args}
        sed 's/deseq2_pca/deseq2_pca_{params.index}/g' <{input.pca_header} >tmp.txt
        sed -i -e 's/DESeq2 /{wildcards.antibody} DESeq2 /g' tmp.txt
        cat tmp.txt $p.pca.vals.txt > $p.pca.vals_mqc.tsv
        sed 's/deseq2_clustering/deseq2_clustering_{params.index}/g' <{input.clust_header} >tmp.txt
        sed -i -e 's/DESeq2 /{wildcards.antibody} DESeq2 /g' tmp.txt
        cat tmp.txt $p.sample.dists.txt > $p.sample.dists_mqc.tsv
        mkdir -p {params.outdir}
        for f in $p.dds.RData $p.rds $p.plots.pdf $p.pca.vals.txt $p.pca.vals_mqc.tsv \
                 $p.sample.dists.txt $p.sample.dists_mqc.tsv R_sessionInfo.log size_factors; do
            mv $f {params.outdir}/
        done
        """


# =============================================================================
# IGV session
# =============================================================================
def igv_inputs(wc):
    abs_ = consensus_antibodies()
    return {
        "fasta": FASTA,
        "bigwigs": [bigwig(s) for s in samples_ok()],
        "peaks": [peak_file(s) for s in peak_samples()],
        "consensus": [f"{consensus_prefix(ab)}.bed" for ab in abs_],
        "mappings": [f"{consensus_prefix(ab)}.antibody.txt" for ab in abs_],
    }


IGV_FASTA_OUT = [] if FASTA == f"{O}/genome/{FASTA_NAME}" else [f"{O}/genome/{FASTA_NAME}"]


# IGV (bin/igv_files_to_session.py; also publishes the FASTA to genome/)
rule igv:
    input:
        unpack(igv_inputs),
    output:
        *IGV_FASTA_OUT,
        xml=f"{O}/igv/{PEAK_TYPE}/igv_session.xml",
        txt=f"{O}/igv/{PEAK_TYPE}/igv_files.txt",
    params:
        consensus_dir=f"{ALIGNER}/merged_library/macs3/{PEAK_TYPE}/consensus/*",
        fasta_out=IGV_FASTA_OUT,
    container:
        container_path("python")
    threads: res("process_default")["threads"]
    resources:
        mem_mb=res("process_default")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        d=stage/{ALIGNER}/merged_library
        mkdir -p $d/bigwig $d/macs3/{PEAK_TYPE}/consensus stage/mappings
        ln -s $(realpath {input.fasta}) stage/{FASTA_NAME}
        for f in {input.bigwigs}; do ln -s $(realpath $f) $d/bigwig/$(basename $f); done
        for f in {input.peaks}; do ln -s $(realpath $f) $d/macs3/{PEAK_TYPE}/$(basename $f); done
        for f in {input.consensus}; do ln -s $(realpath $f) $d/macs3/{PEAK_TYPE}/consensus/$(basename $f); done
        for f in {input.mappings}; do ln -s $(realpath $f) stage/mappings/$(basename $f); done
        cd stage
        find * -type l -name "*.{BW}" -exec echo -e ""{{}}"\\t0,0,178" \\; > bigwig.igv.txt
        find * -type l -name "*Peak" -exec echo -e ""{{}}"\\t0,0,178" \\; > peaks.igv.txt
        # Avoid error when consensus not produced
        find * -type l -name "*.bed" -exec echo -e ""{{}}"\\t0,0,178" \\; | {{ grep "^{params.consensus_dir}" || test $? = 1; }} > consensus.igv.txt
        touch replace_paths.txt
        if [ -d "mappings" ]; then
            cat mappings/* > replace_paths.txt
        fi
        cat *.igv.txt > igv_files_orig.txt
        python3 {SCRIPTS}/igv_files_to_session.py igv_session.xml igv_files_orig.txt replace_paths.txt \
            ../../genome/{FASTA_NAME} --path_prefix '../../'
        cd ..
        mv stage/igv_session.xml {output.xml}
        mv stage/igv_files.txt {output.txt}
        for f in {params.fasta_out}; do cp -L {input.fasta} $f; done
        """


# =============================================================================
# MULTIQC (local module: inputs staged into fixed sub-directories)
# =============================================================================
def multiqc_inputs(wc):
    libs = libs_ok()
    samples = samples_ok()
    ips = ip_samples()
    peaks = peak_samples()
    abs_ = consensus_antibodies()
    d = {}
    d["fastqc"] = [] if SKIP_FASTQC else [f for l in LIBS for f in raw_fastqc(l, "zip")]
    d["trimgalore/fastqc"] = [] if SKIP_TRIM else [f for l in LIBS for f in trim_fastqc(l, "zip")]
    d["trimgalore"] = [] if SKIP_TRIM else [f for l in LIBS for f in trim_logs(l)]
    d["alignment/library"] = [f for l in libs for f in stats_files(lib_bam(l))]
    d["alignment/merged_library/unfiltered"] = [f for s in samples for f in stats_files(mkd_bam(s))]
    d["alignment/merged_library/unfiltered/picard_metrics"] = [
        f"{ML}/picard_metrics/{s}.{MKDS}.MarkDuplicates.metrics.txt" for s in samples]
    d["alignment/merged_library/filtered"] = [f for s in samples for f in stats_files(clean_bam(s))]
    d["alignment/merged_library/filtered/picard_metrics"] = (
        [] if flag("skip_picard_metrics") else [f for s in samples for f in cmm_metrics(s)])
    d["preseq"] = [] if flag("skip_preseq") else [f"{ML}/preseq/{s}.{MKDP}.lc_extrap.txt" for s in samples]
    d["deeptools"] = [] if flag("skip_plot_profile") or NEW_SHEET else [
        f"{ML}/deepTools/plotProfile/{s}.{CLNP}.plotProfile.tab" for s in samples]
    if not flag("skip_plot_fingerprint"):
        d["deeptools"] += [f"{ML}/deepTools/plotFingerprint/{s}.{CLNP}.plotFingerprint.raw.txt" for s in ips]
    d["phantompeakqualtools"] = [] if flag("skip_spp") else [
        f"{ML}/phantompeakqualtools/{s}.{x}" for s in samples
        for x in ("spp.out", "spp_nsc_mqc.tsv", "spp_rsc_mqc.tsv", "spp_correlation_mqc.tsv")]
    d["macs3/peaks"] = [f"{MACS}/qc/{s}.{x}" for s in peaks for x in ("FRiP_mqc.tsv", "peak_count_mqc.tsv")]
    d["macs3/annotation"] = ([f"{MACS}/qc/macs3_annotatePeaks.summary_mqc.tsv"]
                             if peaks and not SKIP_ANNOT and not flag("skip_peak_qc") else [])
    d["macs3/featurecounts"] = [f"{consensus_prefix(ab)}.featureCounts.txt.summary" for ab in abs_]
    d["deseq2"] = [f"{MACS}/consensus/{ab}/deseq2/{ab}.consensus_peaks.{x}"
                   for ab in deseq2_antibodies() for x in ("pca.vals_mqc.tsv", "sample.dists_mqc.tsv")]
    return d


def multiqc_files(wc):
    return [f for files in multiqc_inputs(wc).values() for f in files]


def multiqc_stage_cmd(wc):
    """Link every input into its staging sub-directory (path('<dir>/*') inputs)."""
    cmds = []
    for sub, files in multiqc_inputs(wc).items():
        for f in files:
            cmds.append(f"mkdir -p stage/{sub} && ln -s $(realpath {f}) stage/{sub}/{os.path.basename(f)}")
    return "\n".join(cmds)


# =============================================================================
# Software versions (softwareVersionsToYAML + collectFile)
# =============================================================================
# config/versions.yaml maps every nf-core process to the port rules that run it
# and the version commands of its module; each command runs in the image of the
# rule that ran it. Snakemake replaces Nextflow in the Workflow section.
VERSIONS_YML = f"{O}/pipeline_info/nf_core_chipseq_software_mqc_versions.yml"
VERSIONS_MQC = VERSIONS_YML


def versions_inputs(wc):
    """Everything else the run produces, so the DAG is complete when it runs."""
    # every other output, so every job stays in the DAG the rule reads
    # chipbinner (port extension, not reported) does not hold the versions file back
    return [f for f in all_outputs(wc) if f != VERSIONS_YML and not str(f).startswith(f"{O}/multiqc/")
            and not str(f).startswith(f"{CB}/")]


localrules:
    software_versions,


rule software_versions:
    input:
        versions_inputs,
    output:
        yml=VERSIONS_YML,
    run:
        sys.path.insert(0, os.path.join(workflow.basedir, "scripts"))
        from software_versions import collect, dag_jobs, collect_file, styles, version_chunks, workflow_chunk, write_dump, write_topic

        table = os.path.join(workflow.basedir, "config/versions.yaml")
        versions = collect(table, dag_jobs(workflow, input), globals())
        write_topic(versions, "nf-core/chipseq", "v2.1.0", output.yml)


# MULTIQC. nf-core also feeds workflow_summary_mqc.yaml (Nextflow run
# metadata, not produced here).
rule multiqc:
    input:
        files=multiqc_files,
        versions=VERSIONS_MQC,
        config=f"{ASSETS}/multiqc_config.yml",
        extra_config=param("multiqc_config") or [],
    output:
        report=f"{MQC_DIR}/multiqc_report.html",
        data=directory(f"{MQC_DIR}/multiqc_data"),
        plots=directory(f"{MQC_DIR}/multiqc_plots"),
    params:
        title=f"--title \"{config['multiqc_title']}\"" if param("multiqc_title") else "",
        custom=lambda wc, input: f"--config {os.path.abspath(input.extra_config)}" if input.extra_config else "",
        stage=multiqc_stage_cmd,
        # port sheets: section path filters and sample-name cleaning use the port suffixes
        rename=(" ".join(f"-e 's/{a}/{b}/g'" for a, b in (
            (r"\.mLb\.mkD\.sorted\.bam", f".{MKDS}.bam"), (r"\.mLb\.clN\.sorted\.bam", f".{CLNS}.bam"),
            (r'"\.Lb"', '".lib"'), (r'"mkD"', '".markedDup"'), (r'"clN"', '".final"'),
            (r'"mLb"', '".merged_lib"'))) if NEW_SHEET else "-e ''"),
    container:
        container_path("multiqc")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir -p stage
        sed {params.rename} $(realpath {input.config}) > stage/multiqc_config.yml
        {params.stage}
        mkdir -p stage/versions && ln -s $(realpath {input.versions}) stage/versions/
        cd stage
        multiqc -f {params.title} {params.custom} .
        cd ..
        mv stage/multiqc_report.html {output.report}
        mv stage/multiqc_data {output.data}
        mv stage/multiqc_plots {output.plots}
        """
