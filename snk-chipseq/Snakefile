# Not an nf-core process: Nextflow stages remote inputs itself.
rule fetch_remote:
    output:
        f"{W}/inputs/{{fname}}",
    wildcard_constraints:
        fname=alternation(REMOTE),
    params:
        url=lambda wc: REMOTE[wc.fname],
    retries: 2
    run:
        import shutil

        with urllib.request.urlopen(params.url) as src, open(output[0], "wb") as dst:
            shutil.copyfileobj(src, dst)


if not NEW_SHEET:

    # SAMPLESHEET_CHECK (bin/check_samplesheet.py)
    rule samplesheet_check:
        input:
            INPUT,
        output:
            f"{O}/pipeline_info/samplesheet.valid.csv",
        container:
            container_path("python")
        threads: res("process_single")["threads"]
        resources:
            mem_mb=res("process_single")["mem_mb"],
        shell:
            "python3 {SCRIPTS}/check_samplesheet.py {input} {output}"

else:

    # Port sheets: the parsed design (one row per run), with the sample IDs,
    # the control each ChIP sample uses and whether peaks are called.
    rule samplesheet_check:
        input:
            INPUT,
        output:
            f"{O}/pipeline_info/samplesheet.valid.csv",
        run:
            cols = ["sample", "run", "condition", "protein", "rep", "type", "control", "peak_calling",
                    "scale_factor", "single_end", "fastq_1", "fastq_2"]
            with open(output[0], "w", newline="") as fh:
                writer = csv.DictWriter(fh, fieldnames=cols, lineterminator="\n")
                writer.writeheader()
                for lib, m in LIBS.items():
                    s = strip_run(lib)
                    meta = SAMPLES[s]
                    writer.writerow({
                        "sample": s, "run": lib, "condition": meta["condition"], "protein": meta["protein"],
                        "rep": meta["rep"], "type": "control" if meta["is_control"] else meta["type"],
                        "control": meta["control"],
                        "peak_calling": "no" if meta["is_control"] or not calls_peaks(s) else "yes",
                        "scale_factor": meta["scale_factor"], "single_end": int(meta["single_end"]),
                        "fastq_1": m["raw_fastq"][0], "fastq_2": m["raw_fastq"][1]})


