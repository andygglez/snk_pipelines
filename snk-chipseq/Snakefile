# PRESEQ_LCEXTRAP (on the markduplicates BAM; stderr is the command log)
rule preseq_lcextrap:
    input:
        mkd_bam("{sample}"),
    output:
        txt=f"{ML}/preseq/{{sample}}.{MKDP}.lc_extrap.txt",
        log=f"{ML}/preseq/{{sample}}.{MKDP}.command.log",
    params:
        args=args("preseq"),
        pe=lambda wc: "" if SAMPLES[wc.sample]["single_end"] else "-pe",
    container:
        container_path("preseq")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input}) $(basename {input})
        p={wildcards.sample}.{MKDP}
        preseq lc_extrap {params.args} {params.pe} -output $p.lc_extrap.txt $(basename {input}) \
            2> $p.command.log || {{ cat $p.command.log >&2; exit 1; }}
        mv $p.lc_extrap.txt {output.txt}
        mv $p.command.log {output.log}
        """


def cmm_inputs(s):
    return {"bam": clean_bam(s), "bai": f"{clean_bam(s)}.bai", "fasta": FASTA, "fai": FAI}


CMM = f"{ML}/picard_metrics/{{s}}.{CLNS}.CollectMultipleMetrics"
# PDFs are untracked extras (which plots Picard draws depends on the data).
CMM_CMD = """
        ln -s $(realpath {input.bam}) $(basename {input.bam})
        ln -s $(realpath {input.bai}) $(basename {input.bai})
        ln -s $(realpath {input.fasta}) {FASTA_NAME}
        ln -s $(realpath {input.fai}) {FASTA_NAME}.fai
        p=$(basename {input.bam} .bam)
        picard -Xmx{params.mem}M CollectMultipleMetrics {params.args} \\
            --INPUT $(basename {input.bam}) --OUTPUT $p.CollectMultipleMetrics --REFERENCE_SEQUENCE {FASTA_NAME}
        for f in {output}; do mv $(basename $f) $f; done
        mkdir -p {params.pdf_dir}
        for f in $p.CollectMultipleMetrics*.pdf; do [ -e "$f" ] && mv $f {params.pdf_dir}/; done
"""


# PICARD_COLLECTMULTIPLEMETRICS (paired-end: adds insert size metrics)
rule picard_collectmultiplemetrics_pe:
    input:
        unpack(lambda wc: cmm_inputs(wc.pe_sample)),
    output:
        **{m: CMM.format(s="{pe_sample}") + f".{m}" for m in CMM_METRICS + ["insert_size_metrics"]},
    params:
        args=args("picard_collectmultiplemetrics"),
        mem=lambda wc, resources: picard_mem(resources),
        pdf_dir=os.path.abspath(f"{ML}/picard_metrics/pdf"),
    container:
        container_path("picard")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        CMM_CMD


# PICARD_COLLECTMULTIPLEMETRICS (single-end)
