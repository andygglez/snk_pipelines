# KHMER_UNIQUEKMERS (effective genome size when macs_gsize is not given)
rule khmer_uniquekmers:
    input:
        FASTA,
    output:
        report=f"{W}/khmer/report.txt",
        kmers=f"{W}/khmer/kmers.txt",
    params:
        k=param("read_length"),
    container:
        container_path("khmer")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input}) {FASTA_NAME}
        unique-kmers.py -k {params.k} -R report.txt {FASTA_NAME}
        grep ^number report.txt | sed 's/^.*:.[[:blank:]]//g' > kmers.txt
        mv report.txt {output.report}
        mv kmers.txt {output.kmers}
        """


def macs3_args():
    """conf/modules.config MACS3_CALLPEAK ext.args, with the module's --format handling."""
    parts = [args("macs3"),
             "" if NARROW else f"--broad --broad-cutoff {config['broad_cutoff']}",
             "--bdg --SPMR" if flag("save_macs_pileup") else "",
             f"--qvalue {param('macs_fdr')}" if param("macs_fdr") else "",
             f"--pvalue {param('macs_pvalue')}" if param("macs_pvalue") else "",
             "--format BAM" if ALIGNER == "chromap" else ""]
    tokens = join_args(parts).split()
    fmt = None
    if "--format" in tokens:
        i = tokens.index("--format")
        fmt = tokens[i + 1]
        del tokens[i:i + 2]
    return " ".join(tokens), fmt


MACS3_ARGS, MACS3_FORMAT = macs3_args()


def macs3_outputs(s):
    out = {"peak": f"{MACS}/{s}_peaks.{PEAK_EXT}", "xls": f"{MACS}/{s}_peaks.xls"}
    if NARROW:
        out["summits"] = f"{MACS}/{s}_summits.bed"
    else:
        out["gapped"] = f"{MACS}/{s}_peaks.gappedPeak"
    if flag("save_macs_pileup"):
        out["treat_bdg"] = f"{MACS}/{s}_treat_pileup.bdg"
        out["control_bdg"] = f"{MACS}/{s}_control_lambda.bdg"
    return out


# MACS3_CALLPEAK (IP vs control)
rule macs3_callpeak:
    input:
        unpack(lambda wc: ip_control_bams(wc.sample)),
        kmers=[] if param("macs_gsize") else f"{W}/khmer/kmers.txt",
    output:
        **macs3_outputs("{sample}"),
    params:
        args=MACS3_ARGS,
        format=lambda wc: MACS3_FORMAT or ("BAM" if SAMPLES[wc.sample]["single_end"] else "BAMPE"),
        gsize=param("macs_gsize") or "",
        outdir=MACS,
    container:
        container_path("macs3")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        LINK_IP_CONTROL + """
        GSIZE="{params.gsize}"
        if [ -z "$GSIZE" ]; then GSIZE=$(tr -d '[:space:]' < {input.kmers}); fi
        macs3 callpeak {params.args} --gsize $GSIZE --format {params.format} --name {wildcards.sample} \
            --treatment $(basename {input.ip}) --control $(basename {input.control})
        mkdir -p {params.outdir}
        for f in {output}; do mv $(basename $f) $f; done
        """


# Groovy filter in BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER: peaks.size() > 0
checkpoint peak_summary:
    input:
        lambda wc: [peak_file(s) for s in ip_samples()],
    output:
        f"{W}/status/peak_summary.json",
    params:
        samples=lambda wc: ip_samples(),
    run:
        sizes = {s: os.path.getsize(f) for s, f in zip(params.samples, input)}
        with open(output[0], "w") as fh:
            json.dump(sizes, fh, indent=1)


# FRIP_SCORE
rule frip_score:
    input:
        bam=clean_bam("{sample}"),
        peak=peak_file("{sample}"),
    output:
        f"{W}/frip/{{sample}}.FRiP.txt",
    params:
        args=args("frip"),
    container:
        container_path("frip")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        bam=$(basename {input.bam}); peak=$(basename {input.peak})
        ln -s $(realpath {input.bam}) $bam
        ln -s $(realpath {input.peak}) $peak
        READS_IN_PEAKS=$(intersectBed -a $bam -b $peak {params.args} | awk -F '\\t' '{{sum += $NF}} END {{print sum}}')
        samtools flagstat $bam > $bam.flagstat
        grep 'mapped (' $bam.flagstat | grep -v "primary" | awk -v a="$READS_IN_PEAKS" -v OFS='\\t' '{{print "{wildcards.sample}", a/$1}}' > {wildcards.sample}.FRiP.txt
        mv {wildcards.sample}.FRiP.txt {output}
        """


