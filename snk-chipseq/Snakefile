    raise ValueError("`fasta` is required.")
if not param("gtf") and not param("gff"):
    raise ValueError("No GTF or GFF3 annotation specified (`gtf` or `gff`).")
if not param("macs_gsize") and not param("read_length"):
    raise ValueError("Either `macs_gsize` or `read_length` (for khmer unique-kmers) is required.")

# -----------------------------------------------------------------------------
# Samplesheet format (port extension). Two formats, told apart by the header:
#  * nf-core: sample,fastq_1,fastq_2,replicate,antibody,control,control_replicate.
#    Runs exactly as nf-core/chipseq 2.1.0 (nf-core file names, .bigWig, IGV
#    session, `narrow_peak` sets the MACS3 mode of every IP), so it can still be
#    validated against nf-core.
#  * port: condition,protein,rep,type,fastq1,fastq2,scale_factor (only condition,
#    protein, rep and fastq1 are required; see read_port_samplesheet below).
#    Sample IDs are <condition>_<protein>_<rep>; peaks are called (MACS3 narrow)
#    only for type=narrow; bigWigs are .bw scaled by scale_factor; BAM suffixes
#    are .lib / .merged_lib / .markedDup / .filtered / .final; no IGV session.
# -----------------------------------------------------------------------------
def _sheet_header(path):
    lines = read_text(path).splitlines()
    return [c.strip().lower() for c in lines[0].split(",")] if lines else []


NEW_SHEET = {"condition", "protein"} <= set(_sheet_header(config["input"]))
# File-name stems of the BAM chain (and what is derived from it):
#   LBR  aligner output (unsorted)        LBS  library, sorted      LB   library prefix (logs, unmapped reads)
#   MRG  runs merged                      MKDS duplicates marked    MKDP duplicates marked (Preseq prefix)
#   FLTS filtered (PE)                    FLTN filtered, name-sorted (PE)
#   CLNR orphans removed, unsorted (PE)   CLNS final clean BAM      CLNP final (QC/plot prefix)
#   COV  coverage (bedGraph/scale) prefix BW   bigWig extension
if NEW_SHEET:
    LBR, LBS, LB = "lib.unsorted", "lib", "lib"
    MRG, MKDS, MKDP = "merged_lib", "markedDup", "markedDup"
    FLTS, FLTN = "filtered", "filtered.name_sorted"
    CLNR, CLNS, CLNP, COV, BW = "final.unsorted", "final", "final", "final", "bw"
else:
    LBR, LBS, LB = "Lb", "Lb.sorted", "Lb"
    MRG, MKDS, MKDP = "mLb.sorted", "mLb.mkD.sorted", "mLb.mkD"
    FLTS, FLTN = "mLb.flT.sorted", "mLb.flT.name_sorted"
    CLNR, CLNS, CLNP, COV, BW = "mLb.clN", "mLb.clN.sorted", "mLb.clN", "mLB.clN", "bigWig"
CLEAN_SUFFIX = f".{CLNS}.bam"

