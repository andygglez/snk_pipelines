# GUNZIP_FASTA / GUNZIP_GTF / GUNZIP_GFF / GUNZIP_GENE_BED / GUNZIP_BLACKLIST
rule gunzip:
    input:
        lambda wc: GUNZIP_SRC[wc.fname],
    output:
        f"{GENOME_DIR}/{{fname}}",
    wildcard_constraints:
        fname=alternation(GUNZIP_SRC),
    container:
        container_path("ubuntu22")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        "gzip -cd {input} > {output}"


# GFFREAD (GFF3 -> GTF when no GTF is given)
rule gffread:
    input:
        GFF or [],
    output:
        f"{GENOME_DIR}/null.gtf",
    params:
        args=args("gffread"),
    container:
        container_path("gffread")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input}) {GFF_NAME}
        gffread {GFF_NAME} {params.args} -o null.gtf
        mv null.gtf {output}
        """


GFF_NAME = os.path.basename(GFF) if GFF else ""


