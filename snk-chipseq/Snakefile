# =============================================================================
# Merged libraries: PICARD_MERGESAMFILES, BAM_MARKDUPLICATES_PICARD
# =============================================================================


def single_bam_cmd(save):
    """PICARD_MERGESAMFILES with one input BAM: the module links it (`ln -s`);
    with publish_dir_mode copy the published BAM is a real file (`cp`).

    The link is RELATIVE to the output's directory. These rules run in a shadow
    directory, and Snakemake (dag.py unshadow_output, <=9.27) rewrites an
    absolute output symlink relative to the shadow-dir root instead of the
    link's own directory, leaving a dangling link and a MissingOutputException.
    The input is staged at the same relative path inside the shadow dir, so the
    relative link resolves there and after the move."""
    def cmd(wc, input, output):
        if save:
            return f"cp $(realpath {shlex.quote(input[0])}) {shlex.quote(output[0])}"
        rel = os.path.relpath(input[0], os.path.dirname(output[0]))
        return f"ln -s {shlex.quote(rel)} {shlex.quote(output[0])}"
    return cmd


# PICARD_MERGESAMFILES (a single library is linked, as in the module)
rule picard_mergesamfiles:
    input:
        lambda wc: sorted((lib_bam(l) for l in sample_libs(wc.sample)), key=os.path.basename),
    output:
        f"{MRG_DIR}/{{sample}}.{MRG}.bam",
    params:
        args=args("picard_mergesamfiles"),
        mem=lambda wc, resources: picard_mem(resources),
        single=single_bam_cmd(SAVE_ALIGN),
    container:
        container_path("picard")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        set -- {input}
        if [ $# -gt 1 ]; then
            inputs=
            for f in {input}; do ln -s $(realpath $f) $(basename $f); inputs="$inputs --INPUT $(basename $f)"; done
            picard -Xmx{params.mem}M MergeSamFiles {params.args} $inputs --OUTPUT {wildcards.sample}.{MRG}.bam
            mv {wildcards.sample}.{MRG}.bam {output}
        else
            {params.single}
        fi
        """


# BAM_MARKDUPLICATES_PICARD:PICARD_MARKDUPLICATES
rule picard_markduplicates:
    input:
        bam=f"{MRG_DIR}/{{sample}}.{MRG}.bam",
        fasta=FASTA,
        fai=FAI,
    output:
        bam=f"{MRG_DIR}/{{sample}}.{MKDS}.bam",
        metrics=f"{ML}/picard_metrics/{{sample}}.{MKDS}.MarkDuplicates.metrics.txt",
    params:
        args=args("picard_markduplicates"),
        mem=lambda wc, resources: picard_mem(resources),
    container:
        container_path("picard")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.bam}) {wildcards.sample}.{MRG}.bam
        ln -s $(realpath {input.fasta}) {FASTA_NAME}
        ln -s $(realpath {input.fai}) {FASTA_NAME}.fai
        p={wildcards.sample}.{MKDS}
        picard -Xmx{params.mem}M MarkDuplicates {params.args} \
            --INPUT {wildcards.sample}.{MRG}.bam --OUTPUT $p.bam \
            --REFERENCE_SEQUENCE {FASTA_NAME} --METRICS_FILE $p.MarkDuplicates.metrics.txt
        mv $p.bam {output.bam}
        mv $p.MarkDuplicates.metrics.txt {output.metrics}
        """


# =============================================================================
# BAM_FILTER_BAMTOOLS
# =============================================================================
def bamtools_args(s):
    """conf/modules.config BAMTOOLS_FILTER ext.args"""
    return join_args([
        "-F 0x004" if SAMPLES[s]["single_end"] else "-F 0x004 -F 0x0008 -f 0x001",
        "" if flag("keep_dups") else "-F 0x0400",
        "" if flag("keep_multi_map") else "-q 1",
    ])


def bamtools_inputs(s):
    se = SAMPLES[s]["single_end"]
    return {
        "bam": mkd_bam(s),
        "bai": f"{mkd_bam(s)}.bai",
        "bed": FILTERED_BED,
        "config": asset_path(config["bamtools_filter_se_config" if se else "bamtools_filter_pe_config"]),
    }


BAMTOOLS_FILTER_CMD = """
        ln -s $(realpath {input.bam}) $(basename {input.bam})
        ln -s $(realpath {input.bai}) $(basename {input.bai})
        ln -s $(realpath {input.bed}) $(basename {input.bed})
        ln -s $(realpath {input.config}) $(basename {input.config})
        samtools view {params.args} -L $(basename {input.bed}) -b $(basename {input.bam}) \
            | bamtools filter -out {params.prefix}.bam -script $(basename {input.config})
        mv {params.prefix}.bam {output}
"""


# BAMTOOLS_FILTER (paired-end: <id>.mLb.flT.sorted.bam, orphans removed next)
rule bamtools_filter_pe:
    input:
        unpack(lambda wc: bamtools_inputs(wc.pe_sample)),
    output:
        f"{MRG_DIR}/{{pe_sample}}.{FLTS}.bam",
    params:
        args=lambda wc: bamtools_args(wc.pe_sample),
        prefix=lambda wc: f"{wc.pe_sample}.{FLTS}",
    container:
        container_path("bamtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        BAMTOOLS_FILTER_CMD


# BAMTOOLS_FILTER (single-end: final <id>.mLb.clN.sorted.bam)
rule bamtools_filter_se:
    input:
        unpack(lambda wc: bamtools_inputs(wc.se_sample)),
    output:
        f"{ML}/{{se_sample}}.{CLNS}.bam",
    params:
        args=lambda wc: bamtools_args(wc.se_sample),
        prefix=lambda wc: f"{wc.se_sample}.{CLNS}",
    container:
        container_path("bamtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        BAMTOOLS_FILTER_CMD


# BAM_FILTER_BAMTOOLS:SAMTOOLS_SORT (-n, prefix <id>.mLb.flT.name_sorted)
rule samtools_sort_name:
    input:
        bam=f"{MRG_DIR}/{{pe_sample}}.{FLTS}.bam",
        fasta=FASTA,
    output:
        f"{MRG_DIR}/{{pe_sample}}.{FLTN}.bam",
    params:
