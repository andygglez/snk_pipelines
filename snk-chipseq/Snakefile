PROFILE = f"{ML}/deepTools/plotProfile/{{sample}}.{CLNP}"


# DEEPTOOLS_COMPUTEMATRIX. The gene BED (gtf2bed, BED12) carries each gene's strand,
# and computeMatrix scale-regions reverses minus-strand genes, so the TSS is
# always on the left of the profile/heatmap and the TES on the right.
rule deeptools_computematrix:
    input:
        bigwig=bigwig("{sample}"),
        bed=GENE_BED,
    output:
        mat=f"{PROFILE}.computeMatrix.mat.gz",
        tab=f"{PROFILE}.computeMatrix.vals.mat.tab",
    params:
        args=args("computematrix"),
    container:
        container_path("deeptools")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.bigwig}) $(basename {input.bigwig})
        ln -s $(realpath {input.bed}) {GENE_BED_NAME}
        p={wildcards.sample}.{CLNP}
        computeMatrix {params.args} --regionsFileName {GENE_BED_NAME} --scoreFileName $(basename {input.bigwig}) \
            --outFileName $p.computeMatrix.mat.gz --outFileNameMatrix $p.computeMatrix.vals.mat.tab \
            --numberOfProcessors {threads}
        mv $p.computeMatrix.mat.gz {output.mat}
        mv $p.computeMatrix.vals.mat.tab {output.tab}
        """


