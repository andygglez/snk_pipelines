# Indices: provided directory/file, .tar.gz (UNTAR_*), or built.
UNTAR_SRC = {}  # UNTAR_*: output name in INDEX_DIR -> .tar.gz source


def index_path(key, built):
    value = param(key)
    if not value:
        return built
    value = stage(value)
    if value.endswith(".tar.gz"):
        name = os.path.basename(value)[: -len(".tar.gz")]
        UNTAR_SRC[name] = value
        return f"{INDEX_DIR}/{name}"
    return value


# A .tar.gz chromap index goes through UNTARFILES (no strip, default
# publishDir <outdir>/untarfiles/<archive name>/); chromap uses the file inside.
CHROMAP_TAR = None


def chromap_index_path():
    global CHROMAP_TAR
    value = param("chromap_index")
    if value and str(value).endswith(".tar.gz"):
        CHROMAP_TAR = stage(value)
        return f"{O}/untarfiles/{os.path.basename(value)[: -len('.tar.gz')]}"
    return index_path("chromap_index", f"{O}/genome/index/chromap/{basename_noext(FASTA)}.index")


INDEX = {
    "bwa": lambda: index_path("bwa_index", f"{INDEX_DIR}/bwa"),
    "bowtie2": lambda: index_path("bowtie2_index", f"{INDEX_DIR}/bowtie2"),
    # CHROMAP_INDEX publishes to genome/index/chromap regardless of save_reference
    "chromap": lambda: chromap_index_path(),
    "star": lambda: index_path("star_index", f"{INDEX_DIR}/star"),
}[ALIGNER]()

# -----------------------------------------------------------------------------
# Samplesheet (SAMPLESHEET_CHECK + INPUT_CHECK)
# -----------------------------------------------------------------------------
# bin/check_samplesheet.py is run here to derive the library ids
# (<sample>_REP<n>_T<m>) the DAG needs; the samplesheet_check rule runs it again
# in its container to publish samplesheet.valid.csv.
INPUT = stage(config["input"]) if is_url(config["input"]) else config["input"]

CONTROL_PROTEINS = ("input", "igg")  # protein values that mark a control row (any case)
PORT_SHEET_COLS = ("condition", "protein", "rep", "type", "fastq1", "fastq2", "scale_factor")


def read_port_samplesheet(path, seq_center=""):
    """Port-format samplesheet -> the library metadata read_validated_samplesheet returns.

    Required columns: condition, protein, rep, fastq1. Optional (may be missing or
    empty): type (broad | narrow; required for non-control rows), fastq2 (empty =
    single-end), scale_factor (default 1). Rows sharing condition/protein/rep are
    runs of one sample (merged). Rows whose protein is input or IgG are controls;
    a ChIP sample uses the control of its condition with the same rep, else that
    condition's only control; when only one condition has controls, they are
    shared by every condition. No control found = MACS3 runs without one.
    """
    reader = csv.DictReader(io.StringIO(read_text(path)))
    header = [(h or "").strip().lower() for h in (reader.fieldnames or [])]
    unknown = [h for h in header if h and h not in PORT_SHEET_COLS]
    if unknown:
        raise ValueError(f"{path}: unknown samplesheet column(s) {unknown}; allowed: {', '.join(PORT_SHEET_COLS)}.")
    for col in ("condition", "protein", "rep", "fastq1"):
        if col not in header:
            raise ValueError(f"{path}: the samplesheet needs a `{col}` column.")
    name_re, rep_re = re.compile(r"[A-Za-z0-9][\w.-]*"), re.compile(r"[A-Za-z0-9][A-Za-z0-9.-]*")
    samples = OrderedDict()
    for n, raw in enumerate(reader, start=2):
        row = {(k or "").strip().lower(): (v or "").strip() for k, v in raw.items() if k is not None}
        if not any(row.values()):
            continue
        where = f"{path} line {n}"
        cond, prot, rep = row.get("condition", ""), row.get("protein", ""), row.get("rep", "")
        for key, value, rx in (("condition", cond, name_re), ("protein", prot, name_re), ("rep", rep, rep_re)):
            if not rx.fullmatch(value):
                raise ValueError(f"{where}: {key} {value!r} must be non-empty, start with a letter or digit and "
                                 "contain only letters, digits, '.', '-'" + (" or '_'." if key != "rep" else " (no '_')."))
        is_ctrl = prot.lower() in CONTROL_PROTEINS
        typ = "" if is_ctrl else row.get("type", "").lower()
        if not is_ctrl and typ not in ("broad", "narrow"):
            raise ValueError(f"{where}: type must be broad or narrow for protein {prot} (got {typ!r}).")
        sf_txt = row.get("scale_factor", "")
        try:
            sf = float(sf_txt) if sf_txt else 1.0
        except ValueError:
            raise ValueError(f"{where}: scale_factor {sf_txt!r} is not a number.") from None
        if not sf > 0:
            raise ValueError(f"{where}: scale_factor must be > 0 (got {sf_txt}).")
        fq1, fq2 = row.get("fastq1", ""), row.get("fastq2", "")
        if not fq1:
            raise ValueError(f"{where}: fastq1 is empty.")
        sid = f"{cond}_{prot}_{rep}"
        meta = samples.setdefault(sid, {"condition": cond, "protein": prot, "rep": rep, "is_control": is_ctrl,
                                        "type": typ, "scale_factor": sf, "single_end": not fq2, "runs": [],
                                        "scale_given": bool(sf_txt)})
        for key, value in (("type", typ), ("scale_factor", sf), ("single_end", not fq2)):
            if meta[key] != value:
                raise ValueError(f"{where}: every run of {sid} must have the same {key}.")
        meta["runs"].append((fq1, fq2))
    if not samples:
        raise ValueError(f"{path}: the samplesheet has no samples.")
    ptype = {}
    for sid, m in samples.items():
        if not m["is_control"] and ptype.setdefault(m["protein"], m["type"]) != m["type"]:
            raise ValueError(f"Protein {m['protein']} is listed as both broad and narrow; use one type per protein.")
    controls = [s for s, m in samples.items() if m["is_control"]]
    ctrl_conditions = {samples[c]["condition"] for c in controls}

    def pick_control(m):
        pool = [c for c in controls if samples[c]["condition"] == m["condition"]]
        if not pool and len(ctrl_conditions) == 1:
            pool = controls
        if not pool:
            return ""
        same_rep = [c for c in pool if samples[c]["rep"] == m["rep"]]
        if len(same_rep) == 1:
            return same_rep[0]
        if len(pool) == 1:
            return pool[0]
        raise ValueError(f"Cannot choose a control for {m['condition']}_{m['protein']}_{m['rep']} among {pool}: "
                         "give the controls the same rep values as the ChIP samples.")

    libs = []
    for sid, m in samples.items():
        control = "" if m["is_control"] else pick_control(m)
        for k, (fq1, fq2) in enumerate(m["runs"], start=1):
            lib = f"{sid}_T{k}"
            rg = f"@RG\\tID:{lib}\\tSM:{sid}\\tPL:ILLUMINA\\tLB:{lib}\\tPU:1"
            if seq_center:
                rg += f"\\tCN:{seq_center}"
            libs.append({"id": lib, "single_end": m["single_end"], "antibody": "" if m["is_control"] else m["protein"],
                         "control": control, "read_group": f"'{rg}'", "fastq_1": fq1, "fastq_2": fq2,
                         "is_control": m["is_control"], "type": m["type"], "scale_factor": m["scale_factor"],
                         "group": f"{m['condition']}_{m['protein']}", "condition": m["condition"],
                         "scale_given": m["scale_given"],
                         "protein": m["protein"], "rep": m["rep"]})
    return libs


if NEW_SHEET:
    _libs = read_port_samplesheet(config["input"], param("seq_center") or "")
else:
    with tempfile.TemporaryDirectory() as _tmp:
        _raw = os.path.join(_tmp, "samplesheet.csv")
        with open(_raw, "w") as fh:
            fh.write(read_text(config["input"]))
        _valid = os.path.join(_tmp, "samplesheet.valid.csv")
        try:
            check_samplesheet.check_samplesheet(_raw, _valid)
        except SystemExit as e:
            raise ValueError(f"Samplesheet check failed for {config['input']} (see message above).") from e
        _libs = read_validated_samplesheet(_valid, param("seq_center") or "")

LIBS = OrderedDict()     # library id (..._T<m>) -> meta
SAMPLES = OrderedDict()  # merged library id (..._REP<n>) -> meta
for lib in _libs:
    raw_fq = (lib["fastq_1"], lib["fastq_2"])
    fq = [stage(lib.pop("fastq_1"))]
    fq2 = lib.pop("fastq_2")
    if not lib["single_end"]:
        fq.append(stage(fq2))
    LIBS[lib["id"]] = dict(lib, reads=fq, raw_fastq=raw_fq)
    sid = strip_run(lib["id"])
    meta = SAMPLES.setdefault(sid, {
        "single_end": lib["single_end"], "antibody": lib["antibody"], "control": lib["control"], "libs": [],
        # port extension; nf-core sheets: one MACS3 mode for all IPs, factor 1, group = id - _REP<n>
        "is_control": lib.get("is_control", not lib["antibody"] and not lib["control"]),
        "type": lib.get("type", "narrow" if NARROW else "broad"),
        "scale_factor": lib.get("scale_factor", 1.0),
        "scale_given": lib.get("scale_given", False),
        "group": lib.get("group", strip_rep(sid)),
        "condition": lib.get("condition", ""), "protein": lib.get("protein", ""), "rep": lib.get("rep", "")})
    meta["libs"].append(lib["id"])

PE_LIBS = [l for l in LIBS if not LIBS[l]["single_end"]]
SE_LIBS = [l for l in LIBS if LIBS[l]["single_end"]]
PE_SAMPLES = [s for s in SAMPLES if not SAMPLES[s]["single_end"]]
SE_SAMPLES = [s for s in SAMPLES if SAMPLES[s]["single_end"]]
ANTIBODIES = sorted({m["antibody"] for m in SAMPLES.values() if m["antibody"]})

wildcard_constraints:
    lib=alternation(LIBS),
    pe_lib=alternation(PE_LIBS),
    se_lib=alternation(SE_LIBS),
    sample=alternation(SAMPLES),
    pe_sample=alternation(PE_SAMPLES),
    se_sample=alternation(SE_SAMPLES),
    antibody=alternation(ANTIBODIES),


def mates(lib):
    return [""] if LIBS[lib]["single_end"] else ["_1", "_2"]


# -----------------------------------------------------------------------------
# Per-library / per-sample status written by checkpoints (Groovy logic in nf-core)
# -----------------------------------------------------------------------------
def _summary(cp):
    with open(cp.get().output[0]) as fh:
        return json.load(fh)


def lib_pass(lib):
    """FASTQ_FASTQC_UMITOOLS_TRIMGALORE: reads after trimming >= min_trimmed_reads."""
    return SKIP_TRIM or _summary(checkpoints.trim_summary)[lib]["pass"]


def sample_libs(s):
    return [l for l in SAMPLES[s]["libs"] if lib_pass(l)]


def libs_ok():
    return [l for l in LIBS if lib_pass(l)]


def samples_ok():
    """Merged libraries with at least one library left after trimming."""
    return [s for s in SAMPLES if sample_libs(s)]


def ip_samples():
    """ch_ip_control_bam: IP samples whose control also made it through.

    Port sheets: every ChIP (non-control) sample; one without a control is kept,
    one whose control was dropped (min_trimmed_reads) is dropped, as in nf-core.
    """
    ok = set(samples_ok())
    if NEW_SHEET:
        return [s for s in SAMPLES if s in ok and not SAMPLES[s]["is_control"]
                and (not SAMPLES[s]["control"] or SAMPLES[s]["control"] in ok)]
    return [s for s in SAMPLES if s in ok and SAMPLES[s]["control"] and SAMPLES[s]["control"] in ok]


def calls_peaks(s):
    """Port sheets: MACS3 only for type=narrow (broad marks get tracks and QC only)."""
    return not NEW_SHEET or SAMPLES[s]["type"] == "narrow"


def macs_samples():
    return [s for s in ip_samples() if calls_peaks(s)]


def peak_samples():
    """BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER: peaks.size() > 0."""
    sizes = _summary(checkpoints.peak_summary)
    return [s for s in macs_samples() if sizes[s] > 0]


def antibody_groups():
    """BED_CONSENSUS_QUANTIFY_QC_BEDTOOLS_FEATURECOUNTS_DESEQ2 meta per antibody."""
    groups = OrderedDict()
    for s in peak_samples():
        groups.setdefault(SAMPLES[s]["antibody"], []).append(s)
    out = OrderedDict()
    for ab in sorted(groups):
        counts = Counter(SAMPLES[s]["group"] for s in groups[ab])
        out[ab] = {"peaks": groups[ab], "multiple_groups": len(counts) > 1,
                   "replicates_exist": max(counts.values()) > 1}
    return out


def consensus_antibodies():
    if flag("skip_consensus_peaks"):
        return []
    return [ab for ab, m in antibody_groups().items() if m["multiple_groups"] or m["replicates_exist"]]


def deseq2_antibodies():
    if flag("skip_deseq2_qc"):
        return []
    groups = antibody_groups()
    return [ab for ab in consensus_antibodies() if groups[ab]["multiple_groups"] and groups[ab]["replicates_exist"]]


# -----------------------------------------------------------------------------
# File names
# -----------------------------------------------------------------------------
def raw_reads(lib):
    return LIBS[lib]["reads"]


def trimmed_reads(lib):
    if SKIP_TRIM:
        return raw_reads(lib)
    if LIBS[lib]["single_end"]:
        return [f"{TRIM_DIR}/{lib}_trimmed.fq.gz"]
    return [f"{TRIM_DIR}/{lib}_1_val_1.fq.gz", f"{TRIM_DIR}/{lib}_2_val_2.fq.gz"]


def trim_logs(lib):
    if LIBS[lib]["single_end"]:
        return [f"{O}/trimgalore/logs/{lib}.fastq.gz_trimming_report.txt"]
    return [f"{O}/trimgalore/logs/{lib}_{r}.fastq.gz_trimming_report.txt" for r in (1, 2)]


def trim_fastqc(lib, ext):
    sub = "fastqc" if ext == "html" else "fastqc/zips"
    if LIBS[lib]["single_end"]:
        return [f"{O}/trimgalore/{sub}/{lib}_trimmed_fastqc.{ext}"]
    return [f"{O}/trimgalore/{sub}/{lib}_{r}_val_{r}_fastqc.{ext}" for r in (1, 2)]


def raw_fastqc(lib, ext):
    sub = "fastqc" if ext == "html" else "fastqc/zips"
    return [f"{O}/{sub}/{lib}{m}_fastqc.{ext}" for m in mates(lib)]


def lib_bam(lib):
    return f"{LIB_DIR}/{lib}.{LBS}.bam"


def mkd_bam(s):
    return f"{MRG_DIR}/{s}.{MKDS}.bam"


def clean_bam(s):
    return f"{ML}/{s}.{CLNS}.bam"


def stats_files(bam):
    d, name = os.path.split(bam)
    return [f"{d}/samtools_stats/{name}.{x}" for x in ("stats", "flagstat", "idxstats")]


def bigwig(s):
    """Replicate RPM bigWig (port sheets: bigwig/replicate_bws/<id>.final.bw)."""
    return f"{BW_REP}/{s}.{CLNP}.{BW}"


# Port sheets only -------------------------------------------------------------
def bigwig_scaled(s):
    """Replicate RPM bigWig x its samplesheet scale_factor."""
    return f"{BW_REP}/{s}.{CLNP}.scaled.{BW}"


def sample_bigwig(g, scaled=False):
    """<condition>_<protein> bigWig: mean of its replicates (scaled: x mean scale_factor)."""
    return f"{BW_SMP}/{g}.{CLNP}{'.scaled' if scaled else ''}.{BW}"


def bw_groups():
    """<condition>_<protein> -> replicates that reached a final BAM."""
    groups = OrderedDict()
    for s in samples_ok():
        groups.setdefault(SAMPLES[s]["group"], []).append(s)
    return groups


def heatmap_proteins():
    """ChIP proteins with at least one final BAM (controls are not plotted)."""
    ok = samples_ok()
    return sorted({SAMPLES[s]["protein"] for s in ok if not SAMPLES[s]["is_control"]})


def protein_type(protein):
    return next(m["type"] for m in SAMPLES.values() if m["protein"] == protein and not m["is_control"])


HEATMAP_REGIONS = ("tss", "genes", "intergenic", "enhancers_center", "enhancers_scaled")


def heatmap_regions(protein):
    """tss: reference-point on the TSS (narrow only); genes: scale-regions over gene
    bodies; intergenic: scale-regions over the gaps between genes; enhancers_center /
    enhancers_scaled: enhancer_bed, reference-point on the centre and scale-regions
    (both, when enhancer_bed is set)."""
    regions = (["tss"] if protein_type(protein) == "narrow" else []) + ["genes", "intergenic"]
    return regions + (["enhancers_center", "enhancers_scaled"] if ENHANCER_BED else [])


def protein_bigwigs(protein, kind):
    """bigWigs of one protein (every condition) for a heatmap kind."""
    if kind.startswith("replicate"):
        reps = [s for s in samples_ok() if not SAMPLES[s]["is_control"] and SAMPLES[s]["protein"] == protein]
        return [bigwig_scaled(s) if kind.endswith("scaled") else bigwig(s) for s in reps]
    groups = [g for g, reps in bw_groups().items()
              if not SAMPLES[reps[0]]["is_control"] and SAMPLES[reps[0]]["protein"] == protein]
    return [sample_bigwig(g, kind.endswith("scaled")) for g in groups]


SCALE_PLOT = config.get("scale_factor_barplot") or {}
SCALE_DIR = f"{O}/scale_factors"


def scale_barplot_proteins():
    """ChIP proteins with at least one scale_factor written in the samplesheet."""
    if not NEW_SHEET or not SCALE_PLOT.get("enabled", True):
        return []
    return sorted({m["protein"] for m in SAMPLES.values() if not m["is_control"] and m["scale_given"]})


def scale_barplot_outputs():
    fmt = SCALE_PLOT.get("format", "pdf")
    return [f"{SCALE_DIR}/{p}.scale_factors.{x}" for p in scale_barplot_proteins() for x in (f"barplot.{fmt}", "tsv")]


def heatmap_outputs():
    if flag("skip_plot_profile"):
        return []
    return [f"{HEATMAP}/{p}/{p}.{k}.{r}.{x}" for p in heatmap_proteins() for k in HEATMAP_KINDS
            for r in heatmap_regions(p) for x in ("computeMatrix.mat.gz", "plotHeatmap.png", "plotProfile.png")]


def peak_file(s):
    return f"{MACS}/{s}_peaks.{PEAK_EXT}"


def consensus_prefix(ab):
    return f"{MACS}/consensus/{ab}/{ab}.consensus_peaks"


CMM_METRICS = ["alignment_summary_metrics", "base_distribution_by_cycle_metrics",
               "quality_by_cycle_metrics", "quality_distribution_metrics"]


def cmm_metrics(s):
    out = [f"{ML}/picard_metrics/{s}.{CLNS}.CollectMultipleMetrics.{m}" for m in CMM_METRICS]
    if not SAMPLES[s]["single_end"]:
        out.append(f"{ML}/picard_metrics/{s}.{CLNS}.CollectMultipleMetrics.insert_size_metrics")
    return out


# -----------------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------------
def genome_outputs():
    out = [f"{O}/pipeline_info/samplesheet.valid.csv", FAI, SIZES]
    if not SKIP_IGV:
        out.append(f"{O}/genome/{FASTA_NAME}")
    if SAVE_REF:
        out += [GTF, GENE_BED, FILTERED_BED, INDEX] + ([INTERGENIC_BED] if BUILD_INTERGENIC else [])
        out += [f"{GENOME_DIR}/{n}" for n in GUNZIP_SRC]
    if ALIGNER == "chromap" and not param("chromap_index"):
        out.append(INDEX)
    return out


def library_outputs(lib):
    out = []
    if not SKIP_FASTQC:
        out += raw_fastqc(lib, "html") + raw_fastqc(lib, "zip")
    if not SKIP_TRIM:
        out += trim_logs(lib) + trim_fastqc(lib, "html") + trim_fastqc(lib, "zip")
    return out


def aligned_library_outputs(lib):
    out = []
    if flag("save_trimmed") and not SKIP_TRIM:
        out += trimmed_reads(lib)
    if ALIGNER == "star":
        out += [f"{AL}/library/log/{lib}.{x}" for x in ("Log.final.out", "Log.out", "Log.progress.out", "SJ.out.tab")]
    if SAVE_ALIGN:
        out += [lib_bam(lib), f"{lib_bam(lib)}.bai"] + stats_files(lib_bam(lib))
    return out


def sample_outputs(s):
    pe = not SAMPLES[s]["single_end"]
    out = [f"{ML}/picard_metrics/{s}.{MKDS}.MarkDuplicates.metrics.txt"]
    out += [clean_bam(s), f"{clean_bam(s)}.bai"] + stats_files(clean_bam(s))
    if SAVE_ALIGN:
        out += [f"{MRG_DIR}/{s}.{MRG}.bam", mkd_bam(s), f"{mkd_bam(s)}.bai"] + stats_files(mkd_bam(s))
        if pe:
            out += [f"{MRG_DIR}/{s}.{FLTS}.bam", f"{MRG_DIR}/{s}.{FLTN}.bam",
                    f"{MRG_DIR}/{s}.{CLNR}.bam"]
    if not flag("skip_preseq"):
        out += [f"{ML}/preseq/{s}.{MKDP}.lc_extrap.txt", f"{ML}/preseq/{s}.{MKDP}.command.log"]
    if not flag("skip_picard_metrics"):
        out += cmm_metrics(s)
    if not flag("skip_spp"):
        out += [f"{ML}/phantompeakqualtools/{s}.spp.{x}" for x in ("out", "pdf")]
        out += [f"{ML}/phantompeakqualtools/{s}.spp_{x}_mqc.tsv" for x in ("nsc", "rsc", "correlation")]
    out += [bigwig(s), f"{ML}/bigwig/scale/{s}.{COV}.scale_factor.txt"]
    if NEW_SHEET:
        out.append(bigwig_scaled(s))
    if not flag("skip_plot_profile") and not NEW_SHEET:
        p = f"{ML}/deepTools/plotProfile/{s}.{CLNP}"
        out += [f"{p}.computeMatrix.mat.gz", f"{p}.computeMatrix.vals.mat.tab", f"{p}.plotProfile.pdf",
                f"{p}.plotProfile.tab", f"{p}.plotHeatmap.pdf", f"{p}.plotHeatmap.mat.tab"]
    return out


def ip_outputs(s):
    out = []
    if not flag("skip_plot_fingerprint"):
        p = f"{ML}/deepTools/plotFingerprint/{s}.{CLNP}.plotFingerprint"
        out += [f"{p}.pdf", f"{p}.raw.txt", f"{p}.qcmetrics.txt"]
    if calls_peaks(s):
        out += list(macs3_outputs(s).values())
    return out


def peak_outputs(s):
    out = [f"{MACS}/qc/{s}.peak_count_mqc.tsv", f"{MACS}/qc/{s}.FRiP_mqc.tsv"]
    if not SKIP_ANNOT:
        out.append(f"{MACS}/{s}_peaks.annotatePeaks.txt")
    return out


def consensus_outputs(ab):
    p = consensus_prefix(ab)
    out = [f"{p}.{x}" for x in ("bed", "saf", "boolean.txt", "boolean.intersect.txt",
                                 "boolean.intersect.plot.pdf", "antibody.txt",
                                 "featureCounts.txt", "featureCounts.txt.summary")]
    if not SKIP_ANNOT:
        out += [f"{p}.annotatePeaks.txt", f"{p}.boolean.annotatePeaks.txt"]
    if ab in deseq2_antibodies():
        out += [f"{MACS}/consensus/{ab}/deseq2/{x}" for x in deseq2_names(ab)]
    return out


def all_outputs(wc):
    out = genome_outputs()
    for lib in LIBS:
        out += library_outputs(lib)
    for lib in libs_ok():
        out += aligned_library_outputs(lib)
    for s in samples_ok():
        out += sample_outputs(s)
    if NEW_SHEET:
        for g in bw_groups():
            out += [sample_bigwig(g), sample_bigwig(g, scaled=True)]
        out += heatmap_outputs()
        out += scale_barplot_outputs()
        if CB_ON:
            out += cb_outputs()
    for s in ip_samples():
        out += ip_outputs(s)
    peaks = peak_samples()
    for s in peaks:
        out += peak_outputs(s)
    if peaks and not SKIP_ANNOT and not flag("skip_peak_qc"):
        out += [f"{MACS}/qc/macs3_peak.{x}" for x in ("summary.txt", "plots.pdf")]
        out += [f"{MACS}/qc/macs3_annotatePeaks.{x}" for x in ("summary.txt", "plots.pdf", "summary_mqc.tsv")]
    for ab in consensus_antibodies():
        out += consensus_outputs(ab)
    if not SKIP_IGV:
        out += [f"{O}/igv/{PEAK_TYPE}/igv_session.xml", f"{O}/igv/{PEAK_TYPE}/igv_files.txt"]
    if not flag("skip_multiqc"):
        out.append(f"{MQC_DIR}/multiqc_report.html")
    return out


rule all:
    input:
        lambda wc: all_outputs(wc) + [VERSIONS_YML],


localrules:
    all,
    fetch_remote,
    trim_status,
    trim_summary,
    peak_summary,


