# Groovy in FASTQ_FASTQC_UMITOOLS_TRIMGALORE: reads left after trimming
# (getTrimGaloreReadsAfterFiltering on the last report) vs min_trimmed_reads.
rule trim_status:
    input:
        lambda wc: trim_logs(wc.lib)[-1],
    output:
        f"{W}/status/{{lib}}.trim.json",
    run:
        n = trimgalore_reads_after_filtering(input[0])
        with open(output[0], "w") as fh:
            json.dump({"lib": wildcards.lib, "num_reads": n,
                       "pass": n >= float(config["min_trimmed_reads"])}, fh)


checkpoint trim_summary:
    input:
        [] if SKIP_TRIM else [f"{W}/status/{l}.trim.json" for l in LIBS],
    output:
        f"{W}/status/trim_summary.json",
    run:
        summary = {}
        for f in input:
            with open(f) as fh:
                st = json.load(fh)
            summary[st["lib"]] = st
        with open(output[0], "w") as fh:
            json.dump(summary, fh, indent=1)


# =============================================================================
# Alignment (FASTQ_ALIGN_BWA / FASTQ_ALIGN_BOWTIE2 / FASTQ_ALIGN_CHROMAP / ALIGN_STAR)
# =============================================================================
def read_links(lib):
    """File names the trimmed reads are staged under."""
    return [os.path.basename(f) for f in trimmed_reads(lib)]


def link_reads_cmd(wc, input):
    return "; ".join(f"ln -s $(realpath {f}) {os.path.basename(f)}" for f in input.reads)


# save_unaligned: unmapped reads are written to {AL}/library/unmapped/ as
# untracked extra files (their presence depends on the aligner's output).
def unmapped_reads(lib):
    d = os.path.abspath(f"{AL}/library/unmapped")
    if ALIGNER == "bowtie2":
        if LIBS[lib]["single_end"]:
            return [f"{d}/{lib}.{LB}.unmapped.fastq.gz"]
        return [f"{d}/{lib}.{LB}.unmapped_1.fastq.gz", f"{d}/{lib}.{LB}.unmapped_2.fastq.gz"]
    if LIBS[lib]["single_end"]:
        return [f"{d}/{lib}.unmapped_1.fastq.gz"]
    return [f"{d}/{lib}.unmapped_1.fastq.gz", f"{d}/{lib}.unmapped_2.fastq.gz"]


def bwa_mem_args(lib):
    """conf/modules.config BWA_MEM ext.args"""
    parts = [args("bwa_mem")]
    if param("bwa_min_score"):
        parts.append(f" -T {param('bwa_min_score')}")
    parts.append(f"-R {LIBS[lib]['read_group']}")
    return join_args(parts)


# BWA_MEM (bwa mem | samtools view; sort_bam = false)
rule bwa_mem:
    input:
        reads=lambda wc: trimmed_reads(wc.lib),
        index=INDEX,
    output:
        f"{W}/bwa/library/{{lib}}.{LBR}.bam",
    params:
        args=lambda wc: bwa_mem_args(wc.lib),
        args2=args("bwa_mem_samtools"),
        index=os.path.basename(INDEX),  # staged under its own name, as in Nextflow
        link=link_reads_cmd,
        reads=lambda wc: " ".join(read_links(wc.lib)),
    container:
        container_path("bwa_mem")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        {params.link}
        ln -s $(realpath {input.index}) {params.index}
        INDEX=`find -L ./{params.index} -name "*.amb" | sed 's/\\.amb$//'`
        bwa mem {params.args} -t {threads} $INDEX {params.reads} \
            | samtools view {params.args2} --threads {threads} -o {wildcards.lib}.{LBR}.bam -
        mv {wildcards.lib}.{LBR}.bam {output}
        """


def bowtie2_args(lib):
    """conf/modules.config BOWTIE2_ALIGN ext.args"""
    parts = [f"--rg-id {lib} --rg SM:{strip_run(lib)} --rg PL:ILLUMINA --rg LB:{lib} --rg PU:1"]
    if param("seq_center"):
        parts.append(f"--rg CN:{param('seq_center')}")
    return join_args(parts)


# BOWTIE2_ALIGN (bowtie2 | samtools view; sort_bam = false)
rule bowtie2_align:
    input:
        reads=lambda wc: trimmed_reads(wc.lib),
        index=INDEX,
    output:
        bam=f"{W}/bowtie2/library/{{lib}}.{LBR}.bam",
        log=f"{W}/bowtie2/library/{{lib}}.{LB}.bowtie2.log",
    params:
        args=lambda wc: bowtie2_args(wc.lib),
        index=os.path.basename(INDEX),
        link=link_reads_cmd,
        reads=lambda wc: (f"-U {read_links(wc.lib)[0]}" if LIBS[wc.lib]["single_end"]
                          else f"-1 {read_links(wc.lib)[0]} -2 {read_links(wc.lib)[1]}"),
        unaligned=lambda wc: "" if not SAVE_UNALIGNED else (
            f"--un-gz {wc.lib}.{LB}.unmapped.fastq.gz" if LIBS[wc.lib]["single_end"]
            else f"--un-conc-gz {wc.lib}.{LB}.unmapped.fastq.gz"),
        unmapped=lambda wc: " ".join(unmapped_reads(wc.lib)) if SAVE_UNALIGNED else "",
    container:
        container_path("bowtie2_align")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        {params.link}
        ln -s $(realpath {input.index}) {params.index}
        INDEX=`find -L ./{params.index} -name "*.rev.1.bt2" | sed "s/\\.rev.1.bt2$//"`
        [ -z "$INDEX" ] && INDEX=`find -L ./{params.index} -name "*.rev.1.bt2l" | sed "s/\\.rev.1.bt2l$//"`
        [ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
        bowtie2 -x $INDEX {params.reads} --threads {threads} {params.unaligned} {params.args} \
            2> {wildcards.lib}.{LB}.bowtie2.log \
            | samtools view --threads {threads} -o {wildcards.lib}.{LBR}.bam -
        cat {wildcards.lib}.{LB}.bowtie2.log >&2
        if [ -f {wildcards.lib}.{LB}.unmapped.fastq.1.gz ]; then
            mv {wildcards.lib}.{LB}.unmapped.fastq.1.gz {wildcards.lib}.{LB}.unmapped_1.fastq.gz
        fi
        if [ -f {wildcards.lib}.{LB}.unmapped.fastq.2.gz ]; then
            mv {wildcards.lib}.{LB}.unmapped.fastq.2.gz {wildcards.lib}.{LB}.unmapped_2.fastq.gz
        fi
        mv {wildcards.lib}.{LBR}.bam {output.bam}
        mv {wildcards.lib}.{LB}.bowtie2.log {output.log}
        for f in {params.unmapped}; do mkdir -p $(dirname $f); mv $(basename $f) $f; done
        """


# CHROMAP_CHROMAP (--SAM, then samtools addreplacerg + view -bh)
rule chromap:
    input:
        reads=lambda wc: trimmed_reads(wc.lib),
        index=INDEX,
        fasta=FASTA,
    output:
        f"{W}/chromap/library/{{lib}}.{LBR}.bam",
    params:
        args=args("chromap"),
        args3=lambda wc: f"-r {LIBS[wc.lib]['read_group']}",
        link=link_reads_cmd,
        reads=lambda wc: (f"-1 {','.join(read_links(wc.lib))}" if LIBS[wc.lib]["single_end"]
                          else f"-1 {read_links(wc.lib)[0]} -2 {read_links(wc.lib)[1]}"),
        index=os.path.basename(INDEX),
    container:
        container_path("chromap")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        {params.link}
        if [ -d {input.index} ]; then
            for f in $(find -L {input.index} -type f | sort); do ln -s $(realpath $f) $(basename $f); done
            idx=$(find -L {input.index} -type f | sort | xargs -n1 basename | tr '\n' ' ')
        else
            ln -s $(realpath {input.index}) {params.index}
            idx={params.index}
        fi
        ln -s $(realpath {input.fasta}) {FASTA_NAME}
        p={wildcards.lib}.{LBR}
        chromap {params.args} -t {threads} -x $idx -r {FASTA_NAME} {params.reads} -o $p.sam
        samtools addreplacerg {params.args3} -o $p.rg.sam $p.sam
        samtools view -@ {threads} -bh -o $p.bam $p.rg.sam
        rm $p.rg.sam $p.sam
        mv $p.bam {output}
        """


# STAR_ALIGN (local module, STAR 2.6.1d)
rule star_align:
    input:
        reads=lambda wc: trimmed_reads(wc.lib),
        index=INDEX,
    output:
        bam=f"{W}/star/library/{{lib}}.Aligned.out.bam",
        log_final=f"{AL}/library/log/{{lib}}.Log.final.out",
        log_out=f"{AL}/library/log/{{lib}}.Log.out",
        log_progress=f"{AL}/library/log/{{lib}}.Log.progress.out",
        tab=f"{AL}/library/log/{{lib}}.SJ.out.tab",
    params:
        args=args("star_align") + (" --outReadsUnmapped Fastx" if SAVE_UNALIGNED else ""),
        rg=lambda wc: (f"--outSAMattrRGline ID:{wc.lib} 'CN:{param('seq_center')}' 'SM:{wc.lib}'"
                       if param("seq_center") else f"--outSAMattrRGline ID:{wc.lib} 'SM:{wc.lib}'"),
        link=link_reads_cmd,
        reads=lambda wc: " ".join(read_links(wc.lib)),
        unmapped_dir=os.path.abspath(f"{AL}/library/unmapped"),
    container:
        container_path("star")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        {params.link}
        ln -s $(realpath {input.index}) star
        p={wildcards.lib}
        STAR --genomeDir star --readFilesIn {params.reads} --runThreadN {threads} \
            --outFileNamePrefix $p. {params.rg} {params.args}
        for m in 1 2; do
            if [ -f $p.Unmapped.out.mate$m ]; then
                mv $p.Unmapped.out.mate$m $p.unmapped_$m.fastq
                gzip $p.unmapped_$m.fastq
                mkdir -p {params.unmapped_dir} && mv $p.unmapped_$m.fastq.gz {params.unmapped_dir}/
            fi
        done
        mv $p.Aligned.out.bam {output.bam}
        mv $p.Log.final.out {output.log_final}
        mv $p.Log.out {output.log_out}
        mv $p.Log.progress.out {output.log_progress}
        mv $p.SJ.out.tab {output.tab}
        """


def aligner_bam(wc):
    if ALIGNER == "star":
        return f"{W}/star/library/{wc.lib}.Aligned.out.bam"
    return f"{W}/{ALIGNER}/library/{wc.lib}.{LBR}.bam"


