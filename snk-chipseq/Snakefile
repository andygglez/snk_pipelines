        plotProfile --matrixFile $(basename {input}) --outFileName $p.plotProfile.pdf --outFileNameData $p.plotProfile.tab
        mv $p.plotProfile.pdf {output.pdf}
        mv $p.plotProfile.tab {output.tab}
        """


