# ANNOTATE_BOOLEAN_PEAKS
rule annotate_boolean_peaks:
    input:
        boolean=f"{CONSENSUS}.boolean.txt",
        homer=f"{CONSENSUS}.annotatePeaks.txt",
    output:
        f"{CONSENSUS}.boolean.annotatePeaks.txt",
