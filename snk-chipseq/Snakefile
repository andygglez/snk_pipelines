# BED_CONSENSUS_QUANTIFY_QC_BEDTOOLS_FEATURECOUNTS_DESEQ2
# =============================================================================
CONSENSUS = f"{MACS}/consensus/{{antibody}}/{{antibody}}.consensus_peaks"


# MACS3_CONSENSUS (runs when the antibody has several groups or replicates)
rule macs3_consensus:
    input:
        lambda wc: sorted((peak_file(s) for s in antibody_groups()[wc.antibody]["peaks"]), key=os.path.basename),
    output:
        bed=f"{CONSENSUS}.bed",
        saf=f"{CONSENSUS}.saf",
        boolean=f"{CONSENSUS}.boolean.txt",
        intersect=f"{CONSENSUS}.boolean.intersect.txt",
        pdf=f"{CONSENSUS}.boolean.intersect.plot.pdf",
        antibody=f"{CONSENSUS}.antibody.txt",
        txt=f"{W}/consensus/{{antibody}}.consensus_peaks.txt",
    params:
        mergecols=",".join(str(i) for i in range(2, 11 if NARROW else 10)),
        collapsecols=",".join(["collapse"] * (9 if NARROW else 8)),
        files=lambda wc, input: " ".join(os.path.basename(f) for f in input),
        names=lambda wc, input: ",".join(os.path.basename(f) for f in input).replace(f"_peaks.{PEAK_EXT}", ""),
        min_reps=config["min_reps_consensus"],
        narrow="--is_narrow_peak" if NARROW else "",
    container:
        container_path("consensus")
    threads: res("process_default")["threads"]
    resources:
        mem_mb=res("process_default")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input}; do ln -s $(realpath $f) $(basename $f); done
        p={wildcards.antibody}.consensus_peaks
        sort -T '.' -k1,1 -k2,2n {params.files} \
            | mergeBed -c {params.mergecols} -o {params.collapsecols} > $p.txt
        python3 {SCRIPTS}/macs3_merged_expand.py $p.txt {params.names} $p.boolean.txt \
            --min_replicates {params.min_reps} {params.narrow}
        awk -v FS='\\t' -v OFS='\\t' 'FNR > 1 {{ print $1, $2, $3, $4, "0", "+" }}' $p.boolean.txt > $p.bed
        printf 'GeneID\\tChr\\tStart\\tEnd\\tStrand\\n' > $p.saf
        awk -v FS='\\t' -v OFS='\\t' 'FNR > 1 {{ print $4, $1, $2, $3,  "+" }}' $p.boolean.txt >> $p.saf
        {SCRIPTS}/plot_peak_intersect.r -i $p.boolean.intersect.txt -o $p.boolean.intersect.plot.pdf
        printf '%s\\t%s\\n' "$p.bed" "{wildcards.antibody}/$p.bed" > $p.antibody.txt
        mv $p.bed {output.bed}
        mv $p.saf {output.saf}
        mv $p.boolean.txt {output.boolean}
        mv $p.boolean.intersect.txt {output.intersect}
        mv $p.boolean.intersect.plot.pdf {output.pdf}
        mv $p.antibody.txt {output.antibody}
        mv $p.txt {output.txt}
        """


