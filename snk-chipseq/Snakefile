def ip_control_bams(s):
    ctrl = SAMPLES[s]["control"]  # empty: port-sheet ChIP sample without a control
    return {"ip": clean_bam(s), "ip_bai": f"{clean_bam(s)}.bai",
            "control": clean_bam(ctrl) if ctrl else [], "control_bai": f"{clean_bam(ctrl)}.bai" if ctrl else []}


def macs3_control_arg(s):
    ctrl = SAMPLES[s]["control"]
    return f"--control {os.path.basename(clean_bam(ctrl))}" if ctrl else ""


LINK_IP_CONTROL = """
        for f in {input.ip} {input.ip_bai} {input.control} {input.control_bai}; do
            ln -s $(realpath $f) $(basename $f)
        done
"""


# DEEPTOOLS_PLOTFINGERPRINT (IP + its control)
rule deeptools_plotfingerprint:
    input:
        unpack(lambda wc: ip_control_bams(wc.sample)),
    output:
        pdf=f"{ML}/deepTools/plotFingerprint/{{sample}}.{CLNP}.plotFingerprint.pdf",
        raw=f"{ML}/deepTools/plotFingerprint/{{sample}}.{CLNP}.plotFingerprint.raw.txt",
        qc=f"{ML}/deepTools/plotFingerprint/{{sample}}.{CLNP}.plotFingerprint.qcmetrics.txt",
    params:
        args=lambda wc: join_args([args("plotfingerprint"), f"--numberOfSamples {config['fingerprint_bins']}",
                                   f"--labels {wc.sample} {SAMPLES[wc.sample]['control']}".rstrip()]),
        extend_reads=lambda wc: (f"--extendReads {config['fragment_size']}"
                           if SAMPLES[wc.sample]["single_end"] and float(config["fragment_size"] or 0) > 0 else ""),
        # IP + control (port sheets: IP alone when it has no control)
        bams=lambda wc: " ".join(os.path.basename(b) for b in (ip_control_bams(wc.sample)["ip"],
                                                              ip_control_bams(wc.sample)["control"]) if b),
    container:
        container_path("deeptools")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        LINK_IP_CONTROL + """
        p={wildcards.sample}.{CLNP}
        plotFingerprint {params.args} {params.extend_reads} \
            --bamfiles {params.bams} \
            --plotFile $p.plotFingerprint.pdf --outRawCounts $p.plotFingerprint.raw.txt \
            --outQualityMetrics $p.plotFingerprint.qcmetrics.txt --numberOfProcessors {threads}
        mv $p.plotFingerprint.pdf {output.pdf}
        mv $p.plotFingerprint.raw.txt {output.raw}
        mv $p.plotFingerprint.qcmetrics.txt {output.qc}
        """


