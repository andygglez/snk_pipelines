# BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT (library, prefix <id>.Lb.sorted)
rule samtools_sort_library:
    input:
        bam=aligner_bam,
        fasta=FASTA,
    output:
        f"{LIB_DIR}/{{lib}}.{LBS}.bam",
    container:
        container_path("samtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.bam}) $(basename {input.bam})
        ln -s $(realpath {input.fasta}) {FASTA_NAME}
        p={wildcards.lib}.{LBS}
        samtools cat --threads {threads} $(basename {input.bam}) \
            | samtools sort -T $p --threads {threads} --reference {FASTA_NAME} -o $p.bam -
        mv $p.bam {output}
        """


BAM_DIRS = sorted({LIB_DIR, MRG_DIR, ML})
STAT_BAM = (r"[^/]+\.(?:" + "|".join(re.escape(x) for x in (LBS, MKDS, CLNS))
            + r")\.bam")


# SAMTOOLS_INDEX (library, markduplicates and filtered BAMs)
rule samtools_index:
    input:
        "{bdir}/{bam}",
    output:
        "{bdir}/{bam}.bai",
    wildcard_constraints:
        bdir=alternation(BAM_DIRS),
        bam=STAT_BAM,
    container:
        container_path("samtools")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shell:
        "samtools index -@ $(({threads} - 1)) {input}"


# BAM_STATS_SAMTOOLS:SAMTOOLS_STATS (with --reference, as ch_fasta is given)
rule samtools_stats:
    input:
        bam="{bdir}/{bam}",
        bai="{bdir}/{bam}.bai",
        fasta=FASTA,
    output:
        "{bdir}/samtools_stats/{bam}.stats",
    wildcard_constraints:
        bdir=alternation(BAM_DIRS),
        bam=STAT_BAM,
    container:
        container_path("samtools")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.bam}) {wildcards.bam}
        ln -s $(realpath {input.bai}) {wildcards.bam}.bai
        ln -s $(realpath {input.fasta}) {FASTA_NAME}
        samtools stats --threads {threads} --reference {FASTA_NAME} {wildcards.bam} > {wildcards.bam}.stats
        mv {wildcards.bam}.stats {output}
        """


