# chipbinner image (snk-chipseq port extension; no nf-core counterpart).
# Python stack of snk-chipseq/scripts/chipbinner, pinned to the versions the port
# was validated with. python-kaleido 0.2.1 bundles its own headless Chromium, so
# static plots (pdf/png/svg) work on offline compute nodes without apt packages.
#
# Build (needs internet, e.g. a Rorqual login node; `pipeline pull chipseq` does this):
#   apptainer build --fakeroot containers/chipbinner.sif containers/chipbinner.def
Bootstrap: docker
From: mambaorg/micromamba:2.0.5

%labels
    org.opencontainers.image.title chipbinner
    org.opencontainers.image.description Python port of padilr1/ChIPbinner (snk-chipseq)

%post
    export MAMBA_ROOT_PREFIX=/opt/conda
    micromamba install -y -p /opt/conda -c conda-forge -c bioconda --strict-channel-priority \
        python=3.12 \
        numpy=2.3.5 pandas=2.3.3 scipy=1.16.3 scikit-learn=1.7.2 hdbscan=0.8.40 \
        plotly=6.3.0 python-kaleido=0.2.1 \
        pybigwig=0.3.25 pysam=0.23.3 pyyaml=6.0.3 \
        fonts-conda-ecosystem procps-ng
    micromamba clean -a -y

%environment
    export PATH=/opt/conda/bin:$PATH
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PYTHONNOUSERSITE=1

%test
    export PATH=/opt/conda/bin:$PATH
    python3 -c "import numpy, pandas, scipy, sklearn, hdbscan, plotly, kaleido, pyBigWig, pysam, yaml"
    python3 - <<'EOF'
import os, tempfile
import plotly.graph_objects as go
p = os.path.join(tempfile.mkdtemp(), "t.pdf")
go.Figure(go.Scatter(x=[0, 1], y=[0, 1])).write_image(p)
assert os.path.getsize(p) > 0
print("kaleido static export ok")
EOF
