if RIBO == "sortmerna":

    # SORTMERNA (ext.args '--num_alignments 1 -v --index 0')
    rule sortmerna:
        input:
            reads=lambda wc: reads_bbsplit(wc.sample),
            lint=lambda wc: lint_gate(wc.sample, "bbsplit"),
            fastas=RRNA_FASTAS,
            index=SORTMERNA_INDEX,
        output:
            reads=f"{RIBO_D}/{{sample}}.non_rRNA.fastq.gz",
            log=pub("sortmerna") + "/{sample}.sortmerna.log",
        wildcard_constraints:
            sample=alternation(SE),
        params:
            refs=lambda wc, input: " ".join(f"--ref {os.path.basename(f)}" for f in input.fastas),
        container:
            container_path("sortmerna")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            for f in {input.fastas} {input.reads}; do ln -s $(realpath $f) $(basename $f); done
            ln -s $(realpath {input.index}) idx
            sortmerna {params.refs} --idx-dir idx --reads $(basename {input.reads[0]}) --threads {threads} \
                --workdir . --aligned rRNA_reads --fastx --other non_rRNA_reads \
                --num_alignments 1 -v --index 0
            mv non_rRNA_reads.f*q.gz {output.reads}
            mv rRNA_reads.log {output.log}
            """

    rule sortmerna_pe:
        input:
            reads=lambda wc: reads_bbsplit(wc.sample),
            lint=lambda wc: lint_gate(wc.sample, "bbsplit"),
            fastas=RRNA_FASTAS,
            index=SORTMERNA_INDEX,
        output:
            r1=f"{RIBO_D}/{{sample}}_1.non_rRNA.fastq.gz",
            r2=f"{RIBO_D}/{{sample}}_2.non_rRNA.fastq.gz",
            log=pub("sortmerna") + "/{sample}.sortmerna.log",
        wildcard_constraints:
            sample=alternation(PE),
        params:
            refs=lambda wc, input: " ".join(f"--ref {os.path.basename(f)}" for f in input.fastas),
        container:
            container_path("sortmerna")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            for f in {input.fastas} {input.reads}; do ln -s $(realpath $f) $(basename $f); done
            ln -s $(realpath {input.index}) idx
            sortmerna {params.refs} --idx-dir idx --reads $(basename {input.reads[0]}) --reads $(basename {input.reads[1]}) \
                --threads {threads} --workdir . --aligned rRNA_reads --fastx --other non_rRNA_reads \
                --paired_in --out2 --num_alignments 1 -v --index 0
            mv non_rRNA_reads_fwd.f*q.gz {output.r1}
            mv non_rRNA_reads_rev.f*q.gz {output.r2}
            mv rRNA_reads.log {output.log}
            """

