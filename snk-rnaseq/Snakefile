# PICARD_MARKDUPLICATES
rule picard_markduplicates:
    input:
        bam=f"{SORTED_DIR}/{{sample}}.sorted.bam",
        fasta=FASTA,
        fai=FAI,
    output:
        bam=f"{AL}/{{sample}}.markdup.sorted.bam",
        metrics=f"{AL}/picard_metrics/{{sample}}.markdup.sorted.metrics.txt",
    params:
        mem=lambda wc, resources: int(resources.mem_mb * 0.8),
    container:
        container_path("picard")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bam} {input.fasta} {input.fai}; do ln -s $(realpath $f) $(basename $f); done
        p={wildcards.sample}.markdup.sorted
        picard -Xmx{params.mem}M MarkDuplicates \
            --ASSUME_SORTED true --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp \
            --INPUT $(basename {input.bam}) --OUTPUT $p.bam --REFERENCE_SEQUENCE $(basename {input.fasta}) \
            --METRICS_FILE $p.metrics.txt
        mv $p.bam {output.bam}
        mv $p.metrics.txt {output.metrics}
        """


# SAMTOOLS_INDEX (BAM_MARKDUPLICATES_PICARD)
rule samtools_index_markdup:
    input:
        f"{AL}/{{sample}}.markdup.sorted.bam",
    output:
        f"{AL}/{{sample}}.markdup.sorted.bam.bai",
    container:
        container_path("samtools")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shell:
        "samtools index -@ {threads} {input}"


def final_bam_bai(wc):
    bam = final_bam(wc.sample)
    return {"bam": bam, "bai": bam + ".bai"}


# =============================================================================
# STRINGTIE
# =============================================================================

# STRINGTIE_STRINGTIE (mode expression-estimation, ext.args '<--fr|--rf> -v')
rule stringtie:
    input:
        unpack(final_bam_bai),
        gtf=GTF,
        strand=strand_file,
    output:
        gtf=f"{AL}/stringtie/{{sample}}.transcripts.gtf",
        abundance=f"{AL}/stringtie/{{sample}}.gene.abundance.txt",
        coverage=f"{AL}/stringtie/{{sample}}.coverage.gtf",
        ballgown=directory(f"{AL}/stringtie/{{sample}}.ballgown"),
    container:
        container_path("stringtie")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bam} {input.bai} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
        case "$(cat {input.strand})" in forward) s=--fr ;; reverse) s=--rf ;; *) s= ;; esac
        p={wildcards.sample}
        stringtie -o $p.transcripts.gtf -e -G $(basename {input.gtf}) -A $p.gene.abundance.txt \
            -C $p.coverage.gtf -b $p.ballgown -p {threads} $(basename {input.bam}) $s -v
        mv $p.transcripts.gtf {output.gtf}
        mv $p.gene.abundance.txt {output.abundance}
        mv $p.coverage.gtf {output.coverage}
        mv $p.ballgown {output.ballgown}
        """


