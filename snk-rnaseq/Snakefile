        """


# Groovy in FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS: strandedness 'auto' is
# replaced by the Salmon inference (undetermined -> unstranded).
rule strandedness:
    input:
        lambda wc: (
            f"{W}/strand/{wc.sample}/lib_format_counts.json"
            if SAMPLES[wc.sample]["strandedness"] == "auto" else []
        ),
    output:
        json=f"{W}/status/{{sample}}.strand.json",
        txt=f"{W}/status/{{sample}}.strandedness",
    run:
        provided = SAMPLES[wildcards.sample]["strandedness"]
        analysis = None
        value = provided
        if provided == "auto":
            analysis = salmon_strandedness(
                input[0], float(config["stranded_threshold"]), float(config["unstranded_threshold"])
            )
            value = analysis["inferred_strandedness"]
            if value == "undetermined":
                value = "unstranded"
        with open(output.json, "w") as fh:
            json.dump({"sample": wildcards.sample, "provided": provided, "strandedness": value,
                       "salmon_strand_analysis": analysis}, fh)
        with open(output.txt, "w") as fh:
            fh.write(value + "\n")


# =============================================================================
# ALIGN_STAR
# =============================================================================
def star_align_args(s):
    """conf/modules/align_star.config ext.args (star_salmon, non-Parabricks)."""
    args = [
        "--quantMode TranscriptomeSAM",
        "--outSAMtype BAM Unsorted",
        "--outSAMattributes NH HI AS NM MD",
        "--readFilesCommand zcat",
        "--twopassMode Basic",
        "--runRNGseed 0",
        "--outFilterMultimapNmax 20",
        "--alignSJDBoverhangMin 1",
        "--outSAMstrandField intronMotif",
        "--quantTranscriptomeSAMoutput BanSingleEnd",
    ]
    if flag("save_unaligned"):
        args.append("--outReadsUnmapped Fastx")
    if config["extra_star_align_args"]:
        merged = OrderedDict()
        for token in re.split(r"\s(?=--)", " ".join(args) + " " + config["extra_star_align_args"]):
            parts = token.strip().split(None, 1)
            merged[parts[0]] = parts[1] if len(parts) > 1 else ""
        args = [f"{k} {v}" if v else k for k, v in merged.items()]
    meta = SAMPLES[s]
    rg = [f"'ID:{s}'", f"'SM:{s}'"]
    platform = meta["seq_platform"] or config["seq_platform"]
    center = meta["seq_center"] or config["seq_center"]
    if platform:
        rg.append(f"'PL:{platform}'")
    if center:
        rg.append(f"'CN:{center}'")
    args.append(f"--outSAMattrRGline {' '.join(rg)}")
    return " ".join(args)


# STAR_ALIGN
rule star_align:
    input:
        reads=lambda wc: reads_filtered(wc.sample),
        lint=lambda wc: lint_gate(wc.sample, "bbsplit"),
        index=STAR_INDEX,
        gtf=GTF,
    output:
        bam=f"{STAR_DIR}/{{sample}}.Aligned.out.bam" if SAVE_ALIGN else temp(f"{STAR_DIR}/{{sample}}.Aligned.out.bam"),
        tx_bam=f"{STAR_DIR}/{{sample}}.Aligned.toTranscriptome.out.bam",
        log_final=f"{AL}/log/{{sample}}.Log.final.out",
        log_out=f"{AL}/log/{{sample}}.Log.out",
        log_progress=f"{AL}/log/{{sample}}.Log.progress.out",
        sj=f"{AL}/log/{{sample}}.SJ.out.tab",
    params:
        args=lambda wc: star_align_args(wc.sample),
        gtf=lambda wc, input: "" if flag("star_ignore_sjdbgtf") else f"--sjdbGTFfile {input.gtf}",
        unmapped=os.path.abspath(f"{AL}/unmapped") if flag("save_unaligned") else "",
    container:
        container_path("star")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        p={wildcards.sample}
        STAR --genomeDir {input.index} --readFilesIn {input.reads} --runThreadN {threads} \
            --outFileNamePrefix $p. {params.gtf} {params.args}
        for m in 1 2; do
            if [ -f $p.Unmapped.out.mate$m ]; then
                mv $p.Unmapped.out.mate$m $p.unmapped_$m.fastq
                gzip $p.unmapped_$m.fastq
            fi
        done
        mv $p.Aligned.out.bam {output.bam}
        mv $p.Aligned.toTranscriptome.out.bam {output.tx_bam}
        mv $p.Log.final.out {output.log_final}
        mv $p.Log.out {output.log_out}
        mv $p.Log.progress.out {output.log_progress}
        mv $p.SJ.out.tab {output.sj}
        if [ -n "{params.unmapped}" ]; then mkdir -p {params.unmapped}; mv $p.unmapped_*.fastq.gz {params.unmapped}/; fi
        """


# Groovy in ALIGN_STAR / RNASEQ: getStarPercentMapped vs min_mapped_reads.
rule map_status:
    input:
        f"{AL}/log/{{sample}}.Log.final.out",
    output:
        json=f"{W}/status/{{sample}}.map.json",
    run:
        pm = star_percent_mapped(input[0])
        with open(output.json, "w") as fh:
            json.dump({"sample": wildcards.sample, "percent_mapped": pm,
                       "pass": pm >= float(config["min_mapped_reads"])}, fh)


checkpoint sample_summary:
    input:
        strand=lambda wc: [f"{W}/status/{s}.strand.json" for s in samples_trimmed()],
        map=lambda wc: [f"{W}/status/{s}.map.json" for s in samples_trimmed()],
    output:
        f"{W}/status/sample_summary.json",
    run:
        summary = {}
        for kind in ("strand", "map"):
            for f in input[kind]:
                with open(f) as fh:
                    st = json.load(fh)
                summary.setdefault(st["sample"], {})[kind] = st
        with open(output[0], "w") as fh:
            json.dump(summary, fh, indent=1)


# SAMTOOLS_SORT (BAM_SORT_STATS_SAMTOOLS, prefix <id>.sorted)
rule samtools_sort:
    input:
        bam=f"{STAR_DIR}/{{sample}}.Aligned.out.bam",
        fasta=FASTA,
        fai=FAI,
    output:
        f"{SORTED_DIR}/{{sample}}.sorted.bam",
    container:
        container_path("samtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir 1
        ln -s $(realpath {input.bam}) 1/$(basename {input.bam})
        ln -s $(realpath {input.fasta}) $(basename {input.fasta})
        ln -s $(realpath {input.fai}) $(basename {input.fai})
        samtools cat 1/$(basename {input.bam}) | samtools sort -T {wildcards.sample}.sorted \
            --threads {threads} --reference $(basename {input.fasta}) -o {wildcards.sample}.sorted.bam -
        mv {wildcards.sample}.sorted.bam {output}
        """


