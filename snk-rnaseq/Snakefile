        cat {input.r2} {params.compress} > {output.r2}
        """


def lint_input(wc):
    return {
        "raw": reads_cat,
        "trimmed": reads_trimmed,
        "bbsplit": reads_filtered,
    }[wc.lint_stage](wc.sample)


# FQ_LINT / FQ_LINT_AFTER_TRIMMING / FQ_LINT_AFTER_BBSPLIT. The aliases are the
# same FQ_LINT process, so withName: 'FQ_LINT' (ext.args extra_fqlint_args)
# applies to all three.
rule fq_lint:
    input:
        lint_input,
    output:
        f"{O}/fq_lint/{{lint_stage}}/{{sample}}.fq_lint.txt",
    wildcard_constraints:
        lint_stage="raw|trimmed|bbsplit",
    params:
        args=config["extra_fqlint_args"] or "",
    container:
        container_path("fq")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shell:
        "fq lint {params.args} {input} > {output}"


def fastqc_input(wc):
    files = reads_cat(wc.sample) if wc.stage == "raw" else reads_filtered(wc.sample)
    return mate_file(files, wc.mate)


# FASTQC (raw: FASTQ_FASTQC_UMITOOLS_TRIMGALORE:FASTQC, prefix <id>_raw;
# filtered: FASTQC_FILTERED, prefix <id>_filtered). nf-core runs both mates in
# one process; here each mate is its own job (same files, same arguments).
rule fastqc:
    input:
        fastqc_input,
    output:
        html=f"{O}/fastqc/{{stage}}/{{sample}}_{{stage}}{{mate}}_fastqc.html",
        zip=f"{O}/fastqc/{{stage}}/{{sample}}_{{stage}}{{mate}}_fastqc.zip",
    params:
        # FastQC --memory is per thread, clamped to 100..10000 MB
        memory=lambda wc, threads, resources: min(10000, max(100, int(resources.mem_mb / threads))),
        link=lambda wc, input: f"{wc.sample}_{wc.stage}{wc.mate}.{input[0].rsplit('.', 1)[-1]}",
    container:
        container_path("fastqc")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input}) {params.link}
        fastqc --quiet --threads {threads} --memory {params.memory} {params.link}
        mv {wildcards.sample}_{wildcards.stage}{wildcards.mate}_fastqc.html {output.html}
        mv {wildcards.sample}_{wildcards.stage}{wildcards.mate}_fastqc.zip {output.zip}
        """


def trimgalore_args(threads, single_end):
    """conf/modules/trimgalore.config ext.args (preset map overridden by extra args)."""
    args = {"--fastqc_args": f"'-t {threads}'"}
    extra = config["extra_trimgalore_args"] or ""
    for arg in re.split(r"\s(?=--)", extra.strip()) if extra.strip() else []:
        parts = arg.strip().split(None, 1)
        args[parts[0]] = parts[-1]
    joined = " ".join(f"{k} {v}" for k, v in args.items()).strip()
    if single_end:
        kept = [a for a in re.split(r"\s(?=--)", joined) if "_r2 " not in a.lower()]
        joined = " ".join(kept)
    return joined


def trimgalore_cores(threads, single_end):
    cores = threads - (3 if single_end else 4)
    return min(8, max(1, cores))


def trimgalore_outputs(s):
    p = f"{s}_trimmed"
    if SAMPLES[s]["single_end"]:
        return [f"{O}/trimgalore/{p}.fastq.gz_trimming_report.txt",
                f"{O}/fastqc/trim/{p}_trimmed_fastqc.html", f"{O}/fastqc/trim/{p}_trimmed_fastqc.zip"]
    return [f"{O}/trimgalore/{p}_{r}.fastq.gz_trimming_report.txt" for r in (1, 2)] + [
        f"{O}/fastqc/trim/{p}_{r}_val_{r}_fastqc.{e}" for r in (1, 2) for e in ("html", "zip")
    ]


# TRIMGALORE (paired-end)
rule trimgalore_pe:
    input:
        reads=lambda wc: reads_cat(wc.pe_sample),
        lint=lambda wc: lint_gate(wc.pe_sample, "raw"),
    output:
        r1=f"{TRIM_DIR}/{{pe_sample}}_trimmed_1_val_1.fq.gz",
        r2=f"{TRIM_DIR}/{{pe_sample}}_trimmed_2_val_2.fq.gz",
        log1=f"{O}/trimgalore/{{pe_sample}}_trimmed_1.fastq.gz_trimming_report.txt",
        log2=f"{O}/trimgalore/{{pe_sample}}_trimmed_2.fastq.gz_trimming_report.txt",
        json1=f"{W}/trimgalore/{{pe_sample}}_trimmed_1.fastq.gz_trimming_report.json",
        json2=f"{W}/trimgalore/{{pe_sample}}_trimmed_2.fastq.gz_trimming_report.json",
        html1=f"{O}/fastqc/trim/{{pe_sample}}_trimmed_1_val_1_fastqc.html",
        zip1=f"{O}/fastqc/trim/{{pe_sample}}_trimmed_1_val_1_fastqc.zip",
        html2=f"{O}/fastqc/trim/{{pe_sample}}_trimmed_2_val_2_fastqc.html",
        zip2=f"{O}/fastqc/trim/{{pe_sample}}_trimmed_2_val_2_fastqc.zip",
    params:
        args=lambda wc, threads: trimgalore_args(threads, False),
        cores=lambda wc, threads: trimgalore_cores(threads, False),
        p=lambda wc: f"{wc.pe_sample}_trimmed",
    container:
        container_path("trimgalore")
    threads: res("trimgalore")["threads"]
    resources:
        mem_mb=res("trimgalore")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.reads[0]}) {params.p}_1.fastq.gz
        ln -s $(realpath {input.reads[1]}) {params.p}_2.fastq.gz
        trim_galore {params.args} --cores {params.cores} --paired --gzip \
            {params.p}_1.fastq.gz {params.p}_2.fastq.gz
        mv {params.p}_1_val_1.fq.gz {output.r1}
        mv {params.p}_2_val_2.fq.gz {output.r2}
        mv {params.p}_1.fastq.gz_trimming_report.txt {output.log1}
        mv {params.p}_2.fastq.gz_trimming_report.txt {output.log2}
        mv {params.p}_1.fastq.gz_trimming_report.json {output.json1}
        mv {params.p}_2.fastq.gz_trimming_report.json {output.json2}
        mv {params.p}_1_val_1_fastqc.html {output.html1}
        mv {params.p}_1_val_1_fastqc.zip {output.zip1}
        mv {params.p}_2_val_2_fastqc.html {output.html2}
        mv {params.p}_2_val_2_fastqc.zip {output.zip2}
        """


# TRIMGALORE (single-end)
