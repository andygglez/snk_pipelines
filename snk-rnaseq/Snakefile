        hist=f"{AL}/dupradar/histogram/{{sample}}_expressionHist.pdf",
        matrix=f"{AL}/dupradar/gene_data/{{sample}}_dupMatrix.txt",
        slope=f"{AL}/dupradar/intercepts_slope/{{sample}}_intercept_slope.txt",
        mqc_intercept=f"{W}/dupradar/{{sample}}_dup_intercept_mqc.txt",
        mqc_curve=f"{W}/dupradar/{{sample}}_duprateExpDensCurve_mqc.txt",
    params:
        single_end=lambda wc: "true" if SAMPLES[wc.sample]["single_end"] else "false",
    container:
        container_path("dupradar")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bam} {input.bai} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
        s={wildcards.sample}
        TPL_bam=$(basename {input.bam}) TPL_gtf=$(basename {input.gtf}) TPL_task_ext_prefix=null TPL_meta_id=$s \
        TPL_task_cpus={threads} TPL_task_ext_args=null TPL_meta_strandedness=$(cat {input.strand}) \
        TPL_meta_single_end={params.single_end} TPL_task_process=DUPRADAR \
            Rscript {SCRIPTS}/dupradar.r
        mv ${{s}}_duprateExpDens.pdf {output.scatter}
        mv ${{s}}_duprateExpBoxplot.pdf {output.boxplot}
        mv ${{s}}_expressionHist.pdf {output.hist}
        mv ${{s}}_dupMatrix.txt {output.matrix}
        mv ${{s}}_intercept_slope.txt {output.slope}
        mv ${{s}}_dup_intercept_mqc.txt {output.mqc_intercept}
        mv ${{s}}_duprateExpDensCurve_mqc.txt {output.mqc_curve}
        """


# -----------------------------------------------------------------------------
# BAM_RSEQC
# -----------------------------------------------------------------------------
R = f"{AL}/rseqc"


def rseqc_files(mod, s):
    """Published files of each RSeQC module (conf/modules/rseqc.config)."""
    if mod == "bam_stat":
        return [f"{R}/bam_stat/{s}.bam_stat.txt"]
    if mod == "infer_experiment":
        return [f"{R}/infer_experiment/{s}.infer_experiment.txt"]
    if mod == "inner_distance":
        if SAMPLES[s]["single_end"]:
            return [f"{R}/inner_distance/txt/{s}.inner_distance.txt"]
        return [f"{R}/inner_distance/txt/{s}.inner_distance{x}.txt" for x in ("", "_freq", "_mean")] + [
            f"{R}/inner_distance/pdf/{s}.inner_distance_plot.pdf",
            f"{R}/inner_distance/rscript/{s}.inner_distance_plot.r",
        ]
    if mod == "junction_annotation":
        return [
            f"{R}/junction_annotation/bed/{s}.junction.bed",
            f"{R}/junction_annotation/bed/{s}.junction.Interact.bed",
            f"{R}/junction_annotation/xls/{s}.junction.xls",
            f"{R}/junction_annotation/pdf/{s}.splice_events.pdf",
            f"{R}/junction_annotation/pdf/{s}.splice_junction.pdf",
            f"{R}/junction_annotation/rscript/{s}.junction_plot.r",
            f"{R}/junction_annotation/log/{s}.junction_annotation.log",
        ]
    if mod == "junction_saturation":
        return [f"{R}/junction_saturation/pdf/{s}.junctionSaturation_plot.pdf",
                f"{R}/junction_saturation/rscript/{s}.junctionSaturation_plot.r"]
    if mod == "read_distribution":
        return [f"{R}/read_distribution/{s}.read_distribution.txt"]
    if mod == "read_duplication":
        return [f"{R}/read_duplication/xls/{s}.seq.DupRate.xls",
                f"{R}/read_duplication/xls/{s}.pos.DupRate.xls",
                f"{R}/read_duplication/pdf/{s}.DupRate_plot.pdf",
                f"{R}/read_duplication/rscript/{s}.DupRate_plot.r"]
    if mod == "tin":
        return [f"{R}/tin/{s}.summary.txt", f"{R}/tin/{s}.tin.xls"]
    raise ValueError(f"Unknown rseqc module {mod!r}")


