# PRESEQ_LCEXTRAP (skip_preseq: true by default). nf-core retries once with
# -defects; here a failure is final.
rule preseq_lcextrap:
    input:
        unpack(final_bam_bai),
    output:
        txt=f"{AL}/preseq/{{sample}}.lc_extrap.txt",
        log=f"{AL}/preseq/log/{{sample}}.command.log",
    params:
        pe=lambda wc: "" if SAMPLES[wc.sample]["single_end"] else "-pe",
    container:
        container_path("preseq")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        preseq lc_extrap -verbose -bam -seed 1 -seg_len 100000000 {params.pe} \
            -output {output.txt} {input.bam} 2> {output.log}
        """


# SUBREAD_FEATURECOUNTS (biotype QC)
rule featurecounts:
    input:
        unpack(final_bam_bai),
        gtf=GTF,
        strand=strand_file,
    output:
        counts=f"{AL}/featurecounts/{{sample}}.featureCounts.tsv",
        summary=f"{AL}/featurecounts/{{sample}}.featureCounts.tsv.summary",
    params:
        args=f"-B -C -g {BIOTYPE} -t {config['featurecounts_feature_type']}",
        pe=lambda wc: "" if SAMPLES[wc.sample]["single_end"] else "-p",
    container:
        container_path("subread")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bam} {input.bai} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
        case "$(cat {input.strand})" in forward) s=1 ;; reverse) s=2 ;; *) s=0 ;; esac
        p={wildcards.sample}.featureCounts.tsv
        featureCounts {params.args} {params.pe} -T {threads} -a $(basename {input.gtf}) -s $s \
            -o $p $(basename {input.bam})
        mv $p {output.counts}
        mv $p.summary {output.summary}
        """


