            TPL_fasta={input.fasta} TPL_gtf={input.gtf} TPL_add_fasta={input.add_fasta} \
            TPL_biotype='{params.biotype}' TPL_prefix={params.prefix} \
            TPL_task_process=CUSTOM_CATADDITIONALFASTA \
                python3 {SCRIPTS}/fasta2gtf.py
            mv out/{params.prefix}.fasta {output.fasta}
            mv out/{params.prefix}.gtf {output.gtf}
            """


if not cfg("gene_bed") and PROKARYOTIC:

    # GFFREAD_GENE_BED (prokaryotic: gtf2bed only handles exon features)
