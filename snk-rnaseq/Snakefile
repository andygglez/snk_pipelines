    output:
        bed=f"{RP}/junction_annotation/bed/{{sample}}.junction.bed",
        interact=f"{RP}/junction_annotation/bed/{{sample}}.junction.Interact.bed",
        xls=f"{RP}/junction_annotation/xls/{{sample}}.junction.xls",
