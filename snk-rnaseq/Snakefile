# HISAT2_EXTRACTSPLICESITES unless `splicesites` is given
SPLICESITES = (
    (gunzipped(config["splicesites"]) if cfg("splicesites") else f"{INDEX_DIR}/{basename_noext(GTF)}.splice_sites.txt")
    if ALIGN and ALIGNER == "hisat2" else None
)
# Bowtie2 rRNA index built in FASTQ_REMOVE_RRNA is published under
# bowtie2_rrna/index/ (only with save_reference), not genome/index/.
if RIBO == "bowtie2" and not cfg("bowtie2_rrna_index"):
    BOWTIE2_RRNA_INDEX = (f"{O}/bowtie2_rrna/index/bowtie2" if SAVE_REF else f"{W}/bowtie2_rrna/index/bowtie2")


def mem_gb(text):
    """Nextflow MemoryUnit string ('200.GB', '200 GB', '64G') -> GB."""
    m = re.fullmatch(r"\s*([\d.]+)\s*\.?\s*([KMGT]?)B?\s*", str(text).upper())
    if not m:
        raise ValueError(f"Cannot parse memory {text!r}")
    return float(m.group(1)) * {"": 1 / 1024 ** 3, "K": 1 / 1024 ** 2, "M": 1 / 1024, "G": 1, "T": 1024}[m.group(2)]

# -----------------------------------------------------------------------------
# Samplesheet (samplesheetToList + checkSamplesAfterGrouping)
# -----------------------------------------------------------------------------
# Columns: [condition,]sample,fastq_1,fastq_2,strandedness[,seq_platform,seq_center,
# genome_bam,transcriptome_bam,percent_mapped]. The BAM columns are only used
# with skip_alignment (pre-aligned input, first non-empty value per sample).
# Port extension (not in nf-core): an optional `condition` column. The sample
# ID, used as the prefix of every per-sample file, is then
# <condition>_<sample> (Parental + rep1 -> Parental_rep1), and the condition is
# the DESeq2 design factor of the differential-expression rules.
SAMPLES = OrderedDict()
SHEET_ROWS = []  # samplesheet rows with `sample` replaced by the sample ID
with open(config["input"], newline="") as fh:
    _reader = csv.DictReader(fh)
    HAS_CONDITION = "condition" in (_reader.fieldnames or [])
    for row in _reader:
        sample = str(row["sample"]).strip()
        if not re.fullmatch(r"\S+", sample):
            raise ValueError(f"Sample name {sample!r} must not contain spaces.")
        condition = None
        if HAS_CONDITION:
            condition = str(row["condition"] or "").strip()
            if not re.fullmatch(r"[A-Za-z0-9][\w.-]*", condition):
                raise ValueError(f"Sample {sample}: condition {condition!r} must be non-empty, start with a "
                                 "letter or digit and contain only letters, digits, '_', '.' or '-'.")
            sample = f"{condition}_{sample}"
        SHEET_ROWS.append(dict(row, sample=sample))
        fq1, fq2 = (row.get("fastq_1") or "").strip(), (row.get("fastq_2") or "").strip()
        meta = {
            "strandedness": (row.get("strandedness") or "auto").strip(),
            "single_end": not fq2,
            "seq_platform": (row.get("seq_platform") or "").strip(),
            "seq_center": (row.get("seq_center") or "").strip(),
        }
        if meta["strandedness"] not in ("forward", "reverse", "unstranded", "auto"):
            raise ValueError(f"Sample {sample}: strandedness must be forward, reverse, unstranded or auto.")
        if sample in SAMPLES:
            prev = SAMPLES[sample]
            for key in meta:
                if prev[key] != meta[key]:
                    raise ValueError(f"Multiple runs of sample {sample} must have the same {key}.")
            if fq1 and prev["runs"] and prev["runs"][0][0].endswith(".gz") != fq1.endswith(".gz"):
                raise ValueError(f"Runs of sample {sample} mix compressed and uncompressed FASTQ.")
        else:
            SAMPLES[sample] = dict(meta, runs=[], genome_bam="", transcriptome_bam="", percent_mapped=None,
                                   condition=condition)
        entry = SAMPLES[sample]
        if fq1:
            entry["runs"].append((stage(fq1), stage(fq2) if fq2 else None))
            entry.setdefault("raw_runs", []).append((fq1, fq2))
        for col in ("genome_bam", "transcriptome_bam"):
            value = (row.get(col) or "").strip()
            if value and not entry[col]:
                entry[col] = value
        pm = (row.get("percent_mapped") or "").strip()
        if pm and entry["percent_mapped"] is None:
            entry["percent_mapped"] = float(pm)

# Pre-aligned BAM input (skip_alignment) is staged like any other input.
for _s, _e in SAMPLES.items():
    for _col in ("genome_bam", "transcriptome_bam"):
        if SKIP_ALIGN and _e[_col]:
            _e[_col] = stage(_e[_col])

# RNASEQ branches each sample once: with skip_alignment, a sample that has a BAM
# goes to the BAM branch only (its FASTQs are not processed).
BAM_SAMPLES = [s for s in SAMPLES if SKIP_ALIGN and (SAMPLES[s]["genome_bam"] or SAMPLES[s]["transcriptome_bam"])]
FQ_SAMPLES = [s for s in SAMPLES if SAMPLES[s]["runs"] and s not in BAM_SAMPLES]

# Samplesheet read by the rules (SummarizedExperiment colData, MultiQC name
# tables): with a `condition` column, a copy whose `sample` column holds the
# sample IDs; otherwise the input samplesheet itself.
SHEET = f"{W}/samplesheet.ids.csv" if HAS_CONDITION else config["input"]

# --- Differential expression (port extension) ----------------------------------
COMPARISONS = config.get("comparisons") or []
for _c in COMPARISONS:
    if not isinstance(_c, dict) or set(_c) != {"baseline", "treatment"}:
        raise ValueError(f"Each entry of `comparisons` must be {{baseline: <condition>, treatment: <condition>}} "
                         f"(got {_c!r}).")
if COMPARISONS:
    if not HAS_CONDITION:
        raise ValueError("`comparisons` needs a `condition` column in the samplesheet.")
    if SKIP_MERGE:
        raise ValueError("`comparisons` needs the merged count matrices; remove skip_quantification_merge.")
    _cond_n = Counter(e["condition"] for e in SAMPLES.values())
    for _c in COMPARISONS:
        b, t = str(_c["baseline"]), str(_c["treatment"])
        if b == t:
            raise ValueError(f"Comparison {_c}: baseline and treatment must differ.")
        for _x in (b, t):
            if _cond_n[_x] < 2:
                raise ValueError(f"Comparison {_c}: condition {_x!r} needs at least 2 samples in the samplesheet "
                                 f"(found {_cond_n[_x]}).")
    _check(cfg("de_counts"), "de_counts", ["gene_counts_length_scaled", "gene_counts"])
    _check(cfg("gsea_gene_id"), "gsea_gene_id", ["gene_name", "gene_id"])
CONTRASTS = [f"{c['treatment']}_vs_{c['baseline']}" for c in COMPARISONS]
GSEA_GMT = OrderedDict()  # GMT stem -> path
for _g in config.get("gsea_gmt") or []:
    _stem = re.sub(r"\.gmt$", "", os.path.basename(str(_g)))
    if _stem in GSEA_GMT:
        raise ValueError(f"Two gsea_gmt files share the name {_stem!r}.")
    GSEA_GMT[_stem] = str(_g)

# UMI extraction with umi_discard_read 1/2 keeps one mate, after which the
# sample is treated as single-end (meta.single_end = true).
UMI_DISCARD = int(config.get("umi_discard_read") or 0) if UMI_EXTRACT else 0


def raw_se(s):
    return SAMPLES[s]["single_end"]


def se(s):
    """meta.single_end after UMI extraction."""
    return raw_se(s) or UMI_DISCARD in (1, 2)


RAW_PE = [s for s in FQ_SAMPLES if not raw_se(s)]
RAW_SE = [s for s in FQ_SAMPLES if raw_se(s)]
PE = [s for s in SAMPLES if not se(s)]
SE = [s for s in SAMPLES if se(s)]

wildcard_constraints:
    sample=alternation(SAMPLES),
    mate="|_1|_2",
    strand=r"|\.forward|\.reverse",


def mates(s, raw=False):
    return [""] if (raw_se(s) if raw else se(s)) else ["_1", "_2"]


def mate_file(files, mate):
    return files[{"": 0, "_1": 0, "_2": 1}[mate]]


# -----------------------------------------------------------------------------
# Read files at each stage (FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS)
# -----------------------------------------------------------------------------
SAVE_MERGED = flag("save_merged_fastq")
SKIP_LINT = flag("skip_linting")
SKIP_TRIM = flag("skip_trimming")
SKIP_FASTQC = flag("skip_fastqc") or SKIP_QC
FASTQ_D = keep(SAVE_MERGED, "fastq")
UMI_D = keep(flag("save_umi_intermeds"), "umitools")
TRIM_D = keep(flag("save_trimmed"), TRIMMER)
BBSPLIT_D = keep(flag("save_bbsplit_reads"), "bbsplit")
RIBO_PUB = {"sortmerna": "sortmerna", "ribodetector": "ribodetector", "bowtie2": "bowtie2_rrna"}.get(RIBO)
RIBO_D = keep(flag("save_non_ribo_reads"), RIBO_PUB) if RIBO else None


def needs_cat(s):
    runs = SAMPLES[s]["runs"]
    return len(runs) > 1 or not runs[0][0].endswith(".gz") or SAVE_MERGED


def reads_cat(s):
    """CAT_FASTQ output, or the single input run when no merge is needed."""
    if needs_cat(s):
        if raw_se(s):
            return [at(f"{FASTQ_D}/{{sample}}.merged.fastq.gz", s)]
        return [at(f"{FASTQ_D}/{{sample}}_{r}.merged.fastq.gz", s) for r in (1, 2)]
    r1, r2 = SAMPLES[s]["runs"][0]
    return [r1] if r2 is None else [r1, r2]


def reads_umi_raw(s):
    """UMITOOLS_EXTRACT output (both mates)."""
    if raw_se(s):
        return [at(f"{UMI_D}/{{sample}}.umi_extract.fastq.gz", s)]
    return [at(f"{UMI_D}/{{sample}}.umi_extract_{r}.fastq.gz", s) for r in (1, 2)]


def reads_umi(s):
    """Trimmer input: UMI-extracted reads (one mate kept with umi_discard_read)."""
    if not UMI_EXTRACT:
        return reads_cat(s)
    files = reads_umi_raw(s)
    if UMI_DISCARD and not raw_se(s):
        return [files[UMI_DISCARD % 2]]
    return files


def reads_trimmed(s):
    if SKIP_TRIM:
        return reads_umi(s)
    if TRIMMER == "fastp":
        if se(s):
            return [at(f"{TRIM_D}/{{sample}}.fastp.fastq.gz", s)]
        return [at(f"{TRIM_D}/{{sample}}_R{r}.fastp.fastq.gz", s) for r in (1, 2)]
    if se(s):
        return [at(f"{TRIM_D}/{{sample}}_trimmed_trimmed.fq.gz", s)]
    return [at(f"{TRIM_D}/{{sample}}_trimmed_{r}_val_{r}.fq.gz", s) for r in (1, 2)]


def reads_bbsplit(s):
    if SKIP_BBSPLIT:
        return reads_trimmed(s)
    if se(s):
        return [at(f"{BBSPLIT_D}/{{sample}}_primary.fastq.gz", s)]
    return [at(f"{BBSPLIT_D}/{{sample}}_primary_{r}.fastq.gz", s) for r in (1, 2)]


def reads_ribo(s):
    """FASTQ_REMOVE_RRNA output."""
    if RIBO == "sortmerna":
        names = ["{sample}.non_rRNA.fastq.gz"] if se(s) else ["{sample}_1.non_rRNA.fastq.gz", "{sample}_2.non_rRNA.fastq.gz"]
        return [at(f"{RIBO_D}/{n}", s) for n in names]
    if RIBO == "ribodetector":
        names = ["{sample}.nonrna.fastq.gz"] if se(s) else ["{sample}.nonrna.1.fastq.gz", "{sample}.nonrna.2.fastq.gz"]
        return [at(f"{RIBO_D}/{n}", s) for n in names]
    # bowtie2: unaligned reads (single-end) or both-unmapped pairs from the BAM
    if se(s):
        return [at(f"{RIBO_D}/{{sample}}.bowtie2_rrna.unmapped.fastq.gz", s)]
    return [f"{W}/bowtie2_rrna/{s}.bowtie2_filtered_{r}.fastq.gz" for r in (1, 2)]


def reads_filtered(s):
    """Reads after BBSplit / rRNA removal: input of alignment and quantification."""
    return reads_ribo(s) if RIBO else reads_bbsplit(s)


LINT_STAGES = {"raw": reads_cat, "trimmed": reads_trimmed, "bbsplit": reads_bbsplit, "ribo": reads_ribo}
LINT_DIR = {"raw": "raw", "trimmed": "trimmed", "bbsplit": "bbsplit", "ribo": RIBO or "sortmerna"}


def lint_stages():
    return (["raw"] + ([] if SKIP_TRIM else ["trimmed"]) + ([] if SKIP_BBSPLIT else ["bbsplit"])
            + (["ribo"] if RIBO else []))


def lint_file(s, st):
    return f"{so(s)}/fq_lint/{LINT_DIR[st]}/{s}.fq_lint.txt"


def lint_gate(s, upto):
    """FQ_LINT reports that gate a stage (Nextflow joins reads on the lint output)."""
    if SKIP_LINT:
        return []
    order = ["raw", "trimmed", "bbsplit", "ribo"]
    stages = [st for st in lint_stages() if order.index(st) <= order.index(upto)]
    return [lint_file(s, st) for st in stages]


def last_stage():
    return lint_stages()[-1]


# -----------------------------------------------------------------------------
# Per-sample status written by checkpoints (Groovy logic in nf-core)
# -----------------------------------------------------------------------------
# Per-sample status files are ordinary rules (they run in parallel); two
# aggregate checkpoints collect them so the DAG is re-evaluated only twice:
# trim_summary (all samples) and sample_summary (strandedness + mapping rate).
def _summary(cp):
    with open(cp.get().output[0]) as fh:
        return json.load(fh)


def trim_pass(s):
    return SKIP_TRIM or _summary(checkpoints.trim_summary)[s]["pass"]


def map_pass(s):
    """True / False against min_mapped_reads, None when no rate is known."""
    return _summary(checkpoints.sample_summary)[s]["map"]["pass"]


def strandedness(s):
    return _summary(checkpoints.sample_summary)[s]["strand"]["strandedness"]


def samples_trimmed():
    """FASTQ samples that pass min_trimmed_reads (trimming subworkflows)."""
    return [s for s in FQ_SAMPLES if trim_pass(s)]


def genome_samples():
    """Samples with a genome BAM: aligned samples, or pre-aligned input."""
    if ALIGN:
        return samples_trimmed()
    return [s for s in BAM_SAMPLES if SAMPLES[s]["genome_bam"]]


def samples_mapped():
    """Genome BAMs kept by min_mapped_reads (RNASEQ: map_filtered_genome_bam_bai)."""
    return [s for s in genome_samples() if map_pass(s) is not False]


def strand_file(wc):
    return f"{W}/status/{wc.sample}.strandedness"


def bam_strand(s):
    """Strandedness file seen by genome/transcriptome BAM processes.
    Pre-aligned BAMs keep the samplesheet value (no Salmon inference)."""
    return f"{W}/status/{s}.bam.strandedness" if not ALIGN else f"{W}/status/{s}.strandedness"


def bam_strandedness(s):
    return SAMPLES[s]["strandedness"] if not ALIGN else strandedness(s)


# -----------------------------------------------------------------------------
# Alignment outputs
# -----------------------------------------------------------------------------
SAVE_ALIGN = flag("save_align_intermeds")
SAVE_UMI = SAVE_ALIGN or flag("save_umi_intermeds")
# Parabricks marks duplicates during alignment (markdups_done): no Picard.
SKIP_MARKDUP = flag("skip_markduplicates") or WITH_UMI or PARABRICKS
STAR = ALIGNER in ("star_salmon", "star_rsem")
STAR_W = keep(SAVE_ALIGN, ALIGNER) if SAVE_ALIGN else f"{W}/star"
ALN_D = keep(SAVE_ALIGN, ALIGNER) if SAVE_ALIGN else f"{W}/align"  # HISAT2 / Bowtie2 BAMs
# nf-core quirk (conf precedence): with UMI dedup of a transcriptome BAM, the
# transcriptome BAM_SORT_STATS_SAMTOOLS also gets prefix <id>.sorted, so its
# BAM/stats are published as <id>.sorted.bam* over the genome ones.
UMI_TX = not SKIP_ALIGN and WITH_UMI and ALIGNER != "hisat2"
SORTED_PUB = keep(SAVE_ALIGN or flag("skip_markduplicates"), ALIGNER)
SORTED_D = f"{W}/genome_sorted" if UMI_TX else SORTED_PUB
UMI_GENOME_D = keep(SAVE_UMI, ALIGNER) if SAVE_UMI else f"{W}/umi_dedup"
SCREEN_UNMAPPED = bool(SCREEN) and SCREEN_INPUT == "unmapped"
SAVE_UNALIGNED = flag("save_unaligned")
UNMAPPED_D = keep(SAVE_UNALIGNED, f"{ALIGNER}/unmapped") if SAVE_UNALIGNED else f"{W}/unmapped"


def sorted_bam(s):
    return at(f"{SORTED_D}/{{sample}}.sorted.bam", s)


def input_genome_bam(s):
    return SAMPLES[s]["genome_bam"]


def input_bam_index(s):
    """SAMTOOLS_INDEX of a pre-aligned genome BAM (default publishDir samtools/)."""
    return f"{so(s)}/samtools/{os.path.basename(input_genome_bam(s))}.bai"


def final_bam(s):
    """Genome BAM used by StringTie, QC and bigWigs."""
    if not ALIGN:
        return input_genome_bam(s) if SKIP_MARKDUP else f"{als(s)}/{s}.markdup.sorted.bam"
    if WITH_UMI:
        return at(f"{UMI_GENOME_D}/{{sample}}.umi_dedup.sorted.bam", s)
    if not SKIP_MARKDUP:
        return f"{als(s)}/{s}.markdup.sorted.bam"
    return sorted_bam(s)


def final_idx(s):
    if not ALIGN and SKIP_MARKDUP:
        return input_bam_index(s)
    return f"{final_bam(s)}.{IDX}"


def final_bam_bai(wc):
    return {"bam": final_bam(wc.sample), "bai": final_idx(wc.sample)}


def transcriptome_bam(s):
    """Input of BAM-based quantification (Salmon / RSEM)."""
    if not ALIGN:
        return SAMPLES[s]["transcriptome_bam"]
    if WITH_UMI:
        if se(s):
            return at(f"{UMI_GENOME_D}/{{sample}}.umi_dedup.transcriptome.bam", s)
        return at(f"{UMI_GENOME_D}/{{sample}}.umi_dedup.transcriptome.filtered.bam", s)
    return aligner_transcriptome_bam(s)


def aligner_transcriptome_bam(s):
    if STAR:
        return at(f"{STAR_W}/{{sample}}.Aligned.toTranscriptome.out.bam", s)
    return at(f"{ALN_D}/{{sample}}.bam", s)  # bowtie2_salmon: query-grouped BAM


def quant_samples_bam():
    """Samples quantified from a transcriptome BAM."""
    if ALIGN:
        return samples_trimmed() if ALIGNER != "hisat2" else []
    return [s for s in BAM_SAMPLES if SAMPLES[s]["transcriptome_bam"]]


def qc_tools():
    """utils_nfcore_rnaseq_pipeline: defineQcTools."""
    tools = []
    if SKIP_QC:
        return tools
    if not flag("skip_preseq"):
        tools.append("preseq")
    if not flag("skip_biotype_qc") and biotype_qc_usable():
        tools.append("biotype_qc")
    if not flag("skip_qualimap"):
        tools.append("qualimap")
    if not flag("skip_dupradar"):
        tools.append("dupradar")
    if not flag("skip_rseqc"):
        mods = [m.strip().lower() for m in str(cfg("rseqc_modules")).split(",") if m.strip()]
        if CSI:
            mods = [m for m in mods if m not in ("read_distribution", "inner_distance", "tin")]
        if ALIGNER == "bowtie2_salmon" and "infer_experiment" in mods:
            mods.remove("infer_experiment")
        tools += [f"rseqc_{m}" for m in mods]
    return tools


def biotype_qc_usable():
    """utils_nfcore_rnaseq_pipeline: biotypeQcUsable (checks the input GTF)."""
    if not cfg("gtf"):
        return True
    import gzip
    import io

    path = config["gtf"]
    if is_url(path):
        with urllib.request.urlopen(path) as fh:
            raw = fh.read()
    else:
        with open(path, "rb") as fh:
            raw = fh.read()
    text = gzip.decompress(raw).decode() if path.endswith(".gz") else raw.decode()
    for line in io.StringIO(text):
        fields = line.rstrip("\n").split("\t")
        if len(fields) > 2 and fields[2] == config["featurecounts_feature_type"] and BIOTYPE in fields[-1].split():
            return True
    print(f"WARNING: biotype attribute {BIOTYPE!r} not found on "
          f"{config['featurecounts_feature_type']!r} rows of the GTF; biotype QC skipped.", file=sys.stderr)
    return False


QC_TOOLS = qc_tools()
RSEQC = [t[len("rseqc_"):] for t in QC_TOOLS if t.startswith("rseqc_")]
RUN_IE = not SKIP_QC and (USE_RUSTQC or "infer_experiment" in RSEQC)


# -----------------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------------
def quant_outputs(qdir, samples):
    qt = QUANT_TYPE[qdir]
    d = f"{O}/{qdir}"
    out = [quant_result(qdir, s) for s in samples]
    if qt == "rsem":
        out += [f"{so(s)}/{qdir}/{s}.{x}" for s in samples for x in ("genes.results", "stat")]
    if not samples:
        return out
    out.append(f"{d}/{qt}.merged.tx2gene.tsv")
    if SKIP_MERGE:
        out += [f"{so(s)}/{qdir}/{s}.{x}.tsv" for s in samples for x in TXIMPORT_SAMPLE_OUT]
        return out
    out += [f"{d}/{qt}.merged.{x}.tsv" for x in TXIMPORT_OUT]
    out += [f"{d}/{qt}.merged.{x}.SummarizedExperiment.rds" for x in ("gene", "transcript")]
    if qt == "rsem":
        out += [f"{d}/rsem_merge_counts/rsem.merged.{x}.tsv"
                for x in ("gene_counts", "gene_tpm", "transcript_counts", "transcript_tpm", "genes_long", "isoforms_long")]
    if not SKIP_QC and not flag("skip_deseq2_qc"):
        out.append(f"{d}/deseq2_qc/deseq2.plots.pdf")
    out += de_outputs(qdir)
    return out


def de_outputs(qdir):
    """Differential expression, volcano and GSEA outputs (port extension)."""
    d = f"{O}/{qdir}/differential"
    out = []
    if COMPARISONS:
        out.append(f"{d}/deseq2.normalized_counts.tsv")
        for c in CONTRASTS:
            out += [f"{d}/{c}/{c}.deseq2.results.tsv", f"{d}/{c}/{c}.volcano.pdf"]
            out += [f"{d}/{c}/gsea/{g}/gsea.results.tsv" for g in GSEA_GMT]
    return out


def bam_qc_outputs(s):
    a = als(s)
    out = []
    if USE_RUSTQC:
        return [f"{W}/rustqc/{s}.published"]
    if "preseq" in QC_TOOLS:
        out += [f"{a}/preseq/{s}.lc_extrap.txt", f"{a}/preseq/log/{s}.command.log"]
    if "biotype_qc" in QC_TOOLS:
        out += [f"{a}/featurecounts/{s}.biotype_counts_mqc.tsv"]
    if "qualimap" in QC_TOOLS:
        out.append(f"{a}/qualimap/{s}")
    if "dupradar" in QC_TOOLS:
        out.append(f"{a}/dupradar/gene_data/{s}_dupMatrix.txt")
    for mod in RSEQC:
        out += rseqc_files(mod, s)
    return out


def stats_files(s, kind, d=None):
    d = d or f"{als(s)}/samtools_stats"
    return [f"{d}/{s}.{kind}.bam.{x}" for x in ("stats", "flagstat", "idxstats")]


def umi_outputs(s):
    """Published BAM_DEDUP_UMI files of an aligned sample."""
    a = als(s)
    tool_dir = "umitools" if UMI_TOOL == "umitools" else "umicollapse"
    spaces = ["genome"] + (["transcriptome"] if ALIGNER != "hisat2" else [])
    out = stats_files(s, "umi_dedup.sorted")
    for sp in spaces:
        prefix = UMI_PREFIX[sp]
        log_dir = f"{a}/{tool_dir}/{UMI_LOG_DIR[sp]}"
        out.append(f"{log_dir}/{s}.{prefix}.log" if UMI_TOOL == "umitools" else f"{log_dir}/{s}.{prefix}_UMICollapse.log")
        if UMI_TOOL == "umitools" and UMI_STATS:
            out += [f"{a}/umitools/{s}.{prefix}_{x}.tsv" for x in ("edit_distance", "per_umi", "per_umi_per_position")]
    if SAVE_UMI:
        out += [f"{a}/{s}.umi_dedup.sorted.bam", f"{a}/{s}.umi_dedup.sorted.bam.{IDX}"]
    if "transcriptome" in spaces:
        out += stats_files(s, "umi_dedup.transcriptome.sorted")
        if SAVE_UMI:
            out += [f"{a}/{s}.umi_dedup.transcriptome.sorted.bam", f"{a}/{s}.umi_dedup.transcriptome.sorted.bam.bai",
                    f"{a}/{s}.umi_dedup.transcriptome.bam"]
            if not se(s):
                out.append(f"{a}/{s}.umi_dedup.transcriptome.filtered.bam")
        if not se(s):
            out.append(f"{a}/umitools/prepare_for_quantification_log/"
                       f"{s}.umi_dedup.transcriptome.filtered.prepare_for_rsem.log")
    return out


def ribo_outputs(s):
    d = so(s)
    if RIBO == "sortmerna":
        out = [f"{d}/sortmerna/{s}.sortmerna.log"]
    elif RIBO == "ribodetector":
        out = [f"{d}/ribodetector/{s}.rrna_removal_stats.tsv", f"{d}/ribodetector/{s}.log"]
    else:
        out = [f"{d}/bowtie2_rrna/{s}.bowtie2_rrna.bowtie2.log"]
    if flag("save_non_ribo_reads") and not (RIBO == "bowtie2" and not se(s)):
        out += reads_ribo(s)
    return out


def align_outputs(s):
    """Published alignment files of a sample that passed trimming."""
    a = als(s)
    out = []
    if STAR:
        logs = ("Log.final.out", "Log.out", "Log.progress.out") + (() if PARABRICKS else ("SJ.out.tab",))
        out += [f"{a}/log/{s}.{x}" for x in logs]
        if SAVE_ALIGN:
            out += [f"{a}/{s}.bam" if PARABRICKS else f"{a}/{s}.Aligned.out.bam",
                    f"{a}/{s}.Aligned.toTranscriptome.out.bam"]
    else:
        out.append(f"{a}/log/{s}." + ("hisat2.summary.log" if ALIGNER == "hisat2" else "bowtie2.log"))
        if SAVE_ALIGN:
            out.append(f"{a}/{s}.bam")
    if SAVE_UNALIGNED:
        out += unmapped_reads(s)
    out += stats_files(s, "sorted")
    if SAVE_ALIGN or flag("skip_markduplicates"):
        out += [at(f"{SORTED_PUB}/{{sample}}.sorted.bam", s), at(f"{SORTED_PUB}/{{sample}}.sorted.bam.{IDX}", s)]
    if WITH_UMI:
        out += umi_outputs(s)
    return out


def nfcore_prepared():
    """What PREPARE_GENOME_REFERENCES / PREPARE_GENOME_INDICES make from the
    params alone, used downstream or not (e.g. a STAR index with BAM input)."""
    out = [GENE_BED]  # EAUTILS_GTF2BED / GFFREAD_GENE_BED
    if HAS_FASTA:
        out += [FAI, SIZES]
    tools = set()
    if not flag("skip_bbsplit"):
        tools.add("bbsplit")
    if (not SKIP_ALIGN and ALIGNER) or ALIGNER == "star_rsem":
        tools.add(ALIGNER)
    if not flag("skip_pseudo_alignment") and cfg("pseudo_aligner"):
        tools.add(cfg("pseudo_aligner"))
    if "bbsplit" in tools and not SKIP_BBSPLIT:
        out.append(BBSPLIT_INDEX)
    if RIBO == "sortmerna":
        out.append(SORTMERNA_INDEX)
    if RIBO == "bowtie2" and cfg("bowtie2_rrna_index"):
        out.append(BOWTIE2_RRNA_INDEX)
    if tools & {"star_salmon", "star_rsem"} and (cfg("star_index") or HAS_FASTA):
        out.append(STAR_INDEX)
    if "star_rsem" in tools and (cfg("rsem_index") or HAS_FASTA):
        out.append(RSEM_INDEX)
    if "hisat2" in tools:
        out += [x for x in (SPLICESITES,) if x] + ([HISAT2_INDEX] if cfg("hisat2_index") or HAS_FASTA else [])
    if "bowtie2_salmon" in tools and (cfg("bowtie2_index") or TX_FASTA):
        out.append(BOWTIE2_INDEX)
    if KRAKEN_DB_PREPARED:
        out.append(KRAKEN_DB_PREPARED)
    if untar_name("salmon_index") or ("salmon" in tools and TX_FASTA and not cfg("salmon_index")):
        out.append(SALMON_INDEX)
    if untar_name("kallisto_index") or ("kallisto" in tools and TX_FASTA and not cfg("kallisto_index")):
        out.append(KALLISTO_INDEX)
    return out


def all_outputs(wc):
    out = []
    for s in FQ_SAMPLES:
        d = so(s)
        if not SKIP_LINT:
            out.append(lint_file(s, "raw"))
        if not SKIP_FASTQC:
            out += [f"{d}/fastqc/raw/{s}_raw{m}_fastqc.{e}" for m in mates(s, raw=True) for e in ("html", "zip")]
        if UMI_EXTRACT:
            out.append(f"{d}/umitools/{s}.umi_extract.log")
            if flag("save_umi_intermeds"):
                out += reads_umi_raw(s)
        if not SKIP_TRIM:
            out += trimgalore_outputs(s) if TRIMMER == "trimgalore" else fastp_outputs(s)
        if SAVE_MERGED and needs_cat(s):
            out += reads_cat(s)
    trimmed = samples_trimmed()
    for s in trimmed:
        d = so(s)
        if not SKIP_LINT and not SKIP_TRIM:
            out.append(lint_file(s, "trimmed"))
        if TRIMMER == "fastp" and not SKIP_TRIM and not SKIP_FASTQC:
            out += [f"{d}/fastqc/trim/{s}_trimmed{m}_fastqc.{e}" for m in mates(s) for e in ("html", "zip")]
        if flag("save_trimmed") and not SKIP_TRIM:
            out += reads_trimmed(s)
        if not SKIP_BBSPLIT:
            out.append(f"{d}/bbsplit/{s}.stats.txt")
            if flag("save_bbsplit_reads"):
                out += reads_bbsplit(s)
            if not SKIP_LINT:
                out.append(lint_file(s, "bbsplit"))
        if RIBO:
            out += ribo_outputs(s)
            if not SKIP_LINT:
                out.append(lint_file(s, "ribo"))
        if not SKIP_FASTQC and (not SKIP_BBSPLIT or RIBO):
            out += [f"{d}/fastqc/filtered/{s}_filtered{m}_fastqc.{e}" for m in mates(s) for e in ("html", "zip")]
        if ALIGN:
            out += align_outputs(s)
    out += nfcore_prepared()
    if SAVE_REF:
        out += [GTF, GENE_BED] + ([FAI, SIZES] if HAS_FASTA else []) + ([TX_FASTA] if TX_FASTA else [])
    if RIBO == "bowtie2" and not cfg("bowtie2_rrna_index"):
        out += [f"{O}/seqkit/{r}_{x}.fasta" for r in RRNA_ID for x in ("prefixed", "dna_converted")]
        if SAVE_REF:
            out.append(BOWTIE2_RRNA_INDEX)
    if ALIGNER in QUANT_TYPE:
        out += quant_outputs(ALIGNER, quant_samples(ALIGNER))
    mapped = samples_mapped()
    if not ALIGN:
        # SAMTOOLS_INDEX of every pre-aligned genome BAM (before the
        # percent_mapped filter); its default publishDir is samtools/.
        out += [input_bam_index(s) for s in BAM_SAMPLES if input_genome_bam(s)]
    for s in mapped:
        a = als(s)
        if not SKIP_MARKDUP:
            out += [f"{a}/{s}.markdup.sorted.bam", f"{a}/{s}.markdup.sorted.bam.{IDX}",
                    f"{a}/picard_metrics/{s}.markdup.sorted.metrics.txt"]
            if not USE_RUSTQC:
                out += stats_files(s, "markdup.sorted")
        if not flag("skip_stringtie"):
            out.append(f"{a}/stringtie/{s}.transcripts.gtf")
            if flag("stringtie_ignore_gtf"):
                out.append(f"{a}/stringtie/{s}.denovo.transcripts.gtf")
        if not SKIP_QC:
            out += bam_qc_outputs(s)
        if not flag("skip_bigwig"):
            out.append(f"{a}/bigwig/{s}.bigWig")
            if bam_strandedness(s) in ("forward", "reverse"):
                out += [f"{a}/bigwig/{s}.forward.bigWig", f"{a}/bigwig/{s}.reverse.bigWig"]
    if mapped and not flag("skip_stringtie") and flag("stringtie_ignore_gtf"):
        out.append(f"{AL}/stringtie/stringtie_merge.gtf")
    for s in screen_samples():
        out += screen_outputs(s)
    if PSEUDO:
        out += quant_outputs(PSEUDO, quant_samples(PSEUDO))
    if not flag("skip_multiqc"):
        if SKIP_MERGE:
            out += [f"{sample_mqc_dir(s)}/{s}_multiqc_report.html" for s in SAMPLES]
        else:
            out.append(f"{MQC_DIR}/multiqc_report.html")
    if ALIGN and SAVE_ALIGN:
        out.append(f"{O}/samplesheets/samplesheet_with_bams.csv")
    return out


def all_targets(wc):
    return all_outputs(wc) + [VERSIONS_YML]


rule all:
    input:
        all_targets,


