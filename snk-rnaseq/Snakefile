            r1=f"{RIBO_D}/{{sample}}.nonrna.1.fastq.gz",
            r2=f"{RIBO_D}/{{sample}}.nonrna.2.fastq.gz",
            log=pub("ribodetector") + "/{sample}.log",
        wildcard_constraints:
            sample=alternation(PE),
        params:
            args=literal(cfg("ribodetector_args")),
            # GPU: `ribodetector -m <task memory GB>`; CPU: ribodetector_cpu
            bin="ribodetector" if GPU_RIBO else "ribodetector_cpu",
            mem=lambda wc, resources: f"-m {int(resources.mem_mb // 1024)}" if GPU_RIBO else "",
        container:
            container_path("ribodetector_gpu" if GPU_RIBO else "ribodetector")
        threads: 1
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            len=$(python3 -c "import sys; sys.path.insert(0, '{SCRIPTS}'); from rnaseq_strand import seqkit_read_length as f; print(f('{input.stats}'))")
            p={wildcards.sample}
            {params.bin} -i {input.reads} -o $p.nonrna.1.fastq.gz $p.nonrna.2.fastq.gz -l $len -t {threads} \
                --log $p.log {params.mem} {params.args}
            mv $p.nonrna.1.fastq.gz {output.r1}
            mv $p.nonrna.2.fastq.gz {output.r2}
            mv $p.log {output.log}
            """

if RIBO == "bowtie2":

    BOWTIE2_INDEX_SH = r"""
    ln -s $(realpath {input.index}) bt2_index
    INDEX=`find -L ./bt2_index -name "*.rev.1.bt2" | sed "s/\.rev.1.bt2$//"`
    [ -z "$INDEX" ] && INDEX=`find -L ./bt2_index -name "*.rev.1.bt2l" | sed "s/\.rev.1.bt2l$//"`
    [ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
    """

    # BOWTIE2_ALIGN (single-end, save_unaligned: the unaligned reads go on)
    rule bowtie2_rrna_se:
        input:
            reads=lambda wc: reads_bbsplit(wc.sample),
            lint=lambda wc: lint_gate(wc.sample, "bbsplit"),
            index=BOWTIE2_RRNA_INDEX,
        output:
            reads=f"{RIBO_D}/{{sample}}.bowtie2_rrna.unmapped.fastq.gz",
            log=pub("bowtie2_rrna") + "/{sample}.bowtie2_rrna.bowtie2.log",
            bam=temp(f"{W}/bowtie2_rrna/{{sample}}.bowtie2_rrna.bam"),
        wildcard_constraints:
            sample=alternation(SE),
        params:
            args=literal(cfg("bowtie2_rrna_args")),
        container:
            container_path("bowtie2")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            BOWTIE2_INDEX_SH + """
            p={wildcards.sample}.bowtie2_rrna
            bowtie2 -x $INDEX -U {input.reads} --threads {threads} --un-gz $p.unmapped.fastq.gz \
                --rg-id $p --rg SM:$p {params.args} 2>| >(tee $p.bowtie2.log >&2) \
                | samtools view --threads {threads} -o $p.bam -
            mv $p.unmapped.fastq.gz {output.reads}
            mv $p.bowtie2.log {output.log}
            mv $p.bam {output.bam}
            """

    # BOWTIE2_ALIGN_PE (the rRNA hits; the unmapped pairs are taken from its BAM)
    rule bowtie2_rrna_pe:
