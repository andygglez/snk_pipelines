# =============================================================================
# Contaminant screening (KRAKEN2 / BRACKEN / SYLPH_PROFILE + SYLPHTAX_TAXPROF)
# =============================================================================
CONTAM = pub(f"{ALIGNER}/contaminants")


def screen_samples():
    """Samples whose reads reach contaminant screening."""
    if not SCREEN or SKIP_QC:
        return []
    return FQ_SAMPLES if SCREEN_INPUT == "raw" else samples_trimmed()


def screen_reads(s):
    if SCREEN_INPUT == "trimmed":
        return reads_filtered(s)
    if SCREEN_INPUT == "trim_only":
        return reads_trimmed(s)
    if SCREEN_INPUT == "raw":
        return reads_cat(s)
    return unmapped_reads(s)


def screen_se(s):
    return raw_se(s) if SCREEN_INPUT == "raw" else se(s)


# KRAKEN2 call passes (save_kraken_assignments, save_kraken_unassigned) to the
# module inputs (save_output_fastqs, save_reads_assignment): kept as is.
KRAKEN_FASTQS = flag("save_kraken_assignments")
KRAKEN_ASSIGN = flag("save_kraken_unassigned")


def kraken_extra_outputs(s):
    d = f"{als(s)}/contaminants/kraken2/kraken_reports"
    out = []
    if KRAKEN_FASTQS:
        if screen_se(s):
            out += [f"{d}/{s}.classified.fastq.gz", f"{d}/{s}.unclassified.fastq.gz"]
        else:
            out += [f"{d}/{s}.{c}_{r}.fastq.gz" for c in ("classified", "unclassified") for r in (1, 2)]
    if KRAKEN_ASSIGN:
        out.append(f"{d}/{s}.kraken2.classifiedreads.txt")
    return out


if SCREEN in ("kraken2", "kraken2_bracken"):

    # KRAKEN2 (ext.args '--confidence 0.05 --minimum-hit-groups 3')
    rule kraken2:
        input:
            reads=lambda wc: screen_reads(wc.sample),
            db=KRAKEN_DB,
        output:
            report=f"{CONTAM}/kraken2/kraken_reports/{{sample}}.kraken2.report.txt",
        params:
            paired=lambda wc: "" if screen_se(wc.sample) else "--paired",
            fastqs=lambda wc: (
                "" if not KRAKEN_FASTQS else
                f"--classified-out {wc.sample}.classified.fastq --unclassified-out {wc.sample}.unclassified.fastq"
                if screen_se(wc.sample) else
                f"--classified-out {wc.sample}.classified#.fastq --unclassified-out {wc.sample}.unclassified#.fastq"
            ),
            assign=lambda wc: f"--output {wc.sample}.kraken2.classifiedreads.txt" if KRAKEN_ASSIGN else "--output /dev/null",
            dest=lambda wc: os.path.abspath(f"{als(wc.sample)}/contaminants/kraken2/kraken_reports"),
        container:
            container_path("kraken2")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            p={wildcards.sample}
            kraken2 --db {input.db} --threads {threads} --report $p.kraken2.report.txt --gzip-compressed \
                {params.fastqs} {params.assign} {params.paired} --confidence 0.05 --minimum-hit-groups 3 \
                {input.reads}
            mkdir -p {params.dest}
            if ls *.fastq >/dev/null 2>&1; then pigz -p {threads} *.fastq; mv *.fastq.gz {params.dest}/; fi
            mv $p.kraken2.report.txt {output.report}
            if [ -f $p.kraken2.classifiedreads.txt ]; then mv $p.kraken2.classifiedreads.txt {params.dest}/; fi
            """

if SCREEN == "kraken2_bracken":

    # BRACKEN (ext.args '-l bracken_precision')
    rule bracken:
        input:
            report=f"{CONTAM}/kraken2/kraken_reports/{{sample}}.kraken2.report.txt",
            db=KRAKEN_DB,
        output:
            tsv=f"{CONTAM}/bracken/{{sample}}.tsv",
            txt=f"{CONTAM}/bracken/{{sample}}.kraken2.report_bracken.txt",
        params:
            level=config["bracken_precision"],
        container:
            container_path("bracken")
        threads: res("process_low")["threads"]
        resources:
            mem_mb=res("process_low")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            p={wildcards.sample}
            bracken -l {params.level} -d '{input.db}' -i '{input.report}' -o "$p.tsv" -w "$p.kraken2.report_bracken.txt"
            mv $p.tsv {output.tsv}
            mv $p.kraken2.report_bracken.txt {output.txt}
            """

if SCREEN == "sylph":

    SYLPH_DBS = [stage(p.strip()) for p in str(cfg("sylph_db")).split(",") if p.strip()]
    SYLPH_TAX = [stage(p.strip()) for p in str(cfg("sylph_taxonomy")).split(",") if p.strip()]

    # SYLPH_PROFILE (ext.args '-c 100 -u')
    rule sylph_profile:
        input:
            reads=lambda wc: screen_reads(wc.sample),
            db=SYLPH_DBS,
        output:
            f"{CONTAM}/sylph/{{sample}}.tsv",
        params:
            reads=lambda wc, input: (
                f"-r {os.path.basename(input.reads[0])}" if screen_se(wc.sample)
                else f"-1 {os.path.basename(input.reads[0])} -2 {os.path.basename(input.reads[1])}"
            ),
        container:
            container_path("sylph")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            for f in {input.reads}; do ln -s $(realpath $f) $(basename $f); done
            sylph profile -t {threads} -c 100 -u {input.db} {params.reads} -o {wildcards.sample}.tsv
            mv {wildcards.sample}.tsv {output}
            """

    # SYLPHTAX_TAXPROF. nf-core drops empty profiles before this step; here an
    # empty profile gives an empty .sylphmpa (Snakemake needs the output).
    rule sylphtax_taxprof:
        input:
            profile=f"{CONTAM}/sylph/{{sample}}.tsv",
            taxonomy=SYLPH_TAX,
        output:
            f"{CONTAM}/sylph/{{sample}}.sylphmpa",
        container:
            container_path("sylphtax")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            if [ -s {input.profile} ]; then
                export SYLPH_TAXONOMY_CONFIG="/tmp/config.json"
                ln -s $(realpath {input.profile}) $(basename {input.profile})
                tax=; for f in {input.taxonomy}; do ln -s $(realpath $f) $(basename $f); tax="$tax $(basename $f)"; done
                sylph-tax taxprof $(basename {input.profile}) -t $tax
                mv *.sylphmpa {wildcards.sample}.sylphmpa
            else
                touch {wildcards.sample}.sylphmpa
            fi
            mv {wildcards.sample}.sylphmpa {output}
            """


def screen_outputs(s):
    """Published contaminant-screening files of a sample."""
    d = f"{als(s)}/contaminants"
    if SCREEN in ("kraken2", "kraken2_bracken"):
        out = [f"{d}/kraken2/kraken_reports/{s}.kraken2.report.txt"]
        if SCREEN == "kraken2_bracken":
            out += [f"{d}/bracken/{s}.tsv", f"{d}/bracken/{s}.kraken2.report_bracken.txt"]
        return out
    if SCREEN == "sylph":
        return [f"{d}/sylph/{s}.tsv", f"{d}/sylph/{s}.sylphmpa"]
    return []


def screen_mqc(s):
    d = f"{als(s)}/contaminants"
    return {"kraken2": [f"{d}/kraken2/kraken_reports/{s}.kraken2.report.txt"],
            "kraken2_bracken": [f"{d}/bracken/{s}.kraken2.report_bracken.txt"],
            "sylph": [f"{d}/sylph/{s}.sylphmpa"]}.get(SCREEN, [])


# =============================================================================
# MULTIQC_RNASEQ
# =============================================================================
ALIGNER_DISPLAY = {
    "star_salmon": "STAR uniquely mapped reads",
    "star_rsem": "STAR uniquely mapped reads",
    "hisat2": "HISAT2 overall alignment rate",
    "bowtie2_salmon": "Bowtie2 overall alignment rate",
}.get(ALIGNER, "Aligned reads")


def ie_samples():
    return samples_mapped() if RUN_IE else []


def multiqc_side_inputs(wc):
    trimmed = samples_trimmed()
    ie, ie_dirs = [], []
    if RUN_IE and USE_RUSTQC:
        ie_dirs = [f"{W}/rustqc/{s}" for s in ie_samples()]
    elif RUN_IE:
        ie = [f"{rseqc_dir(s)}/infer_experiment/{s}.infer_experiment.txt" for s in ie_samples()]
    # Strand classification of the genome BAMs uses their own meta: pre-aligned
    # BAMs carry the samplesheet strandedness, aligned ones the inferred one.
    strand = [f"{W}/status/{s}.strand.json" for s in trimmed]
    if RUN_IE and not ALIGN:
        strand = [f"{W}/status/{s}.bam.strand.json" for s in ie_samples()]
    return {
        "trim": [] if SKIP_TRIM else [f"{W}/status/{s}.trim.json" for s in FQ_SAMPLES],
        "map": [f"{W}/status/{s}.map.json" for s in genome_samples()],
        "strand": strand,
        "ie": ie,
        "ie_dirs": ie_dirs,
    }


def _opt(flag_name, files):
    return " ".join([flag_name] + list(files)) if files else ""


# Groovy side of MULTIQC_RNASEQ: fail_trimmed / fail_mapped tables, strand
# check JSON, table_sample_merge config, name replacements (and the
# per-sample variants for skip_quantification_merge).
rule multiqc_rnaseq_inputs:
    input:
        unpack(multiqc_side_inputs),
        samplesheet=SHEET,
        summary=f"{ASSETS}/strand_check_summary.yaml",
        composition=f"{ASSETS}/strand_check_composition.yaml",
        header=f"{ASSETS}/sample_status_header.txt",
    output:
        directory(f"{W}/multiqc/side_files"),
    params:
        trim=lambda wc: _opt("--trim-status", multiqc_side_inputs(wc)["trim"]),
        map=lambda wc: _opt("--map-status", multiqc_side_inputs(wc)["map"]),
        strand=lambda wc: _opt("--strand-status", multiqc_side_inputs(wc)["strand"]),
        ie=lambda wc: _opt("--infer-experiment", multiqc_side_inputs(wc)["ie"]),
        ie_dirs=lambda wc: " ".join(multiqc_side_inputs(wc)["ie_dirs"]),
        per_sample="--per-sample" if SKIP_MERGE else "",
    container:
        container_path("multiqc")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        ie_rustqc=
        for d in {params.ie_dirs}; do ie_rustqc="$ie_rustqc $(python3 {SCRIPTS}/rustqc_publish.py ie $d)"; done
        if [ -n "$ie_rustqc" ]; then ie_rustqc="--infer-experiment $ie_rustqc"; fi
        python3 {SCRIPTS}/multiqc_rnaseq_inputs.py --samplesheet {input.samplesheet} \
            {params.trim} {params.map} {params.strand} {params.ie} $ie_rustqc \
            --aligner-display-name '{ALIGNER_DISPLAY}' --min-trimmed-reads {config[min_trimmed_reads]} \
            --stranded-threshold {config[stranded_threshold]} --unstranded-threshold {config[unstranded_threshold]} \
            --summary-asset {input.summary} --composition-asset {input.composition} \
            --status-header {input.header} {params.per_sample} --outdir {output}
        """


def mqc_fastq_files(s):
    """FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS contributions of one sample.
    Returns (flat, bundle): ch_multiqc_files and the per-sample bundle differ
    only in the trimmer log (the fastp .log is bundled but not in the flat list)."""
    flat, bundle = [], []
    d = so(s)
    trimmed = trim_pass(s)
    if not SKIP_FASTQC:
        flat += [f"{d}/fastqc/raw/{s}_raw{m}_fastqc.zip" for m in mates(s, raw=True)]
    if not SKIP_TRIM and TRIMMER == "trimgalore":
        tg = trimgalore_outputs(s)
        flat += [f for f in tg if f.endswith(".zip")]
        flat += [f for f in tg if f.endswith("_report.txt")]
        flat += trim_json_files(s)
    if not SKIP_TRIM and TRIMMER == "fastp":
        if not SKIP_FASTQC and trimmed:
            flat += [f"{d}/fastqc/trim/{s}_trimmed{m}_fastqc.zip" for m in mates(s)]
        flat += [f"{d}/fastp/{s}.fastp.json"]
    if UMI_EXTRACT:
        flat += [f"{d}/umitools/{s}.umi_extract.log"]
    bundle = list(flat)
    if not SKIP_TRIM and TRIMMER == "fastp":
        bundle.append(f"{d}/fastp/log/{s}.fastp.log")
    if trimmed:
        extra = []
        if not SKIP_BBSPLIT:
            extra.append(f"{d}/bbsplit/{s}.stats.txt")
        if RIBO == "sortmerna":
            extra.append(f"{d}/sortmerna/{s}.sortmerna.log")
        elif RIBO == "ribodetector":
            extra += [f"{d}/ribodetector/{s}.rrna_removal_stats.tsv", f"{d}/ribodetector/{s}.log"]
        elif RIBO == "bowtie2":
            extra.append(f"{d}/bowtie2_rrna/{s}.bowtie2_rrna.bowtie2.log")
        if not SKIP_FASTQC and (not SKIP_BBSPLIT or RIBO):
            extra += [f"{d}/fastqc/filtered/{s}_filtered{m}_fastqc.zip" for m in mates(s)]
        flat += extra
        bundle += extra
    return flat, bundle


def mqc_align_files(s):
    """Aligner logs (+ stats when they are not superseded by MarkDuplicates / UMI)."""
    out = []
    if not ALIGN or not trim_pass(s):
        return out
    if STAR:
        out.append(f"{als(s)}/log/{s}.Log.final.out")
    elif ALIGNER == "bowtie2_salmon":
        out.append(f"{als(s)}/log/{s}.bowtie2.log")
    else:
        out.append(f"{als(s)}/log/{s}.hisat2.summary.log")
    if not WITH_UMI and (flag("skip_markduplicates") or (PARABRICKS and STAR)):
        out += [f"{als(s)}/samtools_stats/{s}.sorted.bam.{x}" for x in ("stats", "flagstat", "idxstats")]
    return out


def mqc_umi_files(s):
    if not (ALIGN and WITH_UMI and trim_pass(s)):
        return []
    if UMI_TOOL == "umitools":
        log = f"{als(s)}/umitools/genomic_dedup_log/{s}.umi_dedup.sorted.log"
    else:
        log = f"{als(s)}/umicollapse/genomic_dedup_log/{s}.umi_dedup.sorted_UMICollapse.log"
    return [log] + [f"{als(s)}/samtools_stats/{s}.umi_dedup.sorted.bam.{x}" for x in ("stats", "flagstat", "idxstats")]


def mqc_quant_bam_files(s):
    if ALIGNER == "star_rsem" and s in quant_samples_bam():
        return [f"{als(s)}/{s}.stat"]
    return []


def mqc_markdup_files(s):
    out = []
    if not SKIP_MARKDUP:
        if not USE_RUSTQC:
            out += [f"{als(s)}/samtools_stats/{s}.markdup.sorted.bam.{x}" for x in ("stats", "flagstat", "idxstats")]
        out.append(f"{als(s)}/picard_metrics/{s}.markdup.sorted.metrics.txt")
    return out


def mqc_bamqc_files(s):
    """BAM_QC_RNASEQ files (RustQC outputs are expanded at run time)."""
    if SKIP_QC or USE_RUSTQC:
        return []
    out = []
    if "preseq" in QC_TOOLS:
        out.append(f"{als(s)}/preseq/{s}.lc_extrap.txt")
    if "biotype_qc" in QC_TOOLS:
        out.append(f"{als(s)}/featurecounts/{s}.biotype_counts_mqc.tsv")
    if "qualimap" in QC_TOOLS:
        out.append(f"{als(s)}/qualimap/{s}")
    if "dupradar" in QC_TOOLS:
        out += [f"{W}/dupradar/{s}_dup_intercept_mqc.txt", f"{W}/dupradar/{s}_duprateExpDensCurve_mqc.txt"]
    R = rseqc_dir(s)
    mqc_rseqc = {
        "bam_stat": [f"{R}/bam_stat/{s}.bam_stat.txt"],
        "infer_experiment": [f"{R}/infer_experiment/{s}.infer_experiment.txt"],
        "inner_distance": [] if se(s) else [f"{R}/inner_distance/txt/{s}.inner_distance_freq.txt"],
        "junction_annotation": [f"{R}/junction_annotation/log/{s}.junction_annotation.log"],
        "junction_saturation": [f"{R}/junction_saturation/rscript/{s}.junctionSaturation_plot.r"],
        "read_distribution": [f"{R}/read_distribution/{s}.read_distribution.txt"],
        "read_duplication": [f"{R}/read_duplication/xls/{s}.pos.DupRate.xls"],
        "tin": [f"{R}/tin/{s}.summary.txt"],
    }
    for mod in RSEQC:
        out += mqc_rseqc[mod]
    return out


def mqc_pseudo_files(s):
    if not PSEUDO or not trim_pass(s):
        return []
    return [f"{so(s)}/salmon/{s}"] if PSEUDO == "salmon" else [f"{W}/kallisto/{s}.log"]


def rustqc_dirs(samples):
    return [f"{W}/rustqc/{s}" for s in samples] if (USE_RUSTQC and not SKIP_QC) else []


def multiqc_files(wc):
    """ch_multiqc_files of RNASEQ (merged-report branch), in nf-core's mix order."""
    files = []
    trimmed = samples_trimmed()
    mapped = samples_mapped()
    for s in FQ_SAMPLES:
        files += mqc_fastq_files(s)[0]
    for s in FQ_SAMPLES:
        files += mqc_align_files(s)
    for s in FQ_SAMPLES:
        files += mqc_umi_files(s)
    for s in quant_samples_bam():
        files += mqc_quant_bam_files(s)
    if ALIGNER in QUANT_TYPE and quant_samples_bam() and not SKIP_QC and not flag("skip_deseq2_qc"):
        files += [f"{W}/deseq2_qc/{ALIGNER}.pca.vals_mqc.tsv", f"{W}/deseq2_qc/{ALIGNER}.sample.dists_mqc.tsv"]
    for s in mapped:
        files += mqc_markdup_files(s)
    for s in mapped:
        files += mqc_bamqc_files(s)
    for s in screen_samples():
        files += screen_mqc(s)
    for s in trimmed:
        files += mqc_pseudo_files(s)
    if PSEUDO and trimmed and not SKIP_QC and not flag("skip_deseq2_qc"):
        files += [f"{W}/deseq2_qc/{PSEUDO}.pca.vals_mqc.tsv", f"{W}/deseq2_qc/{PSEUDO}.sample.dists_mqc.tsv"]
    return files


def multiqc_sample_files(s):
    """Per-sample MultiQC bundle (skip_quantification_merge), in join order."""
    files = []
    if s in FQ_SAMPLES:
        files += mqc_fastq_files(s)[1]
        files += mqc_align_files(s)
        files += mqc_umi_files(s)
    if s in quant_samples_bam():
        files += mqc_quant_bam_files(s)
    if s in samples_mapped():
        files += mqc_markdup_files(s)
        files += mqc_bamqc_files(s)
    if s in screen_samples():
        files += screen_mqc(s)
    if s in FQ_SAMPLES:
        files += mqc_pseudo_files(s)
    return files


MQC_DIR = f"{O}/multiqc" + ("" if SKIP_ALIGN else f"/{ALIGNER}")

# -----------------------------------------------------------------------------
# Software versions (topic `versions` + softwareVersionsToYAML + collectFile)
# -----------------------------------------------------------------------------
# config/versions.yaml maps every nf-core process to the port rules that run it
# and the version commands of its module; each command runs in the image of the
# rule. Per-sample MultiQC reports (skip_quantification_merge) only get the
# workflow manifest (workflowVersionToYAML).
VERSIONS_YML = f"{O}/pipeline_info/nf_core_rnaseq_software_mqc_versions.yml"
VERSIONS_MANIFEST = f"{W}/multiqc/manifest/nf_core_rnaseq_software_mqc_versions.yml"


def versions_inputs(wc):
    """Everything else the run produces, so the DAG is complete when it runs."""
    # every other output (pipeline_info too), so no job drops out of the DAG it reads
    skip = (f"{O}/multiqc/",) + tuple(f"{O}/{s}/multiqc/" for s in SAMPLES)
    return [f for f in all_outputs(wc) if f not in (VERSIONS_YML, VERSIONS_MANIFEST) and not f.startswith(skip)]


rule software_versions:
    input:
        versions_inputs,
    output:
        yml=VERSIONS_YML,
        manifest=VERSIONS_MANIFEST,
    run:
        from software_versions import collect, dag_jobs, write_topic

        versions = collect(os.path.join(workflow.basedir, "config/versions.yaml"), dag_jobs(workflow, input), globals())
        write_topic(versions, "nf-core/rnaseq", "v3.27.0", output.yml)
        write_topic({}, "nf-core/rnaseq", "v3.27.0", output.manifest)

# Shared MultiQC shell: stage every input in its own numbered directory
# (stageAs: "?/*"); RustQC directories contribute their MultiQC files.
MULTIQC_STAGE_SH = r"""
configs="--config $(realpath {input.config}) --config $side/multiqc_sample_merge.yml"
for c in {input.extra_config}; do configs="$configs --config $(realpath $c)"; done
logo=
for l in {input.logo}; do logo="custom_logo: \"$(realpath $l)\""; done
i=0
stage_one() {{ i=$((i + 1)); mkdir -p stage/$i; ln -s $(realpath $1) stage/$i/$(basename $1); }}
for f in {input.files}; do stage_one $f; done
for d in {input.rustqc}; do
    for f in $(python3 {SCRIPTS}/rustqc_publish.py mqc $d); do stage_one $f; done
done
"""


# MULTIQC. nf-core also feeds workflow_summary_mqc.yaml and
# methods_description_mqc.yaml (Nextflow run metadata, not produced here).
rule multiqc:
    input:
        files=multiqc_files,
        versions=VERSIONS_YML,
        rustqc=lambda wc: rustqc_dirs(samples_mapped()),
        side=f"{W}/multiqc/side_files",
        config=f"{ASSETS}/multiqc_config.yml",
        extra_config=cfg("multiqc_config") or [],
        logo=cfg("multiqc_logo") or [],
    output:
        report=f"{MQC_DIR}/multiqc_report.html",
        data=directory(f"{MQC_DIR}/multiqc_report_data"),
    params:
        title=literal(f"--title \"{config['multiqc_title']}\"" if cfg("multiqc_title") else ""),
        plots=lambda wc, output: os.path.join(os.path.abspath(os.path.dirname(output.report)), "multiqc_report_plots"),
    container:
        container_path("multiqc")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        "side=$(realpath {input.side})\n" + MULTIQC_STAGE_SH + """
        replace=
        if [ -f $side/name_replacement.txt ]; then replace="--replace-names $side/name_replacement.txt"; fi
        for f in $(find $side -maxdepth 1 -name '*_mqc.*' ! -name '*_fail_*' ! -name '*_strand_check_*'); do stage_one $f; done
        stage_one {input.versions}
        cd stage
        multiqc --force {params.title} $configs --filename multiqc_report.html \
            ${{logo:+--cl-config "$logo"}} $replace .
        cd ..
        mv stage/multiqc_report.html {output.report}
        mv stage/multiqc_report_data {output.data}
        rm -rf {params.plots}
        if [ -d stage/multiqc_report_plots ]; then mv stage/multiqc_report_plots {params.plots}; fi
        """


def sample_mqc_dir(s):
    return f"{O}/{s}/multiqc" + ("" if SKIP_ALIGN else f"/{ALIGNER}")


# MULTIQC per sample (skip_quantification_merge): the sample's bundle, its own
# fail / strand-check files and the run-level fail tables; no name replacement.
rule multiqc_sample:
    input:
        files=lambda wc: multiqc_sample_files(wc.sample),
        versions=VERSIONS_MANIFEST,
        rustqc=lambda wc: rustqc_dirs([wc.sample] if wc.sample in samples_mapped() else []),
        side=f"{W}/multiqc/side_files",
        config=f"{ASSETS}/multiqc_config.yml",
        extra_config=cfg("multiqc_config") or [],
        logo=cfg("multiqc_logo") or [],
    output:
        report=f"{O}/{{sample}}/multiqc" + ("" if SKIP_ALIGN else f"/{ALIGNER}") + "/{sample}_multiqc_report.html",
        data=directory(f"{O}/{{sample}}/multiqc" + ("" if SKIP_ALIGN else f"/{ALIGNER}") + "/{sample}_multiqc_report_data"),
    params:
        title=literal(f"--title \"{config['multiqc_title']}\"" if cfg("multiqc_title") else ""),
        plots=lambda wc, output: os.path.join(os.path.abspath(os.path.dirname(output.report)),
                                              f"{wc.sample}_multiqc_report_plots"),
    container:
        container_path("multiqc")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        "side=$(realpath {input.side})\n" + MULTIQC_STAGE_SH + """
        s={wildcards.sample}
        for f in $side/${{s}}_fail_trimmed_samples_mqc.tsv $side/${{s}}_fail_mapped_samples_mqc.tsv \
                 $side/${{s}}_strand_check_summary_mqc.json $side/${{s}}_strand_check_composition_mqc.json \
                 $side/fail_trimmed_samples_mqc.tsv $side/fail_mapped_samples_mqc.tsv; do
            if [ -f $f ]; then stage_one $f; fi
        done
        stage_one {input.versions}
        cd stage
        multiqc --force {params.title} $configs --filename ${{s}}_multiqc_report.html \
            ${{logo:+--cl-config "$logo"}} .
        cd ..
        mv stage/${{s}}_multiqc_report.html {output.report}
        mv stage/${{s}}_multiqc_report_data {output.data}
        rm -rf {params.plots}
        if [ -d stage/${{s}}_multiqc_report_plots ]; then mv stage/${{s}}_multiqc_report_plots {params.plots}; fi
        """


# =============================================================================
# samplesheets/samplesheet_with_bams.csv (save_align_intermeds)
# =============================================================================
def published_bam_path(path, s):
    """utils_nfcore_rnaseq_pipeline: mapBamToPublishedPath."""
    if not path:
        return ""
    name = os.path.basename(path)
    base = f"{O}/{ALIGNER}"
    if ALIGNER == "star_salmon":
        if "Aligned.out.bam" in name:
            return f"{base}/{s}.Aligned.out.bam"
        if "toTranscriptome" in name:
            return f"{base}/{s}.Aligned.toTranscriptome.out.bam"
    elif ALIGNER == "star_rsem":
        if "genome.bam" in name:
            return f"{base}/{s}.STAR.genome.bam"
        if "transcript.bam" in name:
            return f"{base}/{s}.transcript.bam"
    elif ALIGNER == "hisat2":
        return f"{base}/{s}.bam"
    return f"{base}/{name}"


# Groovy collectFile in RNASEQ: one row per FASTQ run of each aligned sample
# (genome BAM = the sorted BAM, transcriptome BAM = the aligner's).
rule samplesheet_with_bams:
    input:
        # the checkpoint outputs are read by samples_trimmed() / strandedness()
        lambda wc: [f"{W}/status/{s}.map.json" for s in samples_trimmed()]
        + [f"{W}/status/trim_summary.json", f"{W}/status/sample_summary.json"],
    output:
        f"{O}/samplesheets/samplesheet_with_bams.csv",
    run:
        def uri(path):
            return path if is_url(path) else os.path.abspath(path)

        # checkpoints.<x>.get() raises inside run:, so read the summaries directly
        with open(input[-2]) as fh:
            trim = json.load(fh)
        with open(input[-1]) as fh:
            summ = json.load(fh)
        rows = []
        for s in [s for s in FQ_SAMPLES if SKIP_TRIM or trim[s]["pass"]]:
            with open(f"{W}/status/{s}.map.json") as fh:
                pm = json.load(fh)["percent_mapped"]
            meta = SAMPLES[s]
            gbam = published_bam_path(f"{s}.sorted.bam", s)
            tbam = published_bam_path(f"{s}.Aligned.toTranscriptome.out.bam", s) if STAR else ""
            mapped = "" if pm is None else java_float_str(pm)
            platform = meta["seq_platform"] or cfg("seq_platform")
            center = meta["seq_center"] or cfg("seq_center")
            for fq1, fq2 in meta["raw_runs"]:
                rows.append(f"{s},{uri(fq1)},{uri(fq2) if fq2 else ''},{summ[s]['strand']['strandedness']},{platform},{center},"
                            f"{gbam},{mapped},{tbam}")
        with open(output[0], "w") as fh:
            fh.write("sample,fastq_1,fastq_2,strandedness,seq_platform,seq_center,genome_bam,percent_mapped,"
                     "transcriptome_bam\n")
            fh.write("".join(r + "\n" for r in rows))
