            "samtools view --threads {params.threads} -f 12 -o {output} {input}"

    # SAMTOOLS_FASTQ_BOWTIE2 (interleave false)
    rule samtools_fastq_bowtie2:
        input:
            f"{W}/bowtie2_rrna/{{sample}}.bowtie2_unmapped.bam",
        output:
            r1=f"{W}/bowtie2_rrna/{{sample}}.bowtie2_filtered_1.fastq.gz",
            r2=f"{W}/bowtie2_rrna/{{sample}}.bowtie2_filtered_2.fastq.gz",
        wildcard_constraints:
            sample=alternation(PE),
        params:
            threads=max(1, res("process_low")["threads"] - 1),
        container:
            container_path("samtools")
        threads: res("process_low")["threads"]
        resources:
            mem_mb=res("process_low")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            f={wildcards.sample}.bowtie2_filtered
            samtools fastq --threads {params.threads} -0 ${{f}}_other.fastq.gz {input} \
                -1 ${{f}}_1.fastq.gz -2 ${{f}}_2.fastq.gz -s ${{f}}_singleton.fastq.gz
            mv ${{f}}_1.fastq.gz {output.r1}
            mv ${{f}}_2.fastq.gz {output.r2}
            """


# FQ_SUBSAMPLE (FASTQ_SUBSAMPLE_FQ_SALMON; strandedness: auto only)
rule fq_subsample:
    input:
        reads=lambda wc: reads_filtered(wc.sample),
        lint=lambda wc: lint_gate(wc.sample, last_stage()),
    output:
        directory(f"{W}/strand/{{sample}}/subsampled"),
    params:
        dst=lambda wc, output: (
            f"--r1-dst {output}/{wc.sample}.subsampled.fastq.gz" if se(wc.sample)
            else f"--r1-dst {output}/{wc.sample}.subsampled_R1.fastq.gz "
                 f"--r2-dst {output}/{wc.sample}.subsampled_R2.fastq.gz"
        ),
    container:
        container_path("fq")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        mkdir -p {output}
        fq subsample --record-count 1000000 --seed 1 {input.reads} {params.dst}
        """


# SALMON_QUANT (FASTQ_SUBSAMPLE_FQ_SALMON; ext.args '--skipQuant')
rule salmon_strand:
    input:
        reads=rules.fq_subsample.output,
        index=SALMON_INDEX,
        gtf=GTF,
    output:
        f"{W}/strand/{{sample}}/lib_format_counts.json",
    params:
        reads=lambda wc, input: (
            f"-r {input.reads[0]}/{wc.sample}.subsampled.fastq.gz" if se(wc.sample)
            else f"-1 {input.reads[0]}/{wc.sample}.subsampled_R1.fastq.gz "
                 f"-2 {input.reads[0]}/{wc.sample}.subsampled_R2.fastq.gz"
        ),
    container:
        container_path("salmon")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        salmon quant --geneMap {input.gtf} --threads {threads} --index {input.index} \
            {params.reads} --skipQuant -o {wildcards.sample}
        cp {wildcards.sample}/lib_format_counts.json {output}
        """


# Groovy in FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS: strandedness 'auto' is
# replaced by the Salmon inference (undetermined -> unstranded).
rule strandedness:
    input:
        lambda wc: (
            f"{W}/strand/{wc.sample}/lib_format_counts.json"
            if SAMPLES[wc.sample]["strandedness"] == "auto" else []
        ),
    output:
        json=f"{W}/status/{{sample}}.strand.json",
        txt=f"{W}/status/{{sample}}.strandedness",
    run:
        provided = SAMPLES[wildcards.sample]["strandedness"]
        analysis = None
        value = provided
        if provided == "auto":
            analysis = salmon_strandedness(
                input[0], float(config["stranded_threshold"]), float(config["unstranded_threshold"])
            )
            value = analysis["inferred_strandedness"]
            if value == "undetermined":
                value = "unstranded"
        with open(output.json, "w") as fh:
            json.dump({"sample": wildcards.sample, "provided": provided, "strandedness": value,
                       "salmon_strand_analysis": analysis}, fh)
        with open(output.txt, "w") as fh:
            fh.write(value + "\n")


# Pre-aligned BAM input keeps its samplesheet meta (no Salmon inference).
rule bam_strandedness:
    output:
        json=f"{W}/status/{{sample}}.bam.strand.json",
        txt=f"{W}/status/{{sample}}.bam.strandedness",
    run:
        value = SAMPLES[wildcards.sample]["strandedness"]
        with open(output.json, "w") as fh:
            json.dump({"sample": wildcards.sample, "provided": value, "strandedness": value,
                       "salmon_strand_analysis": None}, fh)
        with open(output.txt, "w") as fh:
            fh.write(value + "\n")


# =============================================================================
# Alignment: ALIGN_STAR / FASTQ_ALIGN_HISAT2 / ALIGN_BOWTIE2
# =============================================================================
def read_group(s, style):
    """Read-group tags from samplesheet meta (priority) or params."""
    meta = SAMPLES[s]
    platform = meta["seq_platform"] or cfg("seq_platform")
    center = meta["seq_center"] or cfg("seq_center")
    if style == "star":
        rg = [f"'ID:{s}'", f"'SM:{s}'"] + ([f"'PL:{platform}'"] if platform else []) \
            + ([f"'CN:{center}'"] if center else [])
        return [f"--outSAMattrRGline {' '.join(rg)}"]
    return [f"--rg-id {s}", f"--rg SM:{s}"] + ([f"--rg PL:{platform}"] if platform else []) \
        + ([f"--rg CN:{center}"] if center else [])


def star_align_args(s):
    """conf/modules/align_star.config ext.args (STAR_ALIGN, non-Parabricks)."""
    args = [
        "--quantMode TranscriptomeSAM",
        "--outSAMtype BAM Unsorted",
        "--outSAMattributes NH HI AS NM MD",
        "--readFilesCommand zcat",
    ]
    if ALIGNER == "star_rsem":
        args += [
            "--outSAMunmapped Within", "--outFilterType BySJout", "--outFilterMultimapNmax 20",
            "--outFilterMismatchNmax 999", "--outFilterMismatchNoverLmax 0.04", "--alignIntronMin 20",
            "--alignIntronMax 1000000", "--alignMatesGapMax 1000000", "--alignSJoverhangMin 8",
            "--alignSJDBoverhangMin 1", "--sjdbScore 1",
        ]
    else:
        args += [
            "--twopassMode Basic", "--runRNGseed 0", "--outFilterMultimapNmax 20", "--alignSJDBoverhangMin 1",
            "--outSAMstrandField intronMotif",
            # Sentieon's STAR predates 2.7.7a and keeps the old spelling
            "--quantTranscriptomeBan Singleend" if SENTIEON else "--quantTranscriptomeSAMoutput BanSingleEnd",
        ]
    if SAVE_UNALIGNED or SCREEN_UNMAPPED:
        args.append("--outReadsUnmapped Fastx")
    if PROKARYOTIC:
        args += ["--sjdbGTFfeatureExon CDS", "--alignIntronMax 1"]
    args = merge_args(args, cfg("extra_star_align_args"))
    return " ".join(args + read_group(s, "star"))


def unmapped_reads(s):
    """Unaligned reads written by STAR / HISAT2 (save_unaligned or screening)."""
    if STAR:
        names = [f"{s}.unmapped_1.fastq.gz"] if se(s) else [f"{s}.unmapped_{r}.fastq.gz" for r in (1, 2)]
    else:
        names = [f"{s}.unmapped.fastq.gz"] if se(s) else [f"{s}.unmapped_{r}.fastq.gz" for r in (1, 2)]
    return [f"{at(UNMAPPED_D, s)}/{n}" for n in names]


WANT_UNMAPPED = SAVE_UNALIGNED or SCREEN_UNMAPPED

if ALIGN and STAR and not PARABRICKS:

    # STAR_ALIGN / SENTIEON_STAR_ALIGN (`sentieon STAR`, same arguments). One
    # rule per endedness so the unmapped mates can be declared.
    for _kind, _members in (("se", SE), ("pe", PE)):

        rule:
            name:
                f"star_align_{_kind}"
            input:
                reads=lambda wc: reads_filtered(wc.sample),
                lint=lambda wc: lint_gate(wc.sample, last_stage()),
                index=STAR_INDEX,
                gtf=GTF,
            output:
                bam=f"{STAR_W}/{{sample}}.Aligned.out.bam" if SAVE_ALIGN else temp(f"{STAR_W}/{{sample}}.Aligned.out.bam"),
                tx_bam=f"{STAR_W}/{{sample}}.Aligned.toTranscriptome.out.bam",
                log_final=pub(f"{ALIGNER}/log") + "/{sample}.Log.final.out",
                log_out=pub(f"{ALIGNER}/log") + "/{sample}.Log.out",
                log_progress=pub(f"{ALIGNER}/log") + "/{sample}.Log.progress.out",
                sj=pub(f"{ALIGNER}/log") + "/{sample}.SJ.out.tab",
                unmapped=(
                    ([f"{UNMAPPED_D}/{{sample}}.unmapped_1.fastq.gz"] if _kind == "se" else
                     [f"{UNMAPPED_D}/{{sample}}.unmapped_1.fastq.gz", f"{UNMAPPED_D}/{{sample}}.unmapped_2.fastq.gz"])
                    if WANT_UNMAPPED else []
                ),
            wildcard_constraints:
                sample=alternation(_members),
            params:
                args=lambda wc: star_align_args(wc.sample),
                gtf=lambda wc, input: "" if flag("star_ignore_sjdbgtf") else f"--sjdbGTFfile {input.gtf}",
                star="sentieon STAR" if SENTIEON else "STAR",
                license=literal(SENTIEON_LICENSE_SH if SENTIEON else ""),
            container:
                container_path("sentieon" if SENTIEON else "star")
            threads: res("process_high")["threads"]
            resources:
                mem_mb=res("process_high")["mem_mb"],
            shadow:
                "minimal"
            shell:
                """
                {params.license}
                p={wildcards.sample}
                {params.star} --genomeDir {input.index} --readFilesIn {input.reads} --runThreadN {threads} \
                    --outFileNamePrefix $p. {params.gtf} {params.args}
                for m in 1 2; do
                    if [ -f $p.Unmapped.out.mate$m ]; then
                        mv $p.Unmapped.out.mate$m $p.unmapped_$m.fastq
                        gzip $p.unmapped_$m.fastq
                    fi
                done
                mv $p.Aligned.out.bam {output.bam}
                mv $p.Aligned.toTranscriptome.out.bam {output.tx_bam}
                mv $p.Log.final.out {output.log_final}
                mv $p.Log.out {output.log_out}
                mv $p.Log.progress.out {output.log_progress}
                mv $p.SJ.out.tab {output.sj}
                for f in {output.unmapped}; do mv $(basename $f) $f; done
                """


def parabricks_args(s):
    """conf/modules/align_star.config ext.args for PARABRICKS_RNA_FQ2BAM (kebab-case)."""
    args = ["--quantMode TranscriptomeSAM", "--out-sam-attributes NH HI AS NM MD",
            "--read-files-command zcat", f"--read-group-sm {s}", f"--read-group-id-prefix {s}"]
    if ALIGNER == "star_rsem":
        args += ["--out-sam-unmapped Within", "--max-out-filter-multimap 20", "--max-out-filter-mismatch 999",
                 "--max-out-filter-mismatch-ratio 0.04", "--min-intron-size 20", "--max-intron-size 1000000",
                 "--max-align-mates-gap 1000000", "--min-align-sj-overhang 8", "--min-align-sjdb-overhang 1"]
    else:
        args += ["--two-pass-mode Basic", "--max-out-filter-multimap 20", "--min-align-sjdb-overhang 1",
                 "--out-sam-strand-field intronMotif"]
    if SAVE_UNALIGNED or SCREEN_UNMAPPED:
        args.append("--out-reads-unmapped Fastx")
    args = merge_args(args, cfg("extra_star_align_args"))
    platform = SAMPLES[s]["seq_platform"] or cfg("seq_platform")
    if platform:
        args.append(f"--read-group-pl {platform}")  # pbrun has no read-group CN flag
    return " ".join(args)


if ALIGN and STAR and PARABRICKS:

    # PARABRICKS_RNA_FQ2BAM (process_gpu; qc_metrics on, duplicate marking unless
    # skip_markduplicates). Its coordinate-sorted BAM then goes through
    # BAM_SORT_STATS_SAMTOOLS like STAR's.
    for _kind, _members in (("se", SE), ("pe", PE)):

        rule:
            name:
                f"parabricks_rnafq2bam_{_kind}"
            input:
                reads=lambda wc: reads_filtered(wc.sample),
                lint=lambda wc: lint_gate(wc.sample, last_stage()),
                index=STAR_INDEX,
                fasta=FASTA,
            output:
                bam=f"{STAR_W}/{{sample}}.bam" if SAVE_ALIGN else temp(f"{STAR_W}/{{sample}}.bam"),
                tx_bam=f"{STAR_W}/{{sample}}.Aligned.toTranscriptome.out.bam",
                log_final=pub(f"{ALIGNER}/log") + "/{sample}.Log.final.out",
                log_out=pub(f"{ALIGNER}/log") + "/{sample}.Log.out",
                log_progress=pub(f"{ALIGNER}/log") + "/{sample}.Log.progress.out",
                unmapped=(
                    ([f"{UNMAPPED_D}/{{sample}}.unmapped_1.fastq.gz"] if _kind == "se" else
                     [f"{UNMAPPED_D}/{{sample}}.unmapped_1.fastq.gz", f"{UNMAPPED_D}/{{sample}}.unmapped_2.fastq.gz"])
                    if WANT_UNMAPPED else []
                ),
            wildcard_constraints:
                sample=alternation(_members),
            params:
                args=lambda wc: parabricks_args(wc.sample),
                in_fq=lambda wc, input: (f"--in-se-fq {' '.join(input.reads)}" if se(wc.sample)
                                         else f"--in-fq {' '.join(input.reads)}"),
                dups=lambda wc: (f"--no-markdups" if flag("skip_markduplicates")
                                 else f"--out-duplicate-metrics {wc.sample}.duplicate-metrics.txt"),
                gpus=f"--num-gpus {config.get('parabricks_num_gpus', 1)}" if config.get("parabricks_num_gpus", 1) else "",
                log_dir=lambda wc: os.path.abspath(f"{als(wc.sample)}/log"),
            container:
                container_path("parabricks")
            threads: res("process_high")["threads"]
            resources:
                mem_mb=res("process_high")["mem_mb"],
            shadow:
                "minimal"
            shell:
                """
                p={wildcards.sample}
                # stageInMode 'copy' in nf-core
                cp -rL {input.index} star_index
                cp -L {input.fasta} $(basename {input.fasta})
                pbrun rna_fq2bam --ref $(basename {input.fasta}) {params.in_fq} --output-dir . \
                    --genome-lib-dir star_index --out-bam $p.bam --logfile $p.Log.final.out --out-prefix $p. \
                    {params.gpus} --out-qc-metrics-dir ${{p}}_qc_metrics {params.dups} {params.args}
                mv $p.bam {output.bam}
                mv $p.Aligned.toTranscriptome.out.bam {output.tx_bam}
                mv $p.Log.final.out {output.log_final}
                mv $p.Log.out {output.log_out}
                mv $p.Log.progress.out {output.log_progress}
                mkdir -p {params.log_dir}
                for f in $p*.tab; do [ -e "$f" ] && mv "$f" {params.log_dir}/; done
                for f in {output.unmapped}; do mv $(basename $f) $f; done
                """


def hisat2_args(s):
    """conf/modules/align_hisat2.config ext.args for each strandedness."""
    out = {}
    for strand in ("forward", "reverse", "unstranded"):
        args = ["--met-stderr", "--new-summary", "--dta"]
        if strand == "forward":
            args.append("--rna-strandness F" if se(s) else "--rna-strandness FR")
        elif strand == "reverse":
            args.append("--rna-strandness R" if se(s) else "--rna-strandness RF")
        args = merge_args(args, cfg("extra_hisat2_align_args"))
        out[strand] = " ".join(args + read_group(s, "hisat2"))
    return out


if ALIGN and ALIGNER == "hisat2":

    # HISAT2_ALIGN (aligned, primary reads only)
    for _kind, _members in (("se", SE), ("pe", PE)):

        rule:
            name:
                f"hisat2_align_{_kind}"
            input:
                reads=lambda wc: reads_filtered(wc.sample),
                lint=lambda wc: lint_gate(wc.sample, last_stage()),
                index=HISAT2_INDEX,
                ss=SPLICESITES,
                strand=strand_file,
            output:
                bam=f"{ALN_D}/{{sample}}.bam",
                log=pub(f"{ALIGNER}/log") + "/{sample}.hisat2.summary.log",
                unmapped=(
                    ([f"{UNMAPPED_D}/{{sample}}.unmapped.fastq.gz"] if _kind == "se" else
                     [f"{UNMAPPED_D}/{{sample}}.unmapped_1.fastq.gz", f"{UNMAPPED_D}/{{sample}}.unmapped_2.fastq.gz"])
                    if WANT_UNMAPPED else []
                ),
            wildcard_constraints:
                sample=alternation(_members),
            params:
                args_forward=lambda wc: hisat2_args(wc.sample)["forward"],
                args_reverse=lambda wc: hisat2_args(wc.sample)["reverse"],
                args_unstranded=lambda wc: hisat2_args(wc.sample)["unstranded"],
                reads=lambda wc, input: (
                    f"-U {input.reads[0]}" if se(wc.sample)
                    else f"-1 {input.reads[0]} -2 {input.reads[1]}"
                ),
                un=lambda wc: (
                    "" if not WANT_UNMAPPED else
                    f"--un-gz {wc.sample}.unmapped.fastq.gz" if se(wc.sample)
                    else f"--un-conc-gz {wc.sample}.unmapped.fastq.gz"
                ),
                pe=lambda wc: "" if se(wc.sample) else "--no-mixed --no-discordant",
                view=lambda wc: "-F 4 -F 256" if se(wc.sample) else "-F 4 -F 8 -F 256",
            container:
                container_path("hisat2")
            threads: res("process_high")["threads"]
            resources:
                mem_mb=res("process_high")["mem_mb"],
            shadow:
                "minimal"
            shell:
                """
                case "$(cat {input.strand})" in
                    forward) args="{params.args_forward}" ;;
                    reverse) args="{params.args_reverse}" ;;
                    *)       args="{params.args_unstranded}" ;;
                esac
                ln -s $(realpath {input.index}) ht2_index
                INDEX=`find -L ./ht2_index -name "*.1.ht2*" | sed 's/\\.1.ht2.*$//'`
                p={wildcards.sample}
                hisat2 -x $INDEX {params.reads} --known-splicesite-infile {input.ss} \
                    --summary-file $p.hisat2.summary.log --threads {threads} {params.un} {params.pe} $args \
                    | samtools view -bS {params.view} - > $p.bam
                if [ -f $p.unmapped.fastq.1.gz ]; then mv $p.unmapped.fastq.1.gz ${{p}}.unmapped_1.fastq.gz; fi
                if [ -f $p.unmapped.fastq.2.gz ]; then mv $p.unmapped.fastq.2.gz ${{p}}.unmapped_2.fastq.gz; fi
                mv $p.bam {output.bam}
                mv $p.hisat2.summary.log {output.log}
                for f in {output.unmapped}; do mv $(basename $f) $f; done
                """


def bowtie2_align_args(s):
    """conf/modules/align_bowtie2.config ext.args (merge splits on ' -')."""
    base = cfg("bowtie2_align_base_args", "--very-sensitive --no-discordant -k 200").split(" -")
    base = [base[0]] + ["-" + b for b in base[1:]]
    args = merge_args(base, cfg("extra_bowtie2_align_args"), split=r"\s(?=-)")
    return " ".join(args + read_group(s, "bowtie2"))


if ALIGN and ALIGNER == "bowtie2_salmon":

    # BOWTIE2_ALIGN (ALIGN_BOWTIE2: transcriptome alignment, unsorted BAM)
    for _kind, _members in (("se", SE), ("pe", PE)):

