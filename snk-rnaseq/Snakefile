if RIBO == "bowtie2" and not cfg("bowtie2_rrna_index"):

    RRNA_ID = {basename_noext(f): f for f in RRNA_FASTAS}

    # SEQKIT_REPLACE: prefix each rRNA sequence name with its file name
    # (no publishDir in the config, so the default <outdir>/seqkit/ applies)
    rule seqkit_replace_rrna:
        input:
            lambda wc: RRNA_ID[wc.rid],
        output:
            f"{O}/seqkit/{{rid}}_prefixed.fasta",
        wildcard_constraints:
            rid=alternation(RRNA_ID),
        container:
            container_path("seqkit")
        threads: res("process_low")["threads"]
        resources:
            mem_mb=res("process_low")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            ln -s $(realpath {input}) $(basename {input})
            seqkit replace --pattern "^(.+)" --replacement "{{fbn}}_\\$1" --threads {threads} \
                -i $(basename {input}) -o {wildcards.rid}_prefixed.fasta
            mv {wildcards.rid}_prefixed.fasta {output}
            """

    # SEQKIT_REPLACE_U2T: RNA -> DNA alphabet
    rule seqkit_replace_u2t:
        input:
            f"{O}/seqkit/{{rid}}_prefixed.fasta",
        output:
            f"{O}/seqkit/{{rid}}_dna_converted.fasta",
        wildcard_constraints:
            rid=alternation(RRNA_ID),
        container:
            container_path("seqkit")
        threads: res("process_low")["threads"]
        resources:
            mem_mb=res("process_low")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            ln -s $(realpath {input}) $(basename {input})
            seqkit replace --by-seq --pattern "[Uu]" --replacement "T" --threads {threads} \
                -i $(basename {input}) -o {wildcards.rid}_dna_converted.fasta
            mv {wildcards.rid}_dna_converted.fasta {output}
            """

    # collectFile(name: 'rrna_combined_dna.fasta', newLine: true) + BOWTIE2_BUILD
    rule bowtie2_build_rrna:
        input:
            [f"{O}/seqkit/{r}_dna_converted.fasta" for r in RRNA_ID],
        output:
            directory(BOWTIE2_RRNA_INDEX),
        container:
            container_path("bowtie2")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            for f in {input}; do cat $f; echo; done > rrna_combined_dna.fasta
            mkdir bowtie2
            bowtie2-build --threads {threads} rrna_combined_dna.fasta bowtie2/rrna_combined_dna
            mv bowtie2 {output}
            """


