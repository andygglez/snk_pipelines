        container_path("bedclip")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shell:
        "bedClip {input.bedgraph} {input.sizes} {output}"


# UCSC_BEDGRAPHTOBIGWIG
rule ucsc_bedgraphtobigwig:
    input:
        bedgraph=f"{W}/bigwig/{{sample}}.clip{{strand}}.bedGraph",
        sizes=SIZES,
    output:
        f"{AL}/bigwig/{{sample}}{{strand}}.bigWig",
    container:
        container_path("bedgraphtobigwig")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        "bedGraphToBigWig {input.bedgraph} {input.sizes} {output}"


# =============================================================================
# MULTIQC_RNASEQ
# =============================================================================
ALIGNER_DISPLAY = {
    "star_salmon": "STAR uniquely mapped reads",
    "star_rsem": "STAR uniquely mapped reads",
    "hisat2": "HISAT2 overall alignment rate",
    "bowtie2_salmon": "Bowtie2 overall alignment rate",
}.get(ALIGNER, "Aligned reads")


def multiqc_side_inputs(wc):
    trimmed = samples_trimmed()
    mapped = samples_mapped()
    ie = []
    if not SKIP_QC and "infer_experiment" in RSEQC:
        ie = [f"{R}/infer_experiment/{s}.infer_experiment.txt" for s in mapped]
    return {
        "trim": [] if SKIP_TRIM else [f"{W}/status/{s}.trim.json" for s in SAMPLES],
        "map": [f"{W}/status/{s}.map.json" for s in trimmed],
        "strand": [f"{W}/status/{s}.strand.json" for s in trimmed],
        "ie": ie,
    }


# Groovy side of MULTIQC_RNASEQ: fail_trimmed / fail_mapped tables, strand
# check JSON, table_sample_merge config, name replacements.
rule multiqc_rnaseq_inputs:
    input:
        unpack(multiqc_side_inputs),
        samplesheet=config["input"],
        summary=f"{ASSETS}/strand_check_summary.yaml",
        composition=f"{ASSETS}/strand_check_composition.yaml",
        header=f"{ASSETS}/sample_status_header.txt",
    output:
        directory(f"{W}/multiqc/side_files"),
    params:
        trim=lambda wc: " ".join(["--trim-status"] + multiqc_side_inputs(wc)["trim"]) if multiqc_side_inputs(wc)["trim"] else "",
        ie=lambda wc: " ".join(["--infer-experiment"] + multiqc_side_inputs(wc)["ie"]) if multiqc_side_inputs(wc)["ie"] else "",
    container:
        container_path("multiqc")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        python3 {SCRIPTS}/multiqc_rnaseq_inputs.py --samplesheet {input.samplesheet} \
            {params.trim} --map-status {input.map} --strand-status {input.strand} {params.ie} \
            --aligner-display-name '{ALIGNER_DISPLAY}' --min-trimmed-reads {config[min_trimmed_reads]} \
            --stranded-threshold {config[stranded_threshold]} --unstranded-threshold {config[unstranded_threshold]} \
            --summary-asset {input.summary} --composition-asset {input.composition} \
            --status-header {input.header} --outdir {output}
        """


def multiqc_files(wc):
    """ch_multiqc_files of RNASEQ (merged-report branch), in nf-core's mix order."""
    files = []
    trimmed = samples_trimmed()
    mapped = samples_mapped()
    for s in SAMPLES:
        if not SKIP_FASTQC:
            files += [f"{O}/fastqc/raw/{s}_raw{m}_fastqc.zip" for m in mates(s)]
        if not SKIP_TRIM:
            files += [f for f in trimgalore_outputs(s) if f.endswith((".zip", "_report.txt"))]
            files += [f"{W}/trimgalore/{os.path.basename(f)[:-4]}.json"
                      for f in trimgalore_outputs(s) if f.endswith("_report.txt")]
    for s in trimmed:
        if not SKIP_BBSPLIT:
            files.append(f"{O}/bbsplit/{s}.stats.txt")
            if not SKIP_FASTQC:
                files += [f"{O}/fastqc/filtered/{s}_filtered{m}_fastqc.zip" for m in mates(s)]
        files.append(f"{AL}/log/{s}.Log.final.out")
        if SKIP_MARKDUP:
            files += [f"{AL}/samtools_stats/{s}.sorted.bam.{x}" for x in ("stats", "flagstat", "idxstats")]
    if trimmed and not SKIP_QC and not flag("skip_deseq2_qc"):
        files += [f"{W}/deseq2_qc/{ALIGNER}.pca.vals_mqc.tsv", f"{W}/deseq2_qc/{ALIGNER}.sample.dists_mqc.tsv"]
    for s in mapped:
        if not SKIP_MARKDUP:
            files += [f"{AL}/samtools_stats/{s}.markdup.sorted.bam.{x}" for x in ("stats", "flagstat", "idxstats")]
            files.append(f"{AL}/picard_metrics/{s}.markdup.sorted.metrics.txt")
        if SKIP_QC:
            continue
        if "preseq" in QC_TOOLS:
            files.append(f"{AL}/preseq/{s}.lc_extrap.txt")
        if "biotype_qc" in QC_TOOLS:
            files.append(f"{AL}/featurecounts/{s}.biotype_counts_mqc.tsv")
        if "qualimap" in QC_TOOLS:
            files.append(f"{AL}/qualimap/{s}")
        if "dupradar" in QC_TOOLS:
            files += [f"{W}/dupradar/{s}_dup_intercept_mqc.txt", f"{W}/dupradar/{s}_duprateExpDensCurve_mqc.txt"]
        mqc_rseqc = {
            "bam_stat": [f"{R}/bam_stat/{s}.bam_stat.txt"],
            "infer_experiment": [f"{R}/infer_experiment/{s}.infer_experiment.txt"],
            "inner_distance": [] if SAMPLES[s]["single_end"] else [f"{R}/inner_distance/txt/{s}.inner_distance_freq.txt"],
            "junction_annotation": [f"{R}/junction_annotation/log/{s}.junction_annotation.log"],
            "junction_saturation": [f"{R}/junction_saturation/rscript/{s}.junctionSaturation_plot.r"],
            "read_distribution": [f"{R}/read_distribution/{s}.read_distribution.txt"],
            "read_duplication": [f"{R}/read_duplication/xls/{s}.pos.DupRate.xls"],
            "tin": [f"{R}/tin/{s}.summary.txt"],
        }
        for mod in RSEQC:
            files += mqc_rseqc[mod]
    if PSEUDO:
        files += [f"{O}/{PSEUDO}/{s}" for s in trimmed]
        if trimmed and not SKIP_QC and not flag("skip_deseq2_qc"):
            files += [f"{W}/deseq2_qc/{PSEUDO}.pca.vals_mqc.tsv", f"{W}/deseq2_qc/{PSEUDO}.sample.dists_mqc.tsv"]
    return files


# MULTIQC. nf-core also feeds workflow_summary_mqc.yaml, methods_description_mqc.yaml
# and the collated software versions; those are Nextflow run metadata and are
# not produced here.
rule multiqc:
    input:
        files=multiqc_files,
        side=f"{W}/multiqc/side_files",
        config=f"{ASSETS}/multiqc_config.yml",
        extra_config=config["multiqc_config"] or [],
        logo=config["multiqc_logo"] or [],
    output:
        report=f"{O}/multiqc/{ALIGNER}/multiqc_report.html",
        data=directory(f"{O}/multiqc/{ALIGNER}/multiqc_report_data"),
    params:
        title=f"--title \"{config['multiqc_title']}\"" if config["multiqc_title"] else "",
        plots=lambda wc, output: os.path.join(os.path.abspath(os.path.dirname(output.report)), "multiqc_report_plots"),
    container:
        container_path("multiqc")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        side=$(realpath {input.side})
        configs="--config $(realpath {input.config}) --config $side/multiqc_sample_merge.yml"
        for c in {input.extra_config}; do configs="$configs --config $(realpath $c)"; done
        logo=
        for l in {input.logo}; do logo="custom_logo: \"$(realpath $l)\""; done
        replace=
        if [ -f $side/name_replacement.txt ]; then replace="--replace-names $side/name_replacement.txt"; fi
        # Stage every input in its own numbered directory (stageAs: "?/*")
        i=0
        for f in {input.files} $(find $side -maxdepth 1 -name '*_mqc.*'); do
            i=$((i + 1)); mkdir -p stage/$i; ln -s $(realpath $f) stage/$i/$(basename $f)
        done
        cd stage
        multiqc --force {params.title} $configs --filename multiqc_report.html \
            ${{logo:+--cl-config "$logo"}} $replace .
        cd ..
        mv stage/multiqc_report.html {output.report}
        mv stage/multiqc_report_data {output.data}
        rm -rf {params.plots}
        if [ -d stage/multiqc_report_plots ]; then mv stage/multiqc_report_plots {params.plots}; fi
        """
