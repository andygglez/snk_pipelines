FASTA_PRE_ADD, GTF_PRE_ADD = _fasta, _gtf
if ADD_FASTA:
    ADD_PREFIX = f"{basename_noext(_fasta)}_{basename_noext(ADD_FASTA)}"
    # CUSTOM_CATADDITIONALFASTA writes (and publishes) out/<prefix>.{fasta,gtf}
    _fasta = f"{GENOME_DIR}/out/{ADD_PREFIX}.fasta"
    _gtf = f"{GENOME_DIR}/out/{ADD_PREFIX}.gtf"
FASTA, GTF = _fasta, _gtf
# SAMTOOLS_FAIDX publishes <fasta>.fai/.sizes to genome/ (save_reference)
FAI, SIZES = ((f"{GENOME_DIR}/{os.path.basename(FASTA)}.fai", f"{GENOME_DIR}/{os.path.basename(FASTA)}.sizes")
              if HAS_FASTA else (None, None))

# Gene BED: provided (GUNZIP_GENE_BED), GFFREAD_GENE_BED (prokaryotic) or
