    container:
        container_path("biotype")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        TPL_count={input.counts} TPL_header={input.header} TPL_task_ext_prefix=null \
        TPL_meta_id={wildcards.sample} TPL_task_ext_args=null TPL_task_process=CUSTOM_MULTIQCCUSTOMBIOTYPE \
            python3 {SCRIPTS}/mqc_features_stat.py
        mv {wildcards.sample}.biotype_counts_mqc.tsv {output.tsv}
        mv {wildcards.sample}.biotype_counts_rrna_mqc.tsv {output.rrna}
        """


# SAMTOOLS_SORT_QUALIMAP (-n, prefix <id>.namesorted)
rule samtools_sort_qualimap:
    input:
        unpack(final_bam_bai),
        fasta=FASTA or [],
        fai=FAI or [],
    output:
        temp(f"{W}/qualimap/{{sample}}.namesorted.bam"),
    container:
        container_path("samtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir 1
        ln -s $(realpath {input.bam}) 1/$(basename {input.bam})
        for f in {input.fasta} {input.fai}; do ln -s $(realpath $f) $(basename $f); done
        samtools cat 1/$(basename {input.bam}) | samtools sort -n -T {wildcards.sample}.namesorted \
            --threads {threads} --reference $(basename {input.fasta}) -o {wildcards.sample}.namesorted.bam -
        mv {wildcards.sample}.namesorted.bam {output}
        """


# QUALIMAP_RNASEQ (--sorted, -p from strandedness)
rule qualimap_rnaseq:
    input:
        bam=f"{W}/qualimap/{{sample}}.namesorted.bam",
        gtf=GTF,
        strand=lambda wc: bam_strand(wc.sample),
    output:
        directory(pub(f"{ALIGNER}/qualimap") + "/{sample}"),
    params:
        mem=lambda wc, resources: f"{int(resources.mem_mb * 0.8)}M",
        pe=lambda wc: "" if se(wc.sample) else "-pe",
    container:
        container_path("qualimap")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        case "$(cat {input.strand})" in
            forward) p=strand-specific-forward ;; reverse) p=strand-specific-reverse ;; *) p=non-strand-specific ;;
        esac
        unset DISPLAY
        mkdir -p tmp
        export _JAVA_OPTIONS=-Djava.io.tmpdir=./tmp
        for f in {input.bam} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
        qualimap --java-mem-size={params.mem} rnaseq --sorted -p $p \
            -bam $(basename {input.bam}) -gtf $(basename {input.gtf}) {params.pe} -outdir {wildcards.sample}
        mv {wildcards.sample} {output}
        """


# DUPRADAR
rule dupradar:
    input:
        unpack(final_bam_bai),
        gtf=GTF,
        strand=lambda wc: bam_strand(wc.sample),
    output:
        scatter=pub(f"{ALIGNER}/dupradar/scatter_plot") + "/{sample}_duprateExpDens.pdf",
        boxplot=pub(f"{ALIGNER}/dupradar/box_plot") + "/{sample}_duprateExpBoxplot.pdf",
        hist=pub(f"{ALIGNER}/dupradar/histogram") + "/{sample}_expressionHist.pdf",
        matrix=pub(f"{ALIGNER}/dupradar/gene_data") + "/{sample}_dupMatrix.txt",
        slope=pub(f"{ALIGNER}/dupradar/intercepts_slope") + "/{sample}_intercept_slope.txt",
        mqc_intercept=f"{W}/dupradar/{{sample}}_dup_intercept_mqc.txt",
        mqc_curve=f"{W}/dupradar/{{sample}}_duprateExpDensCurve_mqc.txt",
    params:
        single_end=lambda wc: "true" if se(wc.sample) else "false",
    container:
        container_path("dupradar")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bam} {input.bai} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
        s={wildcards.sample}
        TPL_bam=$(basename {input.bam}) TPL_gtf=$(basename {input.gtf}) TPL_task_ext_prefix=null TPL_meta_id=$s \
        TPL_task_cpus={threads} TPL_task_ext_args=null TPL_meta_strandedness=$(cat {input.strand}) \
        TPL_meta_single_end={params.single_end} TPL_task_process=DUPRADAR \
            Rscript {SCRIPTS}/dupradar.r
        mv ${{s}}_duprateExpDens.pdf {output.scatter}
        mv ${{s}}_duprateExpBoxplot.pdf {output.boxplot}
        mv ${{s}}_expressionHist.pdf {output.hist}
        mv ${{s}}_dupMatrix.txt {output.matrix}
        mv ${{s}}_intercept_slope.txt {output.slope}
        mv ${{s}}_dup_intercept_mqc.txt {output.mqc_intercept}
        mv ${{s}}_duprateExpDensCurve_mqc.txt {output.mqc_curve}
        """


# -----------------------------------------------------------------------------
# BAM_RSEQC
# -----------------------------------------------------------------------------
RP = pub(f"{ALIGNER}/rseqc")  # pattern


def rseqc_dir(s):
    return f"{als(s)}/rseqc"


def rseqc_files(mod, s):
    """Published files of each RSeQC module (conf/modules/rseqc.config)."""
    R = rseqc_dir(s)
    if mod == "bam_stat":
        return [f"{R}/bam_stat/{s}.bam_stat.txt"]
    if mod == "infer_experiment":
        return [f"{R}/infer_experiment/{s}.infer_experiment.txt"]
    if mod == "inner_distance":
        if se(s):
            return [f"{R}/inner_distance/txt/{s}.inner_distance.txt"]
        return [f"{R}/inner_distance/txt/{s}.inner_distance{x}.txt" for x in ("", "_freq", "_mean")] + [
            f"{R}/inner_distance/pdf/{s}.inner_distance_plot.pdf",
            f"{R}/inner_distance/rscript/{s}.inner_distance_plot.r",
        ]
    if mod == "junction_annotation":
        return [
            f"{R}/junction_annotation/bed/{s}.junction.bed",
            f"{R}/junction_annotation/bed/{s}.junction.Interact.bed",
            f"{R}/junction_annotation/xls/{s}.junction.xls",
            f"{R}/junction_annotation/pdf/{s}.splice_events.pdf",
            f"{R}/junction_annotation/pdf/{s}.splice_junction.pdf",
            f"{R}/junction_annotation/rscript/{s}.junction_plot.r",
            f"{R}/junction_annotation/log/{s}.junction_annotation.log",
        ]
    if mod == "junction_saturation":
        return [f"{R}/junction_saturation/pdf/{s}.junctionSaturation_plot.pdf",
                f"{R}/junction_saturation/rscript/{s}.junctionSaturation_plot.r"]
    if mod == "read_distribution":
        return [f"{R}/read_distribution/{s}.read_distribution.txt"]
    if mod == "read_duplication":
        return [f"{R}/read_duplication/xls/{s}.seq.DupRate.xls",
                f"{R}/read_duplication/xls/{s}.pos.DupRate.xls",
                f"{R}/read_duplication/pdf/{s}.DupRate_plot.pdf",
                f"{R}/read_duplication/rscript/{s}.DupRate_plot.r"]
    if mod == "tin":
        return [f"{R}/tin/{s}.summary.txt", f"{R}/tin/{s}.tin.xls"]
    raise ValueError(f"Unknown rseqc module {mod!r}")


