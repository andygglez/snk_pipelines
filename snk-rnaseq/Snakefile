# -----------------------------------------------------------------------------
# RUSTQC (use_rustqc: single-pass replacement for BAM_QC_RNASEQ)
# -----------------------------------------------------------------------------
RUSTQC_ARGS = " ".join(filter(None, [
    f"--biotype-attribute {BIOTYPE}" if BIOTYPE else "",
    "--preseq-seed 1 --preseq-seg-len 100000000",
    "--tin-seed 1 --junction-saturation-seed 1",
    "--skip-dup-check" if WITH_UMI else "",
]))

if USE_RUSTQC:

    # RUSTQC: raw output in the work dir; rustqc_publish applies the
    # conf/modules/rustqc.config saveAs renaming into <aligner>/rustqc/.
    rule rustqc:
        input:
            unpack(final_bam_bai),
            gtf=GTF,
            strand=lambda wc: bam_strand(wc.sample),
        output:
            directory(f"{W}/rustqc/{{sample}}"),
        params:
            paired=lambda wc: "" if se(wc.sample) else "--paired",
            args=RUSTQC_ARGS,
        container:
            container_path("rustqc")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            for f in {input.bam} {input.bai} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
            rustqc rna $(basename {input.bam}) --gtf $(basename {input.gtf}) {params.paired} --threads {threads} \
                --outdir {wildcards.sample} --sample-name {wildcards.sample} \
                --stranded $(cat {input.strand}) {params.args}
            mv {wildcards.sample} {output}
            """

    rule rustqc_publish:
        input:
            f"{W}/rustqc/{{sample}}",
        output:
            touch(f"{W}/rustqc/{{sample}}.published"),
        params:
            dest=f"{AL}/rustqc",
        run:
            import shutil

            sys.path.insert(0, SCRIPTS)
            from rustqc_publish import published_name

            for root, _dirs, files in os.walk(input[0]):
                for name in files:
                    rel = os.path.relpath(os.path.join(root, name), os.path.dirname(input[0]))
                    target = published_name(rel)
                    if target:
                        dst = os.path.join(params.dest, target)
                        os.makedirs(os.path.dirname(dst), exist_ok=True)
                        shutil.copyfile(os.path.join(root, name), dst)


# =============================================================================
# Coverage tracks (BEDTOOLS_GENOMECOV_* + BEDGRAPH_BEDCLIP_BEDGRAPHTOBIGWIG_*)
# =============================================================================
# BEDTOOLS_GENOMECOV_FW / _REV / _COMBINED. The published name comes from the
# bigWig subworkflow (FORWARD takes the _FW output), so <id>.forward.bigWig is
# '-strand +' for forward-stranded libraries and '-strand -' for reverse ones.
rule bedtools_genomecov:
    input:
        unpack(final_bam_bai),
        strand=lambda wc: bam_strand(wc.sample),
    output:
        temp(f"{W}/bigwig/{{sample}}{{strand}}.bedGraph"),
    params:
        buffer=lambda wc, resources: f"--buffer-size={int(resources.mem_mb // 1024) // 2}G",
    container:
        container_path("bedtools")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        case "{wildcards.strand}:$(cat {input.strand})" in
            :*)                args="-split -bg" ;;
            .forward:reverse)  args="-split -du -strand - -bg" ;;
            .reverse:reverse)  args="-split -du -strand + -bg" ;;
            .forward:*)        args="-split -du -strand + -bg" ;;
            .reverse:*)        args="-split -du -strand - -bg" ;;
        esac
        bedtools genomecov -ibam {input.bam} $args \
            | LC_ALL=C sort --parallel={threads} {params.buffer} -k1,1 -k2,2n > {output}
        """


