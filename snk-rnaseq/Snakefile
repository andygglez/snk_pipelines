        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            BOWTIE2_INDEX_SH + """
            p={wildcards.sample}.bowtie2_rrna
            bowtie2 -x $INDEX -1 {input.reads[0]} -2 {input.reads[1]} --threads {threads} \
                --rg-id $p --rg SM:$p {params.args} 2>| >(tee $p.bowtie2.log >&2) \
                | samtools view --threads {threads} -o $p.bam -
            mv $p.bam {output.bam}
            mv $p.bowtie2.log {output.log}
            """

    # SAMTOOLS_VIEW_BOWTIE2 (ext.args '-f 12': both mates unmapped)
    rule samtools_view_bowtie2:
        input:
            f"{W}/bowtie2_rrna/{{sample}}.bowtie2_rrna.bam",
