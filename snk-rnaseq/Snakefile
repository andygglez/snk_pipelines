# RSEQC_INNERDISTANCE (paired-end)
rule rseqc_innerdistance_pe:
    input:
        bam=lambda wc: final_bam(wc.pe_sample),
        bai=lambda wc: final_bam(wc.pe_sample) + ".bai",
        bed=GENE_BED,
    output:
        distance=f"{R}/inner_distance/txt/{{pe_sample}}.inner_distance.txt",
        freq=f"{R}/inner_distance/txt/{{pe_sample}}.inner_distance_freq.txt",
        mean=f"{R}/inner_distance/txt/{{pe_sample}}.inner_distance_mean.txt",
        pdf=f"{R}/inner_distance/pdf/{{pe_sample}}.inner_distance_plot.pdf",
        rscript=f"{R}/inner_distance/rscript/{{pe_sample}}.inner_distance_plot.r",
    container:
        container_path("rseqc")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        p={wildcards.pe_sample}
        for f in {input.bam} {input.bai} {input.bed}; do ln -s $(realpath $f) $(basename $f); done
        inner_distance.py -i $(basename {input.bam}) -r $(basename {input.bed}) -o $p > stdout.txt
        head -n 2 stdout.txt > $p.inner_distance_mean.txt
        mv $p.inner_distance.txt {output.distance}
        mv $p.inner_distance_freq.txt {output.freq}
        mv $p.inner_distance_mean.txt {output.mean}
        mv $p.inner_distance_plot.pdf {output.pdf}
        mv $p.inner_distance_plot.r {output.rscript}
        """


