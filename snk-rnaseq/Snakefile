# =============================================================================
# snk-rnaseq — Snakemake port of nf-core/rnaseq 3.27.0
#
# Every rule mirrors one nf-core process (named in the comment above each rule)
# and runs inside the same Singularity image the nf-core module uses
# (see config/containers.yaml). nf-core module templates and bin/ scripts live
# in scripts/. Published files follow the nf-core publishDir layout under
# `outdir`; files nf-core keeps only in its work/ directory go to `workdir`.
#
# Ported: aligners star_salmon, star_rsem, hisat2 and bowtie2_salmon;
# pseudo-aligners salmon and kallisto; trimmers trimgalore and fastp; UMI
# extraction and deduplication (UMI-tools / UMICollapse); rRNA removal
# (SortMeRNA, RiboDetector CPU/GPU, Bowtie2); BBSplit; additional_fasta; all QC
# (RSeQC, Qualimap, dupRadar, Preseq, biotype QC, or RustQC); contaminant
# screening (Kraken2, Kraken2 + Bracken, Sylph); StringTie (with optional
# de novo merge); skip_alignment with pre-aligned BAM input;
# skip_quantification_merge (per-sample outputs and MultiQC reports);
# CSI BAM indices; prokaryotic mode; iGenomes (`genome`); samplesheet_with_bams.csv;
# software versions (pipeline_info + MultiQC).
# Sentieon STAR/RSEM (licence) and Parabricks rna_fq2bam / GPU RiboDetector
# (NVIDIA GPU) are ported but need their licence / hardware to run.
# Not produced: the other Nextflow run metadata (execution reports, workflow
# summary and methods sections of MultiQC).
#
# Run:  snakemake --cores N --sdm apptainer
# =============================================================================

import csv
