# -----------------------------------------------------------------------------
# Reference files (PREPARE_GENOME_REFERENCES)
# -----------------------------------------------------------------------------
GUNZIP_SRC = {}  # GUNZIP_*: output name in GENOME_DIR -> .gz source


def gunzipped(path):
    """Return the path a reference ends up at after (optional) GUNZIP."""
    path = stage(path)
    if not path.endswith(".gz"):
        return path
    name = os.path.basename(path)[:-3]
    if GUNZIP_SRC.get(name, path) != path:
        raise ValueError(f"Two gzipped references would both decompress to {name!r}.")
    GUNZIP_SRC[name] = path
    return f"{GENOME_DIR}/{name}"


# Genome FASTA (optional with skip_alignment). It is always linked into
# GENOME_DIR so samtools faidx can write genome.fai next to it, as it does in
# the Nextflow work directory.
FASTA_LINK = {}
_fasta = None
if HAS_FASTA:
    _fasta = gunzipped(config["fasta"])
    if not _fasta.startswith(GENOME_DIR + "/"):
        FASTA_LINK[os.path.basename(_fasta)] = _fasta
        _fasta = f"{W}/genome_link/{os.path.basename(_fasta)}"  # never published

# GTF (GUNZIP_GTF), else GFF -> GTF (GUNZIP_GFF + GFFREAD)
if cfg("gtf"):
    _gtf = gunzipped(config["gtf"])
    GFF = None
else:
    GFF = gunzipped(config["gff"])
    _gtf = f"{GENOME_DIR}/{simple_name(GFF)}.gtf"

# CUSTOM_GTFFILTER
