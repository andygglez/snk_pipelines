# --- Per-sample publish prefix ------------------------------------------------
# nextflow.config ext.publish_prefix: with skip_quantification_merge, every
# process with sample meta publishes under <outdir>/<sample>/<tool>/ instead
# of <outdir>/<tool>/. All per-sample rules use the wildcard name `sample`.
def so(s):
    """Per-sample publish root for sample `s`."""
    return f"{O}/{s}" if SKIP_MERGE else O


SP = f"{O}/{{sample}}" if SKIP_MERGE else O  # the same, as an output pattern


def pub(sub):
    """Pattern of a published per-sample directory."""
    return f"{SP}/{sub}"


def keep(saved, sub):
    """Pattern of a per-sample directory that is published only when `saved`."""
    return pub(sub) if saved else f"{W}/{sub}"


def at(pattern, s, **kw):
    """Concrete path of a per-sample pattern."""
    return pattern.format(sample=s, **kw)


AL = f"{O}/{ALIGNER}"   # run-level files of the aligner (merged counts, DESeq2)
ALP = pub(ALIGNER)      # per-sample aligner directory (pattern)


def als(s):
    return at(ALP, s)


