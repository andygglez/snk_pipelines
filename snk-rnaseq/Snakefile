# Groovy in FASTQ_FASTQC_UMITOOLS_TRIMGALORE: reads left after trimming
# (getTrimGaloreReadsAfterFiltering on the last report) vs min_trimmed_reads.
rule trim_status:
    input:
        lambda wc: [f for f in trimgalore_outputs(wc.sample) if f.endswith("_report.txt")][-1],
    output:
        json=f"{W}/status/{{sample}}.trim.json",
    run:
        n = trimgalore_reads_after_filtering(input[0])
        with open(output.json, "w") as fh:
            json.dump({"sample": wildcards.sample, "num_reads": n,
                       "pass": n >= float(config["min_trimmed_reads"])}, fh)


checkpoint trim_summary:
    input:
        [] if SKIP_TRIM else [f"{W}/status/{s}.trim.json" for s in SAMPLES],
    output:
        f"{W}/status/trim_summary.json",
    run:
        summary = {}
        for f in input:
            with open(f) as fh:
                st = json.load(fh)
            summary[st["sample"]] = st
        with open(output[0], "w") as fh:
            json.dump(summary, fh, indent=1)


def bbsplit_index_input(wc):
    return BBSPLIT_INDEX


BBSPLIT_ARGS = "build=1 ambiguous2=all maxindel=150000 ow=f"

# Shared shell for BBMAP_BBSPLIT with a pre-built index (verbatim nf-core
# logic: writable copy of the index with corrected summary.txt time stamps).
BBSPLIT_STAGE_INDEX = r"""
ln -s $(realpath {input.index}) input_index
find input_index/ref -type f | while read -r f; do
    target="index_writable/${{f#input_index/}}"
    mkdir -p "$(dirname "$target")"
    [[ $(basename "$f") == "summary.txt" ]] && cp "$f" "$target" || ln -s "$(realpath "$f")" "$target"
done
find index_writable/ref/genome -name summary.txt | while read -r summary_file; do
    src=$(grep '^source' "$summary_file" | cut -f2- -d$'\t' | sed 's|.*/ref/|index_writable/ref/|')
    mod=$(echo "System.out.println(java.nio.file.Files.getLastModifiedTime(java.nio.file.Paths.get(\"$src\")).toMillis());" | jshell -J-Djdk.lang.Process.launchMechanism=vfork - 2>/dev/null | grep -oE '^[0-9]{{12,14}}$')
    sed -e 's|bbsplit_index/ref|index_writable/ref|' -e "s|^last modified.*|last modified\t$mod|" "$summary_file" > ${{summary_file}}.tmp && mv ${{summary_file}}.tmp ${{summary_file}}
done
"""


# BBMAP_BBSPLIT (paired-end)
rule bbsplit_pe:
    input:
        reads=lambda wc: reads_trimmed(wc.pe_sample),
        index=bbsplit_index_input,
        lint=lambda wc: lint_gate(wc.pe_sample, "trimmed"),
    output:
        r1=f"{BBSPLIT_DIR}/{{pe_sample}}_primary_1.fastq.gz",
        r2=f"{BBSPLIT_DIR}/{{pe_sample}}_primary_2.fastq.gz",
        stats=f"{O}/bbsplit/{{pe_sample}}.stats.txt",
    params:
        mem=lambda wc, resources: int(resources.mem_mb * 0.8),
        keep_other=os.path.abspath(BBSPLIT_DIR) if flag("save_bbsplit_reads") else "",
    container:
        container_path("bbmap")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    retries: 2
    shadow:
        "minimal"
    shell:
        BBSPLIT_STAGE_INDEX + """
        bbsplit.sh -Xmx{params.mem}M path=index_writable threads={threads} \
            in={input.reads[0]} in2={input.reads[1]} basename={wildcards.pe_sample}_%_#.fastq.gz \
            refstats={wildcards.pe_sample}.stats.txt {BBSPLIT_ARGS} 2>| >(tee {wildcards.pe_sample}.log >&2)
        mv {wildcards.pe_sample}_primary_1.fastq.gz {output.r1}
        mv {wildcards.pe_sample}_primary_2.fastq.gz {output.r2}
        mv {wildcards.pe_sample}.stats.txt {output.stats}
        if [ -n "{params.keep_other}" ]; then mv {wildcards.pe_sample}_*.fastq.gz {params.keep_other}/; fi
        """


# BBMAP_BBSPLIT (single-end)
rule bbsplit_se:
    input:
        reads=lambda wc: reads_trimmed(wc.se_sample),
        index=bbsplit_index_input,
        lint=lambda wc: lint_gate(wc.se_sample, "trimmed"),
    output:
        r1=f"{BBSPLIT_DIR}/{{se_sample}}_primary.fastq.gz",
        stats=f"{O}/bbsplit/{{se_sample}}.stats.txt",
    params:
        mem=lambda wc, resources: int(resources.mem_mb * 0.8),
        keep_other=os.path.abspath(BBSPLIT_DIR) if flag("save_bbsplit_reads") else "",
    container:
        container_path("bbmap")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    retries: 2
    shadow:
        "minimal"
    shell:
        BBSPLIT_STAGE_INDEX + """
        bbsplit.sh -Xmx{params.mem}M path=index_writable threads={threads} \
            in={input.reads[0]} basename={wildcards.se_sample}_%.fastq.gz \
            refstats={wildcards.se_sample}.stats.txt {BBSPLIT_ARGS} 2>| >(tee {wildcards.se_sample}.log >&2)
        mv {wildcards.se_sample}_primary.fastq.gz {output.r1}
        mv {wildcards.se_sample}.stats.txt {output.stats}
        if [ -n "{params.keep_other}" ]; then mv {wildcards.se_sample}_*.fastq.gz {params.keep_other}/; fi
        """


# FQ_SUBSAMPLE (FASTQ_SUBSAMPLE_FQ_SALMON; strandedness: auto only)
rule fq_subsample:
    input:
        reads=lambda wc: reads_filtered(wc.sample),
        lint=lambda wc: lint_gate(wc.sample, "bbsplit"),
    output:
        directory(f"{W}/strand/{{sample}}/subsampled"),
    params:
        dst=lambda wc, output: (
            f"--r1-dst {output}/{wc.sample}.subsampled.fastq.gz" if SAMPLES[wc.sample]["single_end"]
            else f"--r1-dst {output}/{wc.sample}.subsampled_R1.fastq.gz "
                 f"--r2-dst {output}/{wc.sample}.subsampled_R2.fastq.gz"
        ),
    container:
        container_path("fq")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        mkdir -p {output}
        fq subsample --record-count 1000000 --seed 1 {input.reads} {params.dst}
        """


# SALMON_QUANT (FASTQ_SUBSAMPLE_FQ_SALMON; ext.args '--skipQuant')
