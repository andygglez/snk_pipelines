def _check(choice, key, allowed):
    if choice not in allowed:
        raise ValueError(f"{key} must be one of {', '.join(map(str, allowed))} (got {choice!r}).")


_check(ALIGNER, "aligner", ["star_salmon", "star_rsem", "hisat2", "bowtie2_salmon"])
_check(TRIMMER, "trimmer", ["trimgalore", "fastp"])
_check(cfg("pseudo_aligner"), "pseudo_aligner", ["", "salmon", "kallisto"])
_check(config["ribo_removal_tool"], "ribo_removal_tool", ["sortmerna", "ribodetector", "bowtie2"])
_check(config["umi_dedup_tool"], "umi_dedup_tool", ["umitools", "umicollapse"])
_check(cfg("contaminant_screening"), "contaminant_screening", ["", "kraken2", "kraken2_bracken", "sylph"])
_check(SCREEN_INPUT, "contaminant_screening_input", ["trimmed", "unmapped", "trim_only", "raw"])
_check(int(config.get("umi_discard_read") or 0), "umi_discard_read", [0, 1, 2])

PSEUDO = cfg("pseudo_aligner") if cfg("pseudo_aligner") and not flag("skip_pseudo_alignment") else None
_pseudo_index_given = (
    (cfg("pseudo_aligner") == "salmon" and cfg("salmon_index"))
    or (cfg("pseudo_aligner") == "kallisto" and cfg("kallisto_index"))
)
if not cfg("fasta") and (not SKIP_ALIGN or (not cfg("transcript_fasta") and not _pseudo_index_given)):
    raise ValueError(
        "Genome fasta file not specified (`fasta`). You must supply a genome FASTA file, use "
        "skip_alignment with transcript_fasta, or use skip_alignment with a pre-built pseudo-aligner "
        "index (salmon_index / kallisto_index)."
    )
if not cfg("gtf") and not cfg("gff"):
    raise ValueError("No GTF or GFF3 annotation specified (`gtf` or `gff`).")
if cfg("transcript_fasta") and cfg("additional_fasta") and PSEUDO and not (
    (PSEUDO == "salmon" and cfg("salmon_index")) or (PSEUDO == "kallisto" and cfg("kallisto_index"))
):
    raise ValueError(
        "Both `transcript_fasta` and `additional_fasta` were given but no pre-built pseudo-aligner "
        "index; see https://github.com/nf-core/rnaseq/issues/1450"
    )
if not flag("skip_bbsplit") and not cfg("bbsplit_index") and not cfg("bbsplit_fasta_list"):
    raise ValueError("Please provide either `bbsplit_fasta_list` or `bbsplit_index` to run BBSplit.")
if RIBO in ("sortmerna", "bowtie2") and not cfg("ribo_database_manifest"):
    raise ValueError("Please provide `ribo_database_manifest` to remove rRNA with SortMeRNA or Bowtie2.")
if GPU_RIBO and config["ribo_removal_tool"] != "ribodetector":
    raise ValueError("use_gpu_ribodetector requires ribo_removal_tool 'ribodetector'.")
if (GPU_RIBO or PARABRICKS) and flag("arm"):
    raise ValueError("GPU tools (use_gpu_ribodetector / use_parabricks_star) are not supported on ARM.")
if PARABRICKS and SENTIEON:
    raise ValueError("Cannot use both use_parabricks_star and use_sentieon_star; choose one accelerator.")
if PARABRICKS and PROKARYOTIC:
    raise ValueError("Parabricks rna_fq2bam does not support --sjdbGTFfeatureExon CDS (prokaryotic); use standard STAR.")
if PARABRICKS and cfg("genome"):
    raise ValueError("use_parabricks_star is not compatible with `genome`; give fasta and gtf explicitly.")
if USE_RUSTQC and flag("skip_markduplicates"):
    raise ValueError("use_rustqc requires duplicate-marked BAM files; remove skip_markduplicates.")
if UMI_EXTRACT and not cfg("umitools_bc_pattern") and not cfg("umitools_bc_pattern2"):
    raise ValueError("UMI-tools requires a barcode pattern (`umitools_bc_pattern`) to extract barcodes.")
if WITH_UMI and config["umi_dedup_tool"] == "umicollapse" and \
        config["umitools_grouping_method"] not in ("directional", "adjacency", "cluster"):
    raise ValueError(
        f"UMI grouping method {config['umitools_grouping_method']!r} unsupported for umicollapse; "
        "supported methods are 'cluster', 'adjacency' and 'directional'."
    )
if PSEUDO and not (cfg("salmon_index") or cfg("transcript_fasta") or (cfg("fasta") and (cfg("gtf") or cfg("gff")))):
    raise ValueError("pseudo_aligner needs salmon_index, transcript_fasta, or both fasta and gtf / gff.")
if not SKIP_ALIGN and ALIGNER == "star_rsem" and (PROKARYOTIC or flag("gffread_transcript_fasta")):
    raise ValueError("aligner star_rsem is not compatible with prokaryotic / gffread_transcript_fasta "
                     "(RSEM needs exon features); use star_salmon or bowtie2_salmon.")
if SCREEN in ("kraken2", "kraken2_bracken") and not cfg("kraken_db"):
    raise ValueError("Contaminant screening set to kraken2 but no database was provided (`kraken_db`).")
if SCREEN and SCREEN_INPUT == "unmapped":
    if SKIP_ALIGN:
        raise ValueError("contaminant_screening_input 'unmapped' requires alignment to be enabled; use "
                         "'raw', 'trim_only' or 'trimmed' to screen reads before alignment.")
    if ALIGNER not in ("star_salmon", "star_rsem", "hisat2"):
        raise ValueError("contaminant_screening_input 'unmapped' is only supported with star_salmon, "
                         "star_rsem or hisat2; use 'raw', 'trim_only' or 'trimmed' for other aligners.")
if SCREEN and SCREEN_INPUT == "trim_only" and flag("skip_trimming"):
    raise ValueError("contaminant_screening_input 'trim_only' requires trimming; use 'raw' instead.")
if SCREEN == "sylph" and (not cfg("sylph_db") or not cfg("sylph_taxonomy")):
    raise ValueError("Contaminant screening set to Sylph: provide both `sylph_db` and `sylph_taxonomy`.")
VALID_RSEQC = ["bam_stat", "inner_distance", "infer_experiment", "junction_annotation",
