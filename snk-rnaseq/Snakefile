    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.reads[0]}) {params.p}.fastq.gz
        trim_galore {params.args} --cores {params.cores} --gzip {params.p}.fastq.gz
        mv {params.p}_trimmed.fq.gz {output.r1}
        mv {params.p}.fastq.gz_trimming_report.txt {output.log}
        mv {params.p}.fastq.gz_trimming_report.json {output.json}
        mv {params.p}_trimmed_fastqc.html {output.html}
        mv {params.p}_trimmed_fastqc.zip {output.zip}
        """


def fastp_outputs(s):
    """Published FASTP files (json/html, log, failed reads with save_trimmed)."""
    d = f"{so(s)}/fastp"
    out = [f"{d}/{s}.fastp.json", f"{d}/{s}.fastp.html", f"{d}/log/{s}.fastp.log"]
    if flag("save_trimmed"):
        out += [f"{d}/{s}.fail.fastq.gz"] if se(s) else [
            f"{d}/{s}.paired.fail.fastq.gz", f"{d}/{s}_R1.fail.fastq.gz", f"{d}/{s}_R2.fail.fastq.gz"]
    return out


FASTP_ARGS = cfg("extra_fastp_args")


# FASTP (single-end). save_trimmed doubles as save_trimmed_fail.
rule fastp_se:
    input:
        reads=lambda wc: reads_umi(wc.sample),
        lint=lambda wc: lint_gate(wc.sample, "raw"),
    output:
        reads=f"{TRIM_D}/{{sample}}.fastp.fastq.gz",
        json=pub("fastp") + "/{sample}.fastp.json",
        html=pub("fastp") + "/{sample}.fastp.html",
        log=pub("fastp/log") + "/{sample}.fastp.log",
        fail=[pub("fastp") + "/{sample}.fail.fastq.gz"] if flag("save_trimmed") else [],
    wildcard_constraints:
        sample=alternation(SE),
    params:
        fail=lambda wc: f"--failed_out {wc.sample}.fail.fastq.gz" if flag("save_trimmed") else "",
        args=literal(FASTP_ARGS),
    container:
        container_path("fastp")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        p={wildcards.sample}
        [ ! -f $p.fastq.gz ] && ln -sf $(realpath {input.reads[0]}) $p.fastq.gz
        fastp --in1 $p.fastq.gz --out1 $p.fastp.fastq.gz --thread {threads} \
            --json $p.fastp.json --html $p.fastp.html {params.fail} {params.args} \
            2>| >(tee $p.fastp.log >&2)
        mv $p.fastp.fastq.gz {output.reads}
        mv $p.fastp.json {output.json}
        mv $p.fastp.html {output.html}
        mv $p.fastp.log {output.log}
        for f in {output.fail}; do mv $(basename $f) $f; done
        """


# FASTP (paired-end)
rule fastp_pe:
    input:
        reads=lambda wc: reads_umi(wc.sample),
        lint=lambda wc: lint_gate(wc.sample, "raw"),
    output:
        r1=f"{TRIM_D}/{{sample}}_R1.fastp.fastq.gz",
        r2=f"{TRIM_D}/{{sample}}_R2.fastp.fastq.gz",
        json=pub("fastp") + "/{sample}.fastp.json",
        html=pub("fastp") + "/{sample}.fastp.html",
        log=pub("fastp/log") + "/{sample}.fastp.log",
        fail=[pub("fastp") + f"/{{sample}}{x}.fail.fastq.gz" for x in (".paired", "_R1", "_R2")]
        if flag("save_trimmed") else [],
    wildcard_constraints:
        sample=alternation(PE),
    params:
        fail=lambda wc: (
            f"--failed_out {wc.sample}.paired.fail.fastq.gz --unpaired1 {wc.sample}_R1.fail.fastq.gz "
            f"--unpaired2 {wc.sample}_R2.fail.fastq.gz" if flag("save_trimmed") else ""
        ),
        args=literal(FASTP_ARGS),
    container:
        container_path("fastp")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        p={wildcards.sample}
        [ ! -f ${{p}}_R1.fastq.gz ] && ln -sf $(realpath {input.reads[0]}) ${{p}}_R1.fastq.gz
        [ ! -f ${{p}}_R2.fastq.gz ] && ln -sf $(realpath {input.reads[1]}) ${{p}}_R2.fastq.gz
        fastp --in1 ${{p}}_R1.fastq.gz --in2 ${{p}}_R2.fastq.gz --out1 ${{p}}_R1.fastp.fastq.gz \
            --out2 ${{p}}_R2.fastp.fastq.gz --json $p.fastp.json --html $p.fastp.html {params.fail} \
            --thread {threads} --detect_adapter_for_pe {params.args} 2>| >(tee $p.fastp.log >&2)
        mv ${{p}}_R1.fastp.fastq.gz {output.r1}
        mv ${{p}}_R2.fastp.fastq.gz {output.r2}
        mv $p.fastp.json {output.json}
        mv $p.fastp.html {output.html}
        mv $p.fastp.log {output.log}
        for f in {output.fail}; do mv $(basename $f) $f; done
        """


def trim_report(s):
    """File holding the post-trimming read count."""
    if TRIMMER == "fastp":
        return f"{so(s)}/fastp/{s}.fastp.json"
    return [f for f in trimgalore_outputs(s) if f.endswith("_report.txt")][-1]


# Groovy in the trimming subworkflows: reads left after trimming
# (getTrimGaloreReadsAfterFiltering / getFastpReadsAfterFiltering) vs
# min_trimmed_reads.
rule trim_status:
    input:
        lambda wc: trim_report(wc.sample),
    output:
        json=f"{W}/status/{{sample}}.trim.json",
    run:
        if TRIMMER == "fastp":
            n = fastp_reads_after_filtering(input[0])
        else:
            n = trimgalore_reads_after_filtering(input[0])
        with open(output.json, "w") as fh:
            json.dump({"sample": wildcards.sample, "num_reads": n,
                       "pass": n >= float(config["min_trimmed_reads"])}, fh)


checkpoint trim_summary:
    input:
        [] if SKIP_TRIM else [f"{W}/status/{s}.trim.json" for s in FQ_SAMPLES],
    output:
        f"{W}/status/trim_summary.json",
    run:
        summary = {}
        for f in input:
            with open(f) as fh:
                st = json.load(fh)
            summary[st["sample"]] = st
        with open(output[0], "w") as fh:
            json.dump(summary, fh, indent=1)


BBSPLIT_ARGS = "build=1 ambiguous2=all maxindel=150000 ow=f"

# Shared shell for BBMAP_BBSPLIT with a pre-built index (verbatim nf-core
# logic: writable copy of the index with corrected summary.txt time stamps).
BBSPLIT_STAGE_INDEX = r"""
ln -s $(realpath {input.index}) input_index
find input_index/ref -type f | while read -r f; do
    target="index_writable/${{f#input_index/}}"
    mkdir -p "$(dirname "$target")"
    [[ $(basename "$f") == "summary.txt" ]] && cp "$f" "$target" || ln -s "$(realpath "$f")" "$target"
done
find index_writable/ref/genome -name summary.txt | while read -r summary_file; do
    src=$(grep '^source' "$summary_file" | cut -f2- -d$'\t' | sed 's|.*/ref/|index_writable/ref/|')
    mod=$(echo "System.out.println(java.nio.file.Files.getLastModifiedTime(java.nio.file.Paths.get(\"$src\")).toMillis());" | jshell -J-Djdk.lang.Process.launchMechanism=vfork - 2>/dev/null | grep -oE '^[0-9]{{12,14}}$')
    sed -e 's|bbsplit_index/ref|index_writable/ref|' -e "s|^last modified.*|last modified\t$mod|" "$summary_file" > ${{summary_file}}.tmp && mv ${{summary_file}}.tmp ${{summary_file}}
done
"""


# BBMAP_BBSPLIT (paired-end)
rule bbsplit_pe:
    input:
        reads=lambda wc: reads_trimmed(wc.sample),
        index=lambda wc: BBSPLIT_INDEX,
        lint=lambda wc: lint_gate(wc.sample, "trimmed"),
    output:
        r1=f"{BBSPLIT_D}/{{sample}}_primary_1.fastq.gz",
        r2=f"{BBSPLIT_D}/{{sample}}_primary_2.fastq.gz",
        stats=pub("bbsplit") + "/{sample}.stats.txt",
    wildcard_constraints:
        sample=alternation(PE),
    params:
        mem=lambda wc, resources: int(resources.mem_mb * 0.8),
        keep_other=lambda wc: os.path.abspath(at(BBSPLIT_D, wc.sample)) if flag("save_bbsplit_reads") else "",
    container:
        container_path("bbmap")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    retries: 2
    shadow:
        "minimal"
    shell:
        BBSPLIT_STAGE_INDEX + """
        bbsplit.sh -Xmx{params.mem}M path=index_writable threads={threads} \
            in={input.reads[0]} in2={input.reads[1]} basename={wildcards.sample}_%_#.fastq.gz \
            refstats={wildcards.sample}.stats.txt {BBSPLIT_ARGS} 2>| >(tee {wildcards.sample}.log >&2)
        mv {wildcards.sample}_primary_1.fastq.gz {output.r1}
        mv {wildcards.sample}_primary_2.fastq.gz {output.r2}
        mv {wildcards.sample}.stats.txt {output.stats}
        if [ -n "{params.keep_other}" ]; then mv {wildcards.sample}_*.fastq.gz {params.keep_other}/; fi
        """


# BBMAP_BBSPLIT (single-end)
rule bbsplit_se:
    input:
        reads=lambda wc: reads_trimmed(wc.sample),
        index=lambda wc: BBSPLIT_INDEX,
        lint=lambda wc: lint_gate(wc.sample, "trimmed"),
    output:
        r1=f"{BBSPLIT_D}/{{sample}}_primary.fastq.gz",
        stats=pub("bbsplit") + "/{sample}.stats.txt",
    wildcard_constraints:
        sample=alternation(SE),
    params:
        mem=lambda wc, resources: int(resources.mem_mb * 0.8),
        keep_other=lambda wc: os.path.abspath(at(BBSPLIT_D, wc.sample)) if flag("save_bbsplit_reads") else "",
    container:
        container_path("bbmap")
    threads: res("process_high")["threads"]
    resources:
        mem_mb=res("process_high")["mem_mb"],
    retries: 2
    shadow:
        "minimal"
    shell:
        BBSPLIT_STAGE_INDEX + """
        bbsplit.sh -Xmx{params.mem}M path=index_writable threads={threads} \
            in={input.reads[0]} basename={wildcards.sample}_%.fastq.gz \
            refstats={wildcards.sample}.stats.txt {BBSPLIT_ARGS} 2>| >(tee {wildcards.sample}.log >&2)
        mv {wildcards.sample}_primary.fastq.gz {output.r1}
        mv {wildcards.sample}.stats.txt {output.stats}
        if [ -n "{params.keep_other}" ]; then mv {wildcards.sample}_*.fastq.gz {params.keep_other}/; fi
        """


