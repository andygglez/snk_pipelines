    # RIBODETECTOR (cpus = 1; -l = mean read length from SEQKIT_STATS; GPU
    # image + `ribodetector` with use_gpu_ribodetector)
    rule ribodetector:
        input:
            reads=lambda wc: reads_bbsplit(wc.sample),
            stats=pub("ribodetector") + "/{sample}.rrna_removal_stats.tsv",
        output:
            reads=f"{RIBO_D}/{{sample}}.nonrna.fastq.gz",
            log=pub("ribodetector") + "/{sample}.log",
        wildcard_constraints:
            sample=alternation(SE),
        params:
            args=literal(cfg("ribodetector_args")),
            # GPU: `ribodetector -m <task memory GB>`; CPU: ribodetector_cpu
            bin="ribodetector" if GPU_RIBO else "ribodetector_cpu",
            mem=lambda wc, resources: f"-m {int(resources.mem_mb // 1024)}" if GPU_RIBO else "",
        container:
            container_path("ribodetector_gpu" if GPU_RIBO else "ribodetector")
        threads: 1
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            len=$(python3 -c "import sys; sys.path.insert(0, '{SCRIPTS}'); from rnaseq_strand import seqkit_read_length as f; print(f('{input.stats}'))")
            {params.bin} -i {input.reads} -o {wildcards.sample}.nonrna.fastq.gz -l $len -t {threads} \
                --log {wildcards.sample}.log {params.mem} {params.args}
            mv {wildcards.sample}.nonrna.fastq.gz {output.reads}
            mv {wildcards.sample}.log {output.log}
            """

    rule ribodetector_pe:
        input:
