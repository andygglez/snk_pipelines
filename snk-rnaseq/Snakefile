        shell:
            """
            TPL_args='{params.args}' TPL_fasta='{input.fasta}' TPL_gtf={input.gtf} \
            TPL_output={output} TPL_task_process=CUSTOM_GTFFILTER \
                python3 {SCRIPTS}/gtffilter.py
            """


if ADD_FASTA:

