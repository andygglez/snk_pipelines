# =============================================================================
# snk-rnaseq — Snakemake port of nf-core/rnaseq 3.27.0
#
# Every rule mirrors one nf-core process (named in the comment above each rule)
# and runs inside the same Singularity image the nf-core module uses
# (see config/containers.yaml). nf-core module templates and bin/ scripts live
# in scripts/. Published files follow the nf-core publishDir layout under
# `outdir`; files nf-core keeps only in its work/ directory go to `workdir`.
#
# Ported: the default route (aligner star_salmon, trimmer trimgalore) plus
# BBSplit, additional_fasta, pseudo_aligner salmon and all default QC.
# Not ported yet (rejected at start-up): fastp, UMI handling, rRNA removal,
# hisat2 / bowtie2_salmon / star_rsem, kallisto, skip_alignment with BAM input,
# skip_quantification_merge, stringtie_ignore_gtf, contaminant screening,
# RustQC, Sentieon / Parabricks, prokaryotic, bam_csi_index.
#
# Run:  snakemake --cores N --sdm apptainer
# =============================================================================

import csv
import json
import os
import re
import sys
import urllib.request
from collections import OrderedDict

configfile: "config/config.yaml"
configfile: "config/containers.yaml"

SCRIPTS = os.path.join(workflow.basedir, "scripts")
ASSETS = os.path.join(workflow.basedir, "assets")
sys.path.insert(0, SCRIPTS)
from rnaseq_strand import (  # noqa: E402
    salmon_strandedness,
    star_percent_mapped,
    trimgalore_reads_after_filtering,
)

O = config["outdir"].rstrip("/")
W = config["workdir"].rstrip("/")

# nextflow.config env{} and process.shell (bash -e -u -o pipefail).
shell.prefix(
    "set -euo pipefail; export PYTHONNOUSERSITE=1 R_PROFILE_USER=/.Rprofile "
    "R_ENVIRON_USER=/.Renviron MPLCONFIGDIR=${{TMPDIR:-/tmp}}/mplcfg; "
)


# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
def container_path(key):
    path = config["containers"][key]
    return path if os.path.isabs(path) else os.path.join(workflow.basedir, path)


def res(label):
    return config["resources"][label]


def flag(key):
    return bool(config.get(key))


def is_url(path):
    return str(path).startswith(("http://", "https://", "ftp://"))


def basename_noext(path):
    """Nextflow Path.baseName: file name without its last extension."""
    return os.path.splitext(os.path.basename(path))[0]


def simple_name(path):
    """Nextflow Path.simpleName: file name up to the first dot."""
    return os.path.basename(path).split(".")[0]


def alternation(names):
    names = list(names)
    return "|".join(re.escape(n) for n in names) if names else "(?!x)x"


# Remote inputs (FASTQ / reference URLs) are staged into {W}/inputs/ by
# fetch_remote, the equivalent of Nextflow's automatic staging of remote files.
REMOTE = {}


def stage(path):
    if not path or not is_url(path):
        return path
    name = os.path.basename(path)
    if REMOTE.get(name, path) != path:
        raise ValueError(f"Two remote inputs share the file name {name!r}.")
    REMOTE[name] = path
    return f"{W}/inputs/{name}"


def read_text(path):
    if is_url(path):
        with urllib.request.urlopen(path) as fh:
            return fh.read().decode()
    with open(path) as fh:
        return fh.read()


# -----------------------------------------------------------------------------
# Parameter validation (utils_nfcore_rnaseq_pipeline: validateInputParameters)
# -----------------------------------------------------------------------------
UNPORTED = {
    "with_umi": "UMI handling",
    "remove_ribo_rna": "rRNA removal",
    "skip_alignment": "skip_alignment",
    "skip_quantification_merge": "skip_quantification_merge",
    "stringtie_ignore_gtf": "stringtie_ignore_gtf",
    "contaminant_screening": "contaminant screening",
    "use_rustqc": "RustQC",
    "use_sentieon_star": "Sentieon STAR",
    "use_parabricks_star": "Parabricks STAR",
    "prokaryotic": "prokaryotic mode",
    "bam_csi_index": "CSI BAM indices",
}
for key, what in UNPORTED.items():
    if flag(key):
        raise ValueError(f"{what} ({key}) is not ported to snk-rnaseq yet.")
if config["aligner"] != "star_salmon":
    raise ValueError(f"aligner {config['aligner']!r} is not ported yet; use star_salmon.")
if config["trimmer"] != "trimgalore":
    raise ValueError(f"trimmer {config['trimmer']!r} is not ported yet; use trimgalore.")
if config["pseudo_aligner"] not in ("", None, "salmon"):
    raise ValueError(f"pseudo_aligner {config['pseudo_aligner']!r} is not ported yet.")
if not config["fasta"]:
    raise ValueError("`fasta` is required.")
if not config["gtf"] and not config["gff"]:
    raise ValueError("No GTF or GFF3 annotation specified (`gtf` or `gff`).")

ALIGNER = config["aligner"]
PSEUDO = config["pseudo_aligner"] if config["pseudo_aligner"] and not flag("skip_pseudo_alignment") else None
if config["transcript_fasta"] and config["additional_fasta"] and PSEUDO and not config["salmon_index"]:
    raise ValueError(
        "Both `transcript_fasta` and `additional_fasta` were given but no pre-built "
        "`salmon_index`; see https://github.com/nf-core/rnaseq/issues/1450"
    )

SAVE_REF = flag("save_reference")
GENOME_DIR = f"{O}/genome" if SAVE_REF else f"{W}/genome"
INDEX_DIR = f"{O}/genome/index" if SAVE_REF else f"{W}/genome/index"
AL = f"{O}/{ALIGNER}"
SKIP_QC = flag("skip_qc")
BIOTYPE = "gene_type" if flag("gencode") else config["featurecounts_group_type"]

# -----------------------------------------------------------------------------
# Reference files (PREPARE_GENOME_REFERENCES)
# -----------------------------------------------------------------------------
GUNZIP_SRC = {}  # GUNZIP_*: output name in GENOME_DIR -> .gz source


def gunzipped(path):
    """Return the path a reference ends up at after (optional) GUNZIP."""
    path = stage(path)
    if not path.endswith(".gz"):
        return path
    name = os.path.basename(path)[:-3]
    GUNZIP_SRC[name] = path
    return f"{GENOME_DIR}/{name}"


# Genome FASTA. It is always linked into GENOME_DIR so samtools faidx can
# write genome.fai next to it, as it does in the Nextflow work directory.
_fasta = gunzipped(config["fasta"])
FASTA_LINK = {}
if not _fasta.startswith(GENOME_DIR + "/"):
    FASTA_LINK[os.path.basename(_fasta)] = _fasta
    _fasta = f"{GENOME_DIR}/{os.path.basename(_fasta)}"

# GTF (GUNZIP_GTF), else GFF -> GTF (GUNZIP_GFF + GFFREAD)
if config["gtf"]:
    _gtf = gunzipped(config["gtf"])
    GFF = None
else:
    GFF = gunzipped(config["gff"])
    _gtf = f"{GENOME_DIR}/{simple_name(GFF)}.gtf"

# CUSTOM_GTFFILTER
FILTER_GTF = (
    (not flag("skip_alignment") and ALIGNER) or PSEUDO or not config["transcript_fasta"]
) and not flag("skip_gtf_filter")
GTF_UNFILTERED = _gtf
if FILTER_GTF:
    _gtf = f"{GENOME_DIR}/{basename_noext(_gtf)}.filtered.gtf"

# CUSTOM_CATADDITIONALFASTA
ADD_FASTA = gunzipped(config["additional_fasta"]) if config["additional_fasta"] else None
FASTA_PRE_ADD, GTF_PRE_ADD = _fasta, _gtf
if ADD_FASTA:
    ADD_PREFIX = f"{basename_noext(_fasta)}_{basename_noext(ADD_FASTA)}"
    _fasta = f"{GENOME_DIR}/{ADD_PREFIX}.fasta"
    _gtf = f"{GENOME_DIR}/{ADD_PREFIX}.gtf"
FASTA, GTF = _fasta, _gtf
FAI, SIZES = f"{FASTA}.fai", f"{FASTA}.sizes"

# Gene BED: provided (GUNZIP_GENE_BED) or EAUTILS_GTF2BED
GENE_BED = gunzipped(config["gene_bed"]) if config["gene_bed"] else f"{GENOME_DIR}/{basename_noext(GTF)}.bed"

# Transcript FASTA: provided (+ PREPROCESS_TRANSCRIPTS_FASTA_GENCODE), else
# GFFREAD_TRANSCRIPTS or MAKE_TRANSCRIPTS_FASTA (rsem-prepare-reference).
if config["transcript_fasta"]:
    TX_FASTA_RAW = gunzipped(config["transcript_fasta"])
    if flag("gencode"):
        TX_FASTA = f"{GENOME_DIR}/{basename_noext(TX_FASTA_RAW)}.fixed.fa"
    else:
        TX_FASTA = TX_FASTA_RAW
elif flag("gffread_transcript_fasta"):
    TX_FASTA = f"{GENOME_DIR}/transcripts.fasta"
else:
    TX_FASTA = f"{GENOME_DIR}/genome.transcripts.fa"

# -----------------------------------------------------------------------------
# Indices (PREPARE_GENOME_INDICES)
# -----------------------------------------------------------------------------
UNTAR_SRC = {}  # UNTAR_*: output name in INDEX_DIR -> .tar.gz source


def index_path(param, built_name):
    value = config.get(param)
    if not value:
        return f"{INDEX_DIR}/{built_name}"
    value = stage(value)
    if value.endswith(".tar.gz"):
        name = os.path.basename(value)[: -len(".tar.gz")]
        UNTAR_SRC[name] = value
        return f"{INDEX_DIR}/{name}"
    return value


SKIP_BBSPLIT = flag("skip_bbsplit")
if not SKIP_BBSPLIT:
    BBSPLIT_INDEX = index_path("bbsplit_index", "bbsplit_index")
    BBSPLIT_REFS = OrderedDict()
    if not config["bbsplit_index"]:
        for line in read_text(config["bbsplit_fasta_list"]).splitlines():
            if line.strip():
                name, path = [x.strip() for x in line.split(",")[:2]]
                BBSPLIT_REFS[name] = stage(path)
STAR_INDEX = index_path("star_index", "star")
SALMON_INDEX = index_path("salmon_index", "salmon")

# -----------------------------------------------------------------------------
# Samplesheet (samplesheetToList + checkSamplesAfterGrouping)
# -----------------------------------------------------------------------------
SAMPLES = OrderedDict()
with open(config["input"], newline="") as fh:
    for row in csv.DictReader(fh):
        sample = str(row["sample"]).strip()
        if not re.fullmatch(r"\S+", sample):
            raise ValueError(f"Sample name {sample!r} must not contain spaces.")
        fq1, fq2 = row["fastq_1"].strip(), (row.get("fastq_2") or "").strip()
        meta = {
            "strandedness": (row.get("strandedness") or "auto").strip(),
            "single_end": not fq2,
            "seq_platform": (row.get("seq_platform") or "").strip(),
            "seq_center": (row.get("seq_center") or "").strip(),
        }
        if meta["strandedness"] not in ("forward", "reverse", "unstranded", "auto"):
            raise ValueError(f"Sample {sample}: strandedness must be forward, reverse, unstranded or auto.")
        if sample in SAMPLES:
            prev = SAMPLES[sample]
            for key in meta:
                if prev[key] != meta[key]:
                    raise ValueError(f"Multiple runs of sample {sample} must have the same {key}.")
            if prev["runs"][0][0].endswith(".gz") != fq1.endswith(".gz"):
                raise ValueError(f"Runs of sample {sample} mix compressed and uncompressed FASTQ.")
        else:
            SAMPLES[sample] = dict(meta, runs=[])
        SAMPLES[sample]["runs"].append((stage(fq1), stage(fq2) if fq2 else None))

PE = [s for s in SAMPLES if not SAMPLES[s]["single_end"]]
SE = [s for s in SAMPLES if SAMPLES[s]["single_end"]]

wildcard_constraints:
    sample=alternation(SAMPLES),
    pe_sample=alternation(PE),
    se_sample=alternation(SE),
    stage="raw|filtered",
    mate="|_1|_2",
    qdir=alternation([ALIGNER] + ([PSEUDO] if PSEUDO else [])),
    kind=r"sorted|markdup\.sorted",
    strand=r"|\.forward|\.reverse",


def mates(s):
    return [""] if SAMPLES[s]["single_end"] else ["_1", "_2"]


# -----------------------------------------------------------------------------
# Read files at each stage (FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS)
# -----------------------------------------------------------------------------
SAVE_MERGED = flag("save_merged_fastq")
FASTQ_DIR = f"{O}/fastq" if SAVE_MERGED else f"{W}/fastq"
TRIM_DIR = f"{O}/trimgalore" if flag("save_trimmed") else f"{W}/trimgalore"
BBSPLIT_DIR = f"{O}/bbsplit" if flag("save_bbsplit_reads") else f"{W}/bbsplit"
SKIP_LINT = flag("skip_linting")
SKIP_TRIM = flag("skip_trimming")
SKIP_FASTQC = flag("skip_fastqc") or SKIP_QC


def needs_cat(s):
    runs = SAMPLES[s]["runs"]
    return len(runs) > 1 or not runs[0][0].endswith(".gz") or SAVE_MERGED


def reads_cat(s):
    """CAT_FASTQ output, or the single input run when no merge is needed."""
    if needs_cat(s):
        if SAMPLES[s]["single_end"]:
            return [f"{FASTQ_DIR}/{s}.merged.fastq.gz"]
        return [f"{FASTQ_DIR}/{s}_1.merged.fastq.gz", f"{FASTQ_DIR}/{s}_2.merged.fastq.gz"]
    r1, r2 = SAMPLES[s]["runs"][0]
    return [r1] if r2 is None else [r1, r2]


def reads_trimmed(s):
    if SKIP_TRIM:
        return reads_cat(s)
    if SAMPLES[s]["single_end"]:
        return [f"{TRIM_DIR}/{s}_trimmed_trimmed.fq.gz"]
    return [f"{TRIM_DIR}/{s}_trimmed_1_val_1.fq.gz", f"{TRIM_DIR}/{s}_trimmed_2_val_2.fq.gz"]


def reads_filtered(s):
    """Reads after BBSplit (when run): the input of alignment and quantification."""
    if SKIP_BBSPLIT:
        return reads_trimmed(s)
    if SAMPLES[s]["single_end"]:
        return [f"{BBSPLIT_DIR}/{s}_primary.fastq.gz"]
    return [f"{BBSPLIT_DIR}/{s}_primary_1.fastq.gz", f"{BBSPLIT_DIR}/{s}_primary_2.fastq.gz"]


def lint_gate(s, upto):
    """FQ_LINT reports that gate a stage (Nextflow joins reads on the lint output)."""
    if SKIP_LINT:
        return []
    stages = ["raw"] + ([] if SKIP_TRIM else ["trimmed"]) + ([] if SKIP_BBSPLIT else ["bbsplit"])
    stages = stages[: stages.index(upto) + 1] if upto in stages else stages
    return [f"{O}/fq_lint/{st}/{s}.fq_lint.txt" for st in stages]


def mate_file(files, mate):
    return files[{"": 0, "_1": 0, "_2": 1}[mate]]


# -----------------------------------------------------------------------------
# Per-sample status written by checkpoints (Groovy logic in nf-core)
# -----------------------------------------------------------------------------
# Per-sample status files are ordinary rules (they run in parallel); two
# aggregate checkpoints collect them so the DAG is re-evaluated only twice:
# trim_summary (all samples) and sample_summary (strandedness + mapping rate
# of every sample that passed trimming).
def _summary(cp):
    with open(cp.get().output[0]) as fh:
        return json.load(fh)


def trim_pass(s):
    return SKIP_TRIM or _summary(checkpoints.trim_summary)[s]["pass"]


def map_pass(s):
    return _summary(checkpoints.sample_summary)[s]["map"]["pass"]


def strandedness(s):
    return _summary(checkpoints.sample_summary)[s]["strand"]["strandedness"]


def samples_trimmed():
    """Samples that pass min_trimmed_reads (FASTQ_FASTQC_UMITOOLS_TRIMGALORE)."""
    return [s for s in SAMPLES if trim_pass(s)]


def samples_mapped():
    """Samples that pass min_mapped_reads (RNASEQ: map_filtered_genome_bam_bai)."""
    return [s for s in samples_trimmed() if map_pass(s)]


def strand_file(wc):
    return f"{W}/status/{wc.sample}.strandedness"


# -----------------------------------------------------------------------------
# Alignment outputs
# -----------------------------------------------------------------------------
SAVE_ALIGN = flag("save_align_intermeds")
SKIP_MARKDUP = flag("skip_markduplicates")
STAR_DIR = AL if SAVE_ALIGN else f"{W}/star"
SORTED_DIR = AL if (SAVE_ALIGN or SKIP_MARKDUP) else f"{W}/{ALIGNER}"


def final_bam(s):
    return f"{SORTED_DIR}/{s}.sorted.bam" if SKIP_MARKDUP else f"{AL}/{s}.markdup.sorted.bam"


def qc_tools():
    """utils_nfcore_rnaseq_pipeline: defineQcTools."""
    tools = []
    if SKIP_QC:
        return tools
    if not flag("skip_preseq"):
        tools.append("preseq")
    if not flag("skip_biotype_qc") and biotype_qc_usable():
        tools.append("biotype_qc")
    if not flag("skip_qualimap"):
        tools.append("qualimap")
    if not flag("skip_dupradar"):
        tools.append("dupradar")
    if not flag("skip_rseqc"):
        mods = [m.strip().lower() for m in str(config["rseqc_modules"]).split(",") if m.strip()]
        tools += [f"rseqc_{m}" for m in mods]
    return tools


def biotype_qc_usable():
    """utils_nfcore_rnaseq_pipeline: biotypeQcUsable (checks the input GTF)."""
    if not config["gtf"]:
        return True
    import gzip
    import io

    path = config["gtf"]
    if is_url(path):
        with urllib.request.urlopen(path) as fh:
            raw = fh.read()
    else:
        with open(path, "rb") as fh:
            raw = fh.read()
    text = gzip.decompress(raw).decode() if path.endswith(".gz") else raw.decode()
    for line in io.StringIO(text):
        fields = line.rstrip("\n").split("\t")
        if len(fields) > 2 and fields[2] == config["featurecounts_feature_type"] and BIOTYPE in fields[-1].split():
            return True
    print(f"WARNING: biotype attribute {BIOTYPE!r} not found on "
          f"{config['featurecounts_feature_type']!r} rows of the GTF; biotype QC skipped.", file=sys.stderr)
    return False


QC_TOOLS = qc_tools()
RSEQC = [t[len("rseqc_"):] for t in QC_TOOLS if t.startswith("rseqc_")]


# -----------------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------------
def quant_outputs(qdir, samples):
    d = f"{O}/{qdir}"
    out = [f"{d}/{s}" for s in samples]
    if samples:
        out += [f"{d}/salmon.merged.tx2gene.tsv"]
        out += [f"{d}/salmon.merged.{x}.tsv" for x in TXIMPORT_OUT]
        out += [f"{d}/salmon.merged.{x}.SummarizedExperiment.rds" for x in ("gene", "transcript")]
        if not SKIP_QC and not flag("skip_deseq2_qc"):
            out.append(f"{d}/deseq2_qc/deseq2.plots.pdf")
    return out


def bam_qc_outputs(s):
    out = []
    if "preseq" in QC_TOOLS:
        out += [f"{AL}/preseq/{s}.lc_extrap.txt", f"{AL}/preseq/log/{s}.command.log"]
    if "biotype_qc" in QC_TOOLS:
        out += [f"{AL}/featurecounts/{s}.biotype_counts_mqc.tsv"]
    if "qualimap" in QC_TOOLS:
        out.append(f"{AL}/qualimap/{s}")
    if "dupradar" in QC_TOOLS:
        out.append(f"{AL}/dupradar/gene_data/{s}_dupMatrix.txt")
    for mod in RSEQC:
        out += rseqc_files(mod, s)
    return out


def all_outputs(wc):
    out = []
    for s in SAMPLES:
        if not SKIP_LINT:
            out.append(f"{O}/fq_lint/raw/{s}.fq_lint.txt")
        if not SKIP_FASTQC:
            out += [f"{O}/fastqc/raw/{s}_raw{m}_fastqc.{e}" for m in mates(s) for e in ("html", "zip")]
        if not SKIP_TRIM:
            out += trimgalore_outputs(s)
    trimmed = samples_trimmed()
    for s in trimmed:
        if not SKIP_LINT and not SKIP_TRIM:
            out.append(f"{O}/fq_lint/trimmed/{s}.fq_lint.txt")
        if not SKIP_BBSPLIT:
            out.append(f"{O}/bbsplit/{s}.stats.txt")
            if flag("save_bbsplit_reads"):
                out += reads_filtered(s)
            if not SKIP_LINT:
                out.append(f"{O}/fq_lint/bbsplit/{s}.fq_lint.txt")
            if not SKIP_FASTQC:
                out += [f"{O}/fastqc/filtered/{s}_filtered{m}_fastqc.{e}" for m in mates(s) for e in ("html", "zip")]
        out += [f"{AL}/log/{s}.{x}" for x in ("Log.final.out", "Log.out", "Log.progress.out", "SJ.out.tab")]
        out += [f"{AL}/samtools_stats/{s}.sorted.bam.{x}" for x in ("stats", "flagstat", "idxstats")]
        if SAVE_ALIGN or SKIP_MARKDUP:
            out += [f"{SORTED_DIR}/{s}.sorted.bam", f"{SORTED_DIR}/{s}.sorted.bam.bai"]
        if SAVE_ALIGN:
            out += [f"{STAR_DIR}/{s}.Aligned.out.bam", f"{STAR_DIR}/{s}.Aligned.toTranscriptome.out.bam"]
        if SAVE_MERGED and needs_cat(s):
            out += reads_cat(s)
        if flag("save_trimmed") and not SKIP_TRIM:
            out += reads_trimmed(s)
    out += quant_outputs(ALIGNER, trimmed)
    for s in samples_mapped():
        if not SKIP_MARKDUP:
            out += [f"{AL}/{s}.markdup.sorted.bam", f"{AL}/{s}.markdup.sorted.bam.bai",
                    f"{AL}/picard_metrics/{s}.markdup.sorted.metrics.txt"]
            out += [f"{AL}/samtools_stats/{s}.markdup.sorted.bam.{x}" for x in ("stats", "flagstat", "idxstats")]
        if not flag("skip_stringtie"):
            out += [f"{AL}/stringtie/{s}.transcripts.gtf"]
        if not SKIP_QC:
            out += bam_qc_outputs(s)
        if not flag("skip_bigwig"):
            out.append(f"{AL}/bigwig/{s}.bigWig")
            if strandedness(s) in ("forward", "reverse"):
                out += [f"{AL}/bigwig/{s}.forward.bigWig", f"{AL}/bigwig/{s}.reverse.bigWig"]
    if PSEUDO:
        out += quant_outputs(PSEUDO, trimmed)
    if not flag("skip_multiqc"):
        out.append(f"{O}/multiqc/{ALIGNER}/multiqc_report.html")
    return out


rule all:
    input:
        all_outputs,


localrules:
    all,
    fetch_remote,
    link_fasta,
    trim_status,
    trim_summary,
    strandedness,
    map_status,
    sample_summary,


# =============================================================================
# Input staging
# =============================================================================

# Not an nf-core process: Nextflow stages remote inputs itself.
rule fetch_remote:
    output:
        f"{W}/inputs/{{fname}}",
    params:
        url=lambda wc: REMOTE[wc.fname],
    retries: 2
    run:
        import shutil

        with urllib.request.urlopen(params.url) as src, open(output[0], "wb") as dst:
            shutil.copyfileobj(src, dst)


# Not an nf-core process: puts an uncompressed local FASTA next to its .fai
# (Nextflow stages the FASTA into the SAMTOOLS_FAIDX work directory).
rule link_fasta:
    input:
        lambda wc: FASTA_LINK[wc.fname],
    output:
        f"{GENOME_DIR}/{{fname}}",
    wildcard_constraints:
        fname=alternation(FASTA_LINK),
    shell:
        "ln -sf $(realpath {input}) {output}"


# =============================================================================
# PREPARE_GENOME_REFERENCES
# =============================================================================

# GUNZIP_FASTA / GUNZIP_GTF / GUNZIP_GFF / GUNZIP_GENE_BED /
# GUNZIP_TRANSCRIPT_FASTA / GUNZIP_ADDITIONAL_FASTA
rule gunzip:
    input:
        lambda wc: GUNZIP_SRC[wc.fname],
    output:
        f"{GENOME_DIR}/{{fname}}",
    wildcard_constraints:
        fname=alternation(GUNZIP_SRC),
    container:
        container_path("coreutils")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        "gzip -cd {input} > {output}"


if GFF:

    # GFFREAD (GFF3 -> GTF when no GTF is given)
    rule gffread_gtf:
        input:
            GFF,
        output:
            GTF_UNFILTERED,
        container:
            container_path("gffread")
        threads: res("process_low")["threads"]
        resources:
            mem_mb=res("process_low")["mem_mb"],
        shell:
            "gffread {input} --keep-exon-attrs -F -T -o {output}"


if FILTER_GTF:

