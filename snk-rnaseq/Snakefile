if cfg("transcript_fasta") and flag("gencode"):

    # PREPROCESS_TRANSCRIPTS_FASTA_GENCODE (gencode: true with a transcript_fasta)
    rule preprocess_transcripts_fasta_gencode:
        input:
            TX_FASTA_RAW,
        output:
            TX_FASTA,
        container:
            container_path("ubuntu")
        threads: res("process_single")["threads"]
        resources:
            mem_mb=res("process_single")["mem_mb"],
        shell:
            "cat {input} | cut -d '|' -f1 > {output}"


if not cfg("transcript_fasta") and HAS_FASTA and flag("gffread_transcript_fasta"):

    # GFFREAD_TRANSCRIPTS (gffread_transcript_fasta: true, no transcript_fasta)
    rule gffread_transcripts:
        input:
            gtf=GTF,
            fasta=FASTA,
            fai=FAI,
        output:
            f"{GENOME_DIR}/transcripts.fasta",
        container:
            container_path("gffread")
        threads: res("process_low")["threads"]
        resources:
            mem_mb=res("process_low")["mem_mb"],
        shell:
            "gffread {input.gtf} -g {input.fasta} -w {output}"


if not cfg("transcript_fasta") and HAS_FASTA and not flag("gffread_transcript_fasta"):

    # MAKE_TRANSCRIPTS_FASTA (RSEM_PREPAREREFERENCE; default when no transcript_fasta)
    rule make_transcripts_fasta:
        input:
            fasta=FASTA,
            gtf=GTF,
        output:
            f"{GENOME_DIR}/genome.transcripts.fa",
        params:
            rsem_dir=os.path.abspath(f"{GENOME_DIR}/rsem") if SAVE_REF else "",
            star_link=SENTIEON_STAR_LINK if SENTIEON else "",
        container:
            container_path("rsem_sentieon" if SENTIEON else "rsem")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            {params.star_link}
            mkdir rsem
            ln -s $(realpath {input.fasta}) rsem/$(basename {input.fasta})
            rsem-prepare-reference --gtf {input.gtf} --num-threads {threads} \
                rsem/$(basename {input.fasta}) rsem/genome
            mv rsem/genome.transcripts.fa {output}
            if [ -n "{params.rsem_dir}" ]; then rm -rf {params.rsem_dir}; mv rsem {params.rsem_dir}; fi
            """


if HAS_FASTA:

    # SAMTOOLS_FAIDX (get_sizes: true), plus main.nf checkMaxContigSize: a
    # contig > 512 Mbp needs bam_csi_index.
    rule samtools_faidx:
        input:
            FASTA,
        output:
            fai=FAI,
            sizes=SIZES,
        params:
            check="true" if ALIGN and not CSI else "",
        container:
            container_path("samtools")
        threads: res("process_single")["threads"]
        resources:
            mem_mb=res("process_single")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            ln -s $(realpath {input}) $(basename {input})
            samtools faidx $(basename {input})
            mv $(basename {input}).fai {output.fai}
            cut -f 1,2 {output.fai} > {output.sizes}
            if [ -n "{params.check}" ]; then
                awk -F '\\t' '$2 > 512000000 {{print "Contig longer than 512000000bp found in reference genome: " $1 ": " $2 ". Set bam_csi_index: true (https://github.com/nf-core/rnaseq/issues/744)." > "/dev/stderr"; bad = 1}} END {{exit bad}}' {output.fai}
            fi
            """


# =============================================================================
# PREPARE_GENOME_INDICES
# =============================================================================

# UNTAR_BBSPLIT_INDEX / UNTAR_STAR_INDEX / UNTAR_SALMON_INDEX / UNTAR_RSEM_INDEX /
# UNTAR_HISAT2_INDEX / UNTAR_BOWTIE2_INDEX / UNTAR_KALLISTO_INDEX /
# UNTAR_SORTMERNA_INDEX / UNTAR_BOWTIE2_RRNA_INDEX / UNTAR_KRAKEN_DB
rule untar:
    input:
        lambda wc: UNTAR_SRC[wc.name],
    output:
        directory(f"{INDEX_DIR}/{{name}}"),
    wildcard_constraints:
        name=alternation(UNTAR_SRC),
    container:
        container_path("coreutils")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        mkdir -p {output}
        if [[ $(tar -taf {input} | grep -o -P "^.*?\\/" | uniq | wc -l) -eq 1 ]]; then
            tar -C {output} --strip-components 1 -xavf {input} --no-same-owner
        else
            tar -C {output} -xavf {input} --no-same-owner
        fi
        """


if not SKIP_BBSPLIT and not cfg("bbsplit_index"):

    # BBMAP_BBSPLIT (only_build_index: true; ext.args 'build=1')
    rule bbsplit_index:
        input:
            fasta=FASTA,
            refs=lambda wc: list(BBSPLIT_REFS.values()),
        output:
            index=directory(f"{INDEX_DIR}/bbsplit_index"),
            log=f"{INDEX_DIR}/genome_transcriptome.log",
        params:
            refs=lambda wc, input: " ".join(f"ref_{n}={os.path.basename(p)}" for n, p in zip(BBSPLIT_REFS, input.refs)),
            mem=lambda wc, resources: int(resources.mem_mb * 0.8),
        container:
            container_path("bbmap")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            # inputs staged under their own names, as in the nf-core work dir
            for f in {input.fasta} {input.refs}; do ln -s $(realpath $f) $(basename $f); done
            bbsplit.sh -Xmx{params.mem}M ref_primary=$(basename {input.fasta}) {params.refs} path=bbsplit_build \
                threads={threads} build=1 2>| >(tee genome_transcriptome.log >&2)
            # Make summary.txt paths relative so the index can be used elsewhere
            find bbsplit_build/ref/genome -name summary.txt | while read -r summary_file; do
                sed "s|^source.*|source\\t$(grep '^source' "$summary_file" | cut -f2- -d$'\\t' | sed 's|.*/bbsplit_build|bbsplit_index|')|" \
                    "$summary_file" > ${{summary_file}}.tmp && mv ${{summary_file}}.tmp ${{summary_file}}
            done
            mv bbsplit_build {output.index}
            mv genome_transcriptome.log {output.log}
            """


if (not cfg("star_index") or PARABRICKS) and HAS_FASTA:

    # STAR_GENOMEGENERATE (prokaryotic: --sjdbGTFfeatureExon CDS) /
    # PARABRICKS_STARGENOMEGENERATE (same command, STAR 2.7.2a image)
    rule star_genomegenerate:
        input:
            fasta=FASTA,
            gtf=GTF,
        output:
            directory(f"{INDEX_DIR}/star"),
        params:
            ram=lambda wc, resources: resources.mem_mb * 1024 * 1024 - 100000000,
            args="--sjdbGTFfeatureExon CDS" if PROKARYOTIC else "",
        container:
            container_path("star_parabricks" if PARABRICKS else "star")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            fasta=$(basename {input.fasta})
            ln -s $(realpath {input.fasta}) $fasta
            samtools faidx $fasta
            NUM_BASES=`gawk '{{sum = sum + $2}}END{{if ((log(sum)/log(2))/2 - 1 > 14) {{printf "%.0f", 14}} else {{printf "%.0f", (log(sum)/log(2))/2 - 1}}}}' ${{fasta}}.fai`
            mkdir star
            STAR --runMode genomeGenerate --genomeDir star/ --genomeFastaFiles $fasta \
                --sjdbGTFfile {input.gtf} --runThreadN {threads} \
                --genomeSAindexNbases $NUM_BASES --limitGenomeGenerateRAM {params.ram} {params.args}
            mv star {output}
            """


if STAR_LEGACY:

    # STAR_GENOMEPARAMS_UPGRADE (iGenomes star_legacy): genomeParameters.txt of a
    # STAR 2.6.x index rewritten to the 2.7.4a schema; other files copied.
    rule star_genomeparams_upgrade:
        input:
            STAR_INDEX_RAW,
        output:
            directory(STAR_INDEX),
        container:
            container_path("gawk")
        threads: res("process_single")["threads"]
        resources:
            mem_mb=res("process_single")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            ln -s $(realpath {input}) input_index
            mkdir -p star
            for f in input_index/*; do
                name=$(basename "$f")
                if [ "$name" = "genomeParameters.txt" ]; then continue; fi
                cp -r "$(readlink -f "$f")" "star/$name"
            done
            awk -F'\\t' -v OFS='\\t' '
                $1 == "versionGenome" && $2 == "20201" {{ print "versionGenome", "2.7.4a"; seen_upgraded = 1; next }}
                $1 == "genomeType"          {{ seen_genomeType = 1 }}
                $1 == "genomeTransformType" {{ seen_transformType = 1 }}
                $1 == "genomeTransformVCF"  {{ seen_transformVCF = 1 }}
                {{ print }}
                END {{
                    if (seen_upgraded) {{
                        if (!seen_genomeType)    print "genomeType", "Full"
                        if (!seen_transformType) print "genomeTransformType", "None"
                        if (!seen_transformVCF)  print "genomeTransformVCF", "-"
                    }}
                }}
            ' input_index/genomeParameters.txt > star/genomeParameters.txt
            mv star {output}
            """


if not cfg("rsem_index") and HAS_FASTA:

    # RSEM_PREPAREREFERENCE_GENOME (star_rsem). Its genome.transcripts.fa copy
    # is published next to the index with save_reference.
    rule rsem_preparereference_genome:
        input:
            fasta=FASTA,
            gtf=GTF,
        output:
            directory(f"{INDEX_DIR}/rsem"),
        params:
            tx_copy=f"{INDEX_DIR}/genome.transcripts.fa" if SAVE_REF else "",
            star_link=SENTIEON_STAR_LINK if SENTIEON else "",
        container:
            container_path("rsem_sentieon" if SENTIEON else "rsem")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            {params.star_link}
            mkdir rsem
            ln -s $(realpath {input.fasta}) rsem/$(basename {input.fasta})
            rsem-prepare-reference --gtf {input.gtf} --num-threads {threads} \
                rsem/$(basename {input.fasta}) rsem/genome
            if [ -n "{params.tx_copy}" ]; then cp rsem/genome.transcripts.fa {params.tx_copy}; fi
            mv rsem {output}
            """


if ALIGN and ALIGNER == "hisat2" and not cfg("splicesites"):

    # HISAT2_EXTRACTSPLICESITES
    rule hisat2_extractsplicesites:
        input:
            GTF,
        output:
            SPLICESITES,
        container:
            container_path("hisat2")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shell:
            "hisat2_extract_splice_sites.py {input} > {output}"


if ALIGN and ALIGNER == "hisat2" and not cfg("hisat2_index"):

    # HISAT2_BUILD: splice sites and exons are only used when the task memory
    # reaches hisat2_build_memory (conf: HISAT2_BUILD memory 200.GB).
    rule hisat2_build:
        input:
            fasta=FASTA,
            gtf=GTF,
            ss=SPLICESITES,
        output:
            directory(f"{INDEX_DIR}/hisat2"),
        params:
            splice=lambda wc, resources: (
                int(resources.mem_mb // 1024) >= mem_gb(cfg("hisat2_build_memory", "200.GB"))
                if cfg("hisat2_build_memory") else False
            ),
            prefix=basename_noext(FASTA),
            gtf_base=basename_noext(GTF),
        container:
            container_path("hisat2_build")
        threads: res("hisat2_build")["threads"]
        resources:
            mem_mb=res("hisat2_build")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            mkdir hisat2
            ss= exon=
            if [ "{params.splice}" = "True" ]; then
                hisat2_extract_exons.py {input.gtf} > {params.gtf_base}.exons.txt
                ss="--ss {input.ss}"
                exon="--exon {params.gtf_base}.exons.txt"
            fi
            hisat2-build -p {threads} $ss $exon {input.fasta} hisat2/{params.prefix}
            mv hisat2 {output}
            """


if ALIGN and ALIGNER == "bowtie2_salmon" and not cfg("bowtie2_index"):

    # BOWTIE2_BUILD (PREPARE_GENOME_INDICES: transcriptome index for bowtie2_salmon)
    rule bowtie2_build_transcripts:
        input:
            TX_FASTA,
        output:
            directory(f"{INDEX_DIR}/bowtie2"),
        params:
            prefix=basename_noext(TX_FASTA) if TX_FASTA else "",
        container:
            container_path("bowtie2")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            mkdir bowtie2
            bowtie2-build --threads {threads} {input} bowtie2/{params.prefix}
            mv bowtie2 {output}
            """


if not cfg("salmon_index") and TX_FASTA:

    # SALMON_INDEX (decoy-aware with the genome as decoys when a FASTA is
    # given). The extra args only apply to PREPARE_GENOME_INDICES:SALMON_INDEX;
    # the strandedness subworkflow's own index (no Salmon pseudo-aligner) gets
    # the plain SALMON_INDEX ext.args.
    rule salmon_index:
        input:
            transcripts=TX_FASTA,
            genome=FASTA or [],
        output:
            directory(f"{INDEX_DIR}/salmon"),
        params:
            args=" ".join(filter(None, [
                "--gencode" if flag("gencode") else "",
                f"-k {config['pseudo_aligner_kmer_size']}" if config["pseudo_aligner_kmer_size"] else "",
                (cfg("extra_salmon_index_args") if PSEUDO == "salmon" else ""),
            ])),
        container:
            container_path("salmon")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            if [ -n '{input.genome}' ]; then
                grep '^>' {input.genome} | cut -d ' ' -f 1 | cut -d $'\\t' -f 1 | sed 's/>//g' > decoys.txt
                cat {input.transcripts} {input.genome} > gentrome.fa
                salmon index --threads {threads} -t gentrome.fa -d decoys.txt {params.args} -i salmon
            else
                salmon index --threads {threads} -t {input.transcripts} {params.args} -i salmon
            fi
            mv salmon {output}
            """


if not cfg("kallisto_index") and TX_FASTA:

