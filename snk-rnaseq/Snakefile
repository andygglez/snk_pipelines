                """
                ln -s $(realpath {input.index}) bt2_index
                INDEX=`find -L ./bt2_index -name "*.rev.1.bt2" | sed "s/\\.rev.1.bt2$//"`
                [ -z "$INDEX" ] && INDEX=`find -L ./bt2_index -name "*.rev.1.bt2l" | sed "s/\\.rev.1.bt2l$//"`
                [ -z "$INDEX" ] && echo "Bowtie2 index files not found" 1>&2 && exit 1
                p={wildcards.sample}
                bowtie2 -x $INDEX {params.reads} --threads {threads} {params.un} {params.args} \
                    2>| >(tee $p.bowtie2.log >&2) | samtools view --threads {threads} -o $p.bam -
                if [ -f $p.unmapped.fastq.1.gz ]; then mv $p.unmapped.fastq.1.gz ${{p}}.unmapped_1.fastq.gz; fi
                if [ -f $p.unmapped.fastq.2.gz ]; then mv $p.unmapped.fastq.2.gz ${{p}}.unmapped_2.fastq.gz; fi
                mv $p.bam {output.bam}
                mv $p.bowtie2.log {output.log}
                for f in {output.unmapped}; do mv $(basename $f) $f; done
                """


def map_log(s):
    """Log holding the mapping rate (STAR / Bowtie2); HISAT2 reports none."""
    if not ALIGN:
        return []
    if STAR:
        return f"{als(s)}/log/{s}.Log.final.out"
    if ALIGNER == "bowtie2_salmon":
        return f"{als(s)}/log/{s}.bowtie2.log"
    return []


# Groovy in ALIGN_STAR / ALIGN_BOWTIE2 / RNASEQ: percent mapped vs
# min_mapped_reads. HISAT2 emits no rate and pre-aligned BAMs use the
# samplesheet percent_mapped, so their status may be null (no filtering).
rule map_status:
    input:
        map_log=lambda wc: map_log(wc.sample),
    output:
        json=f"{W}/status/{{sample}}.map.json",
    run:
        if not ALIGN:
            pm = SAMPLES[wildcards.sample]["percent_mapped"]
        elif STAR:
            pm = star_percent_mapped(input.map_log)
        elif ALIGNER == "bowtie2_salmon":
            pm = bowtie2_percent_mapped(input.map_log)
        else:
            pm = None
        passed = None if pm is None else pm >= float(config["min_mapped_reads"])
        with open(output.json, "w") as fh:
            json.dump({"sample": wildcards.sample, "percent_mapped": pm, "pass": passed}, fh)


checkpoint sample_summary:
    input:
        strand=lambda wc: [f"{W}/status/{s}.strand.json" for s in samples_trimmed()],
        map=lambda wc: [f"{W}/status/{s}.map.json" for s in genome_samples()],
    output:
        f"{W}/status/sample_summary.json",
    run:
        summary = {}
        for kind in ("strand", "map"):
            for f in input[kind]:
                with open(f) as fh:
                    st = json.load(fh)
                summary.setdefault(st["sample"], {})[kind] = st
        with open(output[0], "w") as fh:
            json.dump(summary, fh, indent=1)


def unsorted_genome_bam(wc):
    if STAR and PARABRICKS:
        return at(f"{STAR_W}/{{sample}}.bam", wc.sample)
    if STAR:
        return at(f"{STAR_W}/{{sample}}.Aligned.out.bam", wc.sample)
    return at(f"{ALN_D}/{{sample}}.bam", wc.sample)


# SAMTOOLS_SORT (BAM_SORT_STATS_SAMTOOLS, prefix <id>.sorted)
rule samtools_sort:
    input:
        bam=unsorted_genome_bam,
        fasta=FASTA or [],
        fai=FAI or [],
    output:
        f"{SORTED_D}/{{sample}}.sorted.bam",
    container:
        container_path("samtools")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir 1
        ln -s $(realpath {input.bam}) 1/$(basename {input.bam})
        ln -s $(realpath {input.fasta}) $(basename {input.fasta})
        ln -s $(realpath {input.fai}) $(basename {input.fai})
        samtools cat 1/$(basename {input.bam}) | samtools sort -T {wildcards.sample}.sorted \
            --threads {threads} --reference $(basename {input.fasta}) -o {wildcards.sample}.sorted.bam -
        mv {wildcards.sample}.sorted.bam {output}
        """


# Index rules: SAMTOOLS_INDEX of BAM_SORT_STATS_SAMTOOLS, BAM_MARKDUPLICATES_PICARD
# and the UMI dedup subworkflows (ext.args '-c' with bam_csi_index, except the
# transcriptome dedup BAM, which keeps a BAI).
UMI_TXSORT_D = SORTED_PUB if (SAVE_ALIGN or flag("skip_markduplicates")) else f"{W}/umi_txsort"
TX_SORTED = f"{UMI_TXSORT_D}/{{sample}}.sorted.bam"  # BAM_DEDUP_UMI:BAM_SORT_STATS_SAMTOOLS
INDEX_RULES = {
    "sorted": (f"{SORTED_D}/{{sample}}.sorted.bam", IDX),
    "markdup": (f"{ALP}/{{sample}}.markdup.sorted.bam", IDX),
    "umi_genome": (f"{UMI_GENOME_D}/{{sample}}.umi_dedup.sorted.bam", IDX),
    "umi_transcriptome": (f"{UMI_GENOME_D}/{{sample}}.umi_dedup.transcriptome.sorted.bam", "bai"),
    **({"transcriptome_sorted": (TX_SORTED, IDX)} if UMI_TX else {}),
    "primary_genome": (f"{W}/umi_primary/genome/{{sample}}.primary.bam", IDX),
    "primary_transcriptome": (f"{W}/umi_primary/transcriptome/{{sample}}.primary.bam", IDX),
}
for _name, (_bam, _ext) in INDEX_RULES.items():

    rule:
        name:
            f"samtools_index_{_name}"
        input:
            _bam,
        output:
            f"{_bam}.{_ext}",
        params:
            args="-c" if _ext == "csi" else "",
        container:
            container_path("samtools")
        threads: res("process_low")["threads"]
        resources:
            mem_mb=res("process_low")["mem_mb"],
        shell:
            "samtools index -@ {threads} {params.args} {input}"


if not ALIGN:

    # SAMTOOLS_INDEX of pre-aligned genome BAMs (default publishDir samtools/)
    INPUT_BAM_SAMPLE = {os.path.basename(input_genome_bam(s)): s for s in BAM_SAMPLES if input_genome_bam(s)}

    rule samtools_index_input:
        input:
            lambda wc: input_genome_bam(INPUT_BAM_SAMPLE[wc.bam]),
        output:
            pub("samtools") + "/{bam}.bai",
        wildcard_constraints:
            bam=alternation(INPUT_BAM_SAMPLE),
        container:
            container_path("samtools")
        threads: res("process_low")["threads"]
        resources:
            mem_mb=res("process_low")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            ln -s $(realpath {input}) {wildcards.bam}
            samtools index -@ {threads} {wildcards.bam}
            mv {wildcards.bam}.bai {output}
            """


# samtools stats/flagstat/idxstats per BAM kind: (BAM, index, reference, dir)
STATS_D = pub(f"{ALIGNER}/samtools_stats")


def stats_target(kind, s):
    """(bam, index, reference FASTA or None) of a samtools stats kind."""
    if kind == "sorted" and UMI_TX:
        bam = at(TX_SORTED, s)  # the transcriptome stats win the published name
        return bam, f"{bam}.{IDX}", TX_FASTA
    if kind == "sorted":
        return sorted_bam(s), f"{sorted_bam(s)}.{IDX}", FASTA
    if kind == "markdup.sorted":
        bam = f"{als(s)}/{s}.markdup.sorted.bam"
        return bam, f"{bam}.{IDX}", FASTA
    if kind == "umi_dedup.sorted":
        bam = at(f"{UMI_GENOME_D}/{{sample}}.umi_dedup.sorted.bam", s)
        return bam, f"{bam}.{IDX}", None
    if kind == "umi_dedup.transcriptome.sorted":
        bam = at(f"{UMI_GENOME_D}/{{sample}}.umi_dedup.transcriptome.sorted.bam", s)
        return bam, f"{bam}.bai", None
    raise ValueError(f"unknown samtools stats kind {kind!r}")


def stats_inputs(wc):
    bam, idx, ref = stats_target(wc.kind, wc.sample)
    out = {"bam": bam, "bai": idx}
    if ref:
        out["fasta"] = ref
        if ref == FASTA:
            out["fai"] = FAI
    return out


def stats_reference(wc):
    ref = stats_target(wc.kind, wc.sample)[2]
    return f"--reference {os.path.basename(ref)}" if ref else ""


STATS_KINDS = r"sorted|markdup\.sorted|umi_dedup\.sorted|umi_dedup\.transcriptome\.sorted"
for _tag, _sd, _kinds in (("bam", STATS_D, STATS_KINDS),):

    # SAMTOOLS_STATS (BAM_STATS_SAMTOOLS)
    rule:
        name:
            f"samtools_stats_{_tag}"
        input:
            unpack(stats_inputs),
        output:
            f"{_sd}/{{sample}}.{{kind}}.bam.stats",
        wildcard_constraints:
            kind=_kinds,
        params:
            ref=stats_reference,
        container:
            container_path("samtools")
        threads: res("process_single")["threads"]
        resources:
            mem_mb=res("process_single")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            for f in {input}; do ln -s $(realpath $f) $(basename $f); done
            samtools stats --threads {threads} {params.ref} $(basename {input.bam}) > $(basename {output})
            mv $(basename {output}) {output}
            """

    # SAMTOOLS_FLAGSTAT
    rule:
        name:
            f"samtools_flagstat_{_tag}"
        input:
            unpack(stats_inputs),
        output:
            f"{_sd}/{{sample}}.{{kind}}.bam.flagstat",
        wildcard_constraints:
            kind=_kinds,
        container:
            container_path("samtools")
        threads: res("process_single")["threads"]
        resources:
            mem_mb=res("process_single")["mem_mb"],
        shell:
            "samtools flagstat --threads {threads} {input.bam} > {output}"

    # SAMTOOLS_IDXSTATS
    rule:
        name:
            f"samtools_idxstats_{_tag}"
        input:
            unpack(stats_inputs),
        output:
            f"{_sd}/{{sample}}.{{kind}}.bam.idxstats",
        wildcard_constraints:
            kind=_kinds,
        container:
            container_path("samtools")
        threads: res("process_single")["threads"]
        resources:
            mem_mb=res("process_single")["mem_mb"],
        shell:
            "samtools idxstats --threads $(({threads} - 1)) {input.bam} > {output}"


# =============================================================================
# BAM_DEDUP_UMI (with_umi): genome and transcriptome deduplication
# =============================================================================
UMI_TOOL = config["umi_dedup_tool"]
UMI_PRIMARY = flag("umitools_dedup_primary_only") and UMI_TOOL == "umitools"


def umi_input(space, s):
    """(BAM, index) entering UMI-tools / UMICollapse for 'genome' or 'transcriptome'."""
    if UMI_PRIMARY:
        bam = f"{W}/umi_primary/{space}/{s}.primary.bam"
        return bam, f"{bam}.{IDX}"
    if space == "genome":
        return sorted_bam(s), f"{sorted_bam(s)}.{IDX}"
    bam = at(TX_SORTED, s)
    return bam, f"{bam}.{IDX}"


if ALIGN and WITH_UMI:

    if UMI_TX:

        # SAMTOOLS_SORT (BAM_DEDUP_UMI:BAM_SORT_STATS_SAMTOOLS, transcriptome BAM,
        # sorted against the transcript FASTA)
        rule samtools_sort_transcriptome:
            input:
                bam=lambda wc: aligner_transcriptome_bam(wc.sample),
                fasta=TX_FASTA,
            output:
                TX_SORTED,
            container:
                container_path("samtools")
            threads: res("process_medium")["threads"]
            resources:
                mem_mb=res("process_medium")["mem_mb"],
            shadow:
                "minimal"
            shell:
                """
                mkdir 1
                ln -s $(realpath {input.bam}) 1/$(basename {input.bam})
                ln -s $(realpath {input.fasta}) $(basename {input.fasta})
                samtools cat 1/$(basename {input.bam}) | samtools sort -T {wildcards.sample}.sorted \
                    --threads {threads} --reference $(basename {input.fasta}) -o {wildcards.sample}.sorted.bam -
                mv {wildcards.sample}.sorted.bam {output}
                """

    if UMI_PRIMARY:

        # SAMTOOLS_VIEW_PRIMARY (ext.args '-F 0x900 -b'): primary alignments only
        rule samtools_view_primary:
            input:
                lambda wc: (sorted_bam(wc.sample) if wc.space == "genome"
                            else at(TX_SORTED, wc.sample)),
            output:
                f"{W}/umi_primary/{{space}}/{{sample}}.primary.bam",
            wildcard_constraints:
                space="genome|transcriptome",
            container:
                container_path("samtools")
            threads: res("process_low")["threads"]
            resources:
                mem_mb=res("process_low")["mem_mb"],
            shell:
                "samtools view --threads $(({threads} - 1)) -F 0x900 -b -o {output} {input}"

    UMI_PREFIX = {"genome": "umi_dedup.sorted", "transcriptome": "umi_dedup.transcriptome.sorted"}
    UMI_LOG_DIR = {"genome": "genomic_dedup_log", "transcriptome": "transcriptomic_dedup_log"}

    def umitools_dedup_args(s):
        return " ".join(filter(None, [
            "" if se(s) else "--unpaired-reads=discard --chimeric-pairs=discard",
            f"--method='{config['umitools_grouping_method']}'" if config["umitools_grouping_method"] else "",
            f"--umi-separator='{cfg('umitools_umi_separator')}'" if cfg("umitools_umi_separator") else "",
            "--random-seed=100",
        ]))

    def umicollapse_args(s):
        algo = {"directional": "dir", "adjacency": "adj", "cluster": "cc"}.get(config["umitools_grouping_method"], "")
        return " ".join(filter(None, [
            "--two-pass",
            "" if se(s) else "--paired --remove-unpaired --remove-chimeric",
            f"--algo '{algo}'" if config["umitools_grouping_method"] else "",
            f"--umi-sep '{cfg('umitools_umi_separator')}'" if cfg("umitools_umi_separator") else "",
        ]))

    UMI_STATS = flag("umitools_dedup_stats")

    if UMI_TOOL == "umitools":

        # UMITOOLS_DEDUP (genome / transcriptome)
        for _space in ("genome", "transcriptome"):

            rule:
                name:
                    f"umitools_dedup_{_space}"
                input:
                    bam=lambda wc, sp=_space: umi_input(sp, wc.sample)[0],
                    bai=lambda wc, sp=_space: umi_input(sp, wc.sample)[1],
                output:
                    bam=f"{UMI_GENOME_D}/{{sample}}.{UMI_PREFIX[_space]}.bam",
                    log=pub(f"{ALIGNER}/umitools/{UMI_LOG_DIR[_space]}") + f"/{{sample}}.{UMI_PREFIX[_space]}.log",
                    tsv=[pub(f"{ALIGNER}/umitools") + f"/{{sample}}.{UMI_PREFIX[_space]}_{x}.tsv"
                         for x in ("edit_distance", "per_umi", "per_umi_per_position")] if UMI_STATS else [],
                params:
                    prefix=lambda wc, sp=_space: f"{wc.sample}.{UMI_PREFIX[sp]}",
                    args=lambda wc: umitools_dedup_args(wc.sample),
                    paired=lambda wc: "" if se(wc.sample) else "--paired",
                    stats=lambda wc, sp=_space: f"--output-stats {wc.sample}.{UMI_PREFIX[sp]}" if UMI_STATS else "",
                container:
                    container_path("umitools")
                threads: res("process_medium")["threads"]
                resources:
                    mem_mb=res("process_medium")["mem_mb"],
                shadow:
                    "minimal"
                shell:
                    """
                    ln -s $(realpath {input.bam}) $(basename {input.bam})
                    ln -s $(realpath {input.bai}) $(basename {input.bai})
                    mkdir .tmp && chmod 777 .tmp
                    MPLCONFIGDIR=.tmp TMPDIR=.tmp PYTHONHASHSEED=0 umi_tools dedup -I $(basename {input.bam}) \
                        -S {params.prefix}.bam -L {params.prefix}.log {params.stats} {params.paired} {params.args}
                    mv {params.prefix}.bam {output.bam}
                    mv {params.prefix}.log {output.log}
                    for f in {output.tsv}; do mv $(basename $f) $f; done
                    """

    else:

        # UMICOLLAPSE (genome / transcriptome; mode bam). Only the genome log
        # is published (umicollapse/genomic_dedup_log).
        for _space in ("genome", "transcriptome"):

            rule:
                name:
                    f"umicollapse_{_space}"
                input:
                    bam=lambda wc, sp=_space: umi_input(sp, wc.sample)[0],
                    bai=lambda wc, sp=_space: umi_input(sp, wc.sample)[1],
                output:
                    bam=f"{UMI_GENOME_D}/{{sample}}.{UMI_PREFIX[_space]}.bam",
                    log=pub(f"{ALIGNER}/umicollapse/{UMI_LOG_DIR[_space]}") + f"/{{sample}}.{UMI_PREFIX[_space]}_UMICollapse.log",
                params:
                    prefix=lambda wc, sp=_space: f"{wc.sample}.{UMI_PREFIX[sp]}",
                    args=lambda wc: umicollapse_args(wc.sample),
                    heap=lambda wc, resources: int(resources.mem_mb * 0.9),
                container:
                    container_path("umicollapse")
                threads: res("umicollapse")["threads"]
                resources:
                    mem_mb=res("umicollapse")["mem_mb"],
                shadow:
                    "minimal"
                shell:
                    """
                    ln -s $(realpath {input.bam}) $(basename {input.bam})
                    ln -s $(realpath {input.bai}) $(basename {input.bai})
                    UMICOLLAPSE_JAR=$(find "$(dirname "$(command -v umicollapse)")/../share" -maxdepth 2 -name umicollapse.jar -print -quit)
                    java -Xmx{params.heap}M -Xss999M -jar "$UMICOLLAPSE_JAR" bam -i $(basename {input.bam}) \
                        -o {params.prefix}.bam {params.args} | tee {params.prefix}_UMICollapse.log
                    mv {params.prefix}.bam {output.bam}
                    mv {params.prefix}_UMICollapse.log {output.log}
                    """

    # SAMTOOLS_SORT (BAM_DEDUP_UMI; ext.args '-n', prefix <id>.umi_dedup.transcriptome)
    rule samtools_sort_umi_transcriptome:
        input:
            bam=f"{UMI_GENOME_D}/{{sample}}.umi_dedup.transcriptome.sorted.bam",
            fasta=FASTA,
            fai=FAI,
        output:
            f"{UMI_GENOME_D}/{{sample}}.umi_dedup.transcriptome.bam",
        container:
            container_path("samtools")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            mkdir 1
            ln -s $(realpath {input.bam}) 1/$(basename {input.bam})
            for f in {input.fasta} {input.fai}; do ln -s $(realpath $f) $(basename $f); done
            p={wildcards.sample}.umi_dedup.transcriptome
            samtools cat 1/$(basename {input.bam}) | samtools sort -n -T $p --threads {threads} \
                --reference $(basename {input.fasta}) -o $p.bam -
            mv $p.bam {output}
            """

    # UMITOOLS_PREPAREFORRSEM (paired-end only)
    rule umitools_prepareforrsem:
        input:
            f"{UMI_GENOME_D}/{{sample}}.umi_dedup.transcriptome.bam",
        output:
            bam=f"{UMI_GENOME_D}/{{sample}}.umi_dedup.transcriptome.filtered.bam",
            log=pub(f"{ALIGNER}/umitools/prepare_for_quantification_log")
                + "/{sample}.umi_dedup.transcriptome.filtered.prepare_for_rsem.log",
        wildcard_constraints:
            sample=alternation(PE),
        container:
            container_path("umitools")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            p={wildcards.sample}.umi_dedup.transcriptome.filtered
            umi_tools prepare-for-rsem --stdin={input} --stdout=$p.bam --log=$p.prepare_for_rsem.log
            mv $p.bam {output.bam}
            mv $p.prepare_for_rsem.log {output.log}
            """


# =============================================================================
# Quantification: QUANTIFY_BAM_SALMON / QUANTIFY_RSEM / QUANTIFY_PSEUDO_ALIGNMENT
# =============================================================================
SALMON_LIBTYPES = {"A", "U", "SF", "SR", "IS", "IU", "ISF", "ISR", "OS", "OU", "OSF", "OSR", "MS", "MU", "MSF", "MSR"}
if cfg("salmon_quant_libtype") and config["salmon_quant_libtype"] not in SALMON_LIBTYPES:
    print(f"[Salmon Quant] Invalid library type '{config['salmon_quant_libtype']}', using 'A'.", file=sys.stderr)
    config["salmon_quant_libtype"] = "A"

# conf/modules/quantify_pseudo_alignment.config: --libType from strandedness
SALMON_LIBTYPE_SH = r"""
if [ -n "{params.fixed_libtype}" ]; then libtype={params.fixed_libtype}
else
    case "$(cat {input.strand})" in
        forward) libtype={params.lt_forward} ;;
        reverse) libtype={params.lt_reverse} ;;
        *)       libtype={params.lt_unstranded} ;;
    esac
fi
"""


def salmon_libtype_params():
    def lt(kind):
        def f(wc):
            single = se(wc.sample)
            return {"forward": "SF" if single else "ISF", "reverse": "SR" if single else "ISR",
                    "unstranded": "U" if single else "IU"}[kind]
        return f
    return {"lt_forward": lt("forward"), "lt_reverse": lt("reverse"), "lt_unstranded": lt("unstranded")}


# Quantification directories: qdir -> quant_type (file prefix <type>.merged.*)
QUANT_TYPE = {}
if ALIGNER in ("star_salmon", "bowtie2_salmon"):
    QUANT_TYPE[ALIGNER] = "salmon"
elif ALIGNER == "star_rsem":
    QUANT_TYPE[ALIGNER] = "rsem"
if PSEUDO:
    QUANT_TYPE[PSEUDO] = PSEUDO


def quant_result(qdir, s):
    """Per-sample quantification output tximport reads."""
    if QUANT_TYPE[qdir] == "rsem":
        return f"{so(s)}/{qdir}/{s}.isoforms.results"
    return f"{so(s)}/{qdir}/{s}"


def quant_samples(qdir):
    """Samples quantified into <qdir> (toSortedList by result file name)."""
    samples = quant_samples_bam() if qdir == ALIGNER else samples_trimmed()
    return sorted(samples, key=lambda s: os.path.basename(quant_result(qdir, s)))


wildcard_constraints:
    qdir=alternation(QUANT_TYPE) if QUANT_TYPE else "(?!x)x",


if ALIGNER in ("star_salmon", "bowtie2_salmon"):

    # SALMON_QUANT (QUANTIFY_BAM_SALMON: alignment mode on the transcriptome BAM)
    rule salmon_quant_bam:
        input:
            bam=lambda wc: transcriptome_bam(wc.sample),
            transcripts=TX_FASTA,
            gtf=GTF,
            strand=lambda wc: bam_strand(wc.sample),
        output:
            directory(f"{ALP}/{{sample}}"),
        params:
            fixed_libtype=cfg("salmon_quant_libtype"),
            extra=literal(cfg("extra_salmon_quant_args")),
            **salmon_libtype_params(),
        container:
            container_path("salmon")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            SALMON_LIBTYPE_SH + """
            for f in {input.bam} {input.transcripts} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
            salmon quant --geneMap $(basename {input.gtf}) --threads {threads} -t $(basename {input.transcripts}) \
                -a $(basename {input.bam}) --libType=$libtype {params.extra} -o {wildcards.sample}
            mv {wildcards.sample} {output}
            """


if ALIGNER == "star_rsem":

    # RSEM_CALCULATEEXPRESSION / SENTIEON_RSEMCALCULATEEXPRESSION (--alignments on the transcriptome BAM;
    # ext.args '--estimate-rspd --seed 1')
    rule rsem_calculateexpression:
        input:
            bam=lambda wc: transcriptome_bam(wc.sample),
            index=RSEM_INDEX,
            strand=lambda wc: bam_strand(wc.sample),
        output:
            genes=f"{ALP}/{{sample}}.genes.results",
            isoforms=f"{ALP}/{{sample}}.isoforms.results",
            stat=directory(f"{ALP}/{{sample}}.stat"),
        params:
            paired=lambda wc: "" if se(wc.sample) else "--paired-end",
            log_dir=lambda wc: os.path.abspath(f"{als(wc.sample)}/log"),
            license=literal(SENTIEON_LICENSE_SH + "; " + SENTIEON_STAR_LINK if SENTIEON else ""),
        container:
            container_path("rsem_sentieon" if SENTIEON else "rsem")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            {params.license}
            case "$(cat {input.strand})" in
                forward) strand="--strandedness forward" ;; reverse) strand="--strandedness reverse" ;; *) strand= ;;
            esac
            ln -s $(realpath {input.index}) rsem_index
            ln -s $(realpath {input.bam}) $(basename {input.bam})
            INDEX=`find -L ./rsem_index -name "*.grp" | sed 's/\\.grp$//'`
            rsem-calculate-expression --num-threads {threads} --temporary-folder ./tmp/ --alignments \
                $strand {params.paired} --estimate-rspd --seed 1 $(basename {input.bam}) $INDEX {wildcards.sample}
            mv {wildcards.sample}.genes.results {output.genes}
            mv {wildcards.sample}.isoforms.results {output.isoforms}
            mv {wildcards.sample}.stat {output.stat}
            if ls {wildcards.sample}*.log >/dev/null 2>&1; then mkdir -p {params.log_dir}; mv {wildcards.sample}*.log {params.log_dir}/; fi
            """

    # CUSTOM_RSEMMERGECOUNTS (prefix rsem.merged)
    rule custom_rsemmergecounts:
        input:
            genes=lambda wc: [f"{so(s)}/{ALIGNER}/{s}.genes.results" for s in quant_samples(ALIGNER)],
            isoforms=lambda wc: [f"{so(s)}/{ALIGNER}/{s}.isoforms.results" for s in quant_samples(ALIGNER)],
        output:
            **{x: f"{AL}/rsem_merge_counts/rsem.merged.{x}.tsv"
               for x in ("gene_counts", "gene_tpm", "transcript_counts", "transcript_tpm", "genes_long", "isoforms_long")},
        container:
            container_path("ubuntu")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            mkdir genes isoforms
            for f in {input.genes}; do ln -s $(realpath $f) genes/$(basename $f); done
            for f in {input.isoforms}; do ln -s $(realpath $f) isoforms/$(basename $f); done
            prefix=rsem.merged
            mkdir -p tmp/genes
            cut -f 1,2 `ls ./genes/* | head -n 1` > gene_ids.txt
            for fileid in `ls ./genes/*`; do
                samplename=`basename $fileid | sed s/\\.genes.results$//g`
                echo $samplename > tmp/genes/${{samplename}}.counts.txt
                cut -f 5 ${{fileid}} | tail -n+2 >> tmp/genes/${{samplename}}.counts.txt
                echo $samplename > tmp/genes/${{samplename}}.tpm.txt
                cut -f 6 ${{fileid}} | tail -n+2 >> tmp/genes/${{samplename}}.tpm.txt
            done
            mkdir -p tmp/isoforms
            cut -f 1,2 `ls ./isoforms/* | head -n 1` > transcript_ids.txt
            for fileid in `ls ./isoforms/*`; do
                samplename=`basename $fileid | sed s/\\.isoforms.results$//g`
                echo $samplename > tmp/isoforms/${{samplename}}.counts.txt
                cut -f 5 ${{fileid}} | tail -n+2 >> tmp/isoforms/${{samplename}}.counts.txt
                echo $samplename > tmp/isoforms/${{samplename}}.tpm.txt
                cut -f 6 ${{fileid}} | tail -n+2 >> tmp/isoforms/${{samplename}}.tpm.txt
            done
            paste gene_ids.txt tmp/genes/*.counts.txt > $prefix.gene_counts.tsv
            paste gene_ids.txt tmp/genes/*.tpm.txt > $prefix.gene_tpm.tsv
            paste transcript_ids.txt tmp/isoforms/*.counts.txt > $prefix.transcript_counts.tsv
            paste transcript_ids.txt tmp/isoforms/*.tpm.txt > $prefix.transcript_tpm.tsv
            echo -e "sample_name\\tgene_id\\ttranscript_id(s)\\tlength\\teffective_length\\texpected_count\\tTPM\\tFPKM" > $prefix.genes_long.tsv
            for fileid in `ls ./genes/*`; do
                samplename=`basename $fileid | sed s/\\.genes.results$//g`
                tail -n+2 $fileid | awk -v sample=$samplename 'BEGIN{{OFS="\\t"}}{{print sample,$1,$2,$3,$4,$5,$6,$7}}' >> $prefix.genes_long.tsv
            done
            echo -e "sample_name\\ttranscript_id\\tgene_id\\tlength\\teffective_length\\texpected_count\\tTPM\\tFPKM\\tIsoPct" > $prefix.isoforms_long.tsv
            for fileid in `ls ./isoforms/*`; do
                samplename=`basename $fileid | sed s/\\.isoforms.results$//g`
                tail -n+2 $fileid | awk -v sample=$samplename 'BEGIN{{OFS="\\t"}}{{print sample,$1,$2,$3,$4,$5,$6,$7,$8}}' >> $prefix.isoforms_long.tsv
            done
            for x in gene_counts gene_tpm transcript_counts transcript_tpm genes_long isoforms_long; do
                mv $prefix.$x.tsv $(dirname {output.gene_counts})/
            done
            """


if PSEUDO == "salmon":

    # SALMON_QUANT (QUANTIFY_PSEUDO_ALIGNMENT: reads mode)
    rule salmon_quant_reads:
        input:
            reads=lambda wc: reads_filtered(wc.sample),
            lint=lambda wc: lint_gate(wc.sample, last_stage()),
            index=SALMON_INDEX,
            gtf=GTF,
            strand=strand_file,
        output:
            directory(pub("salmon") + "/{sample}"),
        params:
            reads=lambda wc, input: (
                f"-r {os.path.basename(input.reads[0])}" if se(wc.sample)
                else f"-1 {os.path.basename(input.reads[0])} -2 {os.path.basename(input.reads[1])}"
            ),
            fixed_libtype=cfg("salmon_quant_libtype"),
            extra=literal(cfg("extra_salmon_quant_args")),
            **salmon_libtype_params(),
        container:
            container_path("salmon")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            SALMON_LIBTYPE_SH + """
            for f in {input.reads} {input.index} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
            salmon quant --geneMap $(basename {input.gtf}) --threads {threads} --index $(basename {input.index}) \
                {params.reads} --libType=$libtype {params.extra} -o {wildcards.sample}
            mv {wildcards.sample} {output}
            """


if PSEUDO == "kallisto":

    KALLISTO_EXTRA = cfg("extra_kallisto_quant_args")

    # KALLISTO_QUANT (--fr/--rf-stranded from strandedness unless given in
    # extra_kallisto_quant_args; --single with the fragment length for SE)
    rule kallisto_quant:
        input:
            reads=lambda wc: reads_filtered(wc.sample),
            lint=lambda wc: lint_gate(wc.sample, last_stage()),
            index=KALLISTO_INDEX,
            gtf=GTF,
            strand=strand_file,
        output:
            results=directory(pub("kallisto") + "/{sample}"),
            log=f"{W}/kallisto/{{sample}}.log",
            json=f"{W}/kallisto/{{sample}}.run_info.json",
        params:
            single=lambda wc: (
                f"--single --fragment-length={config['kallisto_quant_fraglen']} --sd={config['kallisto_quant_fraglen_sd']}"
                if se(wc.sample) else ""
            ),
            own_strand="1" if ("--fr-stranded" in KALLISTO_EXTRA or "--rf-stranded" in KALLISTO_EXTRA) else "",
            extra=literal(KALLISTO_EXTRA),
        container:
            container_path("kallisto")
        threads: res("process_high")["threads"]
        resources:
            mem_mb=res("process_high")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            strand=
            if [ -z "{params.own_strand}" ]; then
                case "$(cat {input.strand})" in forward) strand=--fr-stranded ;; reverse) strand=--rf-stranded ;; esac
            fi
            p={wildcards.sample}
            for f in {input.index} {input.gtf} {input.reads}; do ln -s $(realpath $f) $(basename $f); done
            reads=; for f in {input.reads}; do reads="$reads $(basename $f)"; done
            mkdir -p $p && kallisto quant --threads {threads} --index $(basename {input.index}) \
                --gtf $(basename {input.gtf}) {params.single} $strand {params.extra} -o $p $reads \
                2>| >(tee -a $p/kallisto_quant.log >&2)
            cp $p/kallisto_quant.log $p.log
            cp $p/run_info.json $p.run_info.json
            mv $p {output.results}
            mv $p.log {output.log}
            mv $p.run_info.json {output.json}
            """


# CUSTOM_TX2GENE (QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT; first quant result by name)
rule custom_tx2gene:
    input:
        gtf=GTF,
        quant=lambda wc: quant_result(wc.qdir, quant_samples(wc.qdir)[0]),
    output:
        f"{O}/{{qdir}}/{{qtype}}.merged.tx2gene.tsv",
    wildcard_constraints:
        qtype="salmon|rsem|kallisto",
    params:
        id=config["gtf_group_features"],
        extra=config["gtf_extra_attributes"],
    container:
        container_path("tx2gene")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir quants
        ln -s $(realpath {input.quant}) quants/$(basename {input.quant})
        TPL_quant_type={wildcards.qtype} TPL_gtf={input.gtf} TPL_id='{params.id}' TPL_extra='{params.extra}' \
        TPL_task_ext_prefix={wildcards.qtype}.merged TPL_meta_id=null TPL_task_process=CUSTOM_TX2GENE \
            python3 {SCRIPTS}/tx2gene.py
        mv {wildcards.qtype}.merged.tx2gene.tsv {output}
        """


TXIMPORT_OUT = [
    "gene_tpm", "gene_counts", "gene_counts_length_scaled", "gene_counts_scaled", "gene_lengths",
    "transcript_tpm", "transcript_counts", "transcript_lengths", "tx2gene_augmented",
]
# Per-sample TXIMETA_TXIMPORT (skip_quantification_merge) does not publish
# gene_counts_length_scaled.
TXIMPORT_SAMPLE_OUT = [x for x in TXIMPORT_OUT if x != "gene_counts_length_scaled"]


# TXIMETA_TXIMPORT (meta.id all_samples, prefix <type>.merged)
rule tximport:
    input:
        quants=lambda wc: [quant_result(wc.qdir, s) for s in quant_samples(wc.qdir)],
        tx2gene=f"{O}/{{qdir}}/{{qtype}}.merged.tx2gene.tsv",
    output:
        **{x: f"{O}/{{qdir}}/{{qtype}}.merged.{x}.tsv" for x in TXIMPORT_OUT},
    wildcard_constraints:
        qtype="salmon|rsem|kallisto",
    container:
        container_path("tximport")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir quants
        for q in {input.quants}; do ln -s $(realpath $q) quants/$(basename $q); done
        TPL_task_ext_args=null TPL_quant_type={wildcards.qtype} TPL_tx2gene={input.tx2gene} \
        TPL_task_ext_prefix={wildcards.qtype}.merged TPL_meta_id=all_samples TPL_task_process=TXIMETA_TXIMPORT \
            Rscript {SCRIPTS}/tximport.r
        for f in {wildcards.qtype}.merged.*.tsv; do mv $f $(dirname {output.gene_tpm})/$f; done
        """


# TXIMETA_TXIMPORT per sample (skip_quantification_merge; prefix <id>)
rule tximport_sample:
    input:
        quant=lambda wc: quant_result(wc.qdir, wc.sample),
        tx2gene=lambda wc: f"{O}/{wc.qdir}/{QUANT_TYPE[wc.qdir]}.merged.tx2gene.tsv",
    output:
        **{x: pub("{qdir}") + f"/{{sample}}.{x}.tsv" for x in TXIMPORT_SAMPLE_OUT},
    params:
        qtype=lambda wc: QUANT_TYPE[wc.qdir],
    container:
        container_path("tximport")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        mkdir quants
        ln -s $(realpath {input.quant}) quants/$(basename {input.quant})
        TPL_task_ext_args=null TPL_quant_type={params.qtype} TPL_tx2gene={input.tx2gene} \
        TPL_task_ext_prefix={wildcards.sample} TPL_meta_id={wildcards.sample} TPL_task_process=TXIMETA_TXIMPORT \
            Rscript {SCRIPTS}/tximport.r
        rm -f {wildcards.sample}.gene_counts_length_scaled.tsv
        for f in {wildcards.sample}.*.tsv; do mv $f $(dirname {output.gene_tpm})/$f; done
        """


# SUMMARIZEDEXPERIMENT (SE_GENE_UNIFIED / SE_TRANSCRIPT_UNIFIED)
def se_inputs(wc):
    d = f"{O}/{wc.qdir}"
    p = f"{wc.qtype}.merged"
    if wc.level == "gene":
        mats = ["gene_counts", "gene_counts_length_scaled", "gene_counts_scaled", "gene_lengths", "gene_tpm"]
        rowdata = f"{d}/{p}.tx2gene.tsv"
    else:
        mats = ["transcript_counts", "transcript_lengths", "transcript_tpm"]
        rowdata = f"{d}/{p}.tx2gene_augmented.tsv"
    return {"matrices": [f"{d}/{p}.{m}.tsv" for m in mats], "rowdata": rowdata,
            "coldata": SHEET}


rule summarizedexperiment:
    input:
        unpack(se_inputs),
    output:
        f"{O}/{{qdir}}/{{qtype}}.merged.{{level}}.SummarizedExperiment.rds",
    wildcard_constraints:
        level="gene|transcript",
        qtype="salmon|rsem|kallisto",
    params:
        assays=lambda wc: ("counts,counts_length_scaled,counts_scaled,lengths,tpm"
                           if wc.level == "gene" else "counts,lengths,tpm"),
    container:
        container_path("summarizedexperiment")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        TPL_task_ext_args='--assay_names {params.assays}' TPL_matrix_files='{input.matrices}' \
        TPL_rowdata={input.rowdata} TPL_coldata={input.coldata} \
        TPL_task_ext_prefix={wildcards.qtype}.merged.{wildcards.level} TPL_meta_id=all_samples \
        TPL_task_process=SUMMARIZEDEXPERIMENT \
            Rscript {SCRIPTS}/summarizedexperiment.r
        mv {wildcards.qtype}.merged.{wildcards.level}.SummarizedExperiment.rds {output}
        """


# DESEQ2_QC_BAM_SALMON / DESEQ2_QC_RSEM / DESEQ2_QC_PSEUDO (bin/deseq2_qc.r)
rule deseq2_qc:
    input:
        counts=lambda wc: f"{O}/{wc.qdir}/{QUANT_TYPE[wc.qdir]}.merged.gene_counts_length_scaled.tsv",
        pca_header=f"{ASSETS}/deseq2_pca_header.txt",
        clustering_header=f"{ASSETS}/deseq2_clustering_header.txt",
    output:
        pdf=f"{O}/{{qdir}}/deseq2_qc/deseq2.plots.pdf",
        rdata=f"{O}/{{qdir}}/deseq2_qc/deseq2.dds.RData",
        pca=f"{O}/{{qdir}}/deseq2_qc/deseq2.pca.vals.txt",
        dists=f"{O}/{{qdir}}/deseq2_qc/deseq2.sample.dists.txt",
        session=f"{O}/{{qdir}}/deseq2_qc/R_sessionInfo.log",
        size_factors=directory(f"{O}/{{qdir}}/deseq2_qc/size_factors"),
        pca_mqc=f"{W}/deseq2_qc/{{qdir}}.pca.vals_mqc.tsv",
        dists_mqc=f"{W}/deseq2_qc/{{qdir}}.sample.dists_mqc.tsv",
    params:
        args="--id_col 1 --sample_suffix '' --count_col 3" + (" --vst TRUE" if flag("deseq2_vst") else ""),
        upper=lambda wc: wc.qdir.upper(),
    container:
        container_path("deseq2")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        Rscript {SCRIPTS}/deseq2_qc.r --count_file {input.counts} --outdir ./ --cores {threads} \
            --outprefix deseq2 {params.args}
        if [ -f "R_sessionInfo.log" ]; then
            sed "s/deseq2_pca/{wildcards.qdir}_deseq2_pca/g" <{input.pca_header} > pca_header.tmp
            sed -i -e "s/DESeq2 PCA/{params.upper} DESeq2 PCA/g" pca_header.tmp
            cat pca_header.tmp *.pca.vals.txt > {wildcards.qdir}.pca.vals_mqc.tsv
            rm pca_header.tmp
            sed "s/deseq2_clustering/{wildcards.qdir}_deseq2_clustering/g" <{input.clustering_header} > clustering_header.tmp
            sed -i -e "s/DESeq2 sample/{params.upper} DESeq2 sample/g" clustering_header.tmp
            cat clustering_header.tmp *.sample.dists.txt > {wildcards.qdir}.sample.dists_mqc.tsv
            rm clustering_header.tmp
        fi
        mv deseq2.plots.pdf {output.pdf}
        mv deseq2.dds.RData {output.rdata}
        mv deseq2.pca.vals.txt {output.pca}
        mv deseq2.sample.dists.txt {output.dists}
        mv R_sessionInfo.log {output.session}
        mv size_factors {output.size_factors}
        mv {wildcards.qdir}.pca.vals_mqc.tsv {output.pca_mqc}
        mv {wildcards.qdir}.sample.dists_mqc.tsv {output.dists_mqc}
        """


# =============================================================================
# Differential expression (port extension, not in nf-core/rnaseq 3.27.0):
# PyDESeq2 per comparison, volcano/MA plots, preranked GSEA (GSEApy). Runs on
# every quantification directory (salmon by default; star_rsem / kallisto /
# pseudo_aligner chain the same way) when `comparisons` is set.
# =============================================================================
DE = f"{O}/{{qdir}}/differential"


# Samplesheet with `sample` = <condition>_<sample> (only with a condition column).
rule samplesheet_ids:
    input:
        config["input"],
    output:
        f"{W}/samplesheet.ids.csv",
    run:
        with open(input[0], newline="") as fh:
            fields = csv.DictReader(fh).fieldnames
        with open(output[0], "w", newline="") as fh:
            writer = csv.DictWriter(fh, fieldnames=fields, lineterminator="\n")
            writer.writeheader()
            writer.writerows(SHEET_ROWS)


rule pydeseq2:
    input:
        counts=lambda wc: f"{O}/{wc.qdir}/{QUANT_TYPE[wc.qdir]}.merged.{config['de_counts']}.tsv",
        samplesheet=SHEET,
    output:
        norm=f"{DE}/deseq2.normalized_counts.tsv",
        vst=f"{DE}/deseq2.vst.tsv",
        size_factors=f"{DE}/deseq2.size_factors.tsv",
        pca=f"{DE}/deseq2.pca.pdf",
        pca_tsv=f"{DE}/deseq2.pca.tsv",
        results=[f"{DE}/{c}/{c}.deseq2.results.tsv" for c in CONTRASTS],
        significant=[f"{DE}/{c}/{c}.deseq2.significant.tsv" for c in CONTRASTS],
    params:
        comparisons=" ".join(f"--comparison {c['baseline']}:{c['treatment']}" for c in COMPARISONS),
        shrink="--shrink" if flag("de_lfc_shrink") else "",
        min_counts=config.get("de_min_counts", 10),
        padj=config.get("de_padj", 0.05),
        lfc=config.get("de_lfc", 1.0),
    log:
        f"{DE}/deseq2.log",
    container:
        container_path("pydeseq2")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shell:
        """
        python3 {SCRIPTS}/pydeseq2_de.py --counts {input.counts} --samplesheet {input.samplesheet} \
            {params.comparisons} --outdir $(dirname {output.norm}) --min-counts {params.min_counts} \
            --padj {params.padj} --lfc {params.lfc} {params.shrink} --threads {threads} > {log} 2>&1
        """


rule volcano:
    input:
        f"{DE}/{{contrast}}/{{contrast}}.deseq2.results.tsv",
    output:
        pdf=f"{DE}/{{contrast}}/{{contrast}}.volcano.pdf",
        png=f"{DE}/{{contrast}}/{{contrast}}.volcano.png",
        ma=f"{DE}/{{contrast}}/{{contrast}}.ma.pdf",
    wildcard_constraints:
        contrast=alternation(CONTRASTS),
    params:
        padj=config.get("de_padj", 0.05),
        lfc=config.get("de_lfc", 1.0),
        top=config.get("de_label_top", 15),
    container:
        container_path("volcano")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        python3 {SCRIPTS}/volcano.py --results {input} --title {wildcards.contrast} \
            --volcano {output.pdf} --volcano-png {output.png} --ma {output.ma} \
            --padj {params.padj} --lfc {params.lfc} --label-top {params.top}
        """


rule gsea_prerank:
    input:
        results=f"{DE}/{{contrast}}/{{contrast}}.deseq2.results.tsv",
        gmt=lambda wc: GSEA_GMT[wc.gmt],
    output:
        results=f"{DE}/{{contrast}}/gsea/{{gmt}}/gsea.results.tsv",
        rnk=f"{DE}/{{contrast}}/gsea/{{gmt}}/gsea.rnk",
        top=f"{DE}/{{contrast}}/gsea/{{gmt}}/gsea.top_terms.pdf",
        plots=directory(f"{DE}/{{contrast}}/gsea/{{gmt}}/enrichment_plots"),
    wildcard_constraints:
        contrast=alternation(CONTRASTS),
        gmt=alternation(GSEA_GMT),
    params:
        gene_id=cfg("gsea_gene_id", "gene_name"),
        min_size=config.get("gsea_min_size", 15),
        max_size=config.get("gsea_max_size", 500),
        perm=config.get("gsea_permutations", 1000),
        seed=config.get("gsea_seed", 42),
        top=config.get("gsea_top_terms", 10),
    log:
        f"{DE}/{{contrast}}/gsea/{{gmt}}/gsea.log",
    container:
        container_path("gseapy")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shell:
        """
        python3 {SCRIPTS}/gsea_prerank.py --results {input.results} --gmt {input.gmt} \
            --outdir $(dirname {output.results}) --gene-id {params.gene_id} \
            --min-size {params.min_size} --max-size {params.max_size} --permutations {params.perm} \
            --seed {params.seed} --top-terms {params.top} --threads {threads} > {log} 2>&1
        """


# =============================================================================
# BAM_MARKDUPLICATES_PICARD
# =============================================================================
def markdup_input(wc):
    return input_genome_bam(wc.sample) if not ALIGN else sorted_bam(wc.sample)


# PICARD_MARKDUPLICATES
rule picard_markduplicates:
    input:
        bam=markdup_input,
        fasta=FASTA or [],
        fai=FAI or [],
    output:
        bam=f"{ALP}/{{sample}}.markdup.sorted.bam",
        metrics=pub(f"{ALIGNER}/picard_metrics") + "/{sample}.markdup.sorted.metrics.txt",
    params:
        mem=lambda wc, resources: int(resources.mem_mb * 0.8),
    container:
        container_path("picard")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bam} {input.fasta} {input.fai}; do ln -s $(realpath $f) $(basename $f); done
        p={wildcards.sample}.markdup.sorted
        picard -Xmx{params.mem}M MarkDuplicates \
            --ASSUME_SORTED true --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp \
            --INPUT $(basename {input.bam}) --OUTPUT $p.bam --REFERENCE_SEQUENCE $(basename {input.fasta}) \
            --METRICS_FILE $p.metrics.txt
        mv $p.bam {output.bam}
        mv $p.metrics.txt {output.metrics}
        """


# =============================================================================
# STRINGTIE (+ BAM_STRINGTIE_MERGE with stringtie_ignore_gtf)
# =============================================================================
STRINGTIE_STRAND_SH = 'case "$(cat {input.strand})" in forward) s=--fr ;; reverse) s=--rf ;; *) s= ;; esac'

if flag("stringtie_ignore_gtf"):

    # STRINGTIE_STRINGTIE (BAM_STRINGTIE_MERGE: de novo assembly guided by the
    # GTF, prefix <id>.denovo; only the transcripts GTF is published)
    rule stringtie_denovo:
        input:
            unpack(final_bam_bai),
            gtf=GTF,
            strand=lambda wc: bam_strand(wc.sample),
        output:
            gtf=pub(f"{ALIGNER}/stringtie") + "/{sample}.denovo.transcripts.gtf",
        container:
            container_path("stringtie")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            STRINGTIE_STRAND_SH + """
            for f in {input.bam} {input.bai} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
            p={wildcards.sample}.denovo
            stringtie -o $p.transcripts.gtf -G $(basename {input.gtf}) -A $p.gene.abundance.txt \
                -C $p.coverage.gtf -b $p.ballgown -p {threads} $(basename {input.bam}) $s -v
            mv $p.transcripts.gtf {output.gtf}
            """

    # STRINGTIE_MERGE (prefix stringtie_merge; inputs sorted by file name)
    rule stringtie_merge:
        input:
            gtfs=lambda wc: sorted(
                (f"{als(s)}/stringtie/{s}.denovo.transcripts.gtf" for s in samples_mapped()),
                key=os.path.basename,
            ),
            gtf=GTF,
        output:
            f"{AL}/stringtie/stringtie_merge.gtf",
        container:
            container_path("stringtie")
        threads: res("process_medium")["threads"]
        resources:
            mem_mb=res("process_medium")["mem_mb"],
        shadow:
            "minimal"
        shell:
            """
            for f in {input.gtfs} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
            names=""; for f in {input.gtfs}; do names="$names $(basename $f)"; done
            stringtie --merge $names -G $(basename {input.gtf}) -o stringtie_merge.gtf -p {threads}
            mv stringtie_merge.gtf {output}
            """

STRINGTIE_GTF = f"{AL}/stringtie/stringtie_merge.gtf" if flag("stringtie_ignore_gtf") else GTF


# STRINGTIE_STRINGTIE (mode expression-estimation, ext.args '<--fr|--rf> -v')
rule stringtie:
    input:
        unpack(final_bam_bai),
        gtf=STRINGTIE_GTF,
        strand=lambda wc: bam_strand(wc.sample),
    output:
        gtf=pub(f"{ALIGNER}/stringtie") + "/{sample}.transcripts.gtf",
        abundance=pub(f"{ALIGNER}/stringtie") + "/{sample}.gene.abundance.txt",
        coverage=pub(f"{ALIGNER}/stringtie") + "/{sample}.coverage.gtf",
        ballgown=directory(pub(f"{ALIGNER}/stringtie") + "/{sample}.ballgown"),
    container:
        container_path("stringtie")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        STRINGTIE_STRAND_SH + """
        for f in {input.bam} {input.bai} {input.gtf}; do ln -s $(realpath $f) $(basename $f); done
        p={wildcards.sample}
        stringtie -o $p.transcripts.gtf -e -G $(basename {input.gtf}) -A $p.gene.abundance.txt \
            -C $p.coverage.gtf -b $p.ballgown -p {threads} $(basename {input.bam}) $s -v
        mv $p.transcripts.gtf {output.gtf}
        mv $p.gene.abundance.txt {output.abundance}
        mv $p.coverage.gtf {output.coverage}
        mv $p.ballgown {output.ballgown}
        """


