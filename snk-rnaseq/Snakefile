def stats_bam(wc):
    if wc.kind == "sorted":
        return {"bam": f"{SORTED_DIR}/{wc.sample}.sorted.bam", "bai": f"{SORTED_DIR}/{wc.sample}.sorted.bam.bai"}
    return {"bam": f"{AL}/{wc.sample}.markdup.sorted.bam", "bai": f"{AL}/{wc.sample}.markdup.sorted.bam.bai"}


# SAMTOOLS_STATS (BAM_STATS_SAMTOOLS after sort, and after MarkDuplicates)
rule samtools_stats:
    input:
        unpack(stats_bam),
        fasta=FASTA,
        fai=FAI,
    output:
        f"{AL}/samtools_stats/{{sample}}.{{kind}}.bam.stats",
    container:
        container_path("samtools")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        for f in {input.bam} {input.bai} {input.fasta} {input.fai}; do ln -s $(realpath $f) $(basename $f); done
        samtools stats --threads {threads} --reference $(basename {input.fasta}) $(basename {input.bam}) \
            > $(basename {output})
        mv $(basename {output}) {output}
        """


