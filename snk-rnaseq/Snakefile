# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
def container_path(key):
    path = config["containers"][key]
    return path if os.path.isabs(path) else os.path.join(workflow.basedir, path)


def res(label):
    return config["resources"][label]


def flag(key):
    return bool(config.get(key))


def cfg(key, default=""):
    """A string parameter; None (YAML null) and missing keys become `default`."""
    value = config.get(key)
    return default if value is None else value


def literal(text):
    """A params value Snakemake must not format (it may contain braces)."""
    return lambda wildcards: text


def is_url(path):
    return str(path).startswith(("http://", "https://", "ftp://"))


def basename_noext(path):
    """Nextflow Path.baseName: file name without its last extension."""
    return os.path.splitext(os.path.basename(path))[0]


def simple_name(path):
    """Nextflow Path.simpleName: file name up to the first dot."""
    return os.path.basename(path).split(".")[0]


def alternation(names):
    names = list(names)
    return "|".join(re.escape(n) for n in names) if names else "(?!x)x"


# Sentieon modules: licence from SENTIEON_LICENSE_BASE64 (nf-core secret) if set,
# and a `STAR` symlink to the sentieon binary for RSEM.
SENTIEON_LICENSE_SH = (
    'if [ -n "${SENTIEON_LICENSE_BASE64:-}" ]; then export SENTIEON_LICENSE=$(mktemp); '
    'echo -e "$SENTIEON_LICENSE_BASE64" | base64 -d > $SENTIEON_LICENSE; fi'
)
SENTIEON_STAR_LINK = 'ln -sf $(which sentieon) ./STAR; export PATH=".:$PATH"'


def merge_args(args, extra, split=r"\s(?=--)"):
    """ext.args merge used for STAR/HISAT2/Bowtie2: user extras override defaults."""
    if not extra:
        return args
    merged = OrderedDict()
    for token in re.split(split, " ".join(args) + " " + extra):
        parts = token.strip().split(None, 1)
        merged[parts[0]] = parts[1] if len(parts) > 1 else ""
    return [f"{k} {v}" if v else k for k, v in merged.items()]


# Remote inputs (FASTQ / BAM / reference URLs) are staged into {W}/inputs/ by
# fetch_remote, the equivalent of Nextflow's automatic staging of remote files.
REMOTE = {}


def stage(path):
    if not path or not is_url(path):
        return path
    name = os.path.basename(path)
    if REMOTE.get(name, path) != path:
        raise ValueError(f"Two remote inputs share the file name {name!r}.")
    REMOTE[name] = path
    return f"{W}/inputs/{name}"


def read_text(path):
    if is_url(path):
        with urllib.request.urlopen(path) as fh:
            return fh.read().decode()
    with open(path) as fh:
        return fh.read()


