# RSEQC_JUNCTIONANNOTATION
rule rseqc_junctionannotation:
    input:
        unpack(final_bam_bai),
        bed=GENE_BED,
    output:
        bed=f"{R}/junction_annotation/bed/{{sample}}.junction.bed",
        interact=f"{R}/junction_annotation/bed/{{sample}}.junction.Interact.bed",
        xls=f"{R}/junction_annotation/xls/{{sample}}.junction.xls",
        events=f"{R}/junction_annotation/pdf/{{sample}}.splice_events.pdf",
        junction=f"{R}/junction_annotation/pdf/{{sample}}.splice_junction.pdf",
        rscript=f"{R}/junction_annotation/rscript/{{sample}}.junction_plot.r",
        log=f"{R}/junction_annotation/log/{{sample}}.junction_annotation.log",
    container:
        container_path("rseqc")
    threads: res("process_medium")["threads"]
    resources:
        mem_mb=res("process_medium")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        p={wildcards.sample}
        for f in {input.bam} {input.bai} {input.bed}; do ln -s $(realpath $f) $(basename $f); done
        junction_annotation.py -i $(basename {input.bam}) -r $(basename {input.bed}) -o $p 2> stderr.txt || rc=$?
        grep -v 'E::idx_find_and_load' stderr.txt | tee $p.junction_annotation.log >&2 || true
        [ "${{rc:-0}}" -eq 0 ] || exit $rc
        mv $p.junction.bed {output.bed}
        mv $p.junction.Interact.bed {output.interact}
        mv $p.junction.xls {output.xls}
        mv $p.splice_events.pdf {output.events}
        mv $p.splice_junction.pdf {output.junction}
        mv $p.junction_plot.r {output.rscript}
        mv $p.junction_annotation.log {output.log}
        """


