# =============================================================================
# Coverage tracks (BEDTOOLS_GENOMECOV_* + BEDGRAPH_BEDCLIP_BEDGRAPHTOBIGWIG_*)
# =============================================================================
# BEDTOOLS_GENOMECOV_FW / _REV / _COMBINED. The published name comes from the
# bigWig subworkflow (FORWARD takes the _FW output), so <id>.forward.bigWig is
# '-strand +' for forward-stranded libraries and '-strand -' for reverse ones.
rule bedtools_genomecov:
    input:
        unpack(final_bam_bai),
        strand=strand_file,
    output:
        temp(f"{W}/bigwig/{{sample}}{{strand}}.bedGraph"),
    params:
        buffer=lambda wc, resources: f"--buffer-size={int(resources.mem_mb // 1024) // 2}G",
    container:
        container_path("bedtools")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        case "{wildcards.strand}:$(cat {input.strand})" in
            :*)                args="-split -bg" ;;
            .forward:reverse)  args="-split -du -strand - -bg" ;;
            .reverse:reverse)  args="-split -du -strand + -bg" ;;
            .forward:*)        args="-split -du -strand + -bg" ;;
            .reverse:*)        args="-split -du -strand - -bg" ;;
        esac
        bedtools genomecov -ibam {input.bam} $args \
            | LC_ALL=C sort --parallel={threads} {params.buffer} -k1,1 -k2,2n > {output}
        """


# UCSC_BEDCLIP (prefix <id>.clip[.forward|.reverse])
rule ucsc_bedclip:
    input:
        bedgraph=f"{W}/bigwig/{{sample}}{{strand}}.bedGraph",
        sizes=SIZES,
    output:
        temp(f"{W}/bigwig/{{sample}}.clip{{strand}}.bedGraph"),
