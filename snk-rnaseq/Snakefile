# rRNA FASTAs (ribo_database_manifest, GUNZIP_RRNA_FASTAS). Not needed when a
# pre-built bowtie2_rrna_index is given (nf-core passes no ribo tool then).
RRNA_FASTAS = []
if RIBO == "sortmerna" or (RIBO == "bowtie2" and not cfg("bowtie2_rrna_index")):
    _manifest = cfg("ribo_database_manifest")
    if not os.path.isabs(_manifest) and not is_url(_manifest) and not os.path.exists(_manifest):
        _manifest = os.path.join(workflow.basedir, _manifest)
    RRNA_FASTAS = [gunzipped(line.strip()) for line in read_text(_manifest).splitlines() if line.strip()]
    if not RRNA_FASTAS:
        raise ValueError(f"File provided with ribo_database_manifest is empty: {_manifest}")

# -----------------------------------------------------------------------------
# Indices (PREPARE_GENOME_INDICES). Only the indices a step consumes are built.
# -----------------------------------------------------------------------------
UNTAR_SRC = {}  # UNTAR_*: output name in INDEX_DIR -> .tar.gz source


def index_path(param, built_name):
    value = cfg(param)
    if not value:
        return f"{INDEX_DIR}/{built_name}"
    value = stage(value)
    if value.endswith(".tar.gz"):
        name = os.path.basename(value)[: -len(".tar.gz")]
        UNTAR_SRC[name] = value
        return f"{INDEX_DIR}/{name}"
    return value


def untar_name(param):
    """The untar wildcard of a `.tar.gz` index param (None otherwise)."""
    value = str(cfg(param) or "")
    return os.path.basename(value)[: -len(".tar.gz")] if value.endswith(".tar.gz") else None


SKIP_BBSPLIT = flag("skip_bbsplit") or not HAS_FASTA
if not SKIP_BBSPLIT:
    BBSPLIT_INDEX = index_path("bbsplit_index", "bbsplit_index")
    BBSPLIT_REFS = OrderedDict()
    if not cfg("bbsplit_index"):
        _list = cfg("bbsplit_fasta_list")
        if not read_text(_list).strip():
            raise ValueError(f"File provided with bbsplit_fasta_list is empty: {_list}")
        for line in read_text(_list).splitlines():
            if line.strip():
                name, path = [x.strip() for x in line.split(",")[:2]]
                BBSPLIT_REFS[name] = stage(path)
ALIGN = not SKIP_ALIGN
