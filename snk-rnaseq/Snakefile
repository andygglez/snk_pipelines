# CAT_FASTQ (several runs, uncompressed input or save_merged_fastq)
rule cat_fastq_se:
    input:
        lambda wc: [r1 for r1, _ in SAMPLES[wc.sample]["runs"]],
    output:
        f"{FASTQ_D}/{{sample}}.merged.fastq.gz",
    wildcard_constraints:
        sample=alternation(RAW_SE),
    params:
        compress=lambda wc: "" if SAMPLES[wc.sample]["runs"][0][0].endswith(".gz") else "| gzip",
    container:
        container_path("coreutils")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        "cat {input} {params.compress} > {output}"


rule cat_fastq_pe:
    input:
        r1=lambda wc: [r1 for r1, _ in SAMPLES[wc.sample]["runs"]],
        r2=lambda wc: [r2 for _, r2 in SAMPLES[wc.sample]["runs"]],
    output:
        r1=f"{FASTQ_D}/{{sample}}_1.merged.fastq.gz",
        r2=f"{FASTQ_D}/{{sample}}_2.merged.fastq.gz",
    wildcard_constraints:
        sample=alternation(RAW_PE),
    params:
        compress=lambda wc: "" if SAMPLES[wc.sample]["runs"][0][0].endswith(".gz") else "| gzip",
    container:
        container_path("coreutils")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shell:
        """
        cat {input.r1} {params.compress} > {output.r1}
        cat {input.r2} {params.compress} > {output.r2}
        """


LINT_STAGE_OF_DIR = {d: st for st, d in LINT_DIR.items() if st in lint_stages()}


# FQ_LINT / FQ_LINT_AFTER_TRIMMING / FQ_LINT_AFTER_BBSPLIT /
# FQ_LINT_AFTER_RIBO_REMOVAL. The aliases are the same FQ_LINT process, so
# withName: 'FQ_LINT' (ext.args extra_fqlint_args) applies to all of them.
rule fq_lint:
    input:
        lambda wc: LINT_STAGES[LINT_STAGE_OF_DIR[wc.lint_dir]](wc.sample),
    output:
        pub("fq_lint/{lint_dir}") + "/{sample}.fq_lint.txt",
    wildcard_constraints:
        lint_dir=alternation(LINT_STAGE_OF_DIR),
    params:
        args=literal(cfg("extra_fqlint_args")),
    container:
        container_path("fq")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shell:
        "fq lint {params.args} {input} > {output}"


def fastqc_input(wc):
    files = {"raw": reads_cat, "filtered": reads_filtered, "trimmed": reads_trimmed}[wc.fqtag](wc.sample)
    return mate_file(files, wc.mate)


# FASTQC: raw (prefix <id>_raw), FASTQC_FILTERED (after BBSplit / rRNA removal,
# prefix <id>_filtered) and FASTQ_FASTQC_UMITOOLS_FASTP:FASTQC_TRIM (prefix
# <id>_trimmed). nf-core runs both mates in one process; here each mate is its
# own job (same files, same arguments).
rule fastqc:
    input:
        fastqc_input,
    output:
        html=pub("fastqc/{fqstage}") + "/{sample}_{fqtag}{mate}_fastqc.html",
        zip=pub("fastqc/{fqstage}") + "/{sample}_{fqtag}{mate}_fastqc.zip",
    wildcard_constraints:
        fqstage="raw|filtered|trim",
        fqtag="raw|filtered|trimmed",
    params:
        # FastQC --memory is per thread, clamped to 100..10000 MB
        memory=lambda wc, threads, resources: min(10000, max(100, int(resources.mem_mb / threads))),
        link=lambda wc, input: f"{wc.sample}_{wc.fqtag}{wc.mate}.{input[0].rsplit('.', 1)[-1]}",
    container:
        container_path("fastqc")
    threads: res("process_low")["threads"]
    resources:
        mem_mb=res("process_low")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input}) {params.link}
        fastqc --quiet --threads {threads} --memory {params.memory} {params.link}
        mv {wildcards.sample}_{wildcards.fqtag}{wildcards.mate}_fastqc.html {output.html}
        mv {wildcards.sample}_{wildcards.fqtag}{wildcards.mate}_fastqc.zip {output.zip}
        """


UMI_EXTRACT_ARGS = " ".join(filter(None, [
    f"--extract-method={cfg('umitools_extract_method')}" if cfg("umitools_extract_method") else "",
    f"--bc-pattern='{cfg('umitools_bc_pattern')}'" if cfg("umitools_bc_pattern") else "",
    f"--bc-pattern2='{cfg('umitools_bc_pattern2')}'" if cfg("umitools_bc_pattern2") else "",
    f"--umi-separator='{cfg('umitools_umi_separator')}'" if cfg("umitools_umi_separator") else "",
]))


# UMITOOLS_EXTRACT (single-end)
rule umitools_extract_se:
    input:
        reads=lambda wc: reads_cat(wc.sample),
        lint=lambda wc: lint_gate(wc.sample, "raw"),
    output:
        reads=f"{UMI_D}/{{sample}}.umi_extract.fastq.gz",
        log=pub("umitools") + "/{sample}.umi_extract.log",
    wildcard_constraints:
        sample=alternation(RAW_SE),
    params:
        args=literal(UMI_EXTRACT_ARGS),
    container:
        container_path("umitools")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        umi_tools extract -I {input.reads[0]} -S {wildcards.sample}.umi_extract.fastq.gz {params.args} \
            > {wildcards.sample}.umi_extract.log
        mv {wildcards.sample}.umi_extract.fastq.gz {output.reads}
        mv {wildcards.sample}.umi_extract.log {output.log}
        """


# UMITOOLS_EXTRACT (paired-end)
rule umitools_extract_pe:
    input:
        reads=lambda wc: reads_cat(wc.sample),
        lint=lambda wc: lint_gate(wc.sample, "raw"),
    output:
        r1=f"{UMI_D}/{{sample}}.umi_extract_1.fastq.gz",
        r2=f"{UMI_D}/{{sample}}.umi_extract_2.fastq.gz",
        log=pub("umitools") + "/{sample}.umi_extract.log",
    wildcard_constraints:
        sample=alternation(RAW_PE),
    params:
        args=literal(UMI_EXTRACT_ARGS),
    container:
        container_path("umitools")
    threads: res("process_single")["threads"]
    resources:
        mem_mb=res("process_single")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        p={wildcards.sample}
        umi_tools extract -I {input.reads[0]} --read2-in={input.reads[1]} -S $p.umi_extract_1.fastq.gz \
            --read2-out=$p.umi_extract_2.fastq.gz {params.args} > $p.umi_extract.log
        mv $p.umi_extract_1.fastq.gz {output.r1}
        mv $p.umi_extract_2.fastq.gz {output.r2}
        mv $p.umi_extract.log {output.log}
        """


def trimgalore_args(threads, single_end):
    """conf/modules/trimgalore.config ext.args (preset map overridden by extra args)."""
    args = {"--fastqc_args": f"'-t {threads}'"}
    extra = cfg("extra_trimgalore_args")
    for arg in re.split(r"\s(?=--)", extra.strip()) if extra.strip() else []:
        parts = arg.strip().split(None, 1)
        args[parts[0]] = parts[-1]
    joined = " ".join(f"{k} {v}" for k, v in args.items()).strip()
    if single_end:
        kept = [a for a in re.split(r"\s(?=--)", joined) if "_r2 " not in a.lower()]
        joined = " ".join(kept)
    return joined


def trimgalore_cores(threads, single_end):
    cores = threads - (3 if single_end else 4)
    return min(8, max(1, cores))


def trimgalore_outputs(s):
    p = f"{s}_trimmed"
    d = so(s)
    if se(s):
        return [f"{d}/trimgalore/{p}.fastq.gz_trimming_report.txt",
                f"{d}/fastqc/trim/{p}_trimmed_fastqc.html", f"{d}/fastqc/trim/{p}_trimmed_fastqc.zip"]
    return [f"{d}/trimgalore/{p}_{r}.fastq.gz_trimming_report.txt" for r in (1, 2)] + [
        f"{d}/fastqc/trim/{p}_{r}_val_{r}_fastqc.{e}" for r in (1, 2) for e in ("html", "zip")
    ]


def trim_json_files(s):
    """Trim Galore JSON reports (kept in the work dir; MultiQC reads them)."""
    if se(s):
        return [f"{W}/trimgalore/{s}_trimmed.fastq.gz_trimming_report.json"]
    return [f"{W}/trimgalore/{s}_trimmed_{r}.fastq.gz_trimming_report.json" for r in (1, 2)]


# TRIMGALORE (paired-end)
rule trimgalore_pe:
    input:
        reads=lambda wc: reads_umi(wc.sample),
        lint=lambda wc: lint_gate(wc.sample, "raw"),
    output:
        r1=f"{TRIM_D}/{{sample}}_trimmed_1_val_1.fq.gz",
        r2=f"{TRIM_D}/{{sample}}_trimmed_2_val_2.fq.gz",
        log1=pub("trimgalore") + "/{sample}_trimmed_1.fastq.gz_trimming_report.txt",
        log2=pub("trimgalore") + "/{sample}_trimmed_2.fastq.gz_trimming_report.txt",
        json1=f"{W}/trimgalore/{{sample}}_trimmed_1.fastq.gz_trimming_report.json",
        json2=f"{W}/trimgalore/{{sample}}_trimmed_2.fastq.gz_trimming_report.json",
        html1=pub("fastqc/trim") + "/{sample}_trimmed_1_val_1_fastqc.html",
        zip1=pub("fastqc/trim") + "/{sample}_trimmed_1_val_1_fastqc.zip",
        html2=pub("fastqc/trim") + "/{sample}_trimmed_2_val_2_fastqc.html",
        zip2=pub("fastqc/trim") + "/{sample}_trimmed_2_val_2_fastqc.zip",
    wildcard_constraints:
        sample=alternation(PE),
    params:
        args=lambda wc, threads: trimgalore_args(threads, False),
        cores=lambda wc, threads: trimgalore_cores(threads, False),
        p=lambda wc: f"{wc.sample}_trimmed",
    container:
        container_path("trimgalore")
    threads: res("trimgalore")["threads"]
    resources:
        mem_mb=res("trimgalore")["mem_mb"],
    shadow:
        "minimal"
    shell:
        """
        ln -s $(realpath {input.reads[0]}) {params.p}_1.fastq.gz
        ln -s $(realpath {input.reads[1]}) {params.p}_2.fastq.gz
        trim_galore {params.args} --cores {params.cores} --paired --gzip \
            {params.p}_1.fastq.gz {params.p}_2.fastq.gz
        mv {params.p}_1_val_1.fq.gz {output.r1}
        mv {params.p}_2_val_2.fq.gz {output.r2}
        mv {params.p}_1.fastq.gz_trimming_report.txt {output.log1}
        mv {params.p}_2.fastq.gz_trimming_report.txt {output.log2}
        mv {params.p}_1.fastq.gz_trimming_report.json {output.json1}
        mv {params.p}_2.fastq.gz_trimming_report.json {output.json2}
        mv {params.p}_1_val_1_fastqc.html {output.html1}
        mv {params.p}_1_val_1_fastqc.zip {output.zip1}
        mv {params.p}_2_val_2_fastqc.html {output.html2}
        mv {params.p}_2_val_2_fastqc.zip {output.zip2}
        """


# TRIMGALORE (single-end)
rule trimgalore_se:
    input:
        reads=lambda wc: reads_umi(wc.sample),
